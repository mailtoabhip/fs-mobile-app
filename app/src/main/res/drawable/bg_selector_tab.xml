<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white"/>
            <corners android:radius="@dimen/size_8dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/light_line_grey" />
            <padding
                android:top="@dimen/size_8dp"
                android:bottom="@dimen/size_8dp"
                android:left="16dp"
                android:right="16dp"/>
            <!-- Shadow/elevation is usually set in layout, not drawable, but can be hinted here -->
        </shape>
    </item>
    <item android:state_selected="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_light_grey_v1"/>
            <corners android:radius="@dimen/size_8dp"/>
            <padding
                android:top="@dimen/size_8dp"
                android:bottom="@dimen/size_8dp"
                android:left="16dp"
                android:right="16dp" />
        </shape>
    </item>
</selector> 