<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_pressed_background" />
            <stroke
                android:width="1dp"
                android:color="@color/button_outline_color" />
            <corners android:radius="@dimen/size_6dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_disabled_background" />
            <stroke
                android:width="1dp"
                android:color="@color/button_disabled_outline" />
            <corners android:radius="@dimen/size_6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/button_outline_color" />
            <corners android:radius="@dimen/size_6dp" />
        </shape>
    </item>
</selector>
