<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_enabled="true">
    <shape>
      <corners android:radius="@dimen/size_2dp" />

      <padding android:bottom="@dimen/size_12dp" android:left="@dimen/size_12dp" android:right="@dimen/size_12dp" android:top="@dimen/size_12dp" />

      <solid android:color="@color/colorAccent" />
    </shape>
  </item>

  <item android:state_enabled="false">
    <shape>
      <corners android:radius="@dimen/size_2dp" />

      <padding android:bottom="@dimen/size_12dp" android:left="@dimen/size_12dp" android:right="@dimen/size_12dp" android:top="@dimen/size_12dp" />

      <solid android:color="@color/transparent_white" />
    </shape>
  </item>
</selector>