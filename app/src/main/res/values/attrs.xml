<?xml version="1.0" encoding="utf-8"?>
<resources>
  <declare-styleable name="DelhiveryOTPViewEditText">
    <attr format="boolean" name="state_error"/>
  </declare-styleable>

  <declare-styleable name="DelhiveryOnboardingArcView">
    <attr format="enum" name="direction">
      <enum name="top" value="0"/>
      <enum name="bottom" value="1"/>
    </attr>
  </declare-styleable>

  <declare-styleable name="DelhiveryAutoFitTextView">
    <!-- Minimum size of the text. -->
    <attr format="dimension" name="minTextSize"/>
    <!-- Amount of precision used to calculate the correct text size to fit within its
    bounds. Lower precision is more precise and takes more time. -->
    <attr format="float" name="precision"/>
    <!-- Defines whether to automatically resize text to fit to the view's bounds. -->
    <attr format="boolean" name="sizeToFit"/>
  </declare-styleable>
</resources>