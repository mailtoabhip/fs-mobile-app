<resources>

  <!-- Base application theme. -->
  <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
    <!-- Customize your theme here. -->
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
    <item name="colorAccent">@color/colorAccent</item>
    <item name="android:windowLightStatusBar">true</item>
  </style>

  <style name="CustomSplashScreenTheme" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/white</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/splash_inset</item>
    <item name="windowSplashScreenAnimationDuration">10</item>
    <item name="postSplashScreenTheme">@style/AppTheme</item>
  </style>

  <!-- Action button -->
  <style name="ActionButton">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@drawable/bg_action_btn</item>
    <item name="android:textColor">@color/button_text</item>
    <item name="android:textSize">@dimen/text_16sp</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
  </style>

  <!-- Action button -->
  <style name="SubmitButton">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@drawable/bg_submit_btn</item>
    <item name="android:textColor">@color/button_text</item>
    <item name="android:textSize">@dimen/text_14sp</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
  </style>

  <style name="FilterButton">
    <item name="android:background">@drawable/bg_all_round_corner_red_solid_selector_toggle</item>
    <item name="android:paddingTop">@dimen/size_6dp</item>
    <item name="android:paddingBottom">@dimen/size_6dp</item>
    <item name="android:paddingStart">@dimen/size_10dp</item>
    <item name="android:paddingEnd">@dimen/size_10dp</item>
    <item name="android:textColor">@color/filter_button_text</item>
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
  </style>

  <!-- Action button delete-->
  <style name="ActionDeleteButton">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@color/destructive_red</item>
    <item name="android:textColor">@color/white</item>
    <item name="android:textSize">@dimen/text_16sp</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
  </style>

  <!-- Outline Action button -->
  <style name="OutlineActionButton">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@drawable/bg_outline_action_btn</item>
    <item name="android:textColor">@color/sub_heading_black</item>
    <item name="android:textSize">@dimen/text_14sp</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
  </style>

  <!-- Outline Action delete button -->
  <style name="OutlineDeleteActionButton">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@drawable/bg_outline_delete_action_btn</item>
    <item name="android:textColor">@color/destructive_red</item>
    <item name="android:textSize">@dimen/text_14sp</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
  </style>

  <!-- Outline Action delete button -->
  <style name="DeleteActionButton">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@drawable/bg_delete_action_btn</item>
    <item name="android:textColor">@color/white</item>
    <item name="android:textSize">@dimen/text_14sp</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
  </style>

  <!-- Form input field -->
  <style name="FormInputField" parent="SearchEditText">
    <item name="android:background">@drawable/bg_form_edit</item>
    <item name="colorControlNormal">#1e000000</item>
    <item name="colorControlActivated">@color/colorAccent</item>
    <item name="colorControlHighlight">@color/colorAccent</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColorHint">#61000000</item>
    <item name="android:textSize">@dimen/text_16sp</item>
    <item name="android:textColor">@color/heading_black</item>
    <item name="android:textCursorDrawable">@null</item>
  </style>

  <!-- Bottom navigation View(Inactive) -->
  <style name="BottomNavigationView.Inactive" parent="@style/TextAppearance.AppCompat.Caption">
    <item name="android:textSize">@dimen/text_12sp</item>
    <item name="android:textStyle">normal</item>
  </style>

  <!-- Bottom navigation View(Active) -->
  <style name="BottomNavigationView.Active" parent="@style/TextAppearance.AppCompat.Caption">
    <item name="android:textSize">@dimen/text_12sp</item>
    <item name="android:textStyle">bold</item>
  </style>

  <style name="SearchEditText" parent="Base.V7.Widget.AppCompat.EditText">
    <item name="colorControlNormal">#1e000000</item>
    <item name="colorControlActivated">@color/colorAccent</item>
    <item name="colorControlHighlight">@color/colorAccent</item>
  </style>

  <style name="view_header_background">
    <item name="android:background">@drawable/bg_bids_header_gradient</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:orientation">vertical</item>
    <item name="android:paddingBottom">@dimen/size_8dp</item>
    <item name="android:paddingStart">@dimen/size_16dp</item>
    <item name="android:paddingTop">@dimen/size_8dp</item>
    <item name="android:layout_marginTop">@dimen/size_16dp</item>
    <item name="android:layout_marginBottom">@dimen/size_8dp</item>
  </style>

  <style name="ErrorText" parent="TextAppearance.AppCompat">
    <item name="android:textColor">@color/colorDelhiveryRed</item>
    <item name="android:textSize">@dimen/text_12sp</item>
  </style>

  <style name="TextInputLayoutAppearance" parent="Widget.Design.TextInputLayout">
    <!-- reference our hint & error styles -->
    <item name="errorTextAppearance">@style/ErrorText</item>
    <item name="android:textColorHint">@color/color_hint</item>
    <item name="colorControlNormal">@color/white</item>
    <item name="colorControlActivated">@color/black</item>
    <item name="android:paddingTop">@dimen/size_4dp</item>
    <item name="android:layout_marginTop">@dimen/size_8dp</item>
  </style>

  <style name="style_delete_button">
    <item name="android:layout_width">@dimen/size_24dp</item>
    <item name="android:layout_height">@dimen/size_24dp</item>
    <item name="android:src">@drawable/ic_cancel</item>
    <item name="android:visibility">gone</item>
  </style>

  <style name="view_header_background_white">
    <item name="android:background">@drawable/bg_pending_header_white</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:orientation">vertical</item>
    <item name="android:paddingBottom">@dimen/size_8dp</item>
    <item name="android:paddingStart">@dimen/size_16dp</item>
    <item name="android:paddingEnd">@dimen/size_11dp</item>
    <item name="android:paddingTop">@dimen/size_8dp</item>
    <item name="android:layout_marginTop">@dimen/size_8dp</item>
    <item name="android:layout_marginBottom">@dimen/size_8dp</item>
  </style>

  <style name="DialogAnimation">
    <item name="android:windowEnterAnimation">@anim/slide_in</item>
    <item name="android:windowExitAnimation">@anim/slide_out</item>
  </style>

  <style name="RatingBar" parent="Theme.AppCompat">
    <item name="colorControlNormal">@color/grey_bg</item>
    <item name="colorControlActivated">@color/yellow</item>
  </style>

  <style name="CustomTextAppearanceTab" parent="TextAppearance.Design.Tab">
    <item name="textAllCaps">false</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">@dimen/text_14sp</item>
  </style>

  <style name="CheckBoxStyle" parent="Theme.AppCompat.Light.NoActionBar">
    <item name="colorControlNormal">@color/white</item>
    <item name="colorAccent">@color/dark_blue</item>
    <item name="colorControlActivated">@color/dark_blue</item>
  </style>

  <style name="Toolbar.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
    <item name="android:textSize">@dimen/text_14sp</item>
  </style>

  <style name="MyCustomTabLayout" parent="Widget.Design.TabLayout">
    <item name="tabIndicatorColor">?attr/colorAccent</item>
    <item name="tabTextAppearance">@style/CustomTextAppearanceTab</item>
    <item name="tabTextColor">@color/tab_selected_text</item>
  </style>
</resources>
