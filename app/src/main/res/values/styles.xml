<resources>

  <!-- Base application theme. -->
  <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
    <!-- Customize your theme here. -->
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
    <item name="colorAccent">@color/colorAccent</item>
    <item name="android:windowLightStatusBar">true</item>
  </style>

  <!-- Action button -->
  <style name="ActionButton">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@drawable/bg_action_btn</item>
    <item name="android:textColor">@android:color/white</item>
    <item name="android:textSize">14sp</item>
  </style>

  <!-- Form input field -->
  <style name="FormInputField" parent="Base.V7.Widget.AppCompat.EditText">
    <item name="colorControlNormal">#1e000000</item>
    <item name="colorControlActivated">@color/colorAccent</item>
    <item name="colorControlHighlight">@color/colorAccent</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColorHint">#61000000</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textColor">#de000000</item>
    <item name="android:textCursorDrawable">@null</item>
  </style>

  <!-- Bottom navigation View(Inactive) -->
  <style name="BottomNavigationView.Inactive" parent="@style/TextAppearance.AppCompat.Caption">
    <item name="android:textSize">12sp</item>
    <item name="android:textStyle">normal</item>
  </style>

  <!-- Bottom navigation View(Active) -->
  <style name="BottomNavigationView.Active" parent="@style/TextAppearance.AppCompat.Caption">
    <item name="android:textSize">12sp</item>
    <item name="android:textStyle">bold</item>
  </style>
</resources>
