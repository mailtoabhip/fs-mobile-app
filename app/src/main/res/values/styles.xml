<resources>

  <!-- Base application theme. -->
  <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
    <!-- Customize your theme here. -->
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
    <item name="colorAccent">@color/colorAccent</item>
    <item name="android:windowLightStatusBar">true</item>
  </style>

  <style name="CustomSplashScreenTheme" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/white</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_delfin</item>
    <item name="windowSplashScreenAnimationDuration">10</item>
    <item name="postSplashScreenTheme">@style/AppTheme</item>
  </style>

  <!-- Action button -->
  <style name="ActionButton">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@drawable/bg_action_light_black_btn_without_border</item>
    <item name="android:textColor">@color/button_text</item>
    <item name="android:textSize">@dimen/text_16sp</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
  </style>

  <!-- Action button -->
  <style name="SubmitButton">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@drawable/bg_action_light_black_btn_without_border</item>
    <item name="android:textColor">@color/button_text</item>
    <item name="android:textSize">@dimen/text_14sp</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
  </style>

  <style name="FilterButton">
    <item name="android:background">@drawable/bg_all_round_corner_red_solid_selector_toggle</item>
    <item name="android:paddingTop">@dimen/size_6dp</item>
    <item name="android:paddingBottom">@dimen/size_6dp</item>
    <item name="android:paddingStart">@dimen/size_10dp</item>
    <item name="android:paddingEnd">@dimen/size_10dp</item>
    <item name="android:textColor">@color/filter_button_text</item>
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
  </style>

  <!-- Action button delete-->
  <style name="ActionDeleteButton">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@color/destructive_red</item>
    <item name="android:textColor">@color/white</item>
    <item name="android:textSize">@dimen/text_16sp</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
  </style>

  <!-- Outline Action button -->
  <style name="OutlineActionButton">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@drawable/bg_outline_action_btn</item>
    <item name="android:textColor">@color/sub_heading_black</item>
    <item name="android:textSize">@dimen/text_14sp</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
  </style>

  <!-- Outline Action delete button -->
  <style name="OutlineDeleteActionButton">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@drawable/bg_outline_delete_action_btn</item>
    <item name="android:textColor">@color/destructive_red</item>
    <item name="android:textSize">@dimen/text_14sp</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
  </style>

  <!-- Outline Action delete button -->
  <style name="DeleteActionButton">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:background">@drawable/bg_delete_action_btn</item>
    <item name="android:textColor">@color/white</item>
    <item name="android:textSize">@dimen/text_14sp</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
  </style>

  <!-- Form input field -->
  <style name="FormInputField" parent="SearchEditText">
    <item name="android:background">@drawable/bg_form_edit</item>
    <item name="colorControlNormal">#1e000000</item>
    <item name="colorControlActivated">@color/colorAccent</item>
    <item name="colorControlHighlight">@color/colorAccent</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColorHint">#61000000</item>
    <item name="android:textSize">@dimen/text_16sp</item>
    <item name="android:textColor">@color/heading_black</item>
    <item name="android:textCursorDrawable">@null</item>
  </style>

  <!-- Bottom navigation View(Inactive) -->
  <style name="BottomNavigationView.Inactive" parent="@style/TextAppearance.AppCompat.Caption">
    <item name="android:textSize">@dimen/text_12sp</item>
    <item name="android:textStyle">normal</item>
  </style>

  <!-- Bottom navigation View(Active) -->
  <style name="BottomNavigationView.Active" parent="@style/TextAppearance.AppCompat.Caption">
    <item name="android:textSize">@dimen/text_12sp</item>
    <item name="android:textStyle">bold</item>
  </style>

  <style name="SearchEditText" parent="Base.V7.Widget.AppCompat.EditText">
    <item name="colorControlNormal">#1e000000</item>
    <item name="colorControlActivated">@color/colorAccent</item>
    <item name="colorControlHighlight">@color/colorAccent</item>
  </style>

  <style name="view_header_background">
    <item name="android:background">@drawable/bg_action_light_red_btn</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
    <item name="android:textColor">@color/colorAccent</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:orientation">vertical</item>
    <item name="android:paddingBottom">@dimen/size_4dp</item>
    <item name="android:paddingStart">@dimen/size_4dp</item>
    <item name="android:paddingTop">@dimen/size_4dp</item>
    <item name="android:layout_marginTop">@dimen/size_16dp</item>
    <item name="android:layout_marginBottom">@dimen/size_8dp</item>
  </style>

  <style name="ErrorText" parent="TextAppearance.AppCompat">
    <item name="android:textColor">@color/colorDelhiveryRed</item>
    <item name="android:textSize">@dimen/text_12sp</item>
  </style>

  <style name="TextInputLayoutAppearance" parent="Widget.Design.TextInputLayout">
    <!-- reference our hint & error styles -->
    <item name="errorTextAppearance">@style/ErrorText</item>
    <item name="android:textColorHint">@color/color_hint</item>
    <item name="colorControlNormal">@color/white</item>
    <item name="colorControlActivated">@color/black</item>
    <item name="android:paddingTop">@dimen/size_4dp</item>
    <item name="android:layout_marginTop">@dimen/size_8dp</item>
  </style>

  <style name="style_delete_button">
    <item name="android:layout_width">@dimen/size_24dp</item>
    <item name="android:layout_height">@dimen/size_24dp</item>
    <item name="android:src">@drawable/ic_cancel</item>
    <item name="android:visibility">gone</item>
  </style>

    <style name="style_delete_button_v2">
        <item name="android:layout_width">@dimen/size_24dp</item>
        <item name="android:layout_height">@dimen/size_24dp</item>
        <item name="android:src">@drawable/ic_cross</item>
        <item name="android:visibility">gone</item>
    </style>

  <style name="view_header_background_white">
    <item name="android:background">@drawable/bg_pending_header_white</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:orientation">vertical</item>
    <item name="android:paddingBottom">@dimen/size_8dp</item>
    <item name="android:paddingStart">@dimen/size_16dp</item>
    <item name="android:paddingEnd">@dimen/size_11dp</item>
    <item name="android:paddingTop">@dimen/size_8dp</item>
    <item name="android:layout_marginTop">@dimen/size_8dp</item>
    <item name="android:layout_marginBottom">@dimen/size_8dp</item>
  </style>

  <style name="DialogAnimation">
    <item name="android:windowEnterAnimation">@anim/slide_in</item>
    <item name="android:windowExitAnimation">@anim/slide_out</item>
  </style>

  <style name="DatePickerTheme" parent="Theme.MaterialComponents.Light.Dialog.Alert">
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorAccent">@color/colorAccent</item>
    <item name="android:buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
    <item name="android:buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
  </style>

  <style name="PositiveButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
    <item name="android:textColor">@color/colorAccent</item>
  </style>

  <style name="NegativeButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
    <item name="android:textColor">@color/colorAccent</item>
  </style>

  <style name="RatingBar" parent="Theme.MaterialComponents">
    <item name="colorControlNormal">@color/grey_bg</item>
    <item name="colorControlActivated">@color/yellow</item>
  </style>

  <style name="CustomTextAppearanceTab" parent="TextAppearance.Design.Tab">
    <item name="textAllCaps">false</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textSize">@dimen/text_14sp</item>
  </style>

  <style name="CheckBoxStyle" parent="Theme.MaterialComponents.Light.NoActionBar">
    <item name="colorControlNormal">@color/white</item>
    <item name="colorAccent">@color/dark_blue</item>
    <item name="colorControlActivated">@color/dark_blue</item>
  </style>

  <style name="Toolbar.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
    <item name="android:fontFamily">@font/noto_sans_semibold</item>
    <item name="android:textSize">@dimen/text_14sp</item>
    <item name="android:textColor">@android:color/black</item>
  </style>

  <style name="MyCustomTabLayout" parent="Widget.Design.TabLayout">
    <item name="tabIndicatorColor">?attr/colorAccent</item>
    <item name="tabTextAppearance">@style/CustomTextAppearanceTab</item>
    <item name="tabTextColor">@color/tab_selected_text</item>
  </style>

  <style name="Divider">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">1dp</item>
    <item name="android:background">#E0E3EB</item>
  </style>

  <style name="Button.Primary" parent="Widget.AppCompat.Button">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">48dp</item>
    <item name="android:background">@drawable/bg_button_primary</item>
    <item name="android:textColor">@android:color/white</item>
    <item name="android:textSize">16sp</item>
    <item name="android:textAllCaps">false</item>
  </style>

    <style name="Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_button_clear_filter</item>
        <item name="android:textColor">#111827</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TransparentBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">    <item name="bottomSheetStyle">@style/TransparentBottomSheet</item>
  </style>

  <style name="TransparentBottomSheet" parent="Widget.Design.BottomSheet.Modal">
    <item name="android:background">@android:color/transparent</item>
  </style>

  <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
    <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    <item name="android:windowIsFloating">false</item>
    <item name="android:windowSoftInputMode">adjustResize</item>
  </style>

  <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
    <item name="android:background">@android:color/transparent</item>
  </style>

<!--  Font specific styles -->

  <!-- Base text appearance for app -->
  <style name="TextAppearance.Delfin" parent="TextAppearance.AppCompat">
    <item name="android:fontFamily">@font/noto_sans_regular</item>
  </style>

  <!-- Bold 20sp -->
  <style name="TextAppearance.Delfin.B20">
    <item name="android:fontFamily">@font/noto_sans_bold</item>
    <item name="android:textSize">20sp</item>
  </style>

  <!-- Bold 16sp -->
  <style name="TextAppearance.Delfin.B16">
    <item name="android:fontFamily">@font/noto_sans_bold</item>
    <item name="android:textSize">16sp</item>
  </style>

  <!-- Semi Bold 14sp -->
  <style name="TextAppearance.Delfin.SB14">
    <item name="android:fontFamily">@font/noto_sans_semibold</item>
    <item name="android:textSize">14sp</item>
  </style>

  <!-- Semi Bold 12sp -->
  <style name="TextAppearance.Delfin.SB12">
    <item name="android:fontFamily">@font/noto_sans_semibold</item>
    <item name="android:textSize">12sp</item>
  </style>

  <!-- Medium 14sp -->
  <style name="TextAppearance.Delfin.M14">
    <item name="android:fontFamily">@font/noto_sans_medium</item>
    <item name="android:textSize">14sp</item>
  </style>

  <!-- Medium 12sp -->
  <style name="TextAppearance.Delfin.M12">
    <item name="android:fontFamily">@font/noto_sans_medium</item>
    <item name="android:textSize">12sp</item>
  </style>

  <!-- Regular 20sp -->
  <style name="TextAppearance.Delfin.R14">
    <item name="android:fontFamily">@font/noto_sans_regular</item>
    <item name="android:textSize">14sp</item>
  </style>

</resources>
