<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tool="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="request"
            type="com.delhivery.axle.data.home.placements.HomePlacementsItemData"
            />

        <import type="android.view.View" />
    </data>
    <androidx.cardview.widget.CardView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_2dp"
        android:layout_marginEnd="@dimen/size_2dp"
        android:layout_marginBottom="@dimen/size_12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:cardCornerRadius="@dimen/size_6dp"
        app:cardElevation="@dimen/size_2dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/size_16dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_status_duration"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{request.relativeDurationStatus()}"
                android:textSize="@dimen/text_size_12sp"
                android:textColor="@color/colorDelhiveryRed"
                android:contentDescription="@string/delay_status_content_description"
                tool:text="Delayed by 2 hrs" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/placementLoadType"
                app:layout_constraintTop_toTopOf="@+id/tv_status_duration"
                app:layout_constraintBottom_toBottomOf="@+id/tv_status_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                android:paddingHorizontal="@dimen/size_4dp"
                android:paddingVertical="@dimen/size_4dp"
                android:textStyle="bold"
                android:textSize="@dimen/text_12sp"
                tool:text="Delhivery Load"
                />
            <View
                android:id="@+id/divider"
                android:layout_marginTop="@dimen/size_8dp"
                android:background="@color/bg_light_grey"
                app:layout_constraintTop_toBottomOf="@+id/placementLoadType"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <include layout="@layout/view_origin_destination"
                android:id="@+id/originDestination"
                app:layout_constraintTop_toBottomOf="@+id/divider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp" />

            <include layout="@layout/view_driver_truck_details"
                android:id="@+id/driverTruckDetails"
                app:layout_constraintTop_toBottomOf="@+id/originDestination"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:visibility="@{request.detailsNotVisible()}"
                />

            <include layout="@layout/view_placement_actions"
                android:id="@+id/placementActions"
                app:layout_constraintTop_toBottomOf="@+id/driverTruckDetails"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12dp"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>