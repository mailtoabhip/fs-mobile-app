<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="viewModel"
            type="com.delhivery.axle.ui.kyc.address.CommunicationAddressViewModel"
            />
        <import type="android.view.View" />

    </data>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/light_red_bg"
        android:orientation="vertical">

      <include
          android:id="@+id/progress_step_layout"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          layout="@layout/view_progress_steps"
          android:layout_marginBottom="@dimen/size_24dp"/>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/size_24dp"
            android:paddingEnd="@dimen/size_24dp"
            android:paddingBottom="@dimen/size_48dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/step_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toTopOf="parent"
                android:text="@{viewModel.currentStep}"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_12sp"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/address_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/step_text"
                android:layout_marginTop="@dimen/size_8dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                android:text="@string/label_communication_address"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/address_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/address_text"
                android:text="@string/sub_label_address_details"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_14sp"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/address_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:drawableLeft="@drawable/ic_vector_error"
                android:drawablePadding="@dimen/size_8dp"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/address_hint"
                android:text="@{viewModel.errorText}"
                android:textColor="@color/destructive_red"
                android:textSize="@dimen/text_16sp"
                />
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/gst_address_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                bind:layout_constraintTop_toBottomOf="@+id/address_error"
                android:background="@drawable/bg_all_round_corner_blue_selector"
                android:layout_marginTop="@dimen/size_16dp"
                android:paddingBottom="@dimen/size_16dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/gst_address_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="@dimen/size_18dp"
                android:layout_marginStart="@dimen/size_8dp"
                android:layout_marginEnd="@dimen/size_16dp"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_14sp"
                android:text="GST Address"
                />
             <androidx.appcompat.widget.AppCompatTextView
             android:id="@+id/gst_address_text"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             bind:layout_constraintStart_toStartOf="parent"
             bind:layout_constraintTop_toBottomOf="@+id/gst_address_title"
             android:layout_marginStart="@dimen/size_8dp"
             android:layout_marginEnd="@dimen/size_16dp"
             android:textColor="@color/info_bg"
             android:textSize="@dimen/text_12sp"
             android:text="@{viewModel.gstAddress}"
             tools:text="smwmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm"
             />
         </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/alternate_address_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                bind:layout_constraintTop_toBottomOf="@+id/gst_address_layout"
                android:background="@drawable/bg_all_round_corner_blue_selector"
                android:layout_marginTop="@dimen/size_16dp"
                android:paddingBottom="@dimen/size_16dp"
                android:visibility="gone"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/alt_address_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="@dimen/size_18dp"
                    android:layout_marginStart="@dimen/size_8dp"
                    android:layout_marginEnd="@dimen/size_16dp"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_14sp"
                    android:text="Alternate Address"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/alt_address_title"
                    bind:layout_constraintStart_toStartOf="parent"
                    android:id="@+id/alterate_address_text"
                    android:layout_marginStart="@dimen/size_8dp"
                    android:layout_marginEnd="@dimen/size_16dp"
                    android:textColor="@color/info_bg"
                    android:textSize="@dimen/text_12sp"
                     android:text="@{viewModel.alternateAddress}"
                    app:layout_constraintEnd_toStartOf="@+id/icon_edit" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/icon_edit"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginEnd="@dimen/size_20dp"
                    app:srcCompat="@drawable/ic_edit_pencil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_add_alternate_address"
                android:layout_height="wrap_content"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_14sp"
                android:background="@color/white"
                android:textAllCaps="false"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/alternate_address_layout"
                android:layout_alignParentBottom="true"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/size_24dp"
                android:text="@string/action_add_alternate_address"
                />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_submit_details"
                style="@style/ActionButton"
                android:textAllCaps="false"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/btn_add_alternate_address"
                android:layout_alignParentBottom="true"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/size_24dp"
                android:text="@string/action_submit_details"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>



