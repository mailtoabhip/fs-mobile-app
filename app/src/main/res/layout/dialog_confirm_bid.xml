<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="request"
        type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData"
        />

    <import type="android.view.View" />
  </data>

  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@android:color/white"
      android:orientation="vertical"
      android:paddingStart="@dimen/size_24dp"
      android:paddingTop="@dimen/size_24dp"
      android:paddingEnd="@dimen/size_24dp"
      android:paddingBottom="@dimen/size_4dp"
      >


    <RelativeLayout
        android:layout_marginEnd="@dimen/size_16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/celebrate_icon1"
          android:layout_width="@dimen/size_32dp"
          android:layout_height="@dimen/size_32dp"
          android:layout_centerHorizontal="true"
          app:srcCompat="@drawable/celebrate_1">

      </androidx.appcompat.widget.AppCompatImageView>

      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/celebrate_icon2"
          android:layout_width="@dimen/size_32dp"
          android:layout_height="@dimen/size_32dp"
          android:layout_toEndOf="@+id/celebrate_icon1"
          android:layout_marginStart="@dimen/size_8dp"
          android:layout_centerHorizontal="true"
          app:srcCompat="@drawable/celebrate_2">

      </androidx.appcompat.widget.AppCompatImageView>

    </RelativeLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_bid_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Large"
        android:text="@{request.bidAmountText()}"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="@dimen/text_4sp"
        android:layout_gravity="center"
        android:textColor="@color/heading_black"
        tools:text="Bid placed for Rs 60,000"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/label_stand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bid_stand_label"
        android:layout_marginTop="@dimen/size_16dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="@dimen/text_4sp"
        android:textColor="@color/heading_black"
        tools:text="Where do you stand?"
        />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/lowest_bid_til"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="@{request.lowestBidIconVisibility()}"
        tools:visibility="visible"
        android:layout_marginTop="@dimen/size_12dp"
        >

      <androidx.appcompat.widget.AppCompatImageView
          android:layout_width="@dimen/size_24dp"
          android:layout_height="@dimen/size_24dp"
          app:srcCompat="@drawable/green_tick"/>

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/lowest_bid_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@{request.diffLowestBidText()}"
          android:layout_gravity="center"
          android:fontFamily="sans-serif"
          android:layout_marginStart="@dimen/size_4dp"
          android:lineSpacingExtra="@dimen/text_4sp"
          android:textColor="@color/bid_placed_green"
          tools:text="You currently have the lowest bid"
          />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/non_lowest_bid_til"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="@{request.nonLowestBidIconVisibility()}"
        tools:visibility="gone"
        android:layout_marginTop="@dimen/size_12dp"
        >

      <androidx.appcompat.widget.AppCompatImageView
          android:layout_width="@dimen/size_24dp"
          android:layout_height="@dimen/size_24dp"
          app:srcCompat="@drawable/error_icon"/>

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/non_lowest_bid_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:fontFamily="sans-serif"
          android:layout_marginStart="@dimen/size_4dp"
          android:text="@{request.diffLowestBidText()}"
          android:lineSpacingExtra="@dimen/text_4sp"
          android:textColor="@color/pending"
          tools:text="Your bid is Rs. 2000 higher than the lowest bid"
          />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/benchmark_til"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="@{request.inlineBenchmarkIconVisibility()}"
        tools:visibility="visible"
        android:layout_marginTop="@dimen/size_12dp"
        >

      <androidx.appcompat.widget.AppCompatImageView
          android:layout_width="@dimen/size_24dp"
          android:layout_height="@dimen/size_24dp"
          app:srcCompat="@drawable/green_tick"/>

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/benchmark_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:fontFamily="sans-serif"
          android:text="@{request.diffBenchmarkBidText()}"
          android:layout_marginStart="@dimen/size_4dp"
          android:lineSpacingExtra="@dimen/text_4sp"
          android:textColor="@color/bid_placed_green"
          tools:text="Your bid is inline with DLV Benchmark Price. Your confirmation chances are > 70%"
          />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/non_benchmark_til"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="@{request.notInlineBenchmarkIconVisibility()}"
        tools:visibility="gone"
        android:layout_marginTop="@dimen/size_12dp"
        >

      <androidx.appcompat.widget.AppCompatImageView
          android:layout_width="@dimen/size_24dp"
          android:layout_height="@dimen/size_24dp"
          app:srcCompat="@drawable/error_icon"/>

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/non_benchmark_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:fontFamily="sans-serif"
          android:text="@{request.diffBenchmarkBidText()}"
          android:layout_marginStart="@dimen/size_4dp"
          android:lineSpacingExtra="@dimen/text_4sp"
          android:textColor="@color/pending"
          tools:text="Your bid is 5% higher than the DLV Benchmark price. Reduce it to 57,000 to increase your chances to > 70%"
          />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12dp"
        android:gravity="end"
        >

      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/btn_done"
          style="@style/Widget.AppCompat.Button.Borderless.Colored"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="end"
          android:text="@string/action_done"
          android:textColor="@color/colorAccent"
          android:textSize="@dimen/text_14sp"
          />

      <View
          android:layout_width="@dimen/size_16dp"
          android:layout_height="0dp"
          />

      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/btn_revise"
          style="@style/Widget.AppCompat.Button.Borderless.Colored"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="end"
          android:text="@string/action_revise_bid"
          android:textColor="@color/colorAccent"
          android:textSize="@dimen/text_14sp"
          />

    </androidx.appcompat.widget.LinearLayoutCompat>
  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>