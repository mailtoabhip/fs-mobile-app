<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:bind="http://schemas.android.com/apk/res-auto">

    <data>
       <variable
            name="viewModel"
            type="com.delhivery.axle.ui.profile.HomeProfileViewModel"
            />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        >
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_toolbar"
            android:background="@android:color/white"
            bind:shadow="@{ @dimen/size_1dp }"
        />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/size_16dp"
            android:orientation="vertical">
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_bank_name"
                android:textColor="@color/heading_black"
                android:layout_marginTop="@dimen/size_20dp"
                android:textStyle="normal"
                android:textSize="@dimen/text_14sp"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="@dimen/edit_text_height"
                android:layout_marginTop="@dimen/size_6dp"
                bind:shadow="@{ @dimen/size_4dp }"
                android:layout_gravity="center"
                android:padding="@dimen/size_4dp"
                android:elevation="@dimen/size_4dp"
                android:background="@drawable/bg_rectangle_round_corner_grey">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_bank_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/size_6dp"
                    android:textSize="@dimen/text_16sp"
                    android:text="@{viewModel.bName}"
                    android:textColor="@color/faded_black"
                    tools:text="HDFC Bank"/>


            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_account_number"
                android:layout_marginTop="@dimen/size_20dp"
                android:textColor="@color/black"
                android:textStyle="normal"
                android:textSize="@dimen/text_14sp"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="@dimen/edit_text_height"
                android:layout_marginTop="@dimen/size_6dp"
                android:layout_gravity="center"
                android:padding="@dimen/size_4dp"
                bind:shadow="@{ @dimen/size_4dp }"
                android:elevation="@dimen/size_4dp"
                android:background="@drawable/bg_rectangle_round_corner_grey">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_account_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/size_6dp"
                    android:textSize="@dimen/text_16sp"
                    android:text="@{viewModel.aNum}"
                    android:textColor="@color/faded_black"
                    tools:text="010004256233"/>


            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_ifsc"
                android:layout_marginTop="@dimen/size_20dp"
                android:textColor="@color/black"
                android:textStyle="normal"
                android:textSize="@dimen/text_14sp"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="@dimen/edit_text_height"
                android:layout_marginTop="@dimen/size_6dp"
                bind:shadow="@{ @dimen/size_4dp }"
                android:layout_gravity="center"
                android:padding="@dimen/size_4dp"
                android:elevation="@dimen/size_4dp"
                android:background="@drawable/bg_rectangle_round_corner_grey">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_ifsc_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/size_6dp"
                    android:textSize="@dimen/text_16sp"
                    android:text="@{viewModel.ifsc}"
                    android:textColor="@color/faded_black"
                    tools:text="HDFC0000011"/>


            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>