<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:bind="http://schemas.android.com/apk/res-auto">

    <data>
       <variable
            name="viewModel"
            type="com.delhivery.axle.ui.profile.BankDetailsViewModel"
            />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_toolbar"
            />
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="@dimen/size_24dp"
                android:paddingEnd="@dimen/size_24dp"
                android:paddingBottom="@dimen/size_48dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/payment_error"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16dp"
                    android:fontFamily="sans-serif"
                    android:drawableLeft="@drawable/ic_vector_error"
                    android:drawablePadding="@dimen/size_8dp"
                    android:lineSpacingExtra="@dimen/text_6sp"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/progress"
                    android:textColor="@color/destructive_red"
                    android:textSize="@dimen/text_16sp"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/account_num_textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="@dimen/size_32dp"
                    android:lineSpacingExtra="@dimen/text_6sp"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/payment_error"
                    android:text="@string/sub_label_account_number"
                    android:textColor="@color/sub_heading_black"
                    android:textSize="@dimen/text_16sp"
                    />

                <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                    android:id="@+id/account_num_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edit_text_height"
                    android:imeOptions="actionDone"
                    android:editable="false"
                    android:text="@={ viewModel.accountText }"
                    android:layout_marginTop="@dimen/size_8dp"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/account_num_textView"
                    android:paddingStart="@dimen/size_12dp"
                    android:paddingEnd="@dimen/size_12dp"
                    android:hint="@string/hint_account_num"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_16sp"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/IFSC_textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="@dimen/size_16dp"
                    android:lineSpacingExtra="@dimen/text_6sp"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/account_num_edittext"
                    android:text="@string/sub_label_ifsc"
                    android:textColor="@color/sub_heading_black"
                    android:textSize="@dimen/text_16sp"
                    />

                <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                    android:id="@+id/ifsc_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edit_text_height"
                    android:imeOptions="actionDone"
                    android:editable="false"
                    android:text= "@={ viewModel.ifscText }"
                    android:layout_marginTop="@dimen/size_8dp"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/IFSC_textView"
                    android:paddingStart="@dimen/size_12dp"
                    android:paddingEnd="@dimen/size_12dp"
                    android:hint="@string/sub_label_ifsc"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_16sp"

                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/account_holder_textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="@dimen/size_16dp"
                    android:lineSpacingExtra="@dimen/text_6sp"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/ifsc_edittext"
                    android:text="@string/sub_label_account_holder"
                    android:textColor="@color/sub_heading_black"
                    android:textSize="@dimen/text_16sp"
                    />

                <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                    android:id="@+id/account_holder_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edit_text_height"
                    android:imeOptions="actionDone"
                    android:text= "@={ viewModel.accountHolderText }"
                    android:layout_marginTop="@dimen/size_8dp"
                    android:editable="false"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/account_holder_textView"
                    android:paddingStart="@dimen/size_12dp"
                    android:paddingEnd="@dimen/size_12dp"
                    android:hint="@string/sub_label_account_holder"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_16sp"

                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/account_holder_warning"
                    android:layout_width="wrap_content"
                    android:visibility="gone"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16dp"
                    android:fontFamily="sans-serif"
                    android:drawablePadding="@dimen/size_8dp"
                    android:lineSpacingExtra="@dimen/text_6sp"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/account_holder_edittext"
                    android:text="@string/account_holder_name_warning"
                    android:textColor="@color/destructive_red"
                    android:textSize="@dimen/text_14sp"
                    />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/upload_doc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_24dp"
                    bind:layout_constraintTop_toBottomOf="@+id/account_holder_warning">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/doc_proof"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/text_14sp"
                        android:textStyle="bold"
                        bind:layout_constraintTop_toTopOf="parent"
                        bind:layout_constraintStart_toStartOf="parent"
                        android:text="@string/proof_account"
                        />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/doc_proof_desc"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/text_14sp"
                        android:textStyle="bold"
                        bind:layout_constraintTop_toBottomOf="@+id/doc_proof"
                        bind:layout_constraintStart_toStartOf="parent"
                        android:text="@string/sub_label_proof_account"
                        />
                    <androidx.constraintlayout.widget.ConstraintLayout
                        bind:layout_constraintTop_toBottomOf="@+id/doc_proof_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_16dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/doc_uploaded_lay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            bind:layout_constraintTop_toTopOf="parent"
                            bind:layout_constraintStart_toStartOf="parent">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/doc_icon"
                                android:layout_width="@dimen/size_48dp"
                                android:layout_height="@dimen/size_48dp"
                                bind:srcCompat="@drawable/ic_doc_business"
                                android:layout_marginStart="@dimen/size_2dp"
                                bind:layout_constraintTop_toTopOf="parent"
                                bind:layout_constraintLeft_toLeftOf="parent"
                                bind:layout_constraintBottom_toBottomOf="parent" />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/doc_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/size_12dp"
                                android:layout_marginHorizontal="@dimen/size_16dp"
                                bind:layout_constraintEnd_toStartOf="@+id/doc_remove"
                                bind:layout_constraintTop_toTopOf="parent"
                                android:layout_marginEnd="@dimen/size_30dp"
                                android:textSize="@dimen/text_14sp"
                                bind:layout_constraintStart_toEndOf="@+id/doc_icon"
                                android:text="IMG_344_988"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="0dp"
                                android:id="@+id/doc_size"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/size_12dp"
                                android:layout_marginTop="@dimen/size_8dp"
                                bind:layout_constraintTop_toBottomOf="@+id/doc_title"
                                android:textSize="@dimen/size_12dp"
                                android:textColor="@color/color_hint"
                                bind:layout_constraintLeft_toRightOf="@+id/doc_icon"
                                android:text="233kb"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/doc_remove"
                                android:layout_width="@dimen/size_20dp"
                                android:layout_height="@dimen/size_20dp"
                                bind:srcCompat="@drawable/ic_download_doc_blue"
                                android:layout_marginStart="@dimen/size_2dp"
                                bind:layout_constraintTop_toTopOf="parent"
                                bind:layout_constraintBottom_toBottomOf="parent"
                                bind:layout_constraintRight_toRightOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/upload_doc1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_24dp"
                    bind:layout_constraintTop_toBottomOf="@+id/upload_doc">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/doc_proof1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/text_14sp"
                        android:textStyle="bold"
                        bind:layout_constraintTop_toTopOf="parent"
                        bind:layout_constraintStart_toStartOf="parent"
                        android:text="@string/optional_four_c"
                        />
                    <androidx.constraintlayout.widget.ConstraintLayout
                        bind:layout_constraintTop_toBottomOf="@+id/doc_proof1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_16dp">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:id="@+id/upload_doc_lay1"
                            android:layout_height="wrap_content"
                            android:visibility="visible"
                            bind:layout_constraintTop_toTopOf="parent"
                            bind:layout_constraintStart_toStartOf="parent">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/upload_icon1"
                                android:layout_width="@dimen/size_16dp"
                                android:layout_height="@dimen/size_20dp"
                                bind:srcCompat="@drawable/ic_upload"
                                android:layout_marginStart="@dimen/size_2dp"
                                bind:layout_constraintTop_toTopOf="parent"
                                bind:layout_constraintLeft_toLeftOf="parent"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/size_16dp"
                                bind:layout_constraintTop_toTopOf="parent"
                                android:textSize="@dimen/text_16sp"
                                android:textColor="@color/colorAccent"
                                android:textStyle="bold"
                                bind:layout_constraintLeft_toRightOf="@+id/upload_icon1"
                                android:text="@string/upload_document"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/doc_uploaded_lay1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            bind:layout_constraintTop_toTopOf="parent"
                            bind:layout_constraintStart_toStartOf="parent">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/doc_icon1"
                                android:layout_width="@dimen/size_48dp"
                                android:layout_height="@dimen/size_48dp"
                                bind:srcCompat="@drawable/ic_doc_business"
                                android:layout_marginStart="@dimen/size_2dp"
                                bind:layout_constraintTop_toTopOf="parent"
                                bind:layout_constraintLeft_toLeftOf="parent"
                                bind:layout_constraintBottom_toBottomOf="parent" />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/doc_title1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/size_12dp"
                                android:layout_marginHorizontal="@dimen/size_16dp"
                                bind:layout_constraintEnd_toStartOf="@+id/doc_remove1"
                                bind:layout_constraintTop_toTopOf="parent"
                                android:layout_marginEnd="@dimen/size_30dp"
                                android:textSize="@dimen/text_14sp"
                                bind:layout_constraintStart_toEndOf="@+id/doc_icon1"
                                android:text="IMG_344_988"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="0dp"
                                android:id="@+id/doc_size1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/size_12dp"
                                android:layout_marginTop="@dimen/size_8dp"
                                bind:layout_constraintTop_toBottomOf="@+id/doc_title1"
                                android:textSize="@dimen/size_12dp"
                                android:textColor="@color/color_hint"
                                bind:layout_constraintLeft_toRightOf="@+id/doc_icon1"
                                android:text="233kb"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/doc_remove1"
                                android:layout_width="@dimen/size_20dp"
                                android:layout_height="@dimen/size_20dp"
                                bind:srcCompat="@drawable/ic_remove"
                                android:layout_marginStart="@dimen/size_2dp"
                                bind:layout_constraintTop_toTopOf="parent"
                                bind:layout_constraintBottom_toBottomOf="parent"
                                bind:layout_constraintRight_toRightOf="parent"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/doc_download1"
                                android:layout_width="@dimen/size_20dp"
                                android:layout_height="@dimen/size_20dp"
                                bind:srcCompat="@drawable/ic_download_doc_blue"
                                android:layout_marginStart="@dimen/size_2dp"
                                bind:layout_constraintTop_toTopOf="parent"
                                bind:layout_constraintBottom_toBottomOf="parent"
                                bind:layout_constraintRight_toRightOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/name_declaration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/upload_doc1"
                    android:text="@string/name_declarion_text"
                    />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_submit"
                    style="@style/ActionButton"
                    android:enabled="false"
                    android:textAllCaps="false"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/name_declaration"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/size_32dp"
                    android:text="@string/action_save_changes"
                    />
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_retry"
                    style="@style/ActionButton"
                    android:visibility="gone"
                    android:enabled="false"
                    android:textAllCaps="false"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/name_declaration"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/size_32dp"
                    android:text="@string/label_retry"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>