<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
  <data>
    <variable
        name="origin"
        type="com.delhivery.orion.data.CityModel"
        />
  </data>
  <android.support.v7.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:focusableInTouchMode="true"
      android:orientation="vertical"
      android:paddingTop="@dimen/size_24dp"
      >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_24dp"
        android:layout_marginTop="@dimen/size_16dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="@dimen/text_6sp"
        android:text="@string/label_destination_states"
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_24sp"
        android:textStyle="bold"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_24dp"
        android:layout_marginTop="@dimen/size_6dp"
        android:fontFamily="sans-serif-medium"
        android:text="@{ @string/label_from_state(origin.state) }"
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_16sp"
        android:textStyle="normal"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_24dp"
        android:layout_marginTop="@dimen/size_16dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="@dimen/text_6sp"
        android:text="@string/msg_select_route_destinations"
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_14sp"
        android:textStyle="normal"
        />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/size_12dp"
        android:layout_marginStart="@dimen/size_12dp"
        android:layout_marginTop="@dimen/size_12dp"
        >

      <android.support.v7.widget.RecyclerView
          android:id="@+id/rv_destinations"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:saveEnabled="false"
          />

      <android.support.v7.widget.CardView
          android:id="@+id/action_container"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_alignParentBottom="true"
          android:layout_marginEnd="@dimen/size_8dp"
          android:layout_marginStart="@dimen/size_8dp"
          app:cardCornerRadius="@dimen/size_6dp"
          app:cardElevation="@dimen/size_4dp"
          >

        <android.support.v7.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_top_round_corner_white"
            android:orientation="vertical"
            >

          <android.support.v7.widget.AppCompatCheckBox
              android:id="@+id/check_select_all"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_gravity="center_horizontal"
              android:layout_margin="@dimen/size_8dp"
              android:checked="true"
              android:paddingBottom="@dimen/size_12dp"
              android:paddingStart="@dimen/size_16dp"
              android:paddingTop="@dimen/size_12dp"
              android:saveEnabled="false"
              android:text="@string/action_deselect_all_states"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_16sp"
              />

          <android.support.v7.widget.AppCompatButton
              android:id="@+id/btn_action"
              android:layout_width="match_parent"
              android:layout_marginBottom="@dimen/size_10dp"
              android:layout_marginEnd="@dimen/size_24dp"
              android:layout_marginStart="@dimen/size_24dp"
              android:text="@string/action_confirm_route"
              style="@style/ActionButton"
              />
        </android.support.v7.widget.LinearLayoutCompat>

      </android.support.v7.widget.CardView>

    </RelativeLayout>

  </android.support.v7.widget.LinearLayoutCompat>
</layout>