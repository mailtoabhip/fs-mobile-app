<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="milestone"
            type="com.delhivery.axle.data.tripdetail.TripMilestone" />
        <variable
            name="isLastItem"
            type="Boolean" />
        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_milestone"
            android:layout_width="@dimen/size_16dp"
            android:layout_height="@dimen/size_16dp"
            android:layout_marginStart="@dimen/size_32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@{milestone.getIconRes()}"
            tools:src="@drawable/ic_check_circle_green" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_milestone_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:text="@{milestone.displayName}"
            android:textAlignment="viewStart"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textSize="@dimen/text_12sp"
            app:layout_constraintBottom_toBottomOf="@+id/icon_milestone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/icon_milestone"
            app:layout_constraintTop_toTopOf="@+id/icon_milestone"
            tools:text="Arrived at pickup" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_milestone_timestamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8dp"
            android:layout_marginTop="@dimen/size_2dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:text="@{milestone.timestamp}"
            android:textColor="@color/faded_black"
            android:textSize="10sp"
            android:visibility="@{milestone.timestamp != null &amp;&amp; !milestone.timestamp.isEmpty() ? View.VISIBLE : View.GONE}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/icon_milestone"
            app:layout_constraintTop_toBottomOf="@+id/tv_milestone_name"
            tools:text="17-Mar-2026 11:55AM"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_milestone_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8dp"
            android:layout_marginTop="@dimen/size_2dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:text="@{milestone.subtitle}"
            android:textColor="@color/sub_heading_black"
            android:textSize="10sp"
            android:visibility="@{milestone.subtitle != null &amp;&amp; !milestone.subtitle.isEmpty() ? View.VISIBLE : View.GONE}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/icon_milestone"
            app:layout_constraintTop_toBottomOf="@+id/tv_milestone_timestamp"
            tools:text="₹5,000 | UTR: 123456789"
            tools:visibility="visible" />

        <View
            android:id="@+id/view_connector"
            android:layout_width="@dimen/size_2dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_min="@dimen/size_32dp"
            android:background="@color/black"
            android:visibility="@{isLastItem ? View.GONE : View.VISIBLE}"
            app:layout_constraintEnd_toEndOf="@id/icon_milestone"
            app:layout_constraintStart_toStartOf="@id/icon_milestone"
            app:layout_constraintTop_toBottomOf="@+id/icon_milestone"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
