<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

  <data>
    <import type="com.delhivery.axle.ui.accountsetup.AccountSetupUIState" />
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.accountsetup.AccountSetupViewModel"
        />
    <variable
        name="state"
        type="com.delhivery.axle.ui.accountsetup.AccountSetupUIState"
        />
  </data>

  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/blue_bg"
      android:orientation="vertical">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

      <ScrollView
          android:layout_width="match_parent"
          android:id="@+id/scView"
         android:layout_marginBottom="@dimen/size_72dp"
          android:layout_height="wrap_content">
      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
           android:orientation="vertical"
          android:paddingBottom="@dimen/size_48dp"
          android:paddingStart="@dimen/size_24dp"
          android:paddingEnd="@dimen/size_24dp">

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:id="@+id/progress"
            android:layout_marginBottom="@dimen/size_24dp"
              android:max="100"
            android:progressDrawable="@drawable/account_progress"
            android:progress="33"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:id="@+id/primary_layout">

          <androidx.appcompat.widget.AppCompatTextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_32dp"
              android:fontFamily="sans-serif"
              android:lineSpacingExtra="@dimen/text_6sp"
              android:id="@+id/label_appuse"
              android:text="@string/label_account_setup_primary"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_24sp"
              android:textStyle="bold"
              />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/label_select_appuse"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:gravity="start"
              android:layout_marginTop="@dimen/size_12dp"
              android:layout_below="@+id/label_appuse"
              android:textSize="@dimen/text_16sp"
              android:text="@string/label_account_setup_primary_select"
              android:textColor="@color/sub_heading_black"
              />

          <RelativeLayout
              android:layout_width="match_parent"
              android:background="@color/white"
              android:padding="@dimen/size_16dp"
              android:id="@+id/postloads_layout"
              android:layout_marginTop="@dimen/size_32dp"
              android:layout_below="@+id/label_select_appuse"
              android:layout_height="wrap_content">
            <RadioButton
                android:layout_width="wrap_content"
                android:id="@+id/radioPostloads"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                android:id="@+id/label_postloads"
                android:text="@string/label_account_setup_primary_select_postloads"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/sublabel_postloads"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="start"
                android:layout_below="@+id/label_postloads"
                android:text="@string/label_postloads"
                android:layout_marginTop="4dp"
                android:textSize="@dimen/text_14sp"
                android:textColor="@color/sub_heading_black"
                />
          </RelativeLayout>
          <RelativeLayout
              android:layout_width="match_parent"
              android:background="@color/white"
              android:padding="@dimen/size_16dp"
              android:id="@+id/posttrucks_layout"
              android:layout_marginTop="@dimen/size_24dp"
              android:layout_below="@+id/postloads_layout"
              android:layout_height="wrap_content">
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_alignParentEnd="true"
                android:id="@+id/radioPostTruck"
                android:layout_centerVertical="true"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                android:id="@+id/label_posttrucks"
                android:text="@string/label_account_setup_primary_select_posttrucks"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/sublabel_posttrucks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="start"
                android:layout_below="@+id/label_posttrucks"
                android:text="@string/label_posttrucks"
                android:layout_marginTop="4dp"
                android:textSize="@dimen/text_14sp"
                android:textColor="@color/sub_heading_black"
                />
          </RelativeLayout>
          <RelativeLayout
              android:layout_width="match_parent"
              android:background="@color/white"
              android:padding="@dimen/size_16dp"
              android:id="@+id/postboth_layout"
              android:layout_marginTop="@dimen/size_24dp"
              android:layout_below="@+id/posttrucks_layout"
              android:layout_height="wrap_content">
            <RadioButton
                android:layout_width="wrap_content"
                android:layout_alignParentEnd="true"
                android:id="@+id/radioPostBoth"
                android:layout_centerVertical="true"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                android:id="@+id/label_postboth"
                android:text="@string/label_account_setup_primary_select_postboth"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/sublabel_postboth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="start"
                android:layout_below="@+id/label_postboth"
                android:text="@string/label_postloads"
                android:layout_marginTop="4dp"
                android:textSize="@dimen/text_14sp"
                android:textColor="@color/sub_heading_black"
                />
          </RelativeLayout>
        </RelativeLayout>

      </RelativeLayout>
      </ScrollView>

      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/btn_proceed"
          style="@style/ActionButton"
          android:enabled="false"
          android:textAllCaps="false"
           android:layout_marginStart="@dimen/size_24dp"
          android:layout_alignParentBottom="true"
          android:layout_width="match_parent"
          android:layout_marginBottom="@dimen/size_48dp"
          android:layout_marginTop="@dimen/size_24dp"
          android:layout_marginEnd="@dimen/size_24dp"
          android:text="@string/action_proceed_account"
          />

    </RelativeLayout>

  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>



