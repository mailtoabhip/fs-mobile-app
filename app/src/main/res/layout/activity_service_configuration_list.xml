<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.serviceConfigListing.ServiceConfigurationListActivity">

    <!-- Header with back button and title -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        android:elevation="@dimen/size_4dp"
        app:contentInsetStartWithNavigation="@dimen/size_8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:title="@string/load_services"
        style="@style/Toolbar.TitleText" />

    <!-- Scrollable body -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Services Added section -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/services_added_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_24dp"
                android:layout_marginStart="@dimen/size_16dp"
                android:layout_marginEnd="@dimen/size_18dp"
                android:text="@string/services_added"
                android:textColor="#121212"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/services_added_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:layout_marginStart="@dimen/size_16dp"
                android:layout_marginEnd="@dimen/size_18dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"
                tools:listitem="@layout/service_configuration_view" />

            <!-- Continue where you've left section -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/continue_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_24dp"
                android:layout_marginStart="@dimen/size_16dp"
                android:layout_marginEnd="@dimen/size_18dp"
                android:text="@string/continue_where_you_ve_left"
                android:textColor="#121212"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/continue_service_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:layout_marginStart="@dimen/size_16dp"
                android:layout_marginEnd="@dimen/size_18dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="1"
                tools:listitem="@layout/service_configuration_view" />

            <!-- Load Services section -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/configure_new_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_24dp"
                android:layout_marginStart="@dimen/size_16dp"
                android:layout_marginEnd="@dimen/size_18dp"
                android:text="@string/configure_new_service"
                android:textColor="#121212"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/configure_new_service_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:layout_marginStart="@dimen/size_16dp"
                android:layout_marginEnd="@dimen/size_18dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="5"
                tools:listitem="@layout/service_configuration_view" />

            <!-- Financial Services section -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/financial_services_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_24dp"
                android:layout_marginStart="@dimen/size_16dp"
                android:layout_marginEnd="@dimen/size_18dp"
                android:text="@string/financial_services"
                android:textColor="#121212"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/financial_services_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:layout_marginStart="@dimen/size_16dp"
                android:layout_marginEnd="@dimen/size_18dp"
                android:layout_marginBottom="@dimen/size_24dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="3"
                tools:listitem="@layout/service_configuration_view" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
