<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    >
  <data>
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.searchload.fragments.searchresults.SearchResultsViewModel"
        />
    <variable
        name="origin"
        type="com.delhivery.axle.data.CityModel"
        />
    <variable
        name="destination"
        type="com.delhivery.axle.data.CityModel"
        />
  </data>
  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_cities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:paddingBottom="@dimen/size_16dp"
        android:paddingEnd="@dimen/size_24dp"
        android:paddingStart="@dimen/size_24dp"
        android:paddingTop="@dimen/size_16dp"
        >
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/tv_reporting_center"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="@string/select_reporting_center"
          android:textColor="@color/black"
          android:textFontWeight="500"
          android:textSize="@dimen/text_14sp"
          android:visibility="gone"
          app:layout_constraintBottom_toTopOf="@id/container_reporting_center"
          app:layout_constraintStart_toStartOf="parent"
          />

      <androidx.appcompat.widget.LinearLayoutCompat
          android:id="@+id/container_reporting_center"
          android:layout_width="match_parent"
          android:layout_marginStart="@dimen/size_4dp"
          android:layout_marginTop="36dp"
          android:background="@drawable/rounded_corner"
          android:lineHeight="@dimen/size_24dp"
          android:paddingBottom="@dimen/size_8dp"
          android:paddingLeft="@dimen/size_12dp"
          android:paddingTop="@dimen/size_8dp"
          android:visibility="gone"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
           android:layout_height="40dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_reporting_center_city"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@{origin.cityName()+','}"
            android:textColor="@color/black"
            android:textSize="@dimen/text_16sp"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_reporting_center_state"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@{' '+origin.stateName()}"
            android:textColor="#A3AAC2"
            android:textSize="@dimen/text_16sp"
            />
      </androidx.appcompat.widget.LinearLayoutCompat>
      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/img_forward"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:srcCompat="@drawable/ic_arrow_forward_black"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_source_city"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif"
          android:text="@{ origin.cityName() }"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_16sp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="@id/img_forward"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_source_state"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="@{ origin.stateName() }"
          android:textColor="@color/sub_heading_black"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_source_city"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_destination_city"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_24dp"
          android:fontFamily="sans-serif"
          android:text="@{ destination.cityName() }"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_16sp"
          app:layout_constraintStart_toEndOf="@id/img_forward"
          app:layout_constraintTop_toTopOf="@id/img_forward"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_destination_state"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="@{ destination.stateName() }"
          android:textColor="@color/sub_heading_black"
          app:layout_constraintStart_toStartOf="@id/text_destination_city"
          app:layout_constraintTop_toBottomOf="@id/text_source_city"
          />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rv"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_margin="@dimen/size_8dp"
          />

      <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/container_spinner"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@color/colorPrimary"
          android:paddingBottom="@dimen/size_8dp"
          android:paddingEnd="@dimen/size_16dp"
          android:paddingStart="@dimen/size_16dp"
          android:paddingTop="@dimen/size_8dp"
          bind:shadow="@{ @dimen/size_4dp }"
          >

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/spinner_truck_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="@dimen/size_8dp"
            android:layout_marginEnd="@dimen/size_8dp"
            android:layout_marginStart="@dimen/size_8dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:background="@drawable/bg_search_load_spinner"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            bind:shadow="@{ @dimen/size_2dp }"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_truck_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/truck_type"
            android:textColor="@color/black"
            android:textFontWeight="500"
            android:textSize="@dimen/text_14sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/spinner_truck_type_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_search_load_spinner"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:paddingBottom="@dimen/size_8dp"
            android:paddingStart="@dimen/size_12dp"
            android:paddingTop="@dimen/size_8dp"
            android:textSize="@dimen/text_16sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_truck_type"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:fontFamily="sans-serif"
            android:text="@string/status"
            android:textColor="@color/black"
            android:textFontWeight="500"
            android:textSize="@dimen/text_14sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinner_truck_type_2"
            />
        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@id/spinner_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_search_load_spinner"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:paddingBottom="@dimen/size_8dp"
            android:paddingStart="@dimen/size_12dp"
            android:paddingTop="@dimen/size_8dp"
            android:textSize="@dimen/text_16sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_status"
            />

        <View
            android:id="@+id/view_hidden_indicator"
            android:layout_width="@dimen/size_64dp"
            android:layout_height="@dimen/size_6dp"
            app:layout_constraintTop_toBottomOf="@id/spinner_truck_type"
            android:layout_centerHorizontal="true"
            android:alpha="0"
            android:background="@drawable/bg_search_header_visible_view"
            />
      </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>