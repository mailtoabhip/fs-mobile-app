<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    >
  <data>
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.searchload.fragments.searchresults.SearchResultsViewModel"
        />
    <variable
        name="origin"
        type="com.delhivery.axle.data.CityModel"
        />
    <variable
        name="destination"
        type="com.delhivery.axle.data.CityModel"
        />
  </data>
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_cities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:paddingBottom="@dimen/size_16dp"
        android:paddingEnd="@dimen/size_24dp"
        android:paddingStart="@dimen/size_24dp"
        android:paddingTop="@dimen/size_16dp"
        >
      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/img_forward"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:srcCompat="@drawable/ic_arrow_forward_black"
          />

      <TextView
          android:id="@+id/text_source_city"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif"
          android:text="@{ origin.cityName() }"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_16sp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="@id/img_forward"
          />

      <TextView
          android:id="@+id/text_source_state"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="@{ origin.stateName() }"
          android:textColor="@color/sub_heading_black"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_source_city"
          />

      <TextView
          android:id="@+id/text_destination_city"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_24dp"
          android:fontFamily="sans-serif"
          android:text="@{ destination.cityName() }"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_16sp"
          app:layout_constraintStart_toEndOf="@id/img_forward"
          app:layout_constraintTop_toTopOf="@id/img_forward"
          />

      <TextView
          android:id="@+id/text_destination_state"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="@{ destination.stateName() }"
          android:textColor="@color/sub_heading_black"
          app:layout_constraintStart_toStartOf="@id/text_destination_city"
          app:layout_constraintTop_toBottomOf="@id/text_source_city"
          />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rv"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_margin="@dimen/size_8dp"
          />

      <RelativeLayout
          android:id="@+id/container_spinner"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@color/colorPrimary"
          android:paddingBottom="@dimen/size_8dp"
          android:paddingEnd="@dimen/size_16dp"
          android:paddingStart="@dimen/size_16dp"
          android:paddingTop="@dimen/size_8dp"
          bind:shadow="@{ @dimen/size_4dp }"
          >

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/spinner_truck_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_8dp"
            android:background="@drawable/bg_search_load_spinner"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            bind:shadow="@{ @dimen/size_2dp }"
            />

        <View
            android:id="@+id/view_hidden_indicator"
            android:layout_width="@dimen/size_64dp"
            android:layout_height="@dimen/size_6dp"
            android:layout_below="@id/spinner_truck_type"
            android:layout_centerHorizontal="true"
            android:alpha="0"
            android:background="@drawable/bg_search_header_visible_view"
            />
      </RelativeLayout>
    </FrameLayout>
  </LinearLayout>
</layout>