<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    >
  <data>
    <variable
        name="viewModel"
        type="com.delhivery.orion.ui.searchload.fragments.searchresults.SearchResultsViewModel"
        />
  </data>
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      >

    <android.support.constraint.ConstraintLayout
        android:id="@+id/container_cities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:paddingBottom="@dimen/size_16dp"
        android:paddingEnd="@dimen/size_24dp"
        android:paddingStart="@dimen/size_24dp"
        android:paddingTop="@dimen/size_16dp"
        >
      <android.support.v7.widget.AppCompatImageView
          android:id="@+id/img_forward"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_bids_deadline"
          app:srcCompat="@drawable/ic_arrow_forward_black"
          />

      <TextView
          android:id="@+id/text_source_city"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif"
          android:text="Panjim"
          android:textColor="#de000000"
          android:textSize="16sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="@id/img_forward"
          />

      <TextView
          android:id="@+id/text_source_state"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="GOA"
          android:textColor="#99000000"
          android:textSize="13sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_source_city"
          />

      <TextView
          android:id="@+id/text_destination_city"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="24dp"
          android:fontFamily="sans-serif"
          android:text="Andheri East"
          android:textColor="#de000000"
          android:textSize="16sp"
          android:textStyle="normal"
          app:layout_constraintStart_toEndOf="@id/img_forward"
          app:layout_constraintTop_toTopOf="@id/img_forward"
          />

      <TextView
          android:id="@+id/text_destination_state"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="Mumbai"
          android:textColor="#99000000"
          android:textSize="13sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="@id/text_destination_city"
          app:layout_constraintTop_toBottomOf="@id/text_source_city"
          />
    </android.support.constraint.ConstraintLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

      <android.support.v7.widget.RecyclerView
          android:id="@+id/rv"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          />

      <RelativeLayout
          android:id="@+id/container_spinner"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@color/colorPrimary"
          android:paddingBottom="@dimen/size_8dp"
          android:paddingEnd="@dimen/size_16dp"
          android:paddingStart="@dimen/size_16dp"
          android:paddingTop="@dimen/size_8dp"
          bind:shadow="@{ @dimen/size_4dp }"
          >

        <View
            android:id="@+id/view_spinner_center"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_centerHorizontal="true"
            android:background="#00ffffff"
            />

        <android.support.v7.widget.AppCompatSpinner
            android:id="@+id/spinner_truck_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_8dp"
            android:layout_toStartOf="@id/view_spinner_center"
            android:background="@drawable/bg_search_load_spinner"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            bind:shadow="@{ @dimen/size_2dp }"
            />

        <android.support.v7.widget.AppCompatSpinner
            android:id="@+id/spinner_truck_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_8dp"
            android:layout_toEndOf="@id/view_spinner_center"
            android:background="@drawable/bg_search_load_spinner"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            bind:shadow="@{ @dimen/size_2dp }"
            />

        <View
            android:id="@+id/view_hidden_indicator"
            android:layout_width="@dimen/size_64dp"
            android:layout_height="@dimen/size_6dp"
            android:layout_below="@id/spinner_truck_type"
            android:layout_centerHorizontal="true"
            android:alpha="0"
            android:background="@drawable/bg_search_header_visible_view"
            />
      </RelativeLayout>
    </FrameLayout>
  </LinearLayout>
</layout>