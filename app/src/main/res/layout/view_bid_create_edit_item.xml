<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="item"
            type="com.delhivery.axle.data.bids.DmtBidSummaryItemData"
            />
    </data>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_4dp"
        android:layout_marginBottom="@dimen/size_4dp"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:cardElevation="@dimen/size_2dp"
        >
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/size_8dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/expandButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@{item.toggleButton()}"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <RelativeLayout
                android:id="@+id/expandableLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_2dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/label_vehicle"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/size_40dp"
                    android:text="@string/label_vehicle_type"
                    android:layout_gravity="center"
                    android:paddingEnd="@dimen/size_8dp"
                    android:paddingBottom="@dimen/size_8dp"
                    android:paddingTop="@dimen/size_8dp"
                    android:paddingStart="@dimen/size_1dp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/size_10dp"
                    android:textSize="@dimen/text_16sp"
                    android:layout_alignParentStart="true"
                    android:textStyle="bold"
                    android:layout_alignParentTop="true"/>

                <androidx.appcompat.widget.AppCompatSpinner
                    android:id="@+id/sp_vehicle_type"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_40dp"
                    android:layout_marginStart="@dimen/size_8dp"
                    android:layout_marginTop="@dimen/size_10dp"
                    android:layout_toStartOf="@+id/deleteItem"
                    android:layout_toEndOf="@id/label_vehicle"
                    android:background="@drawable/background_rectangle_border"
                    android:paddingStart="@dimen/size_8dp"
                    android:paddingTop="@dimen/size_8dp"
                    android:paddingEnd="@dimen/size_8dp"
                    android:paddingBottom="@dimen/size_8dp"
                    android:text="6_TYRE(7.5MT)"
                    android:textColor="@color/black" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/deleteItem"
                    android:layout_width="@dimen/size_40dp"
                    android:layout_height="@dimen/size_40dp"
                    android:padding="@dimen/size_2dp"
                    android:layout_alignParentEnd="true"
                    android:layout_gravity="center_vertical"
                    app:srcCompat="@drawable/ic_delete"
                    android:layout_marginTop="@dimen/size_10dp"
                    android:tint="@color/price_red"
                    android:layout_marginStart="@dimen/size_2dp" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/label_pmt"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/size_40dp"
                    android:layout_alignParentStart="true"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:paddingEnd="@dimen/size_8dp"
                    android:paddingBottom="@dimen/size_8dp"
                    android:paddingTop="@dimen/size_8dp"
                    android:paddingStart="@dimen/size_1dp"
                    android:layout_marginTop="@dimen/size_11dp"
                    android:visibility="@{item.visibility()}"
                    android:textSize="@dimen/text_16sp"
                    android:layout_below="@id/label_vehicle"
                    android:text="@string/label_no_of_trucks"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edit_trucks"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_40dp"
                    android:paddingEnd="@dimen/size_8dp"
                    android:paddingBottom="@dimen/size_8dp"
                    android:paddingTop="@dimen/size_8dp"
                    android:paddingStart="@dimen/size_8dp"
                    android:background="@drawable/background_rectangle_border"
                    android:text="@{item.truckCount()}"
                    android:layout_below="@id/label_vehicle"
                    android:layout_toEndOf="@id/label_pmt"
                    android:textColor="@color/black"
                    android:inputType="number"
                    android:layout_toStartOf="@+id/deleteItem"
                    android:visibility="@{item.visibility()}"
                    android:layout_marginTop="@dimen/size_11dp"
                    android:layout_alignStart="@id/sp_vehicle_type"
                    tools:text="2"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/label_count_truck"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/size_40dp"
                    android:layout_below="@id/edit_trucks"
                    android:paddingEnd="@dimen/size_8dp"
                    android:paddingBottom="@dimen/size_8dp"
                    android:paddingTop="@dimen/size_8dp"
                    android:paddingStart="@dimen/size_1dp"
                    android:layout_alignParentStart="true"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/size_8dp"
                    android:textSize="@dimen/text_16sp"
                    android:visibility="@{item.visibility()}"
                    android:text="@string/label_pmt_rate"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/editPmtAmount"
                    android:layout_width="match_parent"
                    android:paddingEnd="@dimen/size_8dp"
                    android:paddingBottom="@dimen/size_8dp"
                    android:paddingTop="@dimen/size_8dp"
                    android:paddingStart="@dimen/size_8dp"
                    android:layout_height="@dimen/size_40dp"
                    android:background="@drawable/background_rectangle_border"
                    android:layout_toEndOf="@id/label_count_truck"
                    android:layout_marginTop="@dimen/size_8dp"
                    android:layout_alignStart="@id/sp_vehicle_type"
                    android:visibility="@{item.visibility()}"
                    android:layout_below="@id/edit_trucks"
                    android:layout_toStartOf="@+id/deleteItem"
                    android:inputType="numberDecimal"
                    android:textColor="@color/black"
                    android:text="@{item.pmtRate()}"
                    android:layout_marginBottom="@dimen/size_10dp"
                    tools:text="1050"/>
            </RelativeLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.cardview.widget.CardView>


</layout>