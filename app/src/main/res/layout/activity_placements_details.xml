<?xml version="1.0" encoding="utf-8"?>
<layout   xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools">
    <data>
        <variable
            name="viewModel"
            type="com.delhivery.axle.ui.placementdetails.PlacementDetailsViewModel"
            />
    </data>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        bind:shadow="@{ @dimen/size_4dp }"
        />
    <FrameLayout
        android:id="@+id/loadInfo"
        android:background="@color/light_red_bg"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <include android:layout_width="match_parent"
        android:id="@+id/intracityContract"
        android:layout_height="wrap_content"
        layout="@layout/view_intracity_contract"
        android:layout_margin="@dimen/size_16dp"
        android:visibility="gone"
        android:elevation="@dimen/size_6dp"
        />
    <include android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/intercityContract"
        layout="@layout/view_intercity_contract"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        android:layout_margin="@dimen/size_16dp"
        android:visibility="gone"
        android:elevation="@dimen/size_6dp"
        />
    <include android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/intracityAdhoc"
        layout="@layout/view_intractiy_adhoc"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        android:layout_margin="@dimen/size_16dp"
        android:visibility="gone"
        android:elevation="@dimen/size_6dp"
        />
    <include android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/intercityAdhoc"
        layout="@layout/view_intercity_adhoc"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        android:layout_margin="@dimen/size_16dp"
        android:visibility="gone"
        />
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintTop_toBottomOf="@+id/loadInfo"
        android:layout_marginStart="@dimen/size_16dp"
        android:layout_marginEnd="@dimen/size_16dp"
        android:paddingBottom="@dimen/size_16dp"
        android:background="@drawable/bg_all_round_corner_grey_boundary"
        android:elevation="@dimen/size_2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.LinearLayoutCompat
            app:layout_constraintTop_toTopOf="parent"
            android:padding="@dimen/size_8dp"
            android:background="@drawable/bg_all_round_corner_grey_boundary"
            android:id="@+id/llReporting"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/reporting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textSize="@dimen/text_12sp"
                android:text="Reporting Time: "/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/reportingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textSize="@dimen/text_12sp"
                android:text="@{viewModel.homePlacementsItemData.formatReportingTime()}"/>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_vehicle_number"
            android:text="@string/vehicle_number"
            android:layout_marginTop="@dimen/size_4dp"
            app:layout_constraintTop_toBottomOf="@+id/llReporting"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="match_parent"
            android:textSize="@dimen/text_14sp"
            android:textColor="@color/heading_black"
            android:layout_marginLeft="@dimen/size_8dp"
            android:layout_marginRight="@dimen/size_8dp"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:id="@+id/vehicleFrameLayout"
            app:layout_constraintTop_toBottomOf="@+id/label_vehicle_number"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/edit_text_vehicle_number"
            android:layout_width="match_parent"
            android:textSize="@dimen/text_16sp"
            android:inputType="textCapCharacters"
            android:drawableEnd="@drawable/bg_spinner"
            android:layout_marginTop="@dimen/size_8dp"
            android:layout_marginLeft="@dimen/size_8dp"
            android:layout_marginRight="@dimen/size_8dp"
            android:background="@drawable/bg_login_edit"
            android:elevation="@dimen/size_2dp"
            android:layout_height="@dimen/size_42dp"/>
        <com.delhivery.axle.ui.custom.DelhiveryTrucksAutoEditText
            android:id="@+id/edit_auto_complete_trucks"
            android:layout_width="match_parent"
            android:textSize="@dimen/text_16sp"
            android:hint="Search"
            android:drawablePadding="@dimen/size_4dp"
            android:drawableStart="@drawable/ic_search_trucks"
            android:inputType="textCapCharacters"
            android:layout_marginTop="@dimen/size_8dp"
            android:layout_marginLeft="@dimen/size_8dp"
            android:layout_marginRight="@dimen/size_8dp"
            android:background="@drawable/bg_login_edit"
            android:elevation="@dimen/size_2dp"
            android:layout_height="@dimen/size_42dp"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/vehicleNumberError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/vehicleFrameLayout"
            app:layout_constraintStart_toStartOf="parent"
            android:textColor="@color/bid_error"
            android:padding="@dimen/size_2dp"
            android:textSize="@dimen/text_12sp"
            android:visibility="gone"
            android:layout_marginStart="@dimen/size_8dp"
            android:text="Please enter valid vehicle number"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_driver_name"
            android:text="@string/label_driver_name"
            app:layout_constraintTop_toBottomOf="@+id/vehicleNumberError"
            app:layout_constraintStart_toStartOf="parent"
            android:textSize="@dimen/text_14sp"
            android:layout_marginTop="@dimen/size_8dp"
            android:textColor="@color/heading_black"
            android:layout_marginLeft="@dimen/size_8dp"
            android:layout_marginRight="@dimen/size_8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/editTextDriverName"
            app:layout_constraintTop_toBottomOf="@+id/label_driver_name"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/size_8dp"
            android:layout_marginLeft="@dimen/size_8dp"
            android:layout_marginRight="@dimen/size_8dp"
            android:digits="@string/allowed_char_name"
            android:textSize="@dimen/text_16sp"
            android:inputType="textCapWords"
            android:elevation="@dimen/size_2dp"
            android:layout_width="match_parent"
            android:background="@drawable/bg_login_edit"
            android:layout_height="@dimen/size_42dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/driverNameError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/editTextDriverName"
            app:layout_constraintStart_toStartOf="parent"
            android:textColor="@color/bid_error"
            android:padding="@dimen/size_2dp"
            android:textSize="@dimen/text_12sp"
            android:visibility="gone"
            android:layout_marginStart="@dimen/size_8dp"
            android:text="Please enter valid driver number"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_driver_number"
            android:text="@string/label_driver_number"
            android:layout_marginTop="@dimen/size_8dp"
            android:textSize="@dimen/text_14sp"
            android:textColor="@color/heading_black"
            android:layout_marginLeft="@dimen/size_8dp"
            android:layout_marginRight="@dimen/size_8dp"
            app:layout_constraintTop_toBottomOf="@+id/driverNameError"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/editTextDriverNumber"
            android:inputType="number"
            android:maxLength="10"
            android:background="@drawable/bg_login_edit"
            app:layout_constraintTop_toBottomOf="@+id/label_driver_number"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/size_8dp"
            android:layout_marginLeft="@dimen/size_8dp"
            android:layout_marginRight="@dimen/size_8dp"
            android:textSize="@dimen/text_16sp"
            android:elevation="@dimen/size_2dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_42dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/driverNumberError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/editTextDriverNumber"
            app:layout_constraintStart_toStartOf="parent"
            android:textColor="@color/bid_error"
            android:padding="@dimen/size_2dp"
            android:textSize="@dimen/text_12sp"
            android:visibility="gone"
            android:layout_marginStart="@dimen/size_8dp"
            android:text="Please enter a valid driver number"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_submit"
            style="@style/SubmitButton"
            android:enabled="false"
            android:textAllCaps="false"
            android:layout_marginEnd="@dimen/size_16dp"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginBottom="@dimen/size_16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/size_20dp"
            android:text="@string/action_submit"
            />
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>