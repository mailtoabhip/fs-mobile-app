<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    >

    <data>
        <variable
            name="request"
            type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData" />
        <import type="android.view.View" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llNep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_grey"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:visibility="@{request.isNEPrequired()}"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingTop="@dimen/size_4dp"
                android:paddingBottom="@dimen/size_4dp"
                android:src="@drawable/warning_icon"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/nepRequired"
                android:text="@{@string/entry_permit_for_required(request.nepState)}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_12sp"
                tools:hint="Entry permit for Haryana required"
                android:fontFamily="sans-serif-medium"
                android:padding="@dimen/size_4dp"
                />
        </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/llNep"
        app:cardElevation="4dp"
        android:backgroundTint="@android:color/white">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Header -->
            <TextView
                android:id="@+id/tv_location_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@{request.originCentreName()}"
                tools:text="Mumbai MIDC"
                android:textColor="#121A31"
                android:textStyle="bold"
                android:textSize="16sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Address -->
            <TextView
                android:id="@+id/tv_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tools:text="C/O Shed No. 876, Plot 6, Mumbai Maharashtra"
                android:text="@{request.pickupLocationAddress}"
                android:textColor="#505361"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tv_location_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Truck Info -->
            <TextView
                android:id="@+id/tv_truck_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="closed 32FTXL18 MT"
                android:textSize="12sp"
                android:text="@{request.getTruckTypeAndNo()}"
                android:textColor="#505361"
                android:drawableStart="@drawable/ic_truck_small"
                android:drawablePadding="6dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_address"
                app:layout_constraintStart_toStartOf="parent" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/closingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:drawablePadding="@dimen/size_4dp"
                tools:text ="Closes in 2 hrs 15 min"
                android:textColor="#505361"
                android:text="@{request.formattedBiddingEndTime()}"
                android:drawableStart="@drawable/ic_clock_small"
                app:layout_constraintTop_toTopOf="@id/tv_truck_type"
                app:layout_constraintEnd_toEndOf="parent"  />

            <!-- Distance and Duration -->
            <TextView
                android:id="@+id/tv_distance_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text ="80 km - 8 hours"
                android:textSize="12sp"
                android:text='@{request.adhocIntracityKms() + request.adhocIntracityhrs()}'
                android:textColor="#505361"
                android:drawablePadding="4dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tv_truck_type"
                app:layout_constraintStart_toStartOf="parent"
                android:drawableStart="@drawable/ic_route"
                />

            <!-- Truck Number -->
            <TextView
                android:id="@+id/tv_truck_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{request.fmsTicketId}"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:drawablePadding="@dimen/size_4dp"
                android:textColor="#505361"
                tools:text="AB#C1245"
                app:layout_constraintStart_toStartOf="@+id/closingTime"
                app:layout_constraintTop_toBottomOf="@id/closingTime"
                android:drawableStart="@drawable/ic_card_intracity_ticket"
                />

            <!-- Divider -->
            <View
                android:id="@+id/view_divider_1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#E5E6EB"
                app:layout_constraintTop_toBottomOf="@id/tv_truck_no"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <include
                android:id="@+id/containerRowBidFor1"
                layout="@layout/item_bottom_card_load"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/view_divider_1"
                />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
