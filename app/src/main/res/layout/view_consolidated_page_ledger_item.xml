<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
    <data>
        <variable
            name="ledger"
            type="com.delhivery.axle.data.ledger.ConsolidatedLedgerItemData"
            />
        <import type="androidx.core.content.ContextCompat" />
        <import type="android.view.View" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_12dp"
        android:layout_marginTop="@dimen/size_6dp"
        android:layout_marginEnd="@dimen/size_12dp"
        android:layout_marginBottom="@dimen/size_6dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="@dimen/size_6dp"
        app:cardElevation="@dimen/size_2dp"
        >

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="@dimen/size_16dp"
            android:paddingTop="@dimen/size_6dp"
            android:paddingEnd="@dimen/size_16dp"
            android:paddingBottom="@dimen/size_6dp"
            android:orientation="vertical"
            >

            <View
                android:layout_width="match_parent"
                android:layout_marginBottom="@dimen/size_10dp"
                android:layout_height="0.5dp"
                android:background="@color/transparent_grey"
                />


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_LR_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight=".90"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:text="@{ledger.key()}"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_16sp"
                    tools:text="Advance - LR 287328"
                    />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_LR_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@{ledger.key()}"
                    android:layout_weight=".05"
                    android:textColor="@color/status_confirmed"
                    android:textSize="@dimen/text_16sp"
                    app:layout_constraintEnd_toEndOf="@id/text_LR_main"
                    tools:text="+ Rs.49,250" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/toggle_LR"
                    android:layout_width="@dimen/size_20dp"
                    android:layout_height="@dimen/size_20dp"
                    android:layout_weight=".05"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_add_black_24dp"
                    />


            </androidx.appcompat.widget.LinearLayoutCompat>


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_UTR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight=".80"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:text="@{ledger.key()}"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                tools:text="UTR: 27372"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_date_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight=".80"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:text="@{ledger.key()}"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                tools:text="5th November 2020, 7:10am"
                />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible"
                android:layout_marginTop="@dimen/size_8dp"
                android:padding="@dimen/size_6dp"
                android:background="@drawable/bg_grey_all_corner_black">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_deductions_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight=".80"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:text="@{ledger.key()}"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_16sp"
                    tools:text="Deductions made:"
                    />


                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_deductions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight=".90"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:text="@{ledger.key()}"
                        android:textColor="@color/heading_black"
                        android:textSize="@dimen/text_16sp"
                        tools:text="TDS (@1.5%)"
                        />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_deductions_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@{ledger.key()}"
                        android:layout_weight=".10"
                        android:textColor="@color/status_confirmed"
                        android:textSize="@dimen/text_16sp"
                        app:layout_constraintEnd_toEndOf="@id/text_LR_main"
                        tools:text="(750)" />


                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/size_10dp"
                android:layout_height="0.5dp"
                android:background="@color/transparent_grey"
                />


        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.cardview.widget.CardView>
</layout>
