<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <androidx.cardview.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/size_6dp"
      android:layout_marginEnd="@dimen/size_12dp"
      android:layout_marginStart="@dimen/size_12dp"
      android:layout_marginTop="@dimen/size_6dp"
      android:clickable="true"
      android:focusable="true"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="@dimen/size_2dp"
      >

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingBottom="@dimen/size_6dp"
        android:paddingEnd="@dimen/size_16dp"
        android:paddingStart="@dimen/size_16dp"
        android:paddingTop="@dimen/size_6dp"
        >


      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          >

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_LR_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight=".90"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:text="@{ledger.getTitle}"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_14sp"
            tools:text="Advance - LR 287328"
            />



        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_LR_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight=".05"
            android:fontFamily="sans-serif"
            android:text=""
            android:textColor="@color/status_confirmed"
            android:textSize="@dimen/text_14sp"
            app:layout_constraintEnd_toEndOf="@id/text_LR_main"
            tools:text="+ Rs.49,250"
            />


        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/toggle_LR"
            android:layout_width="@dimen/size_20dp"
            android:layout_height="@dimen/size_20dp"
            android:layout_weight=".05"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@{ledger.expandedResource()}"
            />





      </androidx.appcompat.widget.LinearLayoutCompat>

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_UTR"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_weight=".80"
          android:layout_marginTop="@dimen/size_4dp"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:text="@{ledger.getUTR}"
          android:textColor="@color/sub_heading_black"
          android:textSize="@dimen/text_14sp"
          tools:text="UTR: 27372"
          />


      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_date_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_weight=".80"
          android:ellipsize="end"
          android:fontFamily="sans-serif-medium"
          android:text="@{ledger.getPaymentDate()}"
          android:textColor="@color/sub_heading_black"
          android:textSize="@dimen/text_14sp"
          tools:text="5th November 2020, 7:10am"
          />


      <androidx.appcompat.widget.LinearLayoutCompat
          android:id="@+id/deductions_parent"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          android:orientation="vertical"
          android:padding="@dimen/size_6dp"
          android:visibility="@{ledger.isExpanded?View.VISIBLE:View.GONE}"
          tools:visibility="visible"
          android:background="@drawable/bg_grey_all_corner_black"
          >

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_deductions_main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight=".80"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:text="Deductions made:"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_14sp"
            />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/deductions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="@{ledger.isExpanded?View.VISIBLE:View.GONE}" />

      </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

  </androidx.cardview.widget.CardView>

  <data>
    <import type="androidx.core.content.ContextCompat" />
    <import type="android.view.View" />
    <variable
        name="ledger"
        type="com.delhivery.axle.data.ledger.ConsolidatedLedgerItemData"
        />
  </data>
</layout>
