<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

  <data>
    <import type="com.delhivery.axle.ui.accountsetup.AccountSetupUIState" />
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.accountsetup.AccountSetupViewModel"
        />
    <variable
        name="state"
        type="com.delhivery.axle.ui.accountsetup.AccountSetupUIState"
        />
  </data>

  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/blue_bg"
      android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

      <ScrollView
          android:layout_width="match_parent"
          android:id="@+id/scView"
         android:layout_marginBottom="@dimen/size_72dp"
          android:layout_height="wrap_content">
      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
           android:orientation="vertical"
          android:paddingBottom="@dimen/size_48dp"
          android:paddingStart="@dimen/size_24dp"
          android:paddingEnd="@dimen/size_24dp">

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:id="@+id/progress"
            android:layout_marginBottom="@dimen/size_24dp"
              android:max="100"
            android:progressDrawable="@drawable/account_progress"
            android:progress="66"/>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:id="@+id/role_layout">

          <androidx.appcompat.widget.AppCompatTextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_32dp"
              android:fontFamily="sans-serif"
              android:lineSpacingExtra="@dimen/text_6sp"
              android:id="@+id/label_role"
              android:text="@string/label_role"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_24sp"
              android:textStyle="bold"
              />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/label_select_role"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:gravity="start"
              android:layout_marginBottom="@dimen/size_16dp"
              android:text="@string/label_role_select"
              android:layout_marginTop="@dimen/size_12dp"
              android:layout_below="@+id/label_role"
              android:textSize="@dimen/text_16sp"
              android:textColor="@color/sub_heading_black"
              />

          <RelativeLayout
              android:layout_width="match_parent"
              android:background="@drawable/bg_rounded_blue"
              android:id="@+id/shipper_layout"
              android:layout_marginTop="@dimen/size_16dp"
              android:layout_below="@+id/label_select_role"
              android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/label_shipper"
                android:id="@+id/labelShipper"
                android:layout_marginTop="@dimen/size_14dp"
                android:layout_marginStart="@dimen/size_14dp"
                android:layout_marginEnd="@dimen/size_14dp"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:layout_toStartOf="@+id/imgShipper"
                android:layout_marginTop="@dimen/size_4dp"
                android:layout_marginStart="@dimen/size_14dp"
                android:layout_marginEnd="@dimen/size_14dp"
                android:layout_below="@+id/labelShipper"
                android:layout_alignParentStart="true"
                android:text="@string/label_shipper_select"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_12sp"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:src="@drawable/shipper"
                android:layout_alignParentEnd="true"
                android:id="@+id/imgShipper"
                android:background="@drawable/bg_all_round_corner_white_right"
                android:layout_height="wrap_content"/>
          </RelativeLayout>
          <RelativeLayout
              android:layout_width="match_parent"
              android:background="@drawable/bg_all_round_corner_white"
              android:id="@+id/broker_layout"
              android:layout_marginTop="@dimen/size_16dp"
              android:layout_below="@+id/shipper_layout"
              android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/label_broker"
                android:id="@+id/labelBroker"
                android:layout_marginTop="@dimen/size_14dp"
                android:layout_marginStart="@dimen/size_14dp"
                android:layout_marginEnd="@dimen/size_14dp"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/imgBroker"
                android:layout_marginTop="@dimen/size_4dp"
                android:layout_marginStart="@dimen/size_14dp"
                android:layout_marginEnd="@dimen/size_14dp"
                android:layout_below="@+id/labelBroker"
                android:text="@string/label_broker_select"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_12sp"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:src="@drawable/broker"
                android:layout_alignParentEnd="true"
                android:id="@+id/imgBroker"
                android:background="@drawable/bg_all_round_corner_white_right"
                android:layout_height="wrap_content"/>
          </RelativeLayout>
          <RelativeLayout
              android:layout_width="match_parent"
              android:background="@drawable/bg_all_round_corner_white"
              android:id="@+id/owner_layout"
              android:layout_marginTop="@dimen/size_16dp"
              android:layout_below="@+id/broker_layout"
              android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/label_owner"
                android:id="@+id/labelOwner"
                android:layout_marginTop="@dimen/size_14dp"
                android:layout_marginStart="@dimen/size_14dp"
                android:layout_marginEnd="@dimen/size_14dp"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="start"
                android:layout_alignParentStart="true"
                android:layout_marginTop="@dimen/size_4dp"
                android:layout_marginStart="@dimen/size_14dp"
                android:layout_marginEnd="@dimen/size_14dp"
                android:layout_below="@+id/labelOwner"
                android:text="@string/label_owner_select"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_12sp"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:src="@drawable/fleet_owner"
                android:layout_alignParentEnd="true"
                android:id="@+id/imgOwner"
                android:background="@drawable/bg_all_round_corner_white_right"
                android:layout_height="wrap_content"/>
          </RelativeLayout>

          <RelativeLayout
              android:layout_width="match_parent"
              android:background="@drawable/bg_all_round_corner_white"
              android:id="@+id/transporter_layout"
              android:layout_marginTop="@dimen/size_16dp"
              android:layout_below="@+id/owner_layout"
              android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/label_transporter"
                android:id="@+id/labelTransporter"
                android:layout_marginTop="@dimen/size_14dp"
                android:layout_marginStart="@dimen/size_14dp"
                android:layout_marginEnd="@dimen/size_14dp"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/label_transporter_select"
                android:layout_alignParentStart="true"
                android:layout_marginTop="@dimen/size_4dp"
                android:layout_marginStart="@dimen/size_14dp"
                android:layout_marginEnd="@dimen/size_14dp"
                android:layout_below="@+id/labelTransporter"
                android:layout_toStartOf="@+id/imgTransporter"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_12sp"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:src="@drawable/transporter"
                android:layout_alignParentEnd="true"
                android:id="@+id/imgTransporter"
                android:background="@drawable/bg_all_round_corner_white_right"
                android:layout_height="wrap_content"/>
          </RelativeLayout>
        </RelativeLayout>


      </RelativeLayout>
      </ScrollView>

      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/btn_verify_otp"
          style="@style/ActionButton"
          android:enabled="false"
          android:textAllCaps="false"
           android:layout_marginStart="@dimen/size_24dp"
          android:layout_alignParentBottom="true"
          android:layout_width="match_parent"
          android:layout_marginBottom="@dimen/size_48dp"
          android:layout_marginTop="@dimen/size_24dp"
          android:layout_marginEnd="@dimen/size_24dp"
          android:text="@string/action_proceed_account"
          />

    </RelativeLayout>

  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>



