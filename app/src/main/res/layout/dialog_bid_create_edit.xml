<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="route"
        type="String"
        />

    <variable
        name="request"
        type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData"
        />

    <import type="android.view.View" />
  </data>

  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@android:color/white"
      android:orientation="vertical"
      android:paddingStart="@dimen/size_24dp"
      android:paddingTop="@dimen/size_24dp"
      android:paddingEnd="@dimen/size_24dp"
      android:paddingBottom="@dimen/size_4dp"
      >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >

      <androidx.appcompat.widget.AppCompatTextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:lineSpacingExtra="@dimen/text_8sp"
          android:text="@string/label_place_bid"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_20sp"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/id1"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_gradient_green"
          android:fontFamily="sans-serif-medium"
          android:lineSpacingExtra="@dimen/text_8sp"
          android:paddingStart="@dimen/size_8dp"
          android:paddingEnd="@dimen/size_8dp"
          android:text="@string/label_multi_stop"
          android:textColor="@color/white"
          android:textSize="@dimen/text_16sp"
          android:visibility="@{request.multiDrop ? View.VISIBLE : View.GONE }"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toStartOf="@+id/id2"
          app:layout_constraintTop_toTopOf="parent"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/id2"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_gradient_blue"
          android:lineSpacingExtra="@dimen/text_8sp"
          android:paddingStart="@dimen/size_8dp"
          android:paddingEnd="@dimen/size_8dp"
          android:text="@string/label_pmt"
          android:textColor="@color/white"
          android:textSize="@dimen/text_16sp"
          android:visibility="@{request.isPMTIndent() ? View.VISIBLE : View.GONE }"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_route_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_6dp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="@dimen/text_14sp"
        android:text="@{ route }"
        android:textColor="@color/heading_black"
        tools:text="GA - MH"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8dp"
        >

      <androidx.appcompat.widget.LinearLayoutCompat
          android:id="@+id/id3"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toStartOf="@+id/guideline"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          >

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_truck_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@{ request.truckTypeDrawableRes() }"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_truck_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8dp"
            android:fontFamily="sans-serif"
            android:text="@{request.truckDetail()}"
            android:textColor="@color/sub_heading_black"
            android:textSize="@dimen/text_14sp"
            tools:text="Type"
            />

      </androidx.appcompat.widget.LinearLayoutCompat>

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/id4"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:text="@{request.requestedCapacityMg()}"
          android:textColor="@color/sub_heading_black"
          android:visibility="@{request.isPMTIndent()? View.VISIBLE: View.GONE}"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toEndOf="@+id/guideline"
          app:layout_constraintTop_toTopOf="parent"
          tools:text="Capacity: 25MG"
          />

      <androidx.constraintlayout.widget.Guideline
          android:id="@+id/guideline"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          app:layout_constraintGuide_percent="0.60"
          />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_amount"
        style="@style/TextInputLayoutAppearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:errorEnabled="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

      <androidx.appcompat.widget.AppCompatEditText
          android:id="@+id/edit_amount"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:background="@drawable/bg_form_edit"
          android:digits="0123456789"
          android:imeOptions="actionDone"
          android:inputType="number"
          android:textSize="@dimen/text_14sp"
          />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/label_bid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="@dimen/text_4sp"
        android:textColor="@color/heading_black"
        android:visibility="@{request.isPMTIndent()? View.VISIBLE: View.GONE}"
        tools:text="Your minimum payout will be ₹ rate * requested"
        />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_28dp"
        android:gravity="end"
        >

      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/btn_cancel"
          style="@style/Widget.AppCompat.Button.Borderless.Colored"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="end"
          android:text="@android:string/cancel"
          android:textColor="@color/colorAccent"
          android:textSize="@dimen/text_14sp"
          />

      <View
          android:layout_width="@dimen/size_16dp"
          android:layout_height="0dp"
          />

      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/btn_confirm"
          style="@style/Widget.AppCompat.Button.Borderless.Colored"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="end"
          android:text="@string/action_confirm"
          android:textColor="@color/colorAccent"
          android:textSize="@dimen/text_14sp"
          />

    </androidx.appcompat.widget.LinearLayoutCompat>
  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>