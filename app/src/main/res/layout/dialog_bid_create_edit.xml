<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="route"
        type="String"
        />
    <variable
        name="targetPrice"
        type="Integer"
        />
    <variable
        name="bidAmount"
        type="String"
        />
  </data>
  <android.support.v7.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@android:color/white"
      android:orientation="vertical"
      android:paddingBottom="@dimen/size_4dp"
      android:paddingEnd="@dimen/size_24dp"
      android:paddingStart="@dimen/size_24dp"
      android:paddingTop="@dimen/size_24dp"
      >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="8sp"
        android:text="@string/label_bid_amount"
        android:textColor="#de000000"
        android:textSize="20sp"
        android:textStyle="normal"
        />

    <TextView
        android:id="@+id/text_route_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_6dp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="@dimen/text_14sp"
        android:text="@{ route }"
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_14sp"
        android:textStyle="normal"
        tools:text="GA - MH (Today)"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_24dp"
        android:fontFamily="sans-serif"
        android:text="@string/label_target_price"
        android:textColor="@color/sub_heading_black"
        android:textSize="@dimen/text_12sp"
        android:textStyle="normal"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        android:lineSpacingExtra="-4sp"
        android:text="@{ @string/label_inr(targetPrice) }"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:textStyle="normal"
        tools:text="₹ 23900.00"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_24dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="4sp"
        android:text="@string/hint_enter_bid_value"
        android:textColor="#61000000"
        android:textSize="@dimen/text_12sp"
        android:textStyle="normal"
        />

    <EditText
        android:id="@+id/edit_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_4dp"
        android:background="@drawable/bg_form_edit"
        android:digits="0123456789"
        android:hint="@{ String.valueOf(targetPrice) }"
        android:imeOptions="actionDone"
        android:inputType="number"
        />

    <android.support.v7.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_28dp"
        android:gravity="end"
        >
      <android.support.v7.widget.AppCompatButton
          android:id="@+id/btn_cancel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="end"
          android:text="@android:string/cancel"
          android:textColor="@color/colorAccent"
          android:textSize="14sp"
          style="@style/Widget.AppCompat.Button.Borderless.Colored"
          />

      <View
          android:layout_width="@dimen/size_16dp"
          android:layout_height="0dp"
          />

      <android.support.v7.widget.AppCompatButton
          android:id="@+id/btn_confirm"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="end"
          android:text="@string/action_confirm"
          android:textColor="@color/colorAccent"
          android:textSize="14sp"
          style="@style/Widget.AppCompat.Button.Borderless.Colored"
          />
    </android.support.v7.widget.LinearLayoutCompat>
  </android.support.v7.widget.LinearLayoutCompat>
</layout>