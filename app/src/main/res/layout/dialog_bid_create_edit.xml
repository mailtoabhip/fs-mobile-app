<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="route"
        type="String"
        />

    <variable
        name="request"
        type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData"
        />

    <import type="android.view.View" />
  </data>

  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@android:color/white"
      android:orientation="vertical"
      android:paddingStart="@dimen/size_24dp"
      android:paddingTop="@dimen/size_24dp"
      android:paddingEnd="@dimen/size_24dp"
      android:paddingBottom="@dimen/size_4dp"
      >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:lineSpacingExtra="@dimen/text_8sp"
          android:text="@string/label_bid_amount"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_20sp"
          android:textStyle="normal"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_gradient_green"
          android:fontFamily="sans-serif-medium"
          android:lineSpacingExtra="@dimen/text_8sp"
          android:paddingStart="@dimen/size_8dp"
          android:paddingEnd="@dimen/size_8dp"
          android:text="@string/label_multi_stop"
          android:textColor="@color/white"
          android:textSize="@dimen/text_16sp"
          android:textStyle="normal"
          android:visibility="@{request.multiDrop ? View.VISIBLE : View.GONE }"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/text_route_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_6dp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="@dimen/text_14sp"
        android:text="@{ route }"
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_14sp"
        android:textStyle="normal"
        tools:text="GA - MH"
        />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8dp"
        android:orientation="horizontal"
        >

      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/img_truck_type"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:srcCompat="@{ request.truckTypeDrawableRes() }"
          />

      <TextView
          android:id="@+id/text_truck_details"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_8dp"
          android:fontFamily="sans-serif"
          android:text="@{request.truckTypeDetails()}"
          android:textColor="@color/sub_heading_black"
          android:textSize="@dimen/text_14sp"
          android:textStyle="bold"
          tools:text="Type"
          />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_24dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="@dimen/text_4sp"
        android:text="@string/hint_enter_bid_value"
        android:textColor="#61000000"
        android:textSize="@dimen/text_12sp"
        android:textStyle="normal"
        />

    <EditText
        android:id="@+id/edit_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_4dp"
        android:background="@drawable/bg_form_edit"
        android:digits="0123456789"
        android:imeOptions="actionDone"
        android:inputType="number"
        />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_28dp"
        android:gravity="end"
        >
      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/btn_cancel"
          style="@style/Widget.AppCompat.Button.Borderless.Colored"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="end"
          android:text="@android:string/cancel"
          android:textColor="@color/colorAccent"
          android:textSize="@dimen/text_14sp"
          />

      <View
          android:layout_width="@dimen/size_16dp"
          android:layout_height="0dp"
          />

      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/btn_confirm"
          style="@style/Widget.AppCompat.Button.Borderless.Colored"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="end"
          android:text="@string/action_confirm"
          android:textColor="@color/colorAccent"
          android:textSize="@dimen/text_14sp"
          />
    </androidx.appcompat.widget.LinearLayoutCompat>
  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>