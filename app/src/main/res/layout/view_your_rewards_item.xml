<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
  <data>
    <variable
        name="request"
        type="com.dfd.delfin.data.yourrewards.YourRewardsItemData"
        />
    <import type="androidx.core.content.ContextCompat"/>
    <import type="android.view.View" />

  </data>
  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/rewards_item"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/white"
      android:layout_marginTop="@dimen/size_24dp"
      android:layout_marginStart="@dimen/size_16dp"
      android:layout_marginEnd="@dimen/size_16dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/route_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:textStyle="bold"
        android:textColor="@color/route_heading"
        android:textSize="@dimen/text_14sp"
        android:text="@{request.routes()}"
        tools:text="Trichy - Gurgaon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/vehicle_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/route_text"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@color/info_bg"
        android:paddingTop="@dimen/size_4dp"
        android:textSize="@dimen/text_12sp"
        tools:text="40ft MXL (25-38MT) / TN 06M 2829"
        android:text="@{request.truckDetails()}"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/route_text"
        app:layout_constraintEnd_toEndOf="parent"
        android:textStyle="bold"
        android:textSize="@dimen/text_12sp"
        android:paddingStart="@dimen/size_8dp"
        android:paddingEnd="@dimen/size_8dp"
        android:paddingTop="@dimen/size_4dp"
        android:paddingBottom="@dimen/size_4dp"
        app:textColor="@{ContextCompat.getColor(context, request.statusTextColor()) }"
        app:layout_constraintBottom_toBottomOf="@+id/vehicle_text"
        android:text="@{request.statusText()}"
        tools:text="Status"
        />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/full_details_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12dp"
        android:visibility="@{request.detailsVisibility()}"
        app:layout_constraintTop_toBottomOf="@+id/vehicle_text"
        app:layout_constraintStart_toStartOf="parent">
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/submitted_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          android:textColor="@color/color_hint"
          android:textSize="@dimen/text_12sp"
          android:text="@string/submitted_on"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/submitted_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintTop_toBottomOf="@+id/submitted_text"
          app:layout_constraintStart_toStartOf="parent"
          android:textSize="@dimen/text_12sp"
          android:textColor="@color/route_heading"
          tools:text="12th Jan 2022"
          android:text="@{request.submittedDate()}"
          />
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/rewards_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintStart_toEndOf="@+id/submitted_text"
          app:layout_constraintEnd_toStartOf="@+id/download_icon"
          android:textSize="@dimen/text_12sp"
          android:textColor="@color/color_hint"
          android:text="@{request.rewardText()}"
          tools:text="@string/rewards_earned"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/rewards_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintTop_toBottomOf="@+id/rewards_text"
          app:layout_constraintStart_toStartOf="@id/rewards_text"
          android:textSize="@dimen/text_12sp"
          app:textColor="@{ContextCompat.getColor(context, request.rewardsValueTextColor()) }"
          tools:text="-------------"
          android:text="@{request.rewardsValue()}"/>
      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/download_icon"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="@dimen/size_16dp"
          android:paddingBottom="@dimen/size_16dp"
          app:layout_constraintTop_toTopOf="@+id/rewards_text"
          app:layout_constraintBottom_toBottomOf="@+id/rewards_value"
          app:srcCompat="@drawable/ic_vector_download"
          app:layout_constraintEnd_toEndOf="parent"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/utr_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_12dp"
          android:textSize="@dimen/text_12sp"
          android:visibility="@{request.isApproved()}"
          app:layout_constraintTop_toBottomOf="@+id/submitted_value"
          app:layout_constraintStart_toStartOf="parent"
          android:textColor="@color/color_hint"
          android:text="@string/utr"
          />
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/utr_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintTop_toBottomOf="@+id/utr_text"
          app:layout_constraintStart_toStartOf="parent"
          android:textColor="@color/route_heading"
          android:textSize="@dimen/text_12sp"
          android:visibility="@{request.isApproved()}"
          tools:text="12388399"
          android:text="@{request.utrValue()}"
          />
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/payment_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_12dp"
          app:layout_constraintTop_toBottomOf="@+id/rewards_value"
          app:layout_constraintStart_toStartOf="@+id/rewards_value"
          app:layout_constraintStart_toEndOf="@+id/utr_text"
          android:textSize="@dimen/text_12sp"
          android:visibility="@{request.isApproved()}"
          android:textColor="@color/color_hint"
          android:text="@string/payment_date"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/payment_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintTop_toBottomOf="@+id/payment_text"
          app:layout_constraintStart_toStartOf="@id/payment_text"
          android:textSize="@dimen/text_12sp"
          android:visibility="@{request.isApproved()}"
          android:textColor="@color/route_heading"
          tools:text="12th Jan 2022"
          android:text="@{request.paymentDate()}"/>

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/offer_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_12dp"
          android:textSize="@dimen/text_12sp"
          app:layout_constraintTop_toBottomOf="@+id/utr_value"
          app:layout_constraintStart_toStartOf="parent"
          android:textColor="@color/color_hint"
          android:text="@string/offer_hash"
          />
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/sort_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintTop_toBottomOf="@+id/offer_text"
          app:layout_constraintStart_toStartOf="parent"
          android:textColor="@color/route_heading"
          android:textSize="@dimen/text_12sp"
          tools:text="12388399"
          android:text="@{request.sortKey}"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/details_update"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:layout_constraintTop_toBottomOf="@+id/sort_value"
          app:layout_constraintStart_toStartOf="parent"
          android:drawableStart="@drawable/ic_vector_info_doc"
          android:drawablePadding="@dimen/size_4dp"
          android:textSize="@dimen/text_12sp"
          android:layout_marginTop="@dimen/size_12dp"
          android:textColor="@color/route_heading"
          android:padding="@dimen/size_8dp"
          android:visibility="@{request.isApprovedAndUpdated()}"
          android:background="@drawable/bg_all_round_corner_light_purple"
          android:text="@string/details_updated_based_on_proof"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/full_view_ll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/size_12dp"
        android:paddingBottom="@dimen/size_16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/full_details_ll">
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/expand_full_details_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          android:textSize="@dimen/text_12sp"
          android:textColor="@color/colorAccent"
          android:text="@string/full_details"/>
      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/expand_full_details_icon"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="@dimen/size_8dp"
          android:paddingTop="@dimen/size_4dp"
          app:layout_constraintTop_toTopOf="@+id/expand_full_details_text"
          app:layout_constraintStart_toEndOf="@+id/expand_full_details_text"
          app:srcCompat="@{request.toggleButton()}"
          />
    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>