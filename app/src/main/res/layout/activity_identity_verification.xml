<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="viewModel"
            type="com.delhivery.axle.ui.kyc.identityverification.IdentityVerificationViewModel"
            />
        <import type="android.view.View" />

    </data>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blue_bg"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_toolbar"
            />
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/size_24dp"
            android:paddingEnd="@dimen/size_24dp"
            android:paddingBottom="@dimen/size_48dp">
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:id="@+id/progress"
                android:layout_marginBottom="@dimen/size_24dp"
                bind:layout_constraintTop_toTopOf="parent"
                android:max="100"
                android:progressDrawable="@drawable/account_progress"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/step_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/progress"
                android:text="@{viewModel.currentStep}"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_16sp"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/business_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/step_text"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                android:text="@string/label_identity_verification"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_24sp"
                android:textStyle="bold"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/identity_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/business_text"
                android:text="@string/sub_label_business_identity"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_16sp"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/identity_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:drawableLeft="@drawable/ic_vector_error"
                android:drawablePadding="@dimen/size_8dp"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/identity_hint"
                android:text="@string/sub_label_gst_details"
                android:textColor="@color/destructive_red"
                android:textSize="@dimen/text_16sp"
                />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cin_edit_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_32dp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/identity_error">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:background="@drawable/bg_all_round_corner_blue_selector"
                    android:id="@+id/layout_cin"
                    android:padding="@dimen/size_1dp"
                    bind:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        bind:layout_constraintBottom_toBottomOf="parent"
                        android:background="@drawable/bg_login_edit"
                        android:layout_marginTop="@dimen/size_16dp">
                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/text_cin"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/edit_text_height"
                            android:clickable="true"
                            bind:layout_constraintStart_toStartOf="parent"
                            bind:layout_constraintTop_toTopOf="parent"
                            android:maxLength="20"
                            android:paddingStart="@dimen/size_12dp"
                            android:paddingEnd="@dimen/size_12dp"
                            android:text="@string/cin_number"
                            android:textColor="@color/heading_black"
                            android:textSize="@dimen/text_16sp"
                            />
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/edit_cin_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            bind:layout_constraintStart_toStartOf="parent"
                            bind:layout_constraintTop_toBottomOf="@+id/text_cin">
                            <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                                android:id="@+id/edit_cin"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/edit_text_height"
                                android:imeOptions="actionDone"
                                bind:layout_constraintStart_toStartOf="parent"
                                bind:layout_constraintTop_toTopOf="parent"
                                android:inputType="textCapCharacters"
                                android:singleLine="true"
                                android:paddingStart="@dimen/size_12dp"
                                android:paddingEnd="@dimen/size_12dp"
                                android:hint="Enter CIN"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_16sp"
                                android:text="@={ viewModel.cinNumber }"
                                />
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/img_wrong"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/edit_text_height"
                                bind:srcCompat="@drawable/ic_wrong"
                                bind:layout_constraintTop_toTopOf="parent"
                                bind:layout_constraintEnd_toEndOf="parent"
                                bind:layout_constraintBottom_toBottomOf="parent"
                                android:visibility="gone"
                                android:paddingStart="@dimen/size_12dp"
                                android:paddingEnd="@dimen/size_12dp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            bind:layout_constraintTop_toBottomOf="@+id/edit_cin_layout"
                            android:textColor="@color/destructive_red"
                            android:visibility="gone"
                            android:id="@+id/rc_error_msg"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
               <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/udyog_edit_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/cin_edit_layout">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:background="@drawable/bg_all_round_corner_blue_selector"
                    android:id="@+id/layout_udyog"
                    android:padding="@dimen/size_1dp"
                    bind:layout_constraintTop_toTopOf="parent"
                    >
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        bind:layout_constraintBottom_toBottomOf="parent"
                        android:background="@drawable/bg_login_edit"
                        android:layout_marginTop="@dimen/size_16dp">
                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/text_udyog"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/edit_text_height"
                            android:clickable="true"
                            bind:layout_constraintStart_toStartOf="parent"
                            bind:layout_constraintTop_toTopOf="parent"
                            android:maxLength="20"
                            android:paddingStart="@dimen/size_12dp"
                            android:paddingEnd="@dimen/size_12dp"
                            android:text="@string/udyog_aadhaar_number"
                            android:textColor="@color/heading_black"
                            android:textSize="@dimen/text_16sp"
                            />
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/edit_udyog_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            bind:layout_constraintStart_toStartOf="parent"
                            bind:layout_constraintTop_toBottomOf="@+id/text_udyog">
                            <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                                android:id="@+id/edit_udyog"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/edit_text_height"
                                android:imeOptions="actionDone"
                                bind:layout_constraintStart_toStartOf="parent"
                                bind:layout_constraintTop_toTopOf="parent"
                                android:inputType="textCapCharacters"
                                android:singleLine="true"
                                android:paddingStart="@dimen/size_12dp"
                                android:paddingEnd="@dimen/size_12dp"
                                android:hint="@string/udyog_hint"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_16sp"
                                android:text="@={ viewModel.udyogNumber }"
                                />
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/img_wrong1"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/edit_text_height"
                                bind:srcCompat="@drawable/ic_wrong"
                                bind:layout_constraintTop_toTopOf="parent"
                                bind:layout_constraintEnd_toEndOf="parent"
                                bind:layout_constraintBottom_toBottomOf="parent"
                                android:visibility="gone"
                                android:paddingStart="@dimen/size_12dp"
                                android:paddingEnd="@dimen/size_12dp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            bind:layout_constraintTop_toBottomOf="@+id/edit_udyog_layout"
                            android:textColor="@color/destructive_red"
                            android:visibility="gone"
                            android:id="@+id/rc_error_msg1"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
               </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/shop_edit_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/udyog_edit_layout">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:background="@drawable/bg_all_round_corner_blue_selector"
                    android:id="@+id/layout_shop"
                    android:padding="@dimen/size_1dp"
                    bind:layout_constraintTop_toTopOf="parent"
                    >
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        bind:layout_constraintBottom_toBottomOf="parent"
                        android:background="@drawable/bg_login_edit"
                        android:layout_marginTop="@dimen/size_16dp">
                        <androidx.appcompat.widget.AppCompatRadioButton
                            android:id="@+id/text_shop"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/edit_text_height"
                            android:clickable="true"
                            bind:layout_constraintStart_toStartOf="parent"
                            bind:layout_constraintTop_toTopOf="parent"
                            android:paddingStart="@dimen/size_12dp"
                            android:paddingEnd="@dimen/size_12dp"
                            android:text="@string/shop_establishment"
                            android:textColor="@color/heading_black"
                            android:textSize="@dimen/text_16sp"
                            />
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/edit_shop_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            bind:layout_constraintStart_toStartOf="parent"
                            bind:layout_constraintTop_toBottomOf="@+id/text_shop">
                            <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                                android:id="@+id/edit_shop"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/edit_text_height"
                                android:imeOptions="actionDone"
                                bind:layout_constraintStart_toStartOf="parent"
                                bind:layout_constraintTop_toTopOf="parent"
                                android:inputType="textCapCharacters"
                                android:singleLine="true"
                                android:paddingStart="@dimen/size_12dp"
                                android:paddingEnd="@dimen/size_12dp"
                                android:hint="@string/shop_hint"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_16sp"
                                android:text="@={ viewModel.shopNumber }"
                                />
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/img_wrong2"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/edit_text_height"
                                bind:srcCompat="@drawable/ic_wrong"
                                bind:layout_constraintTop_toTopOf="parent"
                                bind:layout_constraintEnd_toEndOf="parent"
                                bind:layout_constraintBottom_toBottomOf="parent"
                                android:visibility="gone"
                                android:paddingStart="@dimen/size_12dp"
                                android:paddingEnd="@dimen/size_12dp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            bind:layout_constraintTop_toBottomOf="@+id/edit_shop_layout"
                            android:textColor="@color/destructive_red"
                            android:visibility="gone"
                            android:id="@+id/rc_error_msg2"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/upload_doc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_24dp"
                bind:layout_constraintTop_toBottomOf="@+id/shop_edit_layout">
                <androidx.appcompat.widget.AppCompatTextView
                         android:id="@+id/doc_proof"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:textSize="@dimen/text_14sp"
                        android:textStyle="bold"
                        bind:layout_constraintTop_toTopOf="parent"
                         bind:layout_constraintStart_toStartOf="parent"
                        android:text="@string/proof_attachment"
                        />
                    <androidx.constraintlayout.widget.ConstraintLayout
                        bind:layout_constraintTop_toBottomOf="@+id/doc_proof"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_16dp">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:id="@+id/upload_doc_lay"
                            android:layout_height="wrap_content"
                            android:visibility="visible"
                            bind:layout_constraintTop_toTopOf="parent"
                            bind:layout_constraintStart_toStartOf="parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/upload_icon"
                            android:layout_width="@dimen/size_16dp"
                            android:layout_height="@dimen/size_20dp"
                            bind:srcCompat="@drawable/ic_upload"
                            android:layout_marginStart="@dimen/size_2dp"
                            bind:layout_constraintTop_toTopOf="parent"
                            bind:layout_constraintLeft_toLeftOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/size_16dp"
                            bind:layout_constraintTop_toTopOf="parent"
                            android:textSize="@dimen/text_16sp"
                            android:textColor="@color/colorAccent"
                            android:textStyle="bold"
                            bind:layout_constraintLeft_toRightOf="@+id/upload_icon"
                            android:text="@string/upload_document"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/doc_uploaded_lay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            bind:layout_constraintTop_toTopOf="parent"
                            bind:layout_constraintStart_toStartOf="parent">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/doc_icon"
                                android:layout_width="@dimen/size_48dp"
                                android:layout_height="@dimen/size_48dp"
                                bind:srcCompat="@drawable/ic_doc_gst"
                                android:layout_marginStart="@dimen/size_2dp"
                                bind:layout_constraintTop_toTopOf="parent"
                                bind:layout_constraintLeft_toLeftOf="parent"
                                bind:layout_constraintBottom_toBottomOf="parent" />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/doc_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/size_16dp"
                                bind:layout_constraintTop_toTopOf="parent"
                                android:textSize="@dimen/text_20sp"
                                bind:layout_constraintLeft_toRightOf="@+id/doc_icon"
                                android:text="IMG_344_98899"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:id="@+id/doc_size"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/size_16dp"
                                bind:layout_constraintTop_toBottomOf="@+id/doc_title"
                                android:textSize="@dimen/text_16sp"
                                android:textColor="@color/color_hint"
                                bind:layout_constraintLeft_toRightOf="@+id/doc_icon"
                                android:text="233kb"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/doc_remove"
                                android:layout_width="@dimen/size_20dp"
                                android:layout_height="@dimen/size_20dp"
                                bind:srcCompat="@drawable/ic_remove"
                                android:layout_marginStart="@dimen/size_2dp"
                                android:clickable="true"
                                android:layout_marginLeft="@dimen/size_2dp"
                                bind:layout_constraintTop_toTopOf="parent"
                                bind:layout_constraintBottom_toBottomOf="parent"
                                bind:layout_constraintRight_toRightOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_verify_identity"
                style="@style/ActionButton"
                android:enabled="false"
                android:textAllCaps="false"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/upload_doc"
                android:layout_alignParentBottom="true"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/size_32dp"
                android:text="@string/action_save_proceed"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>



