<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content">
  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/rules"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingEnd="@dimen/size_16dp"
      android:paddingStart="@dimen/size_16dp"
      android:layout_marginTop="@dimen/size_16dp"
      app:layout_constraintTop_toTopOf="parent"
      android:visibility="gone">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/rulesLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rules"
        android:textSize="@dimen/text_16sp"
        android:textColor="@color/background_dark_grey"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textStyle="bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dot1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\u2022  "
        android:layout_marginTop="@dimen/size_8dp"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@color/heading_black"
        app:layout_constraintTop_toBottomOf="@id/rulesLabel"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/rule1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/rulesLabel"
        app:layout_constraintStart_toEndOf="@id/dot1"
        android:layout_marginTop="@dimen/size_8dp"
        android:textSize="@dimen/text_14sp"
        android:textColor="@color/heading_black"
        android:paddingEnd="@dimen/size_10dp"
        android:text="@string/only_bid_if_you_match_vehicle_type_amp_total_vehicles"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dot2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\u2022  "
        android:textColor="@color/heading_black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rule1"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/rule2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/rule1"
        app:layout_constraintStart_toEndOf="@id/dot2"
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_14sp"
        android:paddingEnd="@dimen/size_10dp"
        android:text="@string/ensure_vehicle_reaches_as_per_given_schedule"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dot3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\u2022  "
        android:textColor="@color/heading_black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rule2"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/rule3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/rule2"
        app:layout_constraintStart_toEndOf="@id/dot3"
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_14sp"
        android:paddingEnd="@dimen/size_10dp"
        android:text="@string/schedule_might_change_amp_you_will_be_notified"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dot4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\u2022  "
        android:textColor="@color/heading_black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rule3"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/rule4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/rule3"
        app:layout_constraintStart_toEndOf="@id/dot4"
        android:textSize="@dimen/text_14sp"
        android:textColor="@color/heading_black"
        android:paddingEnd="@dimen/size_10dp"
        android:text="@string/not_meeting_travel_time_will_result_in_delay_penalty"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dot5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\u2022  "
        android:textColor="@color/heading_black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rule4"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/rule5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/rule4"
        app:layout_constraintStart_toEndOf="@id/dot5"
        android:textSize="@dimen/text_14sp"
        android:paddingEnd="@dimen/size_10dp"
        android:textColor="@color/heading_black"
        android:text="@string/for_continuous_lanes_ensure_empty_vehicle_is_always_available_for_docking_loading"/>
  </androidx.constraintlayout.widget.ConstraintLayout>

  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/nonExpRules"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingEnd="@dimen/size_16dp"
      android:paddingStart="@dimen/size_16dp"
      android:visibility="gone"
      android:layout_marginTop="@dimen/size_16dp"
      app:layout_constraintTop_toTopOf="parent"
      >
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpRulesLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rules"
        android:textSize="@dimen/text_16sp"
        android:textColor="@color/background_dark_grey"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textStyle="bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpDot1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\u2022  "
        android:layout_marginTop="@dimen/size_8dp"
        android:textColor="@color/heading_black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nonExpRulesLabel"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpRule1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/nonExpRulesLabel"
        app:layout_constraintStart_toEndOf="@id/nonExpDot1"
        android:layout_marginTop="@dimen/size_8dp"
        android:textSize="@dimen/text_14sp"
        android:textColor="@color/heading_black"
        android:paddingEnd="@dimen/size_10dp"
        android:text="@string/note_that_the_number_of_trips_are_tentative"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpDot2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\u2022  "
        android:textColor="@color/heading_black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nonExpRule1"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpRule2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/nonExpRule1"
        android:textColor="@color/heading_black"
        app:layout_constraintStart_toEndOf="@id/nonExpDot2"
        android:textSize="@dimen/text_14sp"
        android:paddingEnd="@dimen/size_10dp"
        android:text="@string/ensure_adherence_to_no_of_trip_commitments"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpDot3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\u2022  "
        android:textColor="@color/heading_black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nonExpRule2"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpRule3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/nonExpRule2"
        app:layout_constraintStart_toEndOf="@id/nonExpDot3"
        android:textSize="@dimen/text_14sp"
        android:textColor="@color/heading_black"
        android:paddingEnd="@dimen/size_10dp"
        android:text="@string/non_adherence_to_contract_will_impact_your_performance_score_amp_may_result_in_contract_cancellation"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpDot4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\u2022  "
        android:textColor="@color/heading_black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nonExpRule3"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpRule4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/nonExpRule3"
        app:layout_constraintStart_toEndOf="@id/nonExpDot4"
        android:textSize="@dimen/text_14sp"
        android:textColor="@color/heading_black"
        android:paddingEnd="@dimen/size_10dp"
        android:text="@string/frc_start_amp_end_date_will_be_informed_via_email"/>

  </androidx.constraintlayout.widget.ConstraintLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>