<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/size_16dp"
    android:layout_marginBottom="@dimen/size_12dp"
    app:cardCornerRadius="@dimen/size_12dp"
    app:cardElevation="0dp"
    app:strokeColor="#E6E6E6"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/size_16dp">

        <!-- Top Row: Vehicle Number + Balance + Refresh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Vehicle Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvVehicleNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/text_16sp"
                    android:textStyle="bold"
                    tools:text="DL01CA1234" />

                <TextView
                    android:id="@+id/tvTruckMake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_2dp"
                    android:textColor="@color/text_grey"
                    android:textSize="@dimen/text_12sp"
                    tools:text="Ashok Leyland" />
            </LinearLayout>

            <!-- Balance -->
            <TextView
                android:id="@+id/tvBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/black"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold"
                tools:text="₹85" />

            <!-- Refresh Icon -->
            <ImageView
                android:id="@+id/ivRefresh"
                android:layout_width="@dimen/size_24dp"
                android:layout_height="@dimen/size_24dp"
                android:layout_marginStart="@dimen/size_8dp"
                android:contentDescription="@string/fastag_refresh_balance"
                android:src="@drawable/sync" />
        </LinearLayout>

        <!-- Low Balance Warning -->
        <LinearLayout
            android:id="@+id/lowBalanceWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8dp"
            android:background="@drawable/bg_fastag_low_balance_warning"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/size_8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/size_16dp"
                android:layout_height="@dimen/size_16dp"
                android:contentDescription="@string/fastag_balance_low"
                android:src="@drawable/low_balance_alert" />

            <TextView
                android:id="@+id/tvWarningText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_6dp"
                android:text="@string/fastag_balance_low"
                android:textColor="#52430D"
                android:textSize="@dimen/text_12sp" />
        </LinearLayout>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12dp"
            android:orientation="horizontal">

            <!-- Details Button -->
            <TextView
                android:id="@+id/btnDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/size_6dp"
                android:background="@drawable/bg_edittext_outline"
                android:gravity="center"
                android:paddingVertical="@dimen/size_8dp"
                android:text="Details"
                android:textColor="@android:color/black"
                android:textSize="@dimen/text_14sp" />

            <!-- Recharge Button -->
            <TextView
                android:id="@+id/btnRecharge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/size_6dp"
                android:background="@drawable/bg_btn_fastag_recharge_filled"
                android:gravity="center"
                android:paddingVertical="@dimen/size_8dp"
                android:text="@string/fastag_recharge"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_14sp" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
