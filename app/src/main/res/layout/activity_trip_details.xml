<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="viewModel"
        type="com.delhivery.orion.ui.tripdetails.TripDetailsViewModel"
        />

    <variable
        name="tripDetails"
        type="com.delhivery.orion.data.home.trips.HomeTripsItemData"
        />

    <variable
        name="transactionDetails"
        type="com.delhivery.orion.data.home.bids.HomeBidsRequestItemData"
        />
  </data>

  <android.support.v7.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/colorBackground"
      android:orientation="vertical"
      >

    <android.support.v7.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        bind:shadow="@{ @dimen/size_4dp }"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

      <android.support.v7.widget.LinearLayoutCompat
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          >

        <!-- vehicle/driver details container -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_2dp"
            android:background="@color/colorPrimary"
            android:paddingBottom="@dimen/size_16dp"
            android:paddingEnd="@dimen/size_24dp"
            android:paddingStart="@dimen/size_24dp"
            android:paddingTop="@dimen/size_16dp"
            bind:shadow="@{ @dimen/size_2dp }"
            >

          <View
              android:id="@+id/view_center_dot"
              android:layout_width="@dimen/size_2dp"
              android:layout_height="@dimen/size_2dp"
              android:layout_centerInParent="true"
              />

          <TextView
              android:id="@+id/text_vehicle_no_label"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentStart="true"
              android:layout_toStartOf="@id/view_center_dot"
              android:fontFamily="sans-serif"
              android:text="@string/label_vehicle"
              android:textColor="@color/sub_heading_black"
              android:textSize="@dimen/text_12sp"
              android:textStyle="normal"
              />

          <TextView
              android:id="@+id/text_vehicle_no"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentStart="true"
              android:layout_below="@id/text_vehicle_no_label"
              android:layout_marginTop="@dimen/size_4dp"
              android:layout_toStartOf="@id/view_center_dot"
              android:fontFamily="sans-serif"
              android:text="@{ tripDetails.vehicleDetails.vehicleNo }"
              android:textColor="@color/colorAccent"
              android:textSize="@dimen/text_14sp"
              android:textStyle="normal"
              tools:text="DL 4S FG 2134"
              />

          <TextView
              android:id="@+id/text_driver_label"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentEnd="true"
              android:layout_toEndOf="@id/view_center_dot"
              android:fontFamily="sans-serif"
              android:text="@string/label_driver"
              android:textColor="@color/sub_heading_black"
              android:textSize="@dimen/text_12sp"
              android:textStyle="normal"
              />

          <TextView
              android:id="@+id/text_driver"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentEnd="true"
              android:layout_below="@id/text_vehicle_no_label"
              android:layout_marginTop="@dimen/size_4dp"
              android:layout_toEndOf="@id/view_center_dot"
              android:fontFamily="sans-serif"
              android:lineSpacingMultiplier="1.2"
              android:text="@{ tripDetails.formattedDriverDetails() }"
              android:textColor="@color/colorAccent"
              android:textSize="@dimen/text_14sp"
              android:textStyle="normal"
              tools:text="Ram kumar,\n+919090909090"
              />
        </RelativeLayout>

        <!-- trip details container -->
        <android.support.constraint.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4dp"
            android:background="@color/colorPrimary"
            android:paddingBottom="@dimen/size_8dp"
            android:paddingEnd="@dimen/size_24dp"
            android:paddingStart="@dimen/size_24dp"
            android:paddingTop="@dimen/size_24dp"
            bind:shadow="@{ @dimen/size_2dp }"
            >

          <TextView
              android:id="@+id/text_from_label"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:text="@string/label_from"
              android:textColor="@color/sub_heading_black"
              android:textSize="@dimen/text_12sp"
              android:textStyle="normal"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              />

          <TextView
              android:id="@+id/text_source"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_2dp"
              android:fontFamily="sans-serif"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_16sp"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@id/text_from_label"
              bind:htmlText="@{ @string/label_city_state(transactionDetails.origin, transactionDetails.origin) }"
              tools:text="Panjim, Goa"
              />

          <TextView
              android:id="@+id/text_to_label"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_16dp"
              android:fontFamily="sans-serif"
              android:text="@string/label_to"
              android:textColor="@color/sub_heading_black"
              android:textSize="@dimen/text_12sp"
              android:textStyle="normal"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@id/text_source"
              />

          <TextView
              android:id="@+id/text_destination"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_2dp"
              android:fontFamily="sans-serif"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_16sp"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@id/text_to_label"
              bind:htmlText="@{ @string/label_city_state(transactionDetails.destination, transactionDetails.destinationState) }"
              tools:text="Andheri east, Mumbai, Maharashtra"
              />

          <TextView
              android:id="@+id/text_date_time"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_16dp"
              android:lineSpacingExtra="@dimen/text_4sp"
              android:text="@{ transactionDetails.requiredAt() }"
              android:textColor="@color/white"
              android:textSize="@dimen/text_10sp"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@id/text_destination"
              bind:drawableResId="@{ transactionDetails.requiredAtBg() }"
              tools:background="@drawable/bg_date_today"
              tools:text="TODAY 6:30 pm"
              />

          <TextView
              android:id="@+id/text_truck_details"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:gravity="center_vertical"
              android:text="@{ transactionDetails.truckTypeDetails() }"
              android:textColor="@color/sub_heading_black"
              android:textSize="@dimen/text_14sp"
              android:textStyle="normal"
              app:layout_constraintBottom_toBottomOf="@id/text_date_time"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintTop_toTopOf="@id/text_date_time"
              tools:text="Closed truck (32ft)"
              />

          <android.support.v7.widget.AppCompatImageView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginEnd="@dimen/size_8dp"
              app:layout_constraintEnd_toStartOf="@id/text_truck_details"
              app:layout_constraintTop_toTopOf="@id/text_truck_details"
              app:srcCompat="@{ transactionDetails.truckTypeDrawableRes() }"
              tools:srcCompat="@drawable/ic_closed_truck"
              />

          <android.support.v7.widget.AppCompatImageView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_36dp"
              android:alpha="0.6"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@id/text_truck_details"
              app:srcCompat="@drawable/ic_chevron_down_black"
              />
        </android.support.constraint.ConstraintLayout>

        <!-- Pickup location -->
        <android.support.v7.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4dp"
            android:background="@color/colorPrimary"
            android:orientation="vertical"
            android:paddingBottom="@dimen/size_16dp"
            android:paddingEnd="@dimen/size_24dp"
            android:paddingStart="@dimen/size_24dp"
            android:paddingTop="@dimen/size_16dp"
            bind:shadow="@{ @dimen/size_2dp }"
            >

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:text="@string/label_pickup_location"
              android:textColor="@color/sub_heading_black"
              android:textSize="@dimen/text_12sp"
              android:textStyle="normal"
              />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_4dp"
              android:fontFamily="sans-serif"
              android:text="@{ transactionDetails.pickupLocation }"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_14sp"
              android:textStyle="normal"
              tools:text="Shop No 33-35, Kamat Arcade, Santa Inez, Panaji, Goa 403001"
              />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_16dp"
              android:fontFamily="sans-serif"
              android:text="@string/label_contact"
              android:textColor="@color/sub_heading_black"
              android:textSize="@dimen/text_12sp"
              android:textStyle="normal"
              />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_4dp"
              android:fontFamily="sans-serif"
              android:text="@{ transactionDetails.clientName }"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_14sp"
              android:textStyle="normal"
              tools:text="Amit Kumar , +91 9728 281 321"
              />
        </android.support.v7.widget.LinearLayoutCompat>

        <!-- Status history header -->
        <android.support.v7.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/size_8dp"
            android:background="@color/white"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            >

          <android.support.v7.widget.LinearLayoutCompat
              android:id="@+id/view_history"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginEnd="@dimen/size_8dp"
              android:layout_marginStart="@dimen/size_8dp"
              android:layout_weight="1"
              android:background="@drawable/bg_selector_trip_detail_tab"
              >

            <TextView
                android:id="@+id/text_status_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_horizontal"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="@dimen/text_4sp"
                android:paddingBottom="@dimen/size_16dp"
                android:paddingTop="@dimen/size_16dp"
                android:text="@string/label_status_history"
                android:textColor="@color/black"
                android:textSize="@dimen/text_14sp"
                android:textStyle="normal"
                />
          </android.support.v7.widget.LinearLayoutCompat>

          <android.support.v7.widget.LinearLayoutCompat
              android:id="@+id/view_summary"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginEnd="@dimen/size_8dp"
              android:layout_marginStart="@dimen/size_8dp"
              android:layout_weight="1"
              android:background="@drawable/bg_selector_trip_detail_tab"
              >

            <TextView
                android:id="@+id/text_payment_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_horizontal"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="@dimen/text_4sp"
                android:paddingBottom="@dimen/size_16dp"
                android:paddingTop="@dimen/size_16dp"
                android:text="@string/label_payment_summary"
                android:textColor="@color/transparent_grey"
                android:textSize="@dimen/text_14sp"
                android:textStyle="normal"
                />
          </android.support.v7.widget.LinearLayoutCompat>

        </android.support.v7.widget.LinearLayoutCompat>

        <android.support.v7.widget.LinearLayoutCompat
            android:id="@+id/container_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_8dp"
            android:orientation="vertical"
            />

      </android.support.v7.widget.LinearLayoutCompat>
    </ScrollView>
  </android.support.v7.widget.LinearLayoutCompat>
</layout>