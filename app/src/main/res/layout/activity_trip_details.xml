<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.tripdetails.TripDetailsViewModel"
        />

    <variable
        name="tripDetails"
        type="com.delhivery.axle.data.home.trips.HomeTripsItemData"
        />

    <variable
        name="transactionDetails"
        type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData"
        />
  </data>

  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/colorBackground"
      android:orientation="vertical"
      >

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        bind:shadow="@{ @dimen/size_4dp }"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          >

        <!-- vehicle/driver details container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_2dp"
            android:background="@color/colorPrimary"
            android:paddingBottom="@dimen/size_16dp"
            android:paddingStart="@dimen/size_24dp"
            android:paddingTop="@dimen/size_16dp"
            bind:shadow="@{ @dimen/size_2dp }"
            >

          <TextView
              android:id="@+id/text_vehicle_no"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentStart="true"
              android:layout_marginTop="@dimen/size_4dp"
              android:fontFamily="sans-serif"
              android:text="@{ tripDetails.vehicleDetails.vehicleNo }"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_16sp"
              android:textStyle="bold"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              tools:text="DL 4S FG 2134"
              />

          <TextView
              android:id="@+id/text_driver"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@id/text_vehicle_no"
              android:layout_marginTop="@dimen/size_4dp"
              android:fontFamily="sans-serif"
              android:lineSpacingMultiplier="1.2"
              android:text="@{ tripDetails.formattedDriverDetails() }"
              android:textColor="@color/sub_heading_black"
              android:textSize="@dimen/text_14sp"
              android:textStyle="normal"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/text_vehicle_no"
              tools:text="Ram kumar,+919090909090"
              />

          <androidx.appcompat.widget.AppCompatImageView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentEnd="true"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              app:srcCompat="@drawable/ic_awaiting_truck"
              />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- trip details container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4dp"
            android:background="@color/colorPrimary"
            android:paddingBottom="@dimen/size_16dp"
            android:paddingEnd="@dimen/size_24dp"
            android:paddingStart="@dimen/size_24dp"
            android:paddingTop="@dimen/size_16dp"
            bind:shadow="@{ @dimen/size_2dp }"
            >

          <TextView
              android:id="@+id/text_from_label"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:text="@string/label_from"
              android:textColor="@color/sub_heading_black"
              android:textSize="@dimen/text_12sp"
              android:textStyle="normal"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              />

          <TextView
              android:id="@+id/text_source"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_2dp"
              android:fontFamily="sans-serif"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_16sp"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@id/text_from_label"
              bind:htmlText="@{ @string/label_city_state(transactionDetails.originCityName(), transactionDetails.originStateName()) }"
              tools:text="Panjim, Goa"
              />

          <TextView
              android:id="@+id/text_to_label"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_16dp"
              android:fontFamily="sans-serif"
              android:text="@string/label_to"
              android:textColor="@color/sub_heading_black"
              android:textSize="@dimen/text_12sp"
              android:textStyle="normal"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@id/text_source"
              />

          <TextView
              android:id="@+id/text_destination"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_2dp"
              android:fontFamily="sans-serif"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_16sp"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@id/text_to_label"
              bind:htmlText="@{ @string/label_city_state(transactionDetails.destinationCityName(), transactionDetails.destinationStateName()) }"
              tools:text="Andheri east, Mumbai, Maharashtra"
              />

          <TextView
              android:id="@+id/text_truck_details"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:layout_marginTop="@dimen/size_16dp"
              android:gravity="center_vertical"
              android:text="@{ transactionDetails.truckTypeDetails() }"
              android:textColor="@color/sub_heading_black"
              android:layout_marginStart="@dimen/size_8dp"
              app:layout_constraintTop_toBottomOf="@id/text_destination"
              app:layout_constraintStart_toEndOf="@+id/img_truck"
              android:textSize="@dimen/text_14sp"
              android:textStyle="bold"
              tools:text="Closed truck (32ft)"
              />

          <androidx.appcompat.widget.AppCompatImageView
              android:id="@+id/img_truck"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginEnd="@dimen/size_8dp"
              app:layout_constraintBottom_toBottomOf="@id/text_truck_details"
              app:layout_constraintEnd_toStartOf="@id/text_truck_details"
              app:layout_constraintTop_toTopOf="@id/text_truck_details"
              app:layout_constraintStart_toStartOf="parent"
              app:srcCompat="@{ transactionDetails.truckTypeDrawableRes() }"
              tools:srcCompat="@drawable/ic_closed_truck"
              />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Pickup location -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4dp"
            android:background="@color/colorPrimary"
            android:orientation="vertical"
            android:paddingBottom="@dimen/size_16dp"
            android:paddingEnd="@dimen/size_24dp"
            android:paddingStart="@dimen/size_24dp"
            android:paddingTop="@dimen/size_16dp"
            bind:shadow="@{ @dimen/size_2dp }"
            >

          <TextView
              android:id="@+id/id1"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:text="@string/label_lr_number"
              android:textColor="@color/sub_heading_black"
              android:textSize="@dimen/text_12sp"
              android:textStyle="normal"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              />

          <TextView
              android:id="@+id/id2"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_4dp"
              android:fontFamily="sans-serif"
              android:text="@{ tripDetails.lr }"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_14sp"
              android:textStyle="bold"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/id1"
              tools:text="000000"
              />

          <TextView
              android:id="@+id/id3"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:text="@string/label_pickup_location"
              android:textColor="@color/sub_heading_black"
              android:textSize="@dimen/text_12sp"
              android:textStyle="normal"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              />

          <TextView
              android:id="@+id/label_warehouse"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginEnd="@dimen/size_16dp"
              android:layout_marginTop="@dimen/size_4dp"
              android:fontFamily="sans-serif"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_14sp"
              android:textStyle="normal"
              app:layout_constraintEnd_toStartOf="@+id/id2"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/id3"
              tools:text="Shop No 33-35, Kamat Arcade, Santa Inez, Panaji, Goa 403001"
              />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Status history header -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4dp"
            android:background="@color/white"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingTop="@dimen/size_8dp"
            bind:shadow="@{ @dimen/size_2dp }"
            >

          <androidx.appcompat.widget.LinearLayoutCompat
              android:id="@+id/view_history"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginEnd="@dimen/size_8dp"
              android:layout_marginStart="@dimen/size_8dp"
              android:layout_weight="1"
              android:background="@drawable/bg_selector_trip_detail_tab"
              >

            <TextView
                android:id="@+id/text_status_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_horizontal"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="@dimen/text_4sp"
                android:paddingBottom="@dimen/size_16dp"
                android:paddingTop="@dimen/size_16dp"
                android:text="@string/label_status_history"
                android:textColor="@color/black"
                android:textSize="@dimen/text_14sp"
                android:textStyle="normal"
                />
          </androidx.appcompat.widget.LinearLayoutCompat>

          <androidx.appcompat.widget.LinearLayoutCompat
              android:id="@+id/view_summary"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginEnd="@dimen/size_8dp"
              android:layout_marginStart="@dimen/size_8dp"
              android:layout_weight="1"
              android:background="@drawable/bg_selector_trip_detail_tab"
              >

            <TextView
                android:id="@+id/text_payment_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_horizontal"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="@dimen/text_4sp"
                android:paddingBottom="@dimen/size_16dp"
                android:paddingTop="@dimen/size_16dp"
                android:text="@string/label_payment_summary"
                android:textColor="@color/transparent_grey"
                android:textSize="@dimen/text_14sp"
                android:textStyle="normal"
                />
          </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <include
            layout="@layout/view_bid_details_loading_bids"
            android:id="@+id/progress_history"
            />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/container_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_8dp"
            android:orientation="vertical"
            />

      </androidx.appcompat.widget.LinearLayoutCompat>
    </ScrollView>
  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>