<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <androidx.cardview.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/size_12dp"
      android:clickable="true"
      android:focusable="true"
      android:foreground="?attr/selectableItemBackgroundBorderless"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="@dimen/size_2dp">
    <com.delhivery.axle.ui.custom.DelhiveryShimmerLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:paddingTop="@dimen/size_12dp"
        android:paddingBottom="@dimen/size_8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >
      <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/view_cl_bid_status"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_16dp"
          android:padding="@dimen/size_4dp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/view_status_image"
            android:layout_width="@dimen/size_16dp"
            android:layout_height="@dimen/size_16dp"
            android:paddingEnd="@dimen/size_4dp"
            android:paddingStart="@dimen/size_4dp"
            android:paddingTop="@dimen/size_2dp"
            android:layout_marginEnd="@dimen/size_4dp"
            android:background="@color/colorShimmerPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/view_tv_bid_status"
            app:layout_constraintBottom_toBottomOf="@+id/view_tv_bid_status"/>
        <View
            android:id="@+id/view_tv_bid_status"
            android:layout_width="@dimen/size_48dp"
            android:layout_height="@dimen/size_16dp"
            android:layout_marginStart="@dimen/size_4dp"
            app:layout_constraintStart_toEndOf="@id/view_status_image"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@color/colorShimmerPrimary"
            android:paddingEnd="@dimen/size_6dp"/>
        <View
            android:id="@+id/view_tv_bid_time"
            android:layout_width="@dimen/size_48dp"
            android:layout_height="@dimen/size_12dp"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@color/colorShimmerPrimary"
            app:layout_constraintTop_toBottomOf="@id/view_tv_bid_status"
            android:paddingEnd="@dimen/size_6dp"
            android:paddingStart="@dimen/size_2dp"
            android:layout_marginTop="@dimen/size_4dp"
            />
      </androidx.constraintlayout.widget.ConstraintLayout>

      <View
          android:id="@+id/view_user_bid_status"
          android:layout_width="@dimen/size_64dp"
          android:layout_height="@dimen/size_16dp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          android:layout_marginEnd="@dimen/size_16dp"
          android:background="@color/colorShimmerPrimary"
          />
      <View
          android:id="@+id/view_user_bid_info"
          android:layout_width="@dimen/size_64dp"
          android:layout_height="@dimen/size_16dp"
          app:layout_constraintEnd_toEndOf="parent"
          android:background="@color/colorShimmerPrimary"
          android:layout_marginEnd="@dimen/size_16dp"
          android:paddingLeft="@dimen/size_2dp"
          android:layout_marginTop="@dimen/size_4dp"
          app:layout_constraintTop_toBottomOf="@+id/view_user_bid_status"
          />
      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/view_seperator"
          android:layout_width="match_parent"
          android:layout_height="5dp"
          app:srcCompat="@drawable/seperator_line"
          android:layout_marginTop="@dimen/size_12dp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/view_cl_bid_status"
          />

      <View
          android:id="@+id/view_marginView"
          android:layout_width = "wrap_content"
          android:layout_height = "@dimen/size_16dp"
          android:layout_marginTop="@dimen/size_16dp"
          android:layout_marginStart="@dimen/size_16dp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/view_seperator"
          />

      <View
          android:id="@+id/view_img_forward"
          android:layout_width="@dimen/size_24dp"
          android:layout_height="@dimen/size_24dp"
          android:layout_marginTop="@dimen/size_16dp"
          android:background="@color/colorShimmerPrimary"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/view_seperator"
          />

      <View
          android:id="@+id/view_source_city"
          android:layout_width="0dp"
          android:layout_height="0dp"
          android:layout_marginStart="@dimen/size_16dp"
          android:layout_marginEnd="@dimen/size_16dp"
          android:background="@color/colorShimmerPrimary"
          app:layout_constraintBottom_toBottomOf="@id/view_img_forward"
          app:layout_constraintEnd_toStartOf="@id/view_img_forward"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="@id/view_img_forward"
          />

      <View
          android:id="@+id/view_source_state"
          android:layout_width="0dp"
          android:layout_height="@dimen/size_16dp"
          android:layout_marginEnd="@dimen/size_16dp"
          android:layout_marginTop="@dimen/size_4dp"
          android:layout_marginStart="@dimen/size_16dp"
          android:background="@color/colorShimmerSecondary"
          app:layout_constraintEnd_toStartOf="@id/view_img_forward"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/view_source_city"
          />

      <View
          android:id="@+id/view_destination_city"
          android:layout_width="0dp"
          android:layout_height="0dp"
          android:layout_marginStart="@dimen/size_16dp"
          android:layout_marginEnd="@dimen/size_16dp"
          android:background="@color/colorShimmerPrimary"
          app:layout_constraintBottom_toBottomOf="@id/view_img_forward"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toEndOf="@id/view_img_forward"
          app:layout_constraintTop_toTopOf="@id/view_img_forward"
          />

      <View
          android:id="@+id/view_destination_state"
          android:layout_width="0dp"
          android:layout_height="@dimen/size_16dp"
          android:layout_marginStart="@dimen/size_16dp"
          android:layout_marginTop="@dimen/size_4dp"
          android:layout_marginEnd="@dimen/size_16dp"
          android:background="@color/colorShimmerSecondary"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toEndOf="@id/view_img_forward"
          app:layout_constraintTop_toBottomOf="@id/view_destination_city"
          />
      <View
          android:id="@+id/view_truck_type_text"
          android:layout_width="@dimen/size_56dp"
          android:layout_height="@dimen/size_24dp"
          android:layout_marginTop="@dimen/size_20dp"
          android:layout_marginStart="@dimen/size_8dp"
          android:background="@color/colorShimmerSecondary"
          app:layout_constraintTop_toBottomOf="@+id/view_source_state"
          app:layout_constraintStart_toEndOf="@+id/view_truck_type_image"/>
      <View
          android:id="@+id/view_truck_type_image"
          android:layout_width="@dimen/size_24dp"
          android:layout_height="@dimen/size_24dp"
          android:background="@color/colorShimmerSecondary"
          android:layout_marginStart="@dimen/size_16dp"
          android:layout_marginEnd="@dimen/size_8dp"
          app:layout_constraintStart_toStartOf="parent"
          android:layout_marginTop="@dimen/size_20dp"
          android:paddingTop="@dimen/size_4dp"
          app:layout_constraintTop_toBottomOf="@+id/view_source_state"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
    </com.delhivery.axle.ui.custom.DelhiveryShimmerLayout>
  </androidx.cardview.widget.CardView>
</layout>