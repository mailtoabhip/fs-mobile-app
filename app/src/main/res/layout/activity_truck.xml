<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
        name="refreshing"
        type="Boolean"
        />

        <variable
        name="error"
        type="Boolean"
        />

    <import type="android.view.View" />
    <import type="androidx.core.content.ContextCompat" />
    </data>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/colorBackground">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_toolbar"
            android:background="@android:color/white"
            bind:shadow="@{ @dimen/size_4dp }"
            />

        <include
            android:id="@+id/container_error"
            layout="@layout/view_warning_item"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:visibility="@{error ? View.VISIBLE : View.GONE }"
            tools:visibility="gone"
            />
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/size_11dp"
            android:background="@color/colorPrimary"
            android:visibility="@{!error ? View.VISIBLE : View.GONE }"
            tools:visibility="visible">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

          <androidx.core.widget.NestedScrollView
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:fillViewport="true"
              >

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/colorPrimary"
                android:visibility="@{!refreshing &amp;&amp; !error ? View.VISIBLE : View.GONE }"
                tools:visibility="visible">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_12sp"
                    android:text="@string/label_body_type" />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                <RadioGroup
                    android:id="@+id/body_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_6dp"
                    android:layout_marginStart="@dimen/size_6dp"
                    android:paddingStart="@dimen/size_8dp"
                    android:paddingEnd="@dimen/size_8dp"
                    android:paddingTop="@dimen/size_8dp"
                    android:paddingBottom="@dimen/size_2dp"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/btn_radio_container"
                        android:layout_width="@dimen/size_56dp"
                        android:layout_height="@dimen/size_56dp"
                        android:textSize="@dimen/text_12sp"
                        android:layout_gravity="center"
                        android:button="@null"
                        android:checked="true"
                        android:background="@drawable/radio_selection_container"
                        android:textAlignment="center" />
                    <RadioButton
                        android:id="@+id/btn_radio_open"
                        android:layout_width="@dimen/size_56dp"
                        android:layout_height="@dimen/size_56dp"
                        android:layout_marginStart="@dimen/size_24dp"
                        android:textSize="@dimen/text_12sp"
                        android:layout_gravity="center"
                        android:button="@null"
                        android:background="@drawable/radio_selction_open"
                        android:textAlignment="center" />
                    <RadioButton
                        android:id="@+id/btn_radio_trailer"
                        android:layout_width="@dimen/size_56dp"
                        android:layout_height="@dimen/size_56dp"
                        android:layout_marginStart="@dimen/size_24dp"
                        android:layout_gravity="center"
                        android:button="@null"
                        android:background="@drawable/radio_selection_trailer"
                        android:textSize="@dimen/text_12sp"
                        android:textAlignment="center"/>
                </RadioGroup>


                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/body_group"
                        android:layout_marginStart="@dimen/size_6dp"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/size_8dp"
                        android:paddingEnd="@dimen/size_8dp"
                        android:paddingBottom="@dimen/size_8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/body_group"
                            android:text="@string/label_closed"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/body_group"
                            android:layout_marginStart="@dimen/size_28dp"
                            android:text="@string/label_open"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/body_group"
                            android:layout_marginStart="@dimen/size_36dp"
                            android:text="@string/label_trailer"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_12sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </RelativeLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_12sp"
                    android:layout_marginTop="@dimen/size_6dp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_truck_number"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edit_truck_number"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_40dp"
                    android:layout_marginTop="@dimen/size_6dp"
                    android:padding="@dimen/size_8dp"
                    android:hint="Eg: KA-BD2525"
                    android:inputType="textCapCharacters"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_14sp"
                    android:background="@drawable/background_rectangle_border_curved"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/number_error"
                    android:layout_width="wrap_content"
                    android:textColor="@color/bid_placed_red"
                    android:textSize="@dimen/text_12sp"
                    android:visibility="gone"
                    android:layout_height="wrap_content" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/size_14dp"
                    android:textSize="@dimen/text_12sp"
                    android:layout_height="wrap_content"
                    android:text="@string/label_ownership"/>

                <RadioGroup
                    android:id="@+id/ownership_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_6dp"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/btn_radio_own_truck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/label_own_truck"/>
                    <RadioButton
                        android:id="@+id/btn_radio_market_truck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size_24dp"
                        android:text="@string/label_market_truck"/>
                </RadioGroup>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_14dp"
                    android:textSize="@dimen/text_12sp"
                    android:text="@string/label_truck_size"
                    android:textColor="@color/black"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/edit_truck_size"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_40dp"
                    android:layout_marginTop="@dimen/size_6dp"
                    android:padding="@dimen/size_8dp"
                    android:background="@drawable/background_rectangle_border_curved">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_truck_size"
                        android:layout_width="wrap_content"
                        android:hint="32ft SXL"
                        android:textColor="@color/black"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/size_error"
                    android:layout_width="wrap_content"
                    android:textColor="@color/bid_placed_red"
                    android:textSize="@dimen/text_12sp"
                    android:visibility="gone"
                    android:layout_height="wrap_content" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_14dp"
                    android:textSize="@dimen/text_12sp"
                    android:text="@string/label_truck_capacity"
                    android:textColor="@color/black"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/edit_truck_capacity"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_40dp"
                    android:layout_marginTop="@dimen/size_6dp"
                    android:padding="@dimen/size_8dp"
                    android:textSize="@dimen/text_14sp"
                    android:background="@drawable/background_rectangle_border_curved">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_truck_capacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="4.5MT"
                        android:textColor="@color/black"
                        android:layout_gravity="center"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/capacity_error"
                    android:layout_width="wrap_content"
                    android:textColor="@color/bid_placed_red"
                    android:textSize="@dimen/text_12sp"
                    android:visibility="gone"
                    android:layout_height="wrap_content" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_14dp"
                    android:textSize="@dimen/text_12sp"
                    android:text="@string/label_current_city"
                    android:textColor="@color/black"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/edit_current_city"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_40dp"
                    android:padding="@dimen/size_8dp"
                    android:layout_marginTop="@dimen/size_6dp"
                    android:textSize="@dimen/text_14sp"
                    android:background="@drawable/background_rectangle_border_curved">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_current_city"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_search_black"
                        android:drawablePadding="@dimen/size_4dp"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:hint="Search city"/>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/origin_error"
                    android:layout_width="wrap_content"
                    android:textColor="@color/bid_placed_red"
                    android:textSize="@dimen/text_12sp"
                    android:visibility="gone"
                    android:layout_height="wrap_content" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_14dp"
                    android:textSize="@dimen/text_12sp"
                    android:text="@string/label_unloading_destination"
                    android:textColor="@color/black"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/edit_unloading_destinations"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_40dp"
                    android:layout_marginTop="@dimen/size_6dp"
                    android:padding="@dimen/size_8dp"
                    android:textSize="@dimen/text_14sp"
                    android:background="@drawable/background_rectangle_border_curved">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_unloading_destination"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"
                        android:hint="Eg: Bhopal"
                        android:textColor="@color/black"
                        android:layout_height="wrap_content"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/destination_error"
                    android:layout_width="wrap_content"
                    android:textColor="@color/bid_placed_red"
                    android:textSize="@dimen/text_12sp"
                    android:visibility="gone"
                    android:layout_height="wrap_content" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_14dp"
                    android:textSize="@dimen/text_12sp"
                    android:text="@string/label_price_mt"
                    android:textColor="@color/black"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edit_price_add_truck"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_40dp"
                    android:layout_marginTop="@dimen/size_8dp"
                    android:padding="@dimen/size_8dp"
                    android:textSize="@dimen/text_14sp"
                    android:inputType="number"
                    android:maxLength="10"
                    android:textColor="@color/black"
                    android:hint="Eg: ₹2500"
                    android:background="@drawable/background_rectangle_border_curved">
                </androidx.appcompat.widget.AppCompatEditText>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/price_error"
                    android:layout_width="wrap_content"
                    android:textColor="@color/bid_placed_red"
                    android:textSize="@dimen/text_12sp"
                    android:layout_marginBottom="@dimen/size_12dp"
                    android:visibility="gone"
                    android:layout_height="wrap_content" />


            </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_add_truck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_add_truck"
            android:background="@drawable/bg_all_round_corner_black"
            android:textColor="@color/white"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>