<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
        name="refreshing"
        type="Boolean"
        />

        <variable
        name="error"
        type="Boolean"
        />

    <import type="android.view.View" />
    <import type="androidx.core.content.ContextCompat" />
    </data>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/colorBackground"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_toolbar"
            android:background="@android:color/white"
            android:fitsSystemWindows="true"
            bind:shadow="@{ @dimen/size_4dp }"
            />

        <include
            android:id="@+id/container_error"
            layout="@layout/view_warning_item"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:visibility="@{error ? View.VISIBLE : View.GONE }"
            tools:visibility="gone"
            />
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/colorPrimary"
            android:visibility="@{!error ? View.VISIBLE : View.GONE }"
            tools:visibility="visible">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1">

          <androidx.core.widget.NestedScrollView
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:fillViewport="true"
              >

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/colorPrimary"
                android:visibility="@{!refreshing &amp;&amp; !error ? View.VISIBLE : View.GONE }"
                tools:visibility="visible">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/label_body_type" />

                <RadioGroup
                    android:id="@+id/body_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/btn_radio_container"
                        android:layout_width="0dp"
                        android:layout_height="129dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/radio_selection_container"
                        android:button="@null"
                        android:gravity="center_horizontal|bottom"
                        android:paddingStart="12dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="16dp"
                        android:text="@string/label_closed"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/btn_radio_open"
                        android:layout_width="0dp"
                        android:layout_height="129dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/radio_selection_open"
                        android:button="@null"
                        android:gravity="center_horizontal|bottom"
                        android:paddingStart="12dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="16dp"
                        android:text="@string/label_open"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/btn_radio_trailer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/radio_selection_trailer"
                        android:button="@null"
                        android:gravity="center_horizontal|bottom"
                        android:paddingStart="12dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="16dp"
                        android:text="@string/label_trailer"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        android:textSize="16sp" />
                </RadioGroup>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:layout_marginTop="16dp"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:text="@string/label_truck_number"/>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edit_truck_number"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:padding="12dp"
                    android:hint="Eg: KA12BD2525"
                    android:inputType="textCapCharacters"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_hint"
                    android:textSize="14sp"
                    android:background="@drawable/background_rectangle_border_curved"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/number_error"
                    android:layout_width="wrap_content"
                    android:textColor="@color/bid_placed_red"
                    android:textSize="@dimen/text_12sp"
                    android:visibility="gone"
                    android:layout_height="wrap_content" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:textColor="@color/black"
                    android:layout_marginTop="16dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_height="wrap_content"
                    android:text="@string/label_ownership"/>

                <RadioGroup
                    android:id="@+id/ownership_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/btn_radio_own_truck"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_ownership_card"
                        android:button="@drawable/selector_radio_button_ownership"
                        android:checked="true"
                        android:drawablePadding="16dp"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="18dp"
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:text="@string/label_own_truck"/>
                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/btn_radio_market_truck"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:background="@drawable/bg_ownership_card"
                        android:button="@drawable/selector_radio_button_ownership"
                        android:drawablePadding="16dp"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="18dp"
                        android:textSize="18sp"
                        android:textColor="@color/black"
                        android:text="@string/label_market_truck"/>
                </RadioGroup>

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/label_truck_size"
                    android:textColor="@color/black"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/edit_truck_size"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:padding="12dp"
                    android:background="@drawable/background_rectangle_border_curved">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_truck_size"
                        android:layout_width="wrap_content"
                        android:hint="Eg: 32ft SXL"
                        android:textColor="@color/black"
                        android:textColorHint="@color/color_hint"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/size_error"
                    android:layout_width="wrap_content"
                    android:textColor="@color/bid_placed_red"
                    android:textSize="@dimen/text_12sp"
                    android:visibility="gone"
                    android:layout_height="wrap_content" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/label_truck_capacity"
                    android:textColor="@color/black"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/edit_truck_capacity"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:background="@drawable/background_rectangle_border_curved">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_truck_capacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:hint="14.0 MT"
                        android:textColor="@color/black"
                        android:textColorHint="@color/color_hint"
                        android:layout_gravity="center"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/capacity_error"
                    android:layout_width="wrap_content"
                    android:textColor="@color/bid_placed_red"
                    android:textSize="@dimen/text_12sp"
                    android:visibility="gone"
                    android:layout_height="wrap_content" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="@string/label_current_city"
                    android:textColor="@color/black"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/edit_current_city"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:background="@drawable/background_rectangle_border_curved">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_current_city"
                        android:layout_gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:gravity="center"
                        android:textColor="@color/black"
                        android:textColorHint="@color/color_hint"
                        android:hint="Search city"/>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/origin_error"
                    android:layout_width="wrap_content"
                    android:textColor="@color/bid_placed_red"
                    android:textSize="@dimen/text_12sp"
                    android:visibility="gone"
                    android:layout_height="wrap_content" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="14sp"
                    android:text="@string/label_drop_city"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/edit_unloading_destinations"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:background="@drawable/background_rectangle_border_curved">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_unloading_destination"
                        android:layout_width="wrap_content"
                        android:layout_gravity="center"
                        android:hint="Eg: Bhopal"
                        android:textColor="@color/black"
                        android:textColorHint="@color/color_hint"
                        android:layout_height="wrap_content"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/destination_error"
                    android:layout_width="wrap_content"
                    android:textColor="@color/bid_placed_red"
                    android:textSize="@dimen/text_12sp"
                    android:visibility="gone"
                    android:layout_height="wrap_content" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/label_price_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textSize="14sp"
                    android:text="@string/label_expected_price"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edit_price_add_truck"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:padding="12dp"
                    android:textSize="14sp"
                    android:inputType="number"
                    android:maxLength="9"
                    android:layout_marginBottom="16dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/color_hint"
                    android:hint="Eg: ₹2500"
                    android:background="@drawable/background_rectangle_border_curved">
                </androidx.appcompat.widget.AppCompatEditText>

            </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_add_truck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_add_truck_button"
            android:textAllCaps="false"
            android:background="@drawable/bg_action_light_black_btn_without_border"
            android:textColor="@color/selector_button_text"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>