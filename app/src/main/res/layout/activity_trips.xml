<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <import type="com.delhivery.axle.ui.bids.TripType"/>
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.bids.TripsViewModel"
        />
  </data>
  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/colorBackground"
      android:orientation="vertical"
      >

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        bind:shadow="@{ @dimen/size_4dp }"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txt_total_pending"
        android:textColor="@color/black"
        android:padding="@dimen/size_4dp"
        android:layout_marginStart="@dimen/size_8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Total Pending: "
        tools:visibility="visible"/>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/payments_filter_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="3"
        android:orientation="horizontal"
        android:paddingStart="@dimen/size_4dp"
        android:paddingEnd="@dimen/size_4dp"
        >

      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_weight="1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/view_advance_pending"
            android:background="@drawable/bg_white_all_corner_black"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_56dp"
            android:layout_marginStart="@dimen/size_4dp"
            android:layout_marginEnd="@dimen/size_4dp"
            >

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/id1"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif-medium"
              android:lineSpacingExtra="@dimen/text_6sp"
              android:layout_marginTop="@dimen/size_8dp"
              android:maxLines="1"
              android:gravity="center"
              android:text="@string/label_advance_pending"
              android:textColor="@color/black"
              android:textSize="@dimen/text_10sp"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              tools:text="Advance Pending"
              />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/text_advance_pending"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:fontFamily="sans-serif-medium"
              android:gravity="center"
              android:layout_marginBottom="@dimen/size_8dp"
              android:text=""
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintEnd_toEndOf="parent"
              android:textColor="@color/black"
              android:textSize="@dimen/text_14sp"
              android:textStyle="bold"
              app:layout_constraintBottom_toBottomOf="parent"
              tools:text="₹ 10,0000"
              />
        </androidx.constraintlayout.widget.ConstraintLayout>

      </androidx.appcompat.widget.LinearLayoutCompat>

      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_weight="1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/view_balance_pending"
            android:background="@drawable/bg_white_all_corner_black"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_56dp"
            android:layout_marginStart="@dimen/size_4dp"
            android:layout_marginEnd="@dimen/size_4dp"
            >

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/id2"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif-medium"
              android:lineSpacingExtra="@dimen/text_6sp"
              android:text="@string/label_balance_pending"
              android:layout_marginTop="@dimen/size_8dp"
              android:textColor="@color/black"
              android:gravity="center"
              android:textSize="@dimen/text_10sp"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              tools:text="Balance Pending"
              />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/text_balance_pending"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:fontFamily="sans-serif-medium"
              android:gravity="center"
              android:layout_marginBottom="@dimen/size_8dp"
              android:text=""
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintEnd_toEndOf="parent"
              android:textColor="@color/black"
              android:textSize="@dimen/text_14sp"
              android:textStyle="bold"
              app:layout_constraintBottom_toBottomOf="parent"
              tools:text="₹ 10,0000"
              />

        </androidx.constraintlayout.widget.ConstraintLayout>

      </androidx.appcompat.widget.LinearLayoutCompat>

      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_weight="1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/view_recovery_pending"
            android:background="@drawable/bg_white_all_corner_black"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_56dp"
            android:layout_marginStart="@dimen/size_4dp"
            android:layout_marginEnd="@dimen/size_4dp"
            >

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/id3"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif-medium"
              android:lineSpacingExtra="@dimen/text_6sp"
              android:text="@string/label_recovery_pending"
              android:gravity="center"
              android:layout_marginTop="@dimen/size_8dp"
              android:textColor="@color/black"
              android:textSize="@dimen/text_10sp"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              tools:text="Recovery Pending"
              />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/text_recovery_pending"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:fontFamily="sans-serif-medium"
              android:gravity="center"
              android:layout_marginBottom="@dimen/size_8dp"
              android:text=""
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintEnd_toEndOf="parent"
              android:textColor="@color/black"
              android:textSize="@dimen/text_14sp"
              android:textStyle="bold"
              app:layout_constraintBottom_toBottomOf="parent"
              tools:text="₹ 10,0000"
              />

        </androidx.constraintlayout.widget.ConstraintLayout>

      </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <HorizontalScrollView
        android:id="@+id/trips_filter_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        >

      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          android:orientation="horizontal"
          android:paddingStart="@dimen/size_4dp"
          android:paddingEnd="@dimen/size_4dp"
          >

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

          <androidx.constraintlayout.widget.ConstraintLayout
              android:id="@+id/view_awaiting_arrival"
              android:background="@drawable/bg_white_all_corner_black"
              android:layout_width="wrap_content"
              android:layout_height="@dimen/size_56dp"
              android:layout_marginStart="@dimen/size_8dp"
              android:layout_marginEnd="@dimen/size_8dp"
              >

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/id_arrival"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="@dimen/text_6sp"
                android:layout_marginStart="@dimen/size_8dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_marginTop="@dimen/size_8dp"
                android:gravity="center"
                android:minWidth="@dimen/size_80dp"
                android:text="@string/label_awaiting_arrival"
                android:textColor="@color/black"
                android:textSize="@dimen/text_10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Awaiting Arrival"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_arrival"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginBottom="@dimen/size_8dp"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/text_14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="5 Trips"
                />

          </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

          <androidx.constraintlayout.widget.ConstraintLayout
              android:id="@+id/view_in_transit"
              android:background="@drawable/bg_white_all_corner_black"
              android:layout_width="wrap_content"
              android:layout_height="@dimen/size_56dp"
              android:layout_marginStart="@dimen/size_8dp"
              android:layout_marginEnd="@dimen/size_8dp"
              >

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/id_in_transit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="@dimen/text_6sp"
                android:layout_marginStart="@dimen/size_8dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:gravity="center"
                android:layout_marginTop="@dimen/size_8dp"
                android:minWidth="@dimen/size_80dp"
                android:text="@string/label_in_transit"
                android:textColor="@color/black"
                android:textSize="@dimen/text_10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="In-transit"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_in_transit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginBottom="@dimen/size_8dp"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/text_14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="5 Trips"
                />

          </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

          <androidx.constraintlayout.widget.ConstraintLayout
              android:id="@+id/view_awaiting_loading"
              android:background="@drawable/bg_white_all_corner_black"
              android:layout_width="wrap_content"
              android:layout_height="@dimen/size_56dp"
              android:layout_marginStart="@dimen/size_8dp"
              android:layout_marginEnd="@dimen/size_8dp"
              >

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/id_awaiting_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="@dimen/text_6sp"
                android:layout_marginStart="@dimen/size_8dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_marginTop="@dimen/size_8dp"
                android:gravity="center"
                android:minWidth="@dimen/size_80dp"
                android:text="@string/label_awaiting_loading"
                android:textColor="@color/black"
                android:textSize="@dimen/text_10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Awaiting Loading"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_awaiting_loading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginBottom="@dimen/size_8dp"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/text_14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="5 Trips"
                />

          </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

          <androidx.constraintlayout.widget.ConstraintLayout
              android:id="@+id/view_awaiting_unloading"
              android:background="@drawable/bg_white_all_corner_black"
              android:layout_width="wrap_content"
              android:layout_height="@dimen/size_56dp"
              android:layout_marginStart="@dimen/size_8dp"
              android:layout_marginEnd="@dimen/size_8dp"
              >

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/id_awaiting_unloading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="@dimen/text_6sp"
                android:layout_marginStart="@dimen/size_8dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_marginTop="@dimen/size_8dp"
                android:gravity="center"
                android:minWidth="@dimen/size_80dp"
                android:text="@string/label_awaiting_unloading"
                android:textColor="@color/black"
                android:textSize="@dimen/text_10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Awaiting Unloading"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_awaiting_unloading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:layout_marginBottom="@dimen/size_8dp"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/text_14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="5 Trips"
                />

          </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.appcompat.widget.LinearLayoutCompat>

      </androidx.appcompat.widget.LinearLayoutCompat>

    </HorizontalScrollView>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/txt_trip_count"
          android:padding="@dimen/size_8dp"
          android:textStyle="bold"
          android:textColor="@color/black"
          android:layout_marginStart="@dimen/size_4dp"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          tools:text="All Trips (123)"/>

      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/filter_icon"
          app:srcCompat="@drawable/ic_filter"
          android:layout_gravity="center"
          android:layout_marginEnd="@dimen/size_16dp"
          android:layout_centerVertical="true"
          android:layout_alignParentEnd="true"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"/>

    </RelativeLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rv_bids"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:scrollbars="none"
          />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>