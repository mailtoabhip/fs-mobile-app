<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:text="Statement History"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/llOptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tvSheetTitle">

            <!-- Recent -->
            <include
                android:id="@+id/itemRecent"
                layout="@layout/item_statement_option_row" />

            <!-- Last 1 Week -->
            <include
                android:id="@+id/itemLastWeek"
                layout="@layout/item_statement_option_row" />

            <!-- Current Month -->
            <include
                android:id="@+id/itemCurrentMonth"
                layout="@layout/item_statement_option_row" />

            <!-- Last 1 Month -->
            <include
                android:id="@+id/itemLastMonth"
                layout="@layout/item_statement_option_row" />

            <!-- Last 3 Months -->
            <include
                android:id="@+id/itemLast3Months"
                layout="@layout/item_statement_option_row" />

            <!-- Last 6 Months -->
            <include
                android:id="@+id/itemLast6Months"
                layout="@layout/item_statement_option_row" />

        </LinearLayout>
        
        <!-- Divider -->
        <View
            android:id="@+id/viewDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/llOptionsContainer"/>

        <Button
            android:id="@+id/btnDownloadStatement"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@android:color/black"
            android:text="Download Statement"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:cornerRadius="8dp"
            app:layout_constraintTop_toBottomOf="@id/viewDivider" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
