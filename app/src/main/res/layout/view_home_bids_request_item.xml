<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="request"
        type="com.delhivery.orion.data.home.HomeBidsRequestItemData"
        />
  </data>
  <android.support.v7.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/size_4dp"
      android:layout_marginEnd="@dimen/size_4dp"
      android:layout_marginStart="@dimen/size_4dp"
      android:layout_marginTop="@dimen/size_4dp"
      android:clickable="true"
      android:focusable="true"
      android:foreground="?attr/selectableItemBackgroundBorderless"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="2dp"
      >

    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:paddingBottom="16dp"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        >

      <TextView
          android:id="@+id/text_bids_deadline"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif"
          android:text="Bid ends tomorrow at 4:00pm"
          android:textColor="#29a8e0"
          android:textSize="13sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          />

      <android.support.v7.widget.AppCompatImageView
          android:id="@+id/img_forward"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_bids_deadline"
          app:srcCompat="@drawable/ic_arrow_forward_black"
          />

      <TextView
          android:id="@+id/text_source_city"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif"
          android:text="Panjim"
          android:textColor="#de000000"
          android:textSize="16sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="@id/img_forward"
          />

      <TextView
          android:id="@+id/text_source_state"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="GOA"
          android:textColor="#99000000"
          android:textSize="13sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_source_city"
          />

      <TextView
          android:id="@+id/text_destination_city"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="24dp"
          android:fontFamily="sans-serif"
          android:text="Andheri East"
          android:textColor="#de000000"
          android:textSize="16sp"
          android:textStyle="normal"
          app:layout_constraintStart_toEndOf="@id/img_forward"
          app:layout_constraintTop_toTopOf="@id/img_forward"
          />

      <TextView
          android:id="@+id/text_destination_state"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="Mumbai"
          android:textColor="#99000000"
          android:textSize="13sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="@id/text_destination_city"
          app:layout_constraintTop_toBottomOf="@id/text_source_city"
          />

      <TextView
          android:id="@+id/text_date_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_16dp"
          android:background="@drawable/bg_date_tomorrow"
          android:lineSpacingExtra="4sp"
          android:text="TOMORROW 6:30 pm"
          android:textColor="#ffffff"
          android:textSize="10sp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_source_state"
          />

      <android.support.v7.widget.AppCompatImageView
          android:id="@+id/img_truck_type"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintStart_toStartOf="@+id/img_forward"
          app:layout_constraintTop_toTopOf="@id/text_truck_details"
          app:srcCompat="@drawable/ic_closed_truck"
          />

      <TextView
          android:id="@+id/text_truck_details"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_8dp"
          android:fontFamily="sans-serif"
          android:text="Closed truck (32ft)"
          android:textColor="#99000000"
          android:textSize="13sp"
          android:textStyle="normal"
          app:layout_constraintStart_toEndOf="@id/img_truck_type"
          app:layout_constraintTop_toTopOf="@id/text_date_time"
          />

      <TextView
          android:id="@+id/text_load_details"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_20dp"
          android:fontFamily="sans-serif-medium"
          android:text="Load: Industrial materials"
          android:textColor="#181818"
          android:textSize="12sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_date_time"
          />

      <TextView
          android:id="@+id/text_amount"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_14dp"
          android:fontFamily="sans-serif-medium"
          android:letterSpacing="0.01"
          android:lineSpacingExtra="-2sp"
          android:text="@{ @string/label_inr(request.amount) }"
          android:textColor="#000000"
          android:textSize="20sp"
          android:textStyle="normal"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_load_details"
          tools:text="₹ 23900.00"
          />

      <android.support.v7.widget.AppCompatImageView
          android:id="@+id/img_supply_patner"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintBottom_toBottomOf="@id/text_amount"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="@id/text_amount"
          app:srcCompat="@drawable/ic_supply_patner"
          />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_6dp"
          android:fontFamily="sans-serif"
          android:text="Supply partner"
          android:textColor="#99000000"
          android:textSize="12sp"
          android:textStyle="normal"
          app:layout_constraintBottom_toBottomOf="@id/text_amount"
          app:layout_constraintStart_toEndOf="@id/img_supply_patner"
          app:layout_constraintTop_toTopOf="@id/text_amount"
          />
    </android.support.constraint.ConstraintLayout>
  </android.support.v7.widget.CardView>
</layout>