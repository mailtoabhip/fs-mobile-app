<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    >
  <data>
    <variable
        name="request"
        type="com.delhivery.orion.data.home.bids.HomeBidsRequestItemData"
        />
  </data>
  <android.support.v7.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/size_4dp"
      android:layout_marginEnd="@dimen/size_8dp"
      android:layout_marginStart="@dimen/size_8dp"
      android:layout_marginTop="@dimen/size_4dp"
      android:clickable="true"
      android:focusable="true"
      android:foreground="?attr/selectableItemBackgroundBorderless"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="2dp"
      >

    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:paddingBottom="16dp"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        >

      <android.support.v7.widget.AppCompatImageView
          android:id="@+id/img_forward"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:srcCompat="@drawable/ic_arrow_forward_black"
          />

      <TextView
          android:id="@+id/text_source_city"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif"
          android:text="@{request.origin}"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_16sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="@id/img_forward"
          />

      <TextView
          android:id="@+id/text_source_state"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="@{request.originState}"
          android:textColor="@color/sub_heading_black"
          android:textSize="@dimen/text_12sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_source_city"
          />

      <TextView
          android:id="@+id/text_destination_city"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="24dp"
          android:fontFamily="sans-serif"
          android:text="@{request.destination}"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_16sp"
          android:textStyle="normal"
          app:layout_constraintStart_toEndOf="@id/img_forward"
          app:layout_constraintTop_toTopOf="@id/img_forward"
          />

      <TextView
          android:id="@+id/text_destination_state"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="@{request.destinationState}"
          android:textColor="@color/sub_heading_black"
          android:textSize="@dimen/text_12sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="@id/text_destination_city"
          app:layout_constraintTop_toBottomOf="@id/text_source_city"
          />

      <TextView
          android:id="@+id/text_date_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_16dp"
          android:lineSpacingExtra="4sp"
          android:text="@{request.requiredAt()}"
          android:textColor="@color/white"
          android:textSize="@dimen/text_10sp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_source_state"
          bind:drawableResId="@{ request.requiredAtBg() }"
          />

      <TextView
          android:id="@+id/text_amount"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_14dp"
          android:fontFamily="sans-serif-medium"
          android:letterSpacing="0.01"
          android:lineSpacingExtra="-2sp"
          android:text="@{ @string/label_inr(request.targetPrice) }"
          android:textColor="@color/black"
          android:textSize="@dimen/text_20sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_date_time"
          />

      <TextView
          android:id="@+id/text_user_bid_amount_diff"
          android:layout_width="wrap_content"
          android:layout_height="0dp"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:gravity="center"
          android:text="@{request.tripPriceDifference()}"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_12sp"
          android:textStyle="normal"
          app:layout_constraintBottom_toBottomOf="@+id/text_bid_status"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_amount"
          />

      <TextView
          android:id="@+id/text_bid_status"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="@{request.status}"
          android:textColor="@color/white"
          android:textSize="@dimen/text_16sp"
          android:textStyle="normal"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_amount"
          bind:textColor="@{ request.requiredTextColor() }"
          />
    </android.support.constraint.ConstraintLayout>
  </android.support.v7.widget.CardView>
</layout>