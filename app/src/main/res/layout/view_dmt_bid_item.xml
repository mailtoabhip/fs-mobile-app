<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto">


    <data>
    <variable
        name="item"
        type="com.delhivery.axle.data.bids.DmtBidSummaryItemData"
        />
    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/size_10dp"
        android:layout_marginBottom="@dimen/size_10dp"
        android:background="@drawable/background_rectangle_border"
        android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/vehicleContain"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:id="@+id/expandButton"
            android:layout_height="wrap_content"
            app:srcCompat="@{item.toggleButton()}"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehicle type"
            android:layout_marginStart="@dimen/size_10dp"
            android:id="@+id/tvVehicleType"
            android:textColor="@color/black"
            android:textSize="@dimen/size_20dp"
            android:textStyle="bold"
            />
        <Spinner
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/spinner_vehicle_type"
            android:entries="@array/array_truck_type"
            android:background="@drawable/spinner_border"
            android:layout_weight="1"

            />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/deleteItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_delete"
            android:tint="@color/colorDelhiveryRed"
            />

    </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/noOfTruckContainer"
            android:visibility="@{item.visibility()}"
            android:layout_marginStart="@dimen/size_30dp"
            android:layout_marginTop="@dimen/size_10dp"
            app:layout_constraintTop_toBottomOf="@+id/vehicleContain">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No of Trucks"
                android:id="@+id/tv_no_of_trucks"
                android:textSize="@dimen/size_20dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/size_10dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                />
            <EditText
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@{item.truckCount()}"
                android:layout_marginStart="@dimen/size_10dp"
                />


        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/noOfTruckContainer"
            android:visibility="@{item.visibility()}"
            android:layout_marginTop="@dimen/size_10dp"
            >
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PMT Rate"
                android:layout_marginStart="@dimen/size_30dp"
                android:textSize="@dimen/size_20dp"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:textStyle="bold"
                />
            <androidx.appcompat.widget.AppCompatEditText
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@{item.pmtRate()}"
                android:hint="3"
                />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>