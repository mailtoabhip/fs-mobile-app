<?xml version="1.0" encoding="utf-8"?>
<layout  xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/size_16dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/div1"
            app:layout_constraintTop_toTopOf="@+id/durationText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/durationText"
            app:layout_constraintEnd_toStartOf="@+id/durationText"
            android:layout_width="0dp"
            android:layerType="software"
            android:layout_height="@dimen/size_2dp"
            android:src="@drawable/dotted_line"/>
        <androidx.appcompat.widget.AppCompatTextView
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingStart="@dimen/size_16dp"
            android:paddingEnd="@dimen/size_16dp"
            android:paddingTop="@dimen/size_4dp"
            android:paddingBottom="@dimen/size_4dp"
            android:background="@drawable/bg_all_round_corner_orange_boundary"
            android:id="@+id/durationText"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delayed"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/div2"
            app:layout_constraintTop_toTopOf="@+id/durationText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/durationText"
            app:layout_constraintStart_toEndOf="@+id/durationText"
            android:layout_width="0dp"
            android:layerType="software"
            android:layout_height="@dimen/size_2dp"
            android:src="@drawable/dotted_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>