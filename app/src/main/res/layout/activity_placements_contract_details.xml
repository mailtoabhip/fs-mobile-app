<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.contractDetails.ContractDetailsViewModel"
        />
    <variable
        name="activity"
        type="com.delhivery.axle.ui.contractDetails.ContractDetailsActivity"
        />

    <variable
        name="transaction"
        type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData"
        />

    <variable
        name="refreshing"
        type="Boolean"
        />

    <variable
        name="error"
        type="Boolean"
        />
    <import type="android.view.View" />
  </data>
  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:animateLayoutChanges="true"
      android:layout_marginBottom="@dimen/size_12dp"
      android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        bind:shadow="@{ @dimen/size_4dp }"
        android:background="@android:color/white"
        >
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/toolbarEndText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:gravity="center"
            android:textColor="#935F07"
            android:textStyle="bold"
            android:textSize="@dimen/text_12sp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:paddingTop="@dimen/size_4dp"
            android:paddingBottom="@dimen/size_4dp"
            android:paddingStart="@dimen/size_8dp"
            android:paddingEnd="@dimen/size_8dp" />
    </androidx.appcompat.widget.Toolbar>

  <include
      android:id="@+id/container_error"
      layout="@layout/view_warning_item"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_gravity="center_vertical"
      android:visibility="@{error ? View.VISIBLE : View.GONE }"
      tools:visibility="gone"
      />
  <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
      android:id="@+id/refresh_layout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="@{!error ? View.VISIBLE : View.GONE }"
      tools:visibility="visible">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

      <androidx.core.widget.NestedScrollView
          android:layout_width="match_parent"
          android:layout_height="0dp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintHorizontal_bias="1.0"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintVertical_bias="1.0"
          >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_16dp"
            android:id="@+id/mainCl"
            android:paddingBottom="@dimen/size_16dp"
            android:visibility="@{!refreshing &amp;&amp; !error ? View.VISIBLE : View.GONE }"
            >

          <include
              android:visibility="visible"
              android:id="@+id/card_input"
              layout="@layout/card_new_placement_bid_input"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_gravity="center_vertical"
              tools:visibility="visible"
              />
          <View
              android:id="@+id/view_margin_route"
              android:layout_width="match_parent"
              android:layout_height="@dimen/size_10dp"
              android:layout_marginTop="@dimen/size_16dp"
              android:background="@color/transparent_white"
              android:visibility="gone"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/card_input"
              />
          <View
              android:id="@+id/view_margin_paymentInfo"
              android:layout_width="match_parent"
              android:layout_height="@dimen/size_10dp"
              android:layout_marginTop="@dimen/size_16dp"
              android:background="@color/transparent_white"
              android:visibility="@{transaction.paymentSlabsVisibility()}"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/routeDetails"
              tools:visibility="gone"
              />
          <View
              android:id="@+id/view_margin_vehicle_payment"
              android:layout_width="match_parent"
              android:layout_height="@dimen/size_10dp"
              android:layout_marginTop="@dimen/size_16dp"
              android:background="@color/transparent_white"
              android:visibility="@{transaction.paymentSlabsVisibility()}"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/paymentSlabsInfoDetails"
              tools:visibility="gone"
              />
          <View
              android:id="@+id/view_margin_without_result"
              android:layout_width="match_parent"
              android:layout_height="@dimen/size_10dp"
              android:layout_marginTop="@dimen/size_16dp"
              android:background="@color/transparent_white"
              android:visibility="visible"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/clRemarks"
              />
          <androidx.appcompat.widget.AppCompatImageView
              android:id="@+id/seperator2"
              android:layout_width="match_parent"
              android:layout_height="5dp"
              android:layout_margin="@dimen/size_16dp"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toStartOf="parent"
              android:visibility="@{transaction.routeVehicleMarginVisibility()}"
              app:layout_constraintTop_toBottomOf="@+id/routeDetails"
              app:srcCompat="@drawable/dotted"
              />
          <androidx.appcompat.widget.AppCompatImageView
              android:id="@+id/seperator3"
              android:layout_width="match_parent"
              android:layout_height="5dp"
              android:layout_margin="@dimen/size_16dp"
              android:visibility="@{transaction.isLHContract()}"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/vehicleDetails"
              app:srcCompat="@drawable/dotted"
              />
          <androidx.appcompat.widget.AppCompatImageView
              android:id="@+id/seperator4"
              android:layout_width="match_parent"
              android:layout_height="5dp"
              android:layout_margin="@dimen/size_16dp"
              android:visibility="@{transaction.isIntraCityContract()}"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/tripDetails"
              app:srcCompat="@drawable/dotted"
              />
          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/paymentSlabsInfoLbl"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_margin="@dimen/size_16dp"
              android:text="@string/payment_slabs"
              android:textColor="@color/background_dark_grey"
              android:textSize="@dimen/text_16sp"
              android:textStyle="bold"
              tools:visibility="gone"
              android:visibility="@{transaction.paymentSlabsVisibility()}"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/view_margin_paymentInfo"
              />
          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/paymentSlabsMoreSlab"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginBottom="@dimen/size_8dp"
              android:layout_marginEnd="@dimen/size_16dp"
              android:layout_marginStart="@dimen/size_16dp"
              android:layout_marginTop="@dimen/size_8dp"
              android:text="@string/see_full_slabs_list"
              android:textColor="@color/dark_blue"
              android:textSize="@dimen/text_14sp"
              android:textStyle="bold"
              tools:visibility="gone"
              android:visibility="gone"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/rvPaymentSlabs"
              />
          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/paymentSlabsInfoDetails"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="@dimen/size_16dp"
              android:layout_marginEnd="@dimen/size_16dp"
              android:layout_marginStart="@dimen/size_16dp"
              android:lineSpacingExtra="@dimen/size_2dp"
              android:layout_marginTop="@dimen/size_8dp"
              android:text="@string/payment_slabs_details"
              android:textAlignment="viewStart"
              android:textColor="@color/background_dark_grey"
              android:textSize="@dimen/text_12sp"
              tools:visibility="gone"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/paymentSlabsMoreSlab"
              android:visibility="@{transaction.paymentSlabsVisibility()}"
              />
          <androidx.constraintlayout.widget.ConstraintLayout
              android:id="@+id/vehicleDetails"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_margin="@dimen/size_16dp"
              android:paddingTop="@dimen/size_16dp"
              android:visibility="gone"
              app:layout_constraintStart_toStartOf="@id/routeDetails"
              app:layout_constraintTop_toBottomOf="@id/view_margin_vehicle_payment"
              tools:visibility="visible"
              >
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/vehicleIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/size_8dp"
                app:layout_constraintBottom_toBottomOf="@id/bodyType"
                app:layout_constraintEnd_toStartOf="@id/vehicleType"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/vehicleType"
                app:srcCompat="@{transaction.vehicleCloseOpenDrawable()}"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/vehicleNumberIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/size_8dp"
                android:visibility="@{transaction.isLHIntraCityVehicleVisible()}"
                app:layout_constraintBottom_toBottomOf="@id/operateRoute"
                app:layout_constraintEnd_toStartOf="@id/vehicleNumber"
                app:layout_constraintTop_toTopOf="@id/vehicleNumber"
                app:srcCompat="@{transaction.vehicleCloseOpenOperatingPerMonthDrawable()}"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/operationalDaysIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/size_8dp"
                android:visibility="@{transaction.isLHIntraCityVehicleRouteVisible()}"
                app:layout_constraintBottom_toBottomOf="@id/operationalDaysText"
                app:layout_constraintEnd_toStartOf="@id/operatingDays"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/operatingDays"
                app:srcCompat="@{transaction.vehicleOperationDrawableKmPerMonth()}"
                tools:visibility="visible"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/operatingHrPerDayIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/size_8dp"
                android:visibility="@{transaction.isIntraCityContract()}"
                app:layout_constraintBottom_toBottomOf="@id/operatingHrPerDayText"
                app:layout_constraintEnd_toStartOf="@id/operatingHrPerDay"
                app:layout_constraintTop_toTopOf="@id/operatingHrPerDay"
                app:srcCompat="@{transaction.vehicleOperationDrawablePerHrs()}"
                tools:visibility="visible"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/vehicleDetailsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vehicle_requirement"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/vehicleType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:text="@{transaction.truckDetail()}"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_16sp"
                app:layout_constraintStart_toEndOf="@+id/vehicleIcon"
                app:layout_constraintTop_toBottomOf="@id/vehicleDetailsLabel"
                tools:text="32FTXL"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/bodyType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{transaction.setTruckTypeText()}"
                android:textColor="@color/color_hint"
                android:textSize="@dimen/text_12sp"
                app:layout_constraintStart_toStartOf="@id/vehicleType"
                app:layout_constraintTop_toBottomOf="@id/vehicleType"
                tools:text="closed"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/vehicleNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:text="@{transaction.totalVehicleCountOperationDays()}"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_16sp"
                android:visibility="@{transaction.isLHIntraCityVehicleVisible()}"
                app:layout_constraintStart_toStartOf="@id/operateRoute"
                app:layout_constraintTop_toBottomOf="@id/vehicleDetailsLabel"
                tools:text="20 vehicles"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/operateRoute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{transaction.vehicleOperatingDaysPerMonthLabel()}"
                android:textColor="@color/color_hint"
                android:textSize="@dimen/text_12sp"
                android:paddingEnd="@dimen/size_16dp"
                android:visibility="@{transaction.isLHIntraCityVehicleVisible()}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/vehicleNumber"
                tools:text="@string/tentative_total_vehicles"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/vehiclePerDepartureValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/size_2dp"
                android:layout_marginTop="@dimen/size_18dp"
                android:text="@{transaction.vehicleRouteCount()}"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_14sp"
                android:visibility="@{transaction.isLHVehicleVisible()}"
                app:layout_constraintEnd_toStartOf="@id/vehiclePerDeparture"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/bodyType"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/vehiclePerDeparture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_18dp"
                android:paddingStart="@dimen/size_2dp"
                android:paddingTop="@dimen/size_2dp"
                android:text="@string/tentative_total_vehicles_count"
                android:textColor="@color/color_hint"
                android:textSize="@dimen/text_12sp"
                android:visibility="@{transaction.isLHVehicleVisible()}"
                app:layout_constraintEnd_toStartOf="@id/dailyDepApproxValue"
                app:layout_constraintStart_toEndOf="@id/vehiclePerDepartureValue"
                app:layout_constraintTop_toBottomOf="@id/bodyType"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/dailyDepApproxValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/size_2dp"
                android:layout_marginTop="@dimen/size_18dp"
                android:paddingStart="@dimen/size_2dp"
                android:text="@{transaction.vehicleCCCount()}"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_14sp"
                android:visibility="@{transaction.isLHVehicleVisible()}"
                app:layout_constraintEnd_toStartOf="@id/dailyDepApprox"
                app:layout_constraintStart_toEndOf="@+id/vehiclePerDeparture"
                app:layout_constraintTop_toBottomOf="@id/operateRoute"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/dailyDepApprox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_2dp"
                android:layout_marginTop="@dimen/size_18dp"
                android:paddingStart="@dimen/size_2dp"
                android:paddingTop="@dimen/size_2dp"
                android:text="@{transaction.vehicleDepText()}"
                android:textColor="@color/color_hint"
                android:textSize="@dimen/text_12sp"
                android:visibility="@{transaction.isLHVehicleVisible()}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/dailyDepApproxValue"
                app:layout_constraintTop_toBottomOf="@id/operateRoute"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/operatingDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_18dp"
                android:text="@{transaction.vehicleOperatingDays()}"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_16sp"
                android:visibility="@{transaction.isLHIntraCityVehicleRouteVisible()}"
                app:layout_constraintStart_toEndOf="@+id/operationalDaysIcon"
                app:layout_constraintTop_toBottomOf="@id/vehiclePerDeparture"
                tools:text="4 days a week"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/operationalDaysText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{transaction.vehicleOperatingDaysLabel()}"
                android:textColor="@color/color_hint"
                android:textSize="@dimen/text_12sp"
                android:visibility="@{transaction.isLHIntraCityVehicleRouteVisible()}"
                app:layout_constraintStart_toEndOf="@+id/operationalDaysIcon"
                app:layout_constraintTop_toBottomOf="@id/operatingDays"
                tools:text="@string/operating_days"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/operatingHrPerDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_18dp"
                android:text="@{transaction.vehicleOperatingHrsPerDays()}"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_16sp"
                android:visibility="@{transaction.isIntraCityContract()}"
                app:layout_constraintStart_toStartOf="@+id/operatingHrPerDayText"
                app:layout_constraintTop_toBottomOf="@id/vehiclePerDeparture"
                tools:text="14h"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/operatingHrPerDayText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/per_day"
                android:textColor="@color/color_hint"
                android:paddingEnd="@dimen/size_16dp"
                android:textSize="@dimen/text_12sp"
                android:visibility="@{transaction.isIntraCityContract()}"
                app:layout_constraintStart_toStartOf="@+id/vehicleNumber"
                app:layout_constraintTop_toBottomOf="@id/operatingHrPerDay"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/permitRequirementIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/size_8dp"
                android:visibility="@{transaction.isIntraCityContract()}"
                app:layout_constraintBottom_toBottomOf="@id/permitRequirementLabel"
                app:layout_constraintEnd_toStartOf="@id/permitRequirementText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/permitRequirementText"
                app:srcCompat="@{transaction.nepDrawable()}"
                tools:visibility="visible"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/permitRequirementText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_18dp"
                android:text="@{transaction.vehiclePermitRequiredText()}"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_16sp"
                android:visibility="@{transaction.isIntraCityContract()}"
                app:layout_constraintStart_toEndOf="@+id/permitRequirementIcon"
                app:layout_constraintTop_toBottomOf="@id/operationalDaysText"
                tools:text="Not Required"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/permitRequirementLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_entry_permit_label"
                android:textColor="@color/color_hint"
                android:textSize="@dimen/text_12sp"
                android:visibility="@{transaction.isIntraCityContract()}"
                app:layout_constraintStart_toEndOf="@+id/permitRequirementIcon"
                app:layout_constraintTop_toBottomOf="@id/permitRequirementText"
                tools:text="No Entry Permit"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/vehicleUsageIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/size_8dp"
                android:visibility="@{transaction.isIntraCityFixedContract()}"
                app:layout_constraintBottom_toBottomOf="@id/VehicleUsageLabel"
                app:layout_constraintEnd_toStartOf="@id/vehicleUsageType"
                app:layout_constraintTop_toTopOf="@id/vehicleUsageType"
                app:srcCompat="@{transaction.vehicleUsageDrawable()}"
                tools:visibility="visible"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/vehicleUsageType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_18dp"
                android:text="@{transaction.contractUsage}"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_16sp"
                android:visibility="@{transaction.isIntraCityFixedContract()}"
                app:layout_constraintStart_toStartOf="@+id/operatingHrPerDayText"
                app:layout_constraintTop_toBottomOf="@id/operationalDaysText"
                tools:text="LM"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/VehicleUsageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/usage_label"
                android:textColor="@color/color_hint"
                android:paddingEnd="@dimen/size_16dp"
                android:textSize="@dimen/text_12sp"
                android:visibility="@{transaction.isIntraCityFixedContract()}"
                app:layout_constraintStart_toStartOf="@+id/vehicleNumber"
                app:layout_constraintTop_toBottomOf="@id/vehicleUsageType"
                />
          </androidx.constraintlayout.widget.ConstraintLayout>

          <androidx.constraintlayout.widget.ConstraintLayout
              android:id="@+id/tripDetails"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_margin="@dimen/size_16dp"
              android:visibility="gone"
              app:layout_constraintStart_toStartOf="@id/vehicleDetails"
              app:layout_constraintTop_toBottomOf="@id/seperator3"
              tools:visibility="visible"
              >
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/tripIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/size_8dp"
                app:layout_constraintBottom_toBottomOf="@id/tripTypeLabel"
                app:layout_constraintEnd_toStartOf="@id/tripType"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tripType"
                app:srcCompat="@{transaction.tripCloseOpenDrawable()}"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/connectionIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/size_8dp"
                android:visibility="@{transaction.isLHContinousContract()}"
                app:layout_constraintBottom_toBottomOf="@id/connectionTypeLabel"
                app:layout_constraintEnd_toStartOf="@id/connectionTypeLabel"
                app:layout_constraintTop_toTopOf="@id/connectionType"
                app:srcCompat="@{transaction.tripCloseOpenDrawable()}"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tripTypeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_type"
                android:textColor="@color/color_hint"
                android:textSize="@dimen/text_12sp"
                app:layout_constraintStart_toStartOf="@id/tripType"
                app:layout_constraintTop_toBottomOf="@id/tripType"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tripDetailsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trip_details"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/connectionType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:text="@string/continuous"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_16sp"
                android:visibility="@{transaction.isLHContinousContract()}"
                app:layout_constraintStart_toStartOf="@id/connectionTypeLabel"
                app:layout_constraintTop_toBottomOf="@id/tripDetailsLabel"
                tools:text="@string/continuous"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/connectionTypeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connection_type"
                android:textColor="@color/color_hint"
                android:textSize="@dimen/text_12sp"
                android:visibility="@{transaction.isLHContinousContract()}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/connectionType"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tripType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:text="@{transaction.tripWays()}"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_16sp"
                app:layout_constraintStart_toEndOf="@+id/tripIcon"
                app:layout_constraintTop_toBottomOf="@id/tripDetailsLabel"
                tools:text="@string/one_way"
                />

          </androidx.constraintlayout.widget.ConstraintLayout>

          <androidx.constraintlayout.widget.ConstraintLayout
              android:id="@+id/paymentInfo"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_margin="@dimen/size_16dp"
              android:visibility="@{transaction.isIntraCityContract()}"
              app:layout_constraintStart_toStartOf="@id/seperator4"
              app:layout_constraintTop_toBottomOf="@id/seperator4"
              tools:visibility="visible"
              >
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/extraKmIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/size_8dp"
                app:layout_constraintBottom_toBottomOf="@id/extraKmLabel"
                app:layout_constraintEnd_toStartOf="@id/extraKm"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/extraKm"
                app:srcCompat="@{transaction.vehicleRateDrawable()}"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/extraHourIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/size_8dp"
                app:layout_constraintBottom_toBottomOf="@id/extraHourTypeLabel"
                app:layout_constraintEnd_toStartOf="@id/extraHourTypeLabel"
                app:layout_constraintTop_toTopOf="@id/extraHourType"
                app:srcCompat="@{transaction.vehicleRateDrawable()}"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/extraDayIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/size_8dp"
                app:layout_constraintBottom_toBottomOf="@id/extraDayTypeLabel"
                app:layout_constraintEnd_toStartOf="@id/extraDayType"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/extraDayType"
                app:srcCompat="@{transaction.vehicleRateDrawable()}"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/paymentInfoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/payment_info"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/extraKm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:text="@{transaction.intracityExtraKmRate()}"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_16sp"
                app:layout_constraintStart_toEndOf="@+id/extraKmIcon"
                app:layout_constraintTop_toBottomOf="@id/paymentInfoLabel"
                tools:text="₹ 3000"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/extraKmLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/per_extra_km"
                android:textColor="@color/color_hint"
                android:textSize="@dimen/text_12sp"
                app:layout_constraintStart_toStartOf="@id/extraKm"
                app:layout_constraintTop_toBottomOf="@id/extraKm"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/extraHourType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:text="@{transaction.intracityExtraHourRate()}"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_16sp"
                app:layout_constraintStart_toStartOf="@id/extraHourTypeLabel"
                app:layout_constraintTop_toBottomOf="@id/paymentInfoLabel"
                tools:text="₹ 2000"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/extraHourTypeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/per_extra_hour"
                android:textColor="@color/color_hint"
                android:textSize="@dimen/text_12sp"
                android:paddingEnd="@dimen/size_16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/extraHourType"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/extraDayType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:text="@{transaction.intracityExtraDayRate()}"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_16sp"
                app:layout_constraintStart_toEndOf="@+id/extraDayIcon"
                app:layout_constraintTop_toBottomOf="@id/extraKmLabel"
                tools:text="₹ 4000"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/extraDayTypeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/per_extra_day"
                android:textColor="@color/color_hint"
                android:textSize="@dimen/text_12sp"
                app:layout_constraintStart_toStartOf="@id/extraDayType"
                app:layout_constraintTop_toBottomOf="@id/extraDayType"
                />

          </androidx.constraintlayout.widget.ConstraintLayout>

          <androidx.appcompat.widget.AppCompatImageView
              android:id="@+id/seperator5"
              android:layout_width="match_parent"
              android:layout_height="5dp"
              android:layout_margin="@dimen/size_16dp"
              android:visibility="@{transaction.isIntraCityContractWithRemarks()}"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/paymentInfo"
              app:srcCompat="@drawable/dotted"
              />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_16dp"
            android:visibility="@{transaction.isIntraCityContractWithRemarks()}"
            app:layout_constraintStart_toStartOf="@id/seperator5"
            app:layout_constraintTop_toBottomOf="@id/seperator5"
            tools:visibility="visible">

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/remarkLabel"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/remark_label"
              android:textColor="@color/background_dark_grey"
              android:textSize="@dimen/text_16sp"
              android:textStyle="bold"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/remarkDetails"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_8dp"
              android:text="@{transaction.contractRemarks}"
              android:textSize="@dimen/text_14sp"
              android:textColor="@color/heading_black"
              android:paddingEnd="@dimen/size_10dp"
              android:paddingStart="@dimen/size_8dp"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@id/remarkLabel"
              />
        </androidx.constraintlayout.widget.ConstraintLayout>

          <androidx.recyclerview.widget.RecyclerView
              android:id="@+id/rvPaymentSlabs"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginEnd="@dimen/size_16dp"
              android:layout_marginStart="@dimen/size_16dp"
              android:layout_marginTop="@dimen/size_8dp"
              tools:visibility="gone"
              tools:listitem="@layout/view_contracts_payment_slabs"
              app:layout_constraintTop_toBottomOf="@+id/paymentSlabsInfoLbl"
              android:visibility="@{transaction.paymentSlabsVisibility()}"
              />
          <!--<include
              layout="@layout/view_contracts_bid_results"
              android:id="@+id/contractResult"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/view_margin_result"
              />
          <include
              layout="@layout/view_contracts_rules"
              android:id="@+id/contractRulesWithResult"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/view_margin_rule"
              tools:visibility="gone"
              />-->
          <include
              layout="@layout/view_placements_contracts_route_details"
              android:id="@+id/routeDetails"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="@dimen/size_16dp"
              android:layout_marginLeft="@dimen/size_16dp"
              android:layout_marginRight="@dimen/size_16dp"
              android:layout_marginTop="@dimen/size_16dp"
              android:visibility="visible"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/view_margin_route"
              tools:visibility="visible"
              />
          <include
              layout="@layout/view_contracts_rules"
              android:id="@+id/contractRules"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              tools:visibility="visible"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/view_margin_without_result"
              />
        </androidx.constraintlayout.widget.ConstraintLayout>

      </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>