<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="trip"
        type="com.delhivery.axle.data.home.trips.HomeTripsItemData"
        />
    <import type="android.view.View" />
    <import type="com.delhivery.axle.data.home.trips.TripStatus" />
    <import type="androidx.core.content.ContextCompat" />
  </data>

  <androidx.cardview.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/size_8dp"
      android:layout_marginTop="@dimen/size_6dp"
      android:layout_marginEnd="@dimen/size_8dp"
      android:layout_marginBottom="@dimen/size_6dp"
      android:clickable="true"
      android:focusable="true"
      android:foreground="?attr/selectableItemBackgroundBorderless"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="@dimen/size_2dp"
      >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:paddingStart="@dimen/size_16dp"
        android:paddingTop="@dimen/size_6dp"
        android:paddingEnd="@dimen/size_16dp"
        android:paddingBottom="@dimen/size_6dp"
        >

      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/img_forward"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_6dp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:srcCompat="@drawable/ic_arrow_forward_black"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_source_city"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:fontFamily="sans-serif"
          android:text="@{trip.originCityName()}"
          android:textColor="@color/heading_black"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="@id/img_forward"
          tools:text="Panjim"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_source_state"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="@{trip.originDistrictState()}"
          android:textColor="@color/sub_heading_black"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_source_city"
          tools:text="Panjim, GOA"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_destination_city"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_24dp"
          android:ellipsize="end"
          android:fontFamily="sans-serif"
          android:text="@{trip.destinationCityName()}"
          android:textColor="@color/heading_black"
          app:layout_constraintStart_toEndOf="@id/img_forward"
          app:layout_constraintTop_toTopOf="@id/img_forward"
          tools:text="Andheri East"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_destination_state"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="@{trip.destinationDistrictState()}"
          android:textColor="@color/sub_heading_black"
          app:layout_constraintStart_toStartOf="@id/text_destination_city"
          app:layout_constraintTop_toBottomOf="@id/text_source_city"
          tools:text="Thane, Mumbai"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_truck_details"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_6dp"
          android:fontFamily="sans-serif-medium"
          android:lineSpacingExtra="@dimen/text_8sp"
          android:text="@{trip.vehicleDetails.vehicleNo}"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_16sp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/text_source_state"
          tools:text="HR26"
          />

      <androidx.appcompat.widget.AppCompatTextView

          android:id="@+id/text_multidrop"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Multidrop"
          android:layout_marginTop="@dimen/size_4dp"
          android:layout_marginBottom="@dimen/size_4dp"
          android:background="@drawable/bg_gradient_blue"
          android:paddingStart="@dimen/size_4dp"
          android:textAlignment="center"
          android:paddingEnd="@dimen/size_4dp"
          android:paddingTop="@dimen/size_4dp"
          android:paddingBottom="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:visibility="@{trip.setMutidrop()}"
          app:layout_constraintTop_toBottomOf="@+id/text_truck_details"
          app:layout_constraintLeft_toLeftOf="parent" />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_days_pending"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:lineSpacingExtra="@dimen/text_10sp"
          android:text="@{trip.timeDiff()}"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/text_truck_details"
          bind:textColor="@{ ContextCompat.getColor(context, trip.podTimeColor()) }"
          tools:text="12 days ageing"
          tools:textColor="@color/status_active"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_rejection_remark"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:gravity="end"
          android:text="@{trip.podRemarksOrPayment()}"
          android:textColor="@color/status_lost"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toEndOf="@+id/img_forward"
          app:layout_constraintTop_toTopOf="@+id/text_truck_details"
          tools:text="12 days ageing"
          />

      <LinearLayout
          android:id="@+id/container_lr"
          android:layout_marginTop="@dimen/size_8dp"
          app:layout_constraintTop_toBottomOf="@+id/text_days_pending"
          app:layout_constraintStart_toStartOf="parent"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_lr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@{trip.lr()}"
            android:layout_marginTop="@dimen/size_6dp"
            android:textColor="@color/sub_heading_black"
            tools:text="LR: 9823222123"
            />

      </LinearLayout>

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_loading"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_6dp"
          android:layout_marginEnd="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="@{trip.loadedAt()}"
          android:textColor="@color/sub_heading_black"
          app:layout_constraintEnd_toStartOf="@+id/text_unloading"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/container_lr"
          tools:text="Loading: 04-05-2019"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_unloading"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:gravity="end"
          android:text="@{trip.unloadedAt()}"
          android:textColor="@color/sub_heading_black"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toEndOf="@+id/text_loading"
          app:layout_constraintTop_toTopOf="@+id/text_loading"
          tools:text="Unloading: 04-05-2019"
          />

      <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/container_bid_action"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:orientation="horizontal"
          android:paddingTop="@dimen/size_8dp"
          android:paddingBottom="@dimen/size_8dp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/text_loading"
          tools:visibility="visible"
          >

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.45"
            />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/btn_epod"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/size_8dp"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            bind:drawableResId="@{ trip.podDrawable() }"
            bind:shadow="@{ @dimen/action_btn_elevation }"
            >

          <androidx.appcompat.widget.AppCompatTextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif-medium"
              android:gravity="center_horizontal"
              android:maxLines="1"
              android:text="@{trip.podAction().status}"
              android:textColor="@color/white"
              android:textSize="@dimen/text_14sp"
              />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/btn_courier"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/size_8dp"
            android:background="@drawable/bg_load_action_btn"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline"
            app:layout_constraintTop_toTopOf="parent"
            bind:shadow="@{ @dimen/action_btn_elevation }"
            >

          <androidx.appcompat.widget.AppCompatTextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif-medium"
              android:gravity="center_horizontal"
              android:text="@{trip.docketActionText()}"
              android:textColor="@color/white"
              />

        </androidx.appcompat.widget.LinearLayoutCompat>

      </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_selector"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="@{trip.selectable? View.VISIBLE: View.GONE}"
        tools:visibility="visible"
        >

      <androidx.appcompat.widget.AppCompatCheckBox
          android:id="@+id/check_box"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:buttonTint="@color/black"
          android:checked="@{trip.selected}"
          android:enabled="false"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          tools:ignore="UnusedAttribute"
          />

      <View
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@color/view_selected"
          android:visibility="@{trip.selected?View.VISIBLE: View.GONE}"
          tools:visibility="gone"
          />

    </androidx.constraintlayout.widget.ConstraintLayout>
  </androidx.cardview.widget.CardView>
</layout>
