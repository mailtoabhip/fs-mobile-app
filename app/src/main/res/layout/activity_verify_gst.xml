<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
<data>
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.kyc.gst.GstVerificationViewModel"
        />
    <import type="android.view.View" />

</data>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blue_bg"
        android:orientation="vertical">

        <include
            android:id="@+id/progress_step_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/view_progress_steps"
            android:layout_marginBottom="@dimen/size_24dp"/>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:layout_width="match_parent"
            android:layout_below="@+id/progress_step_layout"
            android:id="@+id/refresh_layout"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="@dimen/size_24dp"
                android:layout_below="@+id/toolbar"
                android:paddingEnd="@dimen/size_24dp"
                android:paddingBottom="@dimen/size_48dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/step_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="@dimen/text_6sp"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toTopOf="parent"
                    android:text="@{viewModel.currentStep}"
                    android:textColor="@color/sub_heading_black"
                    android:textSize="@dimen/text_12sp"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/gst_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/step_text"
                    android:layout_marginTop="@dimen/size_8dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="@dimen/text_6sp"
                    android:text="@string/label_gst"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_18sp"
                    android:textStyle="bold"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/gst_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_8dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="@dimen/text_6sp"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/gst_text"
                    android:text="@string/sub_label_gst_details"
                    android:textColor="@color/sub_heading_black"
                    android:textSize="@dimen/text_14sp"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/gst_error"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16dp"
                    android:fontFamily="sans-serif"
                    android:drawableLeft="@drawable/ic_vector_error"
                    android:drawablePadding="@dimen/size_8dp"
                    android:lineSpacingExtra="@dimen/text_6sp"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/gst_hint"
                    android:text="@{viewModel.errorText}"
                    android:textColor="@color/destructive_red"
                    android:textSize="@dimen/text_16sp"
                    />
                     <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:id="@+id/gstList"
                        android:paddingBottom="@dimen/size_72dp"
                         android:layout_marginTop="@dimen/size_32dp"
                         bind:layout_constraintTop_toBottomOf="@+id/gst_error"
                        bind:layout_constraintStart_toStartOf="parent"
                        bind:layout_constraintEnd_toEndOf="parent"
                        android:layout_height="wrap_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_verify_gst"
            style="@style/ActionButton"
            android:layout_marginBottom="@dimen/size_48dp"
            android:layout_marginEnd="@dimen/size_24dp"
            android:layout_marginStart="@dimen/size_24dp"
            android:textAllCaps="false"
            android:enabled="false"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/size_24dp"
            android:text="@string/action_verify_gst"
            />

    </RelativeLayout>
</layout>



