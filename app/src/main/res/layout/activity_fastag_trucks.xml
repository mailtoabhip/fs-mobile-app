<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.dfd.delfin.ui.fastag.trucks.FastagTrucksViewModel" />
    </data>

    <LinearLayout
        android:id="@+id/parentLl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_trucks_screen_with_gradient"
        android:orientation="vertical">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_toolbar"
            android:background="@android:color/white"
            app:titleTextAppearance="@style/Toolbar.TitleText"
            app:contentInsetStartWithNavigation="@dimen/size_8dp"
            app:navigationIcon="@drawable/ic_back_arrow"
            app:title="@string/label_fastag_title" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_1dp"/>
        <!-- Content -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/size_24dp">

                    <!-- Promotional Banner -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/bannerCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/size_16dp"
                        android:layout_marginTop="@dimen/size_16dp"
                        app:cardCornerRadius="@dimen/size_16dp"
                        app:cardElevation="0dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/buy_fastag_background_banner"
                            android:minHeight="120dp"
                            android:padding="@dimen/size_16dp">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tvBannerTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/size_8dp"
                                android:text="@string/fastag_banner_title"
                                android:textColor="@color/text_primary"
                                style="@style/TextAppearance.Delfin.M12"
                                app:layout_constraintEnd_toStartOf="@id/ivBannerImage"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/btnBuyFastag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/size_16dp"
                                android:background="@drawable/bg_all_round_corner_solid_black"
                                android:paddingHorizontal="@dimen/size_16dp"
                                android:paddingVertical="@dimen/size_8dp"
                                android:text="@string/fastag_buy_cta"
                                android:textColor="@android:color/white"
                                style="@style/TextAppearance.Delfin.M12"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tvBannerTitle" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivBannerImage"
                                android:layout_width="120dp"
                                android:layout_height="80dp"
                                android:contentDescription="@string/label_fastag_title"
                                android:scaleType="fitEnd"
                                android:src="@drawable/buy_fastag_truck"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- FASTag Pending Actions Shimmer -->
                    <com.dfd.delfin.ui.custom.DelhiveryShimmerLayout
                        android:id="@+id/fastagPendingShimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/size_16dp"
                        android:layout_marginTop="@dimen/size_24dp"
                        android:paddingBottom="@dimen/size_16dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_fastag_pending_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/size_16dp"
                            android:paddingVertical="@dimen/size_14dp">

                            <View
                                android:layout_width="@dimen/size_20dp"
                                android:layout_height="@dimen/size_20dp"
                                android:background="@color/colorShimmerPrimary" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="@dimen/size_14dp"
                                android:layout_marginStart="@dimen/size_10dp"
                                android:layout_weight="1"
                                android:background="@color/colorShimmerPrimary" />

                            <View
                                android:layout_width="@dimen/size_20dp"
                                android:layout_height="@dimen/size_20dp"
                                android:layout_marginStart="@dimen/size_10dp"
                                android:background="@color/colorShimmerSecondary" />

                        </LinearLayout>

                    </com.dfd.delfin.ui.custom.DelhiveryShimmerLayout>

                    <!-- FASTag Pending Actions Card -->
                    <LinearLayout
                        android:id="@+id/fastagPendingCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/size_16dp"
                        android:layout_marginTop="@dimen/size_24dp"
                        android:background="@drawable/bg_fastag_pending_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/size_16dp"
                        android:paddingVertical="@dimen/size_14dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/size_20dp"
                            android:layout_height="@dimen/size_20dp"
                            android:contentDescription="@string/label_fastag_title"
                            android:src="@drawable/fs_pending_clock" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvFastagPendingText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/size_10dp"
                            android:layout_weight="1"
                            android:textColor="@color/text_warning_primary"
                            style="@style/TextAppearance.Delfin.B16"
                            android:textSize="@dimen/text_14sp"
                            tools:text="FASTag pending actions (8)" />

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/size_20dp"
                            android:layout_height="@dimen/size_20dp"
                            android:contentDescription="@string/action_continue"
                            android:src="@drawable/ic_chevron_right_dark"
                            app:tint="#7B6414" />

                    </LinearLayout>

                    <!-- Your FASTags Section Title -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvSectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/size_16dp"
                        android:layout_marginTop="@dimen/size_24dp"
                        android:layout_marginBottom="@dimen/size_12dp"
                        android:text="@string/fastag_your_fastags"
                        android:textColor="@color/text_primary"
                        style="@style/TextAppearance.Delfin.B16"
                        android:textSize="@dimen/text_18sp"
                        android:visibility="gone"
                        tools:visibility="visible"/>

                    <!-- Loading Shimmer -->
                    <LinearLayout
                        android:id="@+id/shimmerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <include layout="@layout/shimmer_service_group_item" />
                        <include layout="@layout/shimmer_service_group_item" />
                        <include layout="@layout/shimmer_service_group_item" />
                    </LinearLayout>

                    <!-- FASTag Trucks RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvFastagTrucks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_fastag_truck"
                        android:visibility="gone"
                        tools:visibility="visible"/>

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/emptyState"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/size_24dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="@dimen/size_96dp"
                            android:layout_height="@dimen/size_96dp"
                            android:layout_marginBottom="@dimen/size_16dp"
                            android:src="@drawable/fastag_empty_box" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fastag_no_fastags_heading"
                            android:textAlignment="center"
                            android:textColor="@color/text_primary"
                            style="@style/TextAppearance.Delfin.B16"
                            android:textSize="@dimen/text_20sp" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_16dp"
                            android:text="@string/fastag_no_fastags_description"
                            android:textAlignment="center"
                            android:textColor="@color/text_body_primary"
                            style="@style/TextAppearance.Delfin.M12"
                            android:lineSpacingExtra="4dp" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/btnEmptyBuyFastag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_32dp"
                            android:background="@drawable/bg_all_round_corner_solid_black"
                            android:gravity="center"
                            android:paddingVertical="@dimen/size_16dp"
                            android:text="@string/fastag_buy_cta"
                            android:paddingHorizontal="@dimen/size_16dp"
                            android:textColor="@android:color/white"
                            style="@style/TextAppearance.Delfin.B16" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
</layout>
