<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
  <data>
    <variable
        name="title"
        type="String"
        />

    <variable
        name="message"
        type="String"
        />

    <variable
        name="icon"
        type="Integer"
        />
  </data>
  <androidx.appcompat.widget.LinearLayoutCompat
      android:id="@+id/container_text"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:orientation="vertical"
      android:padding="28dp"
      >

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@{icon}"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_horizontal"
        android:lineSpacingExtra="8sp"
        android:text="@{ title }"
        android:layout_marginTop="@dimen/size_16dp"
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_20sp"
        android:textStyle="normal"
        tools:text="Welcome to Axle!"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"
        android:gravity="center_horizontal"
        android:lineSpacingExtra="@dimen/text_6sp"
        android:text="@{ message }"
        android:textColor="@color/sub_heading_black"
        android:textStyle="normal"
        tools:text="Glad to see that you have taken the right step towards the digitising logistics. We ensure you the best possible loads across the country."
        />

  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>