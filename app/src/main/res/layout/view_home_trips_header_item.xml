<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools"
    >

  <data></data>

  <HorizontalScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:scrollbars="none"
      >

    <android.support.v7.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/size_4dp"
        android:paddingStart="@dimen/size_4dp"
        >

      <android.support.constraint.ConstraintLayout
          android:layout_width="wrap_content"
          android:layout_height="@dimen/size_56dp"
          android:layout_marginEnd="@dimen/size_4dp"
          android:layout_marginStart="@dimen/size_4dp"
          bind:shadow="@{ @dimen/action_btn_elevation }"
          style="@style/view_header_background"
          >

        <TextView
            android:id="@+id/text_advance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:minWidth="@dimen/size_80dp"
            android:text="@string/label_advance_pending"
            android:textColor="@color/white"
            android:textSize="@dimen/text_10sp"
            android:textStyle="normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            android:textSize="@dimen/text_14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/size_8dp"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:minWidth="@dimen/size_36dp"
            android:textColor="@color/white"
            android:textSize="@dimen/text_10sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/text_advance"
            />
      </android.support.constraint.ConstraintLayout>

      <android.support.constraint.ConstraintLayout
          android:layout_width="wrap_content"
          android:layout_height="@dimen/size_56dp"
          android:layout_marginEnd="@dimen/size_4dp"
          android:layout_marginStart="@dimen/size_4dp"
          bind:shadow="@{ @dimen/action_btn_elevation }"
          style="@style/view_header_background"
          >

        <TextView
            android:id="@+id/text_transit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:minWidth="@dimen/size_80dp"
            android:text="@string/label_in_transit"
            android:textColor="@color/white"
            android:textSize="@dimen/text_10sp"
            android:textStyle="normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            android:textSize="@dimen/text_14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"

            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/size_8dp"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_4dp"
            android:fontFamily="sans-serif-medium"
            android:minWidth="@dimen/size_36dp"
            android:textColor="@color/white"
            android:textSize="@dimen/text_10sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/text_transit"
            />
      </android.support.constraint.ConstraintLayout>

      <android.support.constraint.ConstraintLayout
          android:layout_width="wrap_content"
          android:layout_height="@dimen/size_56dp"
          android:layout_marginEnd="@dimen/size_4dp"
          android:layout_marginStart="@dimen/size_4dp"
          bind:shadow="@{ @dimen/action_btn_elevation }"
          style="@style/view_header_background"
          >

        <TextView
            android:id="@+id/text_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:minWidth="@dimen/size_80dp"
            android:text="@string/label_balance_pending"
            android:textColor="@color/white"
            android:textSize="@dimen/text_10sp"
            android:textStyle="normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            android:textSize="@dimen/text_14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"

            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/size_16dp"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_4dp"
            android:fontFamily="sans-serif-medium"
            android:minWidth="@dimen/size_36dp"
            android:textColor="@color/white"
            android:textSize="@dimen/text_10sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/text_balance"
            />
      </android.support.constraint.ConstraintLayout>

      <android.support.constraint.ConstraintLayout
          android:layout_width="wrap_content"
          android:layout_height="56dp"
          android:layout_marginEnd="@dimen/size_4dp"
          android:layout_marginStart="@dimen/size_4dp"
          bind:shadow="@{ @dimen/action_btn_elevation }"
          style="@style/view_header_background"
          >

        <TextView
            android:id="@+id/text_complete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:minWidth="@dimen/size_80dp"
            android:text="@string/label_active_bids"
            android:textColor="@color/white"
            android:textSize="@dimen/text_10sp"
            android:textStyle="normal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            android:textSize="@dimen/text_14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"

            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/size_16dp"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:minWidth="@dimen/size_36dp"
            android:textColor="@color/white"
            android:textSize="@dimen/text_10sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/text_complete"
            />
      </android.support.constraint.ConstraintLayout>


    </android.support.v7.widget.LinearLayoutCompat>
  </HorizontalScrollView>

</layout>