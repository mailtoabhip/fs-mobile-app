<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <androidx.appcompat.widget.AppCompatImageView
      android:id="@+id/intraCityAdHocHubIcon"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:srcCompat="@drawable/ic_hub_route"
      app:layout_constraintStart_toStartOf="parent"
      android:paddingEnd="@dimen/size_4dp"
      app:layout_constraintTop_toTopOf="@+id/intraCityAdHocTvHubCity"
      app:layout_constraintBottom_toBottomOf="@id/intraCityAdHocTvState"/>
  <androidx.appcompat.widget.AppCompatTextView
      android:id="@+id/intraCityAdHocTvHubCity"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:layout_constraintStart_toEndOf="@+id/intraCityAdHocHubIcon"
      app:layout_constraintTop_toTopOf="parent"
      android:textSize="@dimen/text_14sp"
      android:textColor="@color/heading_black"
      android:layout_marginTop="@dimen/size_10dp"
      tools:text="HUL Pvt. Ltd."/>
  <androidx.appcompat.widget.AppCompatTextView
      android:id="@+id/intraCityAdHocTvCity"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:layout_constraintStart_toStartOf="@id/intraCityAdHocTvHubCity"
      app:layout_constraintStart_toEndOf="@+id/intraCityAdHocHubIcon"
      app:layout_constraintTop_toBottomOf="@+id/intraCityAdHocTvHubCity"
      android:textSize="@dimen/text_12sp"
      android:textColor="@color/color_hint"
      tools:text="Hisag "/>
  <androidx.appcompat.widget.AppCompatTextView
      android:id="@+id/intraCityAdHocTvState"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:layout_constraintStart_toStartOf="@id/intraCityAdHocTvCity"
      app:layout_constraintStart_toEndOf="@+id/intraCityAdHocHubIcon"
      app:layout_constraintTop_toBottomOf="@+id/intraCityAdHocTvCity"
      android:textSize="@dimen/text_12sp"
      android:textColor="@color/heading_black"
      tools:text="Haryana"/>
  <androidx.appcompat.widget.AppCompatTextView
      android:id="@+id/intraCityAdHocTvMapView"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      app:layout_constraintStart_toStartOf="@id/intraCityAdHocTvCity"
      app:layout_constraintStart_toEndOf="@+id/intraCityAdHocHubIcon"
      app:layout_constraintTop_toBottomOf="@+id/intraCityAdHocTvState"
      android:textColor="@color/colorAccent"
      android:paddingTop="@dimen/size_2dp"
      android:paddingBottom="@dimen/size_2dp"
      android:paddingEnd="@dimen/size_8dp"
      android:textSize="@dimen/text_12sp"
      android:text="@string/view_on_map"
      tools:text="@string/view_on_map"/>

</androidx.constraintlayout.widget.ConstraintLayout>