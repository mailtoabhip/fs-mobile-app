<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >

  <data>

    <variable
        name="actionLabel"
        type="Boolean"
        />

  </data>

  <androidx.appcompat.widget.LinearLayoutCompat
      android:gravity="end"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_express_toggle"
        android:layout_marginBottom="@dimen/size_8dp"
        android:background="@drawable/bg_round_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

      <TextView
          android:id="@+id/toggle_express"
          android:textColor="@color/white"
          android:padding="@dimen/size_8dp"
          android:paddingStart="@dimen/size_8dp"
          android:fontFamily="sans-serif"
          android:textStyle="bold"
          android:gravity="center"
          android:layout_gravity="center"
          android:text="@string/express"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"/>


      <ImageView
          android:id="@+id/toggle_removed_mark"
          android:paddingTop="@dimen/size_8dp"
          android:paddingBottom="@dimen/size_8dp"
          android:paddingEnd="@dimen/size_8dp"
          app:srcCompat="@drawable/ic_cancel"
          android:tint="@color/white"
          android:layout_gravity="center"
          android:layout_width="@dimen/size_32dp"
          android:layout_height="@dimen/size_32dp"
          android:visibility="gone"
          tools:visibility="visible"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_vehicle_filter"
        android:layout_marginBottom="@dimen/size_8dp"
        android:background="@drawable/bg_round_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

    </androidx.appcompat.widget.LinearLayoutCompat>

  </androidx.appcompat.widget.LinearLayoutCompat>

</layout>