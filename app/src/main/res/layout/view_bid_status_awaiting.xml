<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="title"
            type="String"
            />

        <variable
            name="subTitle"
            type="String"
            />

        <variable
            name="actionLabel"
            type="String"
            />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_all_round_corner_light_orange_v2"
        android:padding="16dp"
        android:layout_margin="16dp"
        android:elevation="2dp">

        <!-- Icon and Title -->
        <LinearLayout
            android:id="@+id/ll_titlerow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_face_sad"
                android:layout_marginEnd="8dp"
                app:tint="@color/orange_v3"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="@{ title }"
                android:lineSpacingExtra="2sp"
                android:translationY="-0.9sp"
                android:gravity="top"
                android:textColor="@color/orange_v3"
                tools:text="Awaiting Result"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Description -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@{ subTitle }"
            android:textColor="@color/text_grey_v3"
            android:textSize="14sp"
            tools:text="We will notify you once the results are out"
            app:layout_constraintTop_toBottomOf="@id/ll_titlerow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2sp"
            android:translationY="-0.9sp"
            android:gravity="top" />

        <!-- Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_action"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_all_round_corner_solid_orange"
            android:text="@{ actionLabel }"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
            app:layout_constraintVertical_bias="1.0"
            tools:text="Explore New Bids" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>