<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >

  <data>
    <variable
        name="pickUpLocation"
        type="String"
        />
    <variable
        name="vehicleNumber"
        type="String"
        />
    <variable
        name="driverPhone"
        type="String"
        />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/size_4dp"
      android:background="@color/colorAccent"
      android:paddingBottom="@dimen/size_24dp"
      android:paddingStart="@dimen/size_24dp"
      android:paddingTop="@dimen/size_24dp"
      bind:shadow="@{ @dimen/size_2dp }"
      >

    <TextView
        android:id="@+id/text_pickup_location_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="@string/label_pickup_location"
        android:textColor="@color/white"
        android:textSize="@dimen/text_12sp"
        android:textStyle="normal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <TextView
        android:id="@+id/text_pickup_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_4dp"
        android:fontFamily="sans-serif"
        android:paddingEnd="@dimen/size_24dp"
        android:text="@{pickUpLocation}"
        android:textColor="@color/white"
        android:textSize="@dimen/text_14sp"
        android:textStyle="normal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_pickup_location_label"
        tools:text="Shop No 33-35, Kamat Arcade, Santa Inez, Panaji, Goa 403001"
        />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/id1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_awaiting_truck"
        />

    <TextView
        android:id="@+id/text_truck_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_32dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        android:lineSpacingExtra="-2sp"
        android:text="@string/label_truck_details"
        android:textColor="@color/white"
        android:textSize="@dimen/text_20sp"
        android:textStyle="normal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_pickup_location"
        />

    <TextView
        android:id="@+id/label_vehicle_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8dp"
        android:fontFamily="sans-serif"
        android:text="@string/label_vehicle_number"
        android:textColor="@color/white"
        android:textSize="@dimen/text_14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_truck_details"
        />

    <TextView
        android:id="@+id/text_vehicle_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif"
        android:text="@{vehicleNumber}"
        android:textColor="@color/white"
        android:textSize="@dimen/text_14sp"
        android:textStyle="normal"
        app:layout_constraintStart_toEndOf="@+id/label_driver_number"
        app:layout_constraintTop_toTopOf="@+id/label_vehicle_number"
        tools:text="HD56 AWM"
        />

    <TextView
        android:id="@+id/label_driver_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8dp"
        android:fontFamily="sans-serif"
        android:text="@string/label_driver_phone_no"
        android:textColor="@color/white"
        android:textSize="@dimen/text_14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_vehicle_number"
        app:layout_goneMarginTop="@dimen/size_16dp"
        />

    <TextView
        android:id="@+id/text_driver_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="@{driverPhone}"
        android:textColor="@color/white"
        android:textSize="@dimen/text_14sp"
        android:textStyle="normal"
        app:layout_constraintStart_toStartOf="@+id/text_vehicle_number"
        app:layout_constraintTop_toTopOf="@id/label_driver_number"
        tools:text="9090909090"
        />

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>