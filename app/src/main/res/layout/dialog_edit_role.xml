<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:id="@+id/scView"
            android:layout_marginBottom="@dimen/size_72dp"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/size_48dp"
                android:paddingStart="@dimen/size_24dp"
                android:paddingEnd="@dimen/size_24dp">



                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:id="@+id/role_layout">



                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:id="@+id/shipper_section"
                        android:layout_below="@+id/label_select_role"
                        android:layout_height="wrap_content">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/bg_all_round_corner_blue_selector"
                            android:id="@+id/shipper_layout"
                            android:layout_marginTop="@dimen/size_16dp"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_shipper"
                                android:id="@+id/labelShipper"
                                android:layout_alignParentStart="true"
                                android:layout_marginTop="@dimen/size_14dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_toStartOf="@+id/cardShipp"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_14sp"
                                android:textStyle="bold"
                                />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:layout_toStartOf="@+id/cardShipp"
                                android:layout_marginTop="@dimen/size_4dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_below="@+id/labelShipper"
                                android:layout_alignParentStart="true"
                                android:text="@string/label_shipper_select"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_12sp"
                                />
                            <View
                                android:id="@+id/centerShim"
                                android:layout_height="match_parent"
                                android:layout_width="0dp"
                                android:visibility="invisible"
                                android:layout_centerHorizontal="true"/>
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                android:id="@+id/cardShipp"
                                android:layout_marginEnd="@dimen/size_1dp"
                                android:layout_marginBottom="@dimen/size_1dp"
                                android:layout_marginTop="@dimen/size_1dp"
                                android:layout_alignParentEnd="true"
                                bind:cardCornerRadius="@dimen/size_8dp"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:src="@drawable/shipper"
                                    android:background="@drawable/round_image"
                                    android:layout_height="wrap_content"/>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>



                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/bg_all_round_corner_blue_selector"
                            android:id="@+id/owner_layout4"
                            android:layout_below="@+id/shipper_layout"
                            android:layout_marginTop="@dimen/size_16dp"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_owner"
                                android:id="@+id/labelOwner4"
                                android:layout_marginTop="@dimen/size_14dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_toStartOf="@+id/imgOwner4"
                                android:layout_alignParentStart="true"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_14sp"
                                android:textStyle="bold"
                                />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:gravity="start"
                                android:layout_toStartOf="@+id/imgOwner4"
                                android:layout_alignParentStart="true"
                                android:layout_marginTop="@dimen/size_4dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_below="@+id/labelOwner4"
                                android:text="@string/label_owner_select"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_12sp"
                                />
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                bind:cardCornerRadius="@dimen/size_8dp"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="@dimen/size_1dp"
                                android:layout_marginBottom="@dimen/size_1dp"
                                android:layout_marginTop="@dimen/size_1dp"
                                android:id="@+id/imgOwner4"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:src="@drawable/fleet_owner"
                                    android:background="@drawable/bg_all_round_corner_white_right"
                                    android:layout_height="wrap_content"/>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>




                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/bg_all_round_corner_blue_selector"
                            android:id="@+id/transporter_layout"
                            android:layout_marginTop="@dimen/size_16dp"
                            android:layout_below="@+id/owner_layout4"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_transporter"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@+id/imgTransporter"
                                android:id="@+id/labelTransporter"
                                android:layout_marginTop="@dimen/size_14dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_14sp"
                                android:textStyle="bold"
                                />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_transporter_select"
                                android:layout_alignParentStart="true"
                                android:layout_marginTop="@dimen/size_4dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_below="@+id/labelTransporter"
                                android:layout_toStartOf="@+id/imgTransporter"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_12sp"
                                />
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                bind:cardCornerRadius="@dimen/size_8dp"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/imgTransporter"
                                android:layout_marginEnd="@dimen/size_1dp"
                                android:layout_marginBottom="@dimen/size_1dp"
                                android:layout_marginTop="@dimen/size_1dp"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:src="@drawable/transporter"
                                    android:background="@drawable/bg_all_round_corner_white_right"
                                    android:layout_height="wrap_content"/>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/bg_all_round_corner_blue_selector"
                            android:id="@+id/broker_layout"
                            android:layout_marginTop="@dimen/size_16dp"
                            android:layout_below="@+id/transporter_layout"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_broker"
                                android:id="@+id/labelBroker"
                                android:layout_marginTop="@dimen/size_14dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:textColor="@color/heading_black"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@+id/imgBroker"
                                android:textSize="@dimen/text_14sp"
                                android:textStyle="bold"
                                />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@+id/imgBroker"
                                android:layout_marginTop="@dimen/size_4dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_below="@+id/labelBroker"
                                android:text="@string/label_broker_select"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_12sp"
                                />

                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                bind:cardCornerRadius="@dimen/size_8dp"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/imgBroker"
                                android:layout_marginEnd="@dimen/size_1dp"
                                android:layout_marginBottom="@dimen/size_1dp"
                                android:layout_marginTop="@dimen/size_1dp"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:src="@drawable/broker"
                                    android:background="@drawable/bg_all_round_corner_white_right"
                                    android:layout_height="wrap_content"/>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:id="@+id/transporter_section"
                        android:visibility="gone"
                        android:layout_below="@+id/label_select_role"
                        android:layout_height="wrap_content">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/bg_all_round_corner_blue_selector"
                            android:id="@+id/broker_layout2"
                            android:layout_marginTop="@dimen/size_16dp"
                            android:layout_below="@+id/transporter_layout2"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_broker"
                                android:id="@+id/labelBroker2"
                                android:layout_marginTop="@dimen/size_14dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@+id/imgBroker2"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_14sp"
                                android:textStyle="bold"
                                />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@+id/imgBroker2"
                                android:layout_marginTop="@dimen/size_4dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_below="@+id/labelBroker2"
                                android:text="@string/label_broker_select"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_12sp"
                                />
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                android:layout_marginEnd="@dimen/size_1dp"
                                android:layout_marginBottom="@dimen/size_1dp"
                                android:layout_marginTop="@dimen/size_1dp"
                                bind:cardCornerRadius="@dimen/size_8dp"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/imgBroker2"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:src="@drawable/broker"
                                    android:background="@drawable/bg_all_round_corner_white_right"
                                    android:layout_height="wrap_content"/>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/bg_all_round_corner_blue_selector"
                            android:id="@+id/owner_layout2"

                            android:layout_marginTop="@dimen/size_16dp"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_owner"
                                android:id="@+id/labelOwner2"
                                android:layout_marginTop="@dimen/size_14dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_toStartOf="@+id/imgOwner2"
                                android:layout_alignParentStart="true"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_14sp"
                                android:textStyle="bold"
                                />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:gravity="start"
                                android:layout_toStartOf="@+id/imgOwner2"
                                android:layout_alignParentStart="true"
                                android:layout_marginTop="@dimen/size_4dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_below="@+id/labelOwner2"
                                android:text="@string/label_owner_select"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_12sp"
                                />
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                bind:cardCornerRadius="@dimen/size_8dp"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="@dimen/size_1dp"
                                android:layout_marginBottom="@dimen/size_1dp"
                                android:layout_marginTop="@dimen/size_1dp"
                                android:id="@+id/imgOwner2"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:src="@drawable/fleet_owner"
                                    android:background="@drawable/bg_all_round_corner_white_right"
                                    android:layout_height="wrap_content"/>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/bg_all_round_corner_blue_selector"
                            android:id="@+id/transporter_layout2"
                            android:layout_marginTop="@dimen/size_16dp"
                            android:layout_below="@+id/owner_layout2"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_transporter"
                                android:id="@+id/labelTransporter2"
                                android:layout_marginTop="@dimen/size_14dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_toStartOf="@+id/imgTransporter2"
                                android:layout_alignParentStart="true"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_14sp"
                                android:textStyle="bold"
                                />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_transporter_select"
                                android:layout_alignParentStart="true"
                                android:layout_marginTop="@dimen/size_4dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_below="@+id/labelTransporter2"
                                android:layout_toStartOf="@+id/imgTransporter2"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_12sp"
                                />
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                bind:cardCornerRadius="@dimen/size_8dp"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/imgTransporter2"
                                android:layout_marginEnd="@dimen/size_1dp"
                                android:layout_marginBottom="@dimen/size_1dp"
                                android:layout_marginTop="@dimen/size_1dp"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:src="@drawable/transporter"
                                    android:background="@drawable/bg_all_round_corner_white_right"
                                    android:layout_height="wrap_content"/>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                    </RelativeLayout>
                </RelativeLayout>


            </RelativeLayout>
        </ScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_proceed"
            style="@style/ActionButton"
            android:textAllCaps="false"
            android:enabled="false"
            android:layout_marginStart="@dimen/size_24dp"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_marginBottom="@dimen/size_48dp"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_24dp"
            android:text="@string/action_save_changes"
            />

    </RelativeLayout>

</layout>