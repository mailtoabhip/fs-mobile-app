                                android:layout_width="wrap_content"
                                bind:cardCornerRadius="@dimen/size_8dp"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="@dimen/size_1dp"
                                android:layout_marginBottom="@dimen/size_1dp"
                                android:layout_marginTop="@dimen/size_1dp"
                                android:id="@+id/imgOwner2"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:src="@drawable/fleet_owner"
                                    android:background="@drawable/bg_all_round_corner_white_right"
                                    android:layout_height="wrap_content"/>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/bg_all_round_corner_blue_selector_grey"
                            android:id="@+id/transporter_layout2"
                            android:layout_marginTop="@dimen/size_16dp"
                            android:layout_below="@+id/owner_layout2"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_transporter"
                                android:id="@+id/labelTransporter2"
                                android:layout_marginTop="@dimen/size_14dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_toStartOf="@+id/imgTransporter2"
                                android:layout_alignParentStart="true"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_14sp"
                                android:textStyle="bold"
                                />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_transporter_select"
                                android:layout_alignParentStart="true"
                                android:layout_marginTop="@dimen/size_4dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_below="@+id/labelTransporter2"
                                android:layout_toStartOf="@+id/imgTransporter2"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_12sp"
                                />
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                bind:cardCornerRadius="@dimen/size_8dp"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/imgTransporter2"
                                android:layout_marginEnd="@dimen/size_1dp"
                                android:layout_marginBottom="@dimen/size_1dp"
                                android:layout_marginTop="@dimen/size_1dp"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:src="@drawable/transporter"
                                    android:background="@drawable/bg_all_round_corner_white_right"
                                    android:layout_height="wrap_content"/>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:id="@+id/both_section"
                        android:visibility="gone"
                        android:layout_height="wrap_content">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/bg_all_round_corner_blue_selector_grey"
                            android:id="@+id/shipper_layout3"
                            android:layout_marginTop="@dimen/size_16dp"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_shipper"
                                android:id="@+id/labelShipper3"
                                android:layout_marginTop="@dimen/size_14dp"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@+id/imgShipper3"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_14sp"
                                android:textStyle="bold"
                                />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:layout_toStartOf="@+id/imgShipper3"
                                android:layout_marginTop="@dimen/size_4dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_below="@+id/labelShipper3"
                                android:layout_alignParentStart="true"
                                android:text="@string/label_shipper_select"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_12sp"
                                />
                            <View
                                android:id="@+id/centerShim3"
                                android:layout_height="match_parent"
                                android:layout_width="0dp"
                                android:visibility="invisible"
                                android:layout_centerHorizontal="true"/>
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                bind:cardCornerRadius="@dimen/size_8dp"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/imgShipper3"
                                android:layout_marginEnd="@dimen/size_1dp"
                                android:layout_marginBottom="@dimen/size_1dp"
                                android:layout_marginTop="@dimen/size_1dp"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:src="@drawable/shipper"
                                    android:background="@drawable/bg_all_round_corner_white_right"
                                    android:layout_height="wrap_content"/>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/bg_all_round_corner_blue_selector_grey"
                            android:id="@+id/broker_layout3"
                            android:layout_marginTop="@dimen/size_16dp"
                            android:layout_below="@+id/shipper_layout3"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_broker"
                                android:id="@+id/labelBroker3"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@+id/imgBroker3"
                                android:layout_marginTop="@dimen/size_14dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_14sp"
                                android:textStyle="bold"
                                />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@+id/imgBroker3"
                                android:layout_marginTop="@dimen/size_4dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_below="@+id/labelBroker3"
                                android:text="@string/label_broker_select"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_12sp"
                                />
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                bind:cardCornerRadius="@dimen/size_8dp"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/imgBroker3"
                                android:layout_marginEnd="@dimen/size_1dp"
                                android:layout_marginBottom="@dimen/size_1dp"
                                android:layout_marginTop="@dimen/size_1dp"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:src="@drawable/broker"
                                    android:background="@drawable/bg_all_round_corner_white_right"
                                    android:layout_height="wrap_content"/>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/bg_all_round_corner_blue_selector_grey"
                            android:id="@+id/owner_layout3"
                            android:layout_marginTop="@dimen/size_16dp"
