<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools">
    <RelativeLayout
        android:layout_width="match_parent"
        android:background="@drawable/bg_all_round_corner_white"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:id="@+id/label_select_role"
            bind:layout_constraintStart_toStartOf="parent"
            bind:layout_constraintTop_toTopOf="parent"
            android:layout_alignParentStart="true"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/size_12dp"
                app:layout_constraintStart_toEndOf="@+id/close_btn"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_12dp"
                android:textColor="@color/heading_black"
                android:layout_gravity="center"
                android:textSize="@dimen/text_16sp"
                android:id="@+id/label_gst"
                android:layout_marginStart="@dimen/size_12dp"
                android:layout_toEndOf="@+id/close_btn"
                android:text="@string/label_edit_occupation"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close_btn"
                android:layout_marginTop="@dimen/size_16dp"
                android:layout_marginEnd="@dimen/size_10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="@dimen/size_24dp"
                android:layout_alignParentStart="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_close_black"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_4dp"
                android:id="@+id/sepLine"
                android:layout_marginTop="@dimen/size_12dp"
                android:layout_marginBottom="@dimen/size_20dp"
                app:layout_constraintTop_toBottomOf="@+id/label_gst"
                app:srcCompat="@drawable/seperator_line"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <ScrollView
            android:layout_width="match_parent"
            android:id="@+id/scView"
            android:layout_below="@+id/label_select_role"
            android:layout_marginBottom="@dimen/size_72dp"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/size_48dp"
                android:paddingStart="@dimen/size_24dp"
                android:paddingEnd="@dimen/size_24dp">


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:id="@+id/role_layout">



                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:id="@+id/shipper_section"
                        android:layout_height="wrap_content">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/bg_all_round_corner_blue_selector_grey"
                            android:id="@+id/shipper_layout"
                            android:layout_marginTop="@dimen/size_16dp"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_shipper"
                                android:id="@+id/labelShipper"
                                android:layout_alignParentStart="true"
                                android:layout_marginTop="@dimen/size_14dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_toStartOf="@+id/cardShipp"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_14sp"
                                android:textStyle="bold"
                                />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:layout_toStartOf="@+id/cardShipp"
                                android:layout_marginTop="@dimen/size_4dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_below="@+id/labelShipper"
                                android:layout_alignParentStart="true"
                                android:text="@string/label_shipper_select"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_12sp"
                                />
                            <View
                                android:id="@+id/centerShim"
                                android:layout_height="match_parent"
                                android:layout_width="0dp"
                                android:visibility="invisible"
                                android:layout_centerHorizontal="true"/>
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                android:id="@+id/cardShipp"
                                android:layout_marginEnd="@dimen/size_1dp"
                                android:layout_marginBottom="@dimen/size_1dp"
                                android:layout_marginTop="@dimen/size_1dp"
                                android:layout_alignParentEnd="true"
                                bind:cardCornerRadius="@dimen/size_8dp"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:src="@drawable/shipper"
                                    android:background="@drawable/round_image"
                                    android:layout_height="wrap_content"/>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/bg_all_round_corner_blue_selector_grey"
                            android:id="@+id/transporter_layout"
                            android:layout_marginTop="@dimen/size_16dp"
                            android:layout_below="@+id/shipper_layout"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_transporter"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@+id/imgTransporter"
                                android:id="@+id/labelTransporter"
                                android:layout_marginTop="@dimen/size_14dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_14sp"
                                android:textStyle="bold"
                                />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_transporter_select"
                                android:layout_alignParentStart="true"
                                android:layout_marginTop="@dimen/size_4dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_below="@+id/labelTransporter"
                                android:layout_toStartOf="@+id/imgTransporter"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_12sp"
                                />
                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                bind:cardCornerRadius="@dimen/size_8dp"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/imgTransporter"
                                android:layout_marginEnd="@dimen/size_1dp"
                                android:layout_marginBottom="@dimen/size_1dp"
                                android:layout_marginTop="@dimen/size_1dp"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:src="@drawable/transporter"
                                    android:background="@drawable/bg_all_round_corner_white_right"
                                    android:layout_height="wrap_content"/>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:background="@drawable/bg_all_round_corner_blue_selector_grey"
                            android:id="@+id/broker_layout"
                            android:layout_marginTop="@dimen/size_16dp"
                            android:layout_below="@+id/transporter_layout"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_broker"
                                android:id="@+id/labelBroker"
                                android:layout_marginTop="@dimen/size_14dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:textColor="@color/heading_black"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@+id/imgBroker"
                                android:textSize="@dimen/text_14sp"
                                android:textStyle="bold"
                                />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@+id/imgBroker"
                                android:layout_marginTop="@dimen/size_4dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_below="@+id/labelBroker"
                                android:text="@string/label_broker_select"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_12sp"
                                />

                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                bind:cardCornerRadius="@dimen/size_8dp"
                                android:layout_alignParentEnd="true"
                                android:id="@+id/imgBroker"
                                android:layout_marginEnd="@dimen/size_1dp"
                                android:layout_marginBottom="@dimen/size_1dp"
                                android:layout_marginTop="@dimen/size_1dp"
                                android:layout_height="wrap_content">
                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="wrap_content"
                                    android:src="@drawable/broker"
                                    android:background="@drawable/bg_all_round_corner_white_right"
                                    android:layout_height="wrap_content"/>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>

                    </RelativeLayout>

                    <RelativeLayout
