                            android:background="@drawable/bg_all_round_corner_blue_selector_grey"
                            android:id="@+id/owner_layout2"

                            android:layout_marginTop="@dimen/size_16dp"
                            android:layout_height="wrap_content">
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="@string/label_owner"
                                android:id="@+id/labelOwner2"
                                android:layout_marginTop="@dimen/size_14dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_toStartOf="@+id/imgOwner2"
                                android:layout_alignParentStart="true"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_14sp"
                                android:textStyle="bold"
                                />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:gravity="start"
                                android:layout_toStartOf="@+id/imgOwner2"
                                android:layout_alignParentStart="true"
                                android:layout_marginTop="@dimen/size_4dp"
                                android:layout_marginStart="@dimen/size_14dp"
                                android:layout_marginEnd="@dimen/size_14dp"
                                android:layout_below="@+id/labelOwner2"
                                android:text="@string/label_owner_select"
                                android:textColor="@color/heading_black"
                                android:textSize="@dimen/text_12sp"
                                />
