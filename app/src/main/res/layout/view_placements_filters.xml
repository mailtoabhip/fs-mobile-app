<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:bind="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="request"
            type="com.delhivery.axle.data.home.placements.HomePlacementsFilterItemData"
            />

        <import type="android.view.View" />
    </data>

<androidx.constraintlayout.widget.ConstraintLayout
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_all_round_corner_summary_grey_boundary"
    android:paddingTop="@dimen/size_16dp"
    android:paddingBottom="@dimen/size_16dp"
    android:paddingStart="@dimen/size_4dp"
    android:paddingEnd="@dimen/size_4dp">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/summaryText"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_12sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/background_dark_grey"
            android:textStyle="bold"
            android:text="Summary"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/timePeriod"
            app:layout_constraintTop_toBottomOf="@+id/summaryText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_12sp"
            android:textColor="@color/color_hint"
            android:fontFamily="sans-serif"
            android:text="Upcoming 18 hrs"/>
        <View
            android:id="@+id/divider"
            android:background="@color/light_grey"
            app:layout_constraintTop_toBottomOf="@+id/timePeriod"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/size_16dp"
            android:layout_height="1dp"/>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llDelay"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/size_16dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_percent="0.32"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:layout_constraintStart_toStartOf="parent"
        android:padding="@dimen/size_8dp"
        android:elevation="@dimen/size_4dp"
        bind:shadow="@{ @dimen/size_4dp }"
        android:orientation="vertical"
        android:background="@drawable/bg_all_round_corner_red_boundary">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/delayCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_14sp"
            android:textColor="@color/faded_black"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:text="@{request.delayedCount}"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/delay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_12sp"
            android:textColor="@color/faded_black"
            android:fontFamily="sans-serif"
            android:text="Delayed"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:id="@+id/div1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/llDelay"
        app:layout_constraintEnd_toStartOf="@+id/llMissing"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.015"
        android:layout_height="@dimen/size_8dp"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llMissing"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="@dimen/size_8dp"
        android:elevation="@dimen/size_4dp"
        android:layout_marginTop="@dimen/size_16dp"

        bind:shadow="@{ @dimen/size_4dp }"
        app:layout_constraintWidth_percent="0.32"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:layout_constraintStart_toEndOf="@+id/div1"
        android:background="@drawable/bg_all_round_corner_red_boundary"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/missingCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_14sp"
            android:textColor="@color/faded_black"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:text="@{request.missingDetailsCount}"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/missing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_12sp"
            android:textColor="@color/faded_black"
            android:fontFamily="sans-serif"
            android:text="Details missing"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:id="@+id/div2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/llMissing"
        app:layout_constraintEnd_toStartOf="@+id/llExpected"
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.015"
        android:layout_height="@dimen/size_8dp"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llExpected"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="@dimen/size_8dp"
        android:elevation="@dimen/size_4dp"
        android:layout_marginTop="@dimen/size_16dp"
        bind:shadow="@{ @dimen/size_4dp }"
        app:layout_constraintWidth_percent="0.32"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        app:layout_constraintStart_toEndOf="@+id/div2"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@drawable/bg_all_round_corner_red_boundary"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/expCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_14sp"
            android:textColor="@color/faded_black"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:text="@{request.expectedCount}"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/exp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_12sp"
            android:textColor="@color/faded_black"
            android:fontFamily="sans-serif"
            android:text="Expected"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>