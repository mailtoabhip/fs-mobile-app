<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

  <androidx.cardview.widget.CardView
      android:id="@+id/add_more_route"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/size_4dp"
      android:layout_marginEnd="@dimen/size_12dp"
      android:layout_marginStart="@dimen/size_12dp"
      android:layout_marginTop="@dimen/size_4dp"
      android:clickable="true"
      android:focusable="true"
      app:cardBackgroundColor="@color/colorPrimary"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="@dimen/size_8dp"
      >
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingBottom="@dimen/size_20dp"
        android:paddingEnd="@dimen/size_16dp"
        android:paddingStart="@dimen/size_16dp"
        android:paddingTop="@dimen/size_20dp"
        >

      <androidx.appcompat.widget.AppCompatImageView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:srcCompat="@drawable/ic_add_black_24dp"
          />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_18dp"
          android:fontFamily="sans-serif-medium"
          android:text="@string/action_add_more_route"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_16sp"
          android:textStyle="normal"
          />

    </androidx.appcompat.widget.LinearLayoutCompat>
  </androidx.cardview.widget.CardView>
</layout>