<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <data>
        <variable
            name="request"
            type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData"
            />
    </data>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/size_16dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/size_8dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_intercity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/size_8dp"
            app:cardCornerRadius="@dimen/size_8dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingStart="@dimen/size_16dp"
                android:paddingEnd="@dimen/size_16dp"
                android:elevation="4dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/closingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:drawablePadding="@dimen/size_4dp"
                    tools:text ="Closes in 2 hrs 15 min"
                    android:textColor="#ED4136"
                    android:paddingTop="@dimen/size_4dp"
                    android:text="@{request.formattedBiddingEndTime()}"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/cl_from_to_city" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_from_to_city"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_18dp"
                    app:layout_constraintTop_toBottomOf="@id/closingTime"
                    app:layout_constraintStart_toStartOf="parent">

                    <!-- 1. FromCity - Sticks to left side -->
                    <TextView
                        android:id="@+id/fromCity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_14sp"
                        android:text="@{request.originCityState()}"
                        tools:text ="Navi Mumbai"
                        android:textColor="#121A31"
                        android:maxWidth="150dp"
                        android:maxLines="2"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- 2. Arrow - Sticks to fromCity with 4dp gap -->
                    <TextView
                        android:id="@+id/fromCity_toCity_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_14sp"
                        android:layout_marginStart="@dimen/size_4dp"
                        android:text="➔"
                        tools:text ="➔"
                        android:textColor="#121A31"
                        android:gravity="center"
                        app:layout_constraintStart_toEndOf="@id/fromCity"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/toCity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_14sp"
                        android:text="@{request.destinationCityState()}"
                        tools:text ="Jaisalmer"
                        android:textColor="#121A31"
                        android:maxLines="2"
                        android:layout_marginStart="@dimen/size_4dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/fromCity_toCity_arrow" />

                    <TextView
                        android:id="@+id/stops"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_12sp"
                        tools:text="3 stops"
                        android:text="@{request.getIntermediateStops()}"
                        android:layout_marginStart="@dimen/size_4dp"
                        android:paddingTop="@dimen/size_2dp"
                        android:gravity="center"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/toCity" />

                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/truckInfo"
                    android:layout_width="wrap_content"
                    android:paddingTop="@dimen/size_4dp"
                    android:paddingEnd="@dimen/size_11dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:layout_marginTop="@dimen/size_12dp"
                    android:drawablePadding="@dimen/size_4dp"
                    android:text="@{request.getTruckTypeAndNo()}"
                    tools:text ="Open 32FTXXL18 MT"
                    android:textColor="#505361"
                    android:drawableStart="@drawable/ic_truck_small"
                    app:layout_constraintTop_toBottomOf="@id/cl_from_to_city"
                    app:layout_constraintStart_toStartOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/paymentType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:drawablePadding="@dimen/size_4dp"
                    tools:text ="Advance Payment"
                    android:textColor="#505361"
                    android:layout_marginStart="@dimen/size_8dp"
                    android:paddingTop="@dimen/size_4dp"
                    android:drawableStart="@drawable/money_bill_wave"
                    app:layout_constraintStart_toEndOf="@id/truckInfo"
                    app:layout_constraintTop_toTopOf="@id/truckInfo"
                    app:layout_constraintBottom_toBottomOf="@id/truckInfo" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/supplierNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:drawablePadding="@dimen/size_4dp"
                    tools:text ="9876******"
                    android:textColor="#505361"
                    android:paddingTop="@dimen/size_4dp"
                    android:layout_marginTop="@dimen/size_12dp"
                    android:drawableStart="@drawable/ic_call_12dp"
                    app:layout_constraintStart_toStartOf="@id/paymentType"
                    app:layout_constraintTop_toBottomOf="@id/paymentType" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/advance_payment_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:drawablePadding="@dimen/size_4dp"
                    tools:text ="(50%)"
                    android:textColor="#505361"
                    android:layout_marginStart="@dimen/size_2dp"
                    android:paddingTop="@dimen/size_4dp"
                    android:text="@{request.getAdvancePaymentPercentage()}"
                    app:layout_constraintStart_toEndOf="@id/paymentType"
                    app:layout_constraintTop_toTopOf="@id/paymentType"
                    app:layout_constraintBottom_toBottomOf="@id/paymentType" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/supplierName"
                    android:layout_width="wrap_content"
                    android:paddingTop="@dimen/size_4dp"
                    android:paddingEnd="@dimen/size_11dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:layout_marginTop="@dimen/size_12dp"
                    android:drawablePadding="@dimen/size_4dp"
                    android:text="@{request.getTruckTypeAndNo()}"
                    tools:text ="Mohan Aggarwal"
                    android:textColor="#505361"
                    android:drawableStart="@drawable/ic_user"
                    app:layout_constraintTop_toBottomOf="@id/truckInfo"
                    app:layout_constraintStart_toStartOf="@id/truckInfo" />

                <include
                    android:id="@+id/container_error"
                    layout="@layout/item_bottom_button_with_call"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/size_12dp"
                    android:layout_gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/supplierName"
                    tools:visibility="visible"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>
    </androidx.cardview.widget.CardView>

</layout>
