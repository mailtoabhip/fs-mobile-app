<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >

  <data>
    <variable
        name="activated"
        type="Boolean"
        />
  </data>

  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      >

    <LinearLayout
        android:id="@+id/container_activate"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_height="match_parent"
        >

      <TextView
          android:id="@+id/btn_activate"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:padding="@dimen/size_24dp"
          android:text="Get Started"
          android:gravity="center"
          android:textColor="@color/black"
          />
    </LinearLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/container_wallet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground"
        android:orientation="vertical"
        android:padding="@dimen/size_8dp"
        >

      <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_all_round_corner_white"
          >

        <TextView
            android:id="@+id/text_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="-2sp"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_24sp"
            app:layout_constraintStart_toEndOf="@+id/id1"
            app:layout_constraintTop_toBottomOf="@+id/id2"
            tools:text="₹ 23900.00"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/id1"
            android:layout_width="@dimen/size_48dp"
            android:layout_height="@dimen/size_48dp"
            android:layout_marginStart="@dimen/size_8dp"
            android:layout_marginTop="@dimen/size_16dp"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/id2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8dp"
            android:text="@string/label_your_balance"
            app:layout_constraintStart_toEndOf="@+id/id1"
            app:layout_constraintTop_toTopOf="@+id/id1"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/view_transaction_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_8dp"
            android:layout_marginEnd="@dimen/size_8dp"
            android:layout_marginTop="@dimen/size_24dp"
            android:text="@string/label_view_transaction_summary"
            android:textColor="@color/heading_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_balance"
            />

      </androidx.constraintlayout.widget.ConstraintLayout>

      <androidx.appcompat.widget.AppCompatTextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_16dp"
          android:textColor="@color/heading_black"
          android:text="@string/label_transfer_amount"
          />

      <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/container_fuel"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_all_round_corner_white"
          android:layout_marginTop="@dimen/size_8dp"
          >

        <TextView
            android:id="@+id/sublabel_fuel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8dp"
            android:textColor="@color/sub_heading_black"
            android:textSize="@dimen/text_12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_fuel"
            app:layout_constraintTop_toBottomOf="@+id/label_fuel"
            tools:text="₹ 23900.00"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_fuel"
            android:layout_width="@dimen/size_48dp"
            android:layout_height="@dimen/size_48dp"
            android:layout_marginBottom="@dimen/size_8dp"
            android:layout_marginStart="@dimen/size_8dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/size_24dp"
            android:layout_height="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_8dp"
            app:srcCompat="@drawable/ic_arrow_forward_black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_fuel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8dp"
            android:fontFamily="sans-serif"
            android:text="@string/label_fuel_credit"
            android:textColor="@color/heading_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/sublabel_fuel"
            app:layout_constraintStart_toEndOf="@+id/img_fuel"
            app:layout_constraintTop_toTopOf="parent"
            />

      </androidx.constraintlayout.widget.ConstraintLayout>

      <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/container_bank"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_all_round_corner_white"
          android:layout_marginTop="@dimen/size_16dp"
          >

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_bank"
            android:layout_width="@dimen/size_48dp"
            android:layout_height="@dimen/size_48dp"
            android:layout_marginBottom="@dimen/size_8dp"
            android:layout_marginStart="@dimen/size_8dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/size_24dp"
            android:layout_height="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_8dp"
            app:srcCompat="@drawable/ic_arrow_forward_black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_bank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8dp"
            android:fontFamily="sans-serif"
            android:text="@string/label_bank"
            android:textColor="@color/heading_black"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/img_bank"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

      </androidx.constraintlayout.widget.ConstraintLayout>

      <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/container_fast_tag"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_all_round_corner_white"
          android:layout_marginTop="@dimen/size_16dp"
          >

        <TextView
            android:id="@+id/sublabel_fast_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8dp"
            android:textColor="@color/sub_heading_black"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textSize="@dimen/text_12sp"
            app:layout_constraintStart_toEndOf="@+id/img_fast_tag"
            app:layout_constraintTop_toBottomOf="@+id/label_fast_tag"
            android:text="Coming Soon"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_fast_tag"
            android:layout_width="@dimen/size_48dp"
            android:layout_height="@dimen/size_48dp"
            android:layout_marginBottom="@dimen/size_8dp"
            android:layout_marginStart="@dimen/size_8dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/size_24dp"
            android:layout_height="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_8dp"
            app:srcCompat="@drawable/ic_arrow_forward_black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_fast_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8dp"
            android:fontFamily="sans-serif"
            android:text="@string/label_fastag"
            android:textColor="@color/heading_black"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/sublabel_fast_tag"
            app:layout_constraintStart_toEndOf="@+id/img_fast_tag"
            app:layout_constraintTop_toTopOf="parent"
            />

      </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>
  </FrameLayout>
</layout>