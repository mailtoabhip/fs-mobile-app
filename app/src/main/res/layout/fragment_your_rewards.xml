<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <androidx.constraintlayout.widget.ConstraintLayout
      android:background="@color/white"
      android:layout_width="match_parent"
      android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/start_layout"
        android:background="@drawable/bg_all_round_corner_grey_boundary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="@dimen/size_4dp"
        android:layout_marginStart="@dimen/size_16dp"
        android:layout_marginTop="@dimen/size_16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/end_layout"
        app:layout_constraintTop_toTopOf="parent">
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/start_date"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          android:layout_width="match_parent"
          android:layout_height="@dimen/size_40dp"
          android:textSize="@dimen/text_16sp"
          android:textColor="@color/info_bg"
          android:gravity="center_vertical"
          android:paddingStart="@dimen/size_8dp"
          android:paddingEnd="@dimen/size_4dp"
          />
      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/start_icon"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingEnd="@dimen/size_12dp"
          android:paddingStart="@dimen/size_4dp"
          app:layout_constraintBottom_toBottomOf="parent"
          app:srcCompat="@drawable/ic_vector_calender"
          app:layout_constraintEnd_toEndOf="@+id/start_date"
          app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/end_layout"
        android:layout_marginTop="@dimen/size_16dp"
        android:layout_marginEnd="@dimen/size_16dp"
        android:background="@drawable/bg_all_round_corner_grey_boundary"
        android:layout_width="0dp"
        android:padding="@dimen/size_4dp"
        android:layout_marginStart="@dimen/size_12dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/start_layout"
        app:layout_constraintEnd_toEndOf="parent">
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/end_date"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          android:layout_width="match_parent"
          android:layout_height="@dimen/size_40dp"
          android:gravity="center_vertical"
          android:textSize="@dimen/text_16sp"
          android:paddingStart="@dimen/size_8dp"
          android:textColor="@color/info_bg"
          android:paddingEnd="@dimen/size_4dp"
          app:layout_constraintBottom_toBottomOf="parent"/>
      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/end_icon"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingEnd="@dimen/size_12dp"
          android:paddingStart="@dimen/size_4dp"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toEndOf="@+id/end_date"
          app:srcCompat="@drawable/ic_vector_calender"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/clear_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clear all"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/end_layout"
        app:layout_constraintEnd_toEndOf="parent"
        android:textColor="@color/colorAccent"
        android:layout_marginEnd="@dimen/size_16dp"
        android:layout_marginTop="@dimen/size_8dp"
        android:textSize="@dimen/text_12sp"
        />
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/size_16dp"
        app:layout_constraintTop_toBottomOf="@+id/clear_all"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rewards_rv"
          android:layout_marginBottom="@dimen/size_16dp"
          android:paddingBottom="@dimen/size_16dp"
          android:layout_marginTop="@dimen/size_4dp"
          app:layout_constrainedHeight="true"
          android:clipToPadding="false"
          android:layout_width="match_parent"
          android:layout_height="0dp"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>