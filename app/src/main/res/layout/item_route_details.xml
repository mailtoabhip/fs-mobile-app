<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />

        <variable
            name="request"
            type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_route_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="@{request.isIntraCityContract()}"
        tools:visibility="gone"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tv_location_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@{request.originCityName()}"
            android:textColor="#121A31"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Mumbai MIDC" />

        <TextView
            android:id="@+id/tv_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="C/O Shed No. 876, Plot 6, Mumbai Maharashtra"
            android:text="@{request.pickupLocationAddress}"
            android:textColor="#505361"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_location_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_route_details_from_to"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingTop="16dp"
        android:paddingBottom="@dimen/size_4dp"
        android:visibility="@{request.isFRCLHContract()}"
        tools:visibility="visible"
        android:paddingStart="@dimen/size_16dp"
        android:paddingEnd="@dimen/size_16dp"
        android:elevation="4dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_from_to_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            >
            <TextView
                android:id="@+id/fromCity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16sp"
                android:text="@{request.originCityName()}"
                tools:text ="Navi Mumbai"
                android:textColor="#121A31"
                app:layout_constraintEnd_toStartOf="@id/guidelineCenter"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/view_stops"
                android:layout_width="60dp"
                android:layout_height="@dimen/size_16dp"
                app:layout_constraintBottom_toBottomOf="@id/fromCity"
                app:layout_constraintEnd_toStartOf="@id/toCity"
                app:layout_constraintHorizontal_bias="0.211"
                app:layout_constraintStart_toEndOf="@id/fromCity"
                app:layout_constraintTop_toTopOf="@id/fromCity"
                app:srcCompat="@drawable/ic_line_5" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_stops"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                tools:text ="2 stops"
                android:text="@{request.getIntermediateStops()}"
                android:textColor="#8F9198"
                app:layout_constraintTop_toBottomOf="@id/view_stops"
                app:layout_constraintEnd_toEndOf="@id/view_stops"
                app:layout_constraintStart_toStartOf="@id/view_stops" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.4"
                android:orientation="vertical" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineCenter3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.7"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/toCity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@{request.destinationCityName()}"
                tools:text ="Jaisalmer"
                android:textColor="#121A31"
                app:layout_constraintStart_toStartOf="@id/guidelineCenter3"
                android:textAlignment="textEnd"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineCenter2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.4"
                android:orientation="vertical" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineCenter1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="0.7"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/fromState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#505361"
                android:paddingTop="@dimen/size_4dp"
                android:text="@{request.originDistrictState()}"
                tools:text ="Mumbai, Maharashtra"
                app:layout_constraintTop_toBottomOf="@id/fromCity"
                app:layout_constraintEnd_toStartOf="@id/guidelineCenter2"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/toState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:paddingTop="@dimen/size_4dp"
                android:textColor="#505361"
                android:textAlignment="textEnd"
                android:text="@{request.destinationDistrictState()}"
                tools:text ="Rajasthan "
                app:layout_constraintTop_toBottomOf="@id/toCity"
                app:layout_constraintStart_toEndOf="@id/guidelineCenter1"
                app:layout_constraintEnd_toEndOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>