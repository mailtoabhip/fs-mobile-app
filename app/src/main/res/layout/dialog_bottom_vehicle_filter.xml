<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_dialog">

        <!-- Header with close button and title -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:paddingTop="@dimen/size_24dp"
            android:paddingStart="@dimen/size_16dp"
            android:paddingEnd="@dimen/size_16dp"
            android:paddingBottom="@dimen/size_16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
                
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/text_20sp"
                android:layout_marginStart="@dimen/size_12dp"
                android:layout_gravity="center"
                android:text="Filters"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_close_black"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Separator -->
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_1dp"
            app:srcCompat="@drawable/seperator_line"/>

        <!-- Open Vehicle Option -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/open_vehicle_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/size_16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkbox_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
                
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#525B7A"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginStart="@dimen/size_12dp"
                android:text="Open"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Separator -->
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_1dp"
            app:srcCompat="@drawable/seperator_line"/>

        <!-- Closed Vehicle Option -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/closed_vehicle_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/size_16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkbox_closed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
                
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#525B7A"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginStart="@dimen/size_12dp"
                android:text="Closed"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Separator -->
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_1dp"
            app:srcCompat="@drawable/seperator_line"/>

        <!-- Trailer Vehicle Option -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/trailer_vehicle_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/size_16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkbox_trailer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
                
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#525B7A"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginStart="@dimen/size_12dp"
                android:text="Trailer"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Separator -->
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_1dp"
            app:srcCompat="@drawable/seperator_line"/>

        <!-- Filter Button -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/size_16dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_clear_filter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_search_white_load_minimal_padding"
                android:text="Clear Filter"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginEnd="@dimen/size_8dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_apply_filter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_place_bid_radius_6px"
                android:text="Apply"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginStart="@dimen/size_8dp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>


