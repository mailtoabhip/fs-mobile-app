<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

  <data>
    <variable
        name="data"
        type="com.delhivery.orion.data.home.loads.HomeLoadsInfoItemData"
        />
  </data>
  <android.support.v7.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/size_12dp"
      android:layout_marginEnd="@dimen/size_2dp"
      android:layout_marginStart="@dimen/size_2dp"
      android:foreground="?attr/selectableItemBackgroundBorderless"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="2dp"
      >

    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:paddingBottom="16dp"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        >

      <TextView
          android:id="@+id/text_search"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif"
          android:text="These are recommended loads,\n Serach Here"
          android:textSize="@dimen/text_14sp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          />

      <TextView
          android:id="@+id/text_edit_route"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_12dp"
          android:fontFamily="sans-serif"
          android:text="To get more relevant loads - change your \n preference here"
          android:textSize="@dimen/text_14sp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/text_search"
          />

    </android.support.constraint.ConstraintLayout>
  </android.support.v7.widget.LinearLayoutCompat>
</layout>