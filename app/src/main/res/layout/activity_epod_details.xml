<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F6F7F8">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="@dimen/size_1dp"
        app:elevation="@dimen/size_1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/epod_details_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:padding="@dimen/size_16dp">

            <!-- Back Arrow -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btn_back"
                android:layout_width="@dimen/size_24dp"
                android:layout_height="@dimen/size_24dp"
                android:src="@drawable/ic_back_arrow"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:tint="@color/heading_black" />

            <!-- ePOD Pending Badge -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/badge_epod_pending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ePOD Pending"
                android:textColor="@color/pending_font"
                android:textSize="@dimen/text_12sp"
                android:background="@drawable/bg_load_type_100dp_corner"
                android:backgroundTint="#FFF7EB"
                android:paddingStart="@dimen/size_8dp"
                android:paddingEnd="@dimen/size_8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/epod_pics_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/size_12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/app_bar_layout"
            android:layout_marginTop="@dimen/size_12dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/size_4dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/pod_pic_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ePOD Picture *"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_14sp"
                    android:layout_marginStart="@dimen/size_12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <LinearLayout
                    android:id="@+id/container_pod_maxWidth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:layout_marginTop="@dimen/size_4dp"
                    android:layout_marginBottom="@dimen/size_4dp"
                    android:elevation="@dimen/size_2dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:clickable="true"
                    android:focusable="true"
                    tools:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/pod_pic_tv"
                    app:layout_constraintBottom_toTopOf="@id/recommendation_text">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/size_72dp"
                        android:background="@drawable/bg_upload_container"
                        android:padding="8dp"
                        android:gravity="center"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/image_pod_maxWidth"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/ic_add_black_24dp"
                            app:tint="@color/info_title"
                            />

                    </LinearLayout>

                </LinearLayout>

                <!-- RecyclerView for dynamic POD items -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pod_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="@dimen/size_4dp"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:layout_constraintTop_toBottomOf="@id/pod_pic_tv"
                    app:layout_constraintBottom_toTopOf="@id/recommendation_text" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/recommendation_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload a .JPG, .PNG, or .PDF file (Max 5MB)"
                    android:textColor="#8F9198"
                    android:textSize="@dimen/text_12sp"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:layout_marginBottom="@dimen/size_16dp"
                    app:layout_constraintBottom_toTopOf="@+id/submitButton_maxWidth"
                    app:layout_constraintStart_toStartOf="parent"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submitButton_maxWidth"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size_40dp"
                    android:text="Submit"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_button_submit_selector"
                    android:textAllCaps="false"
                    app:backgroundTint="@null"
                    android:visibility="visible"
                    android:textSize="@dimen/text_14sp"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:layout_marginBottom="@dimen/size_16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginTop="16dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>