<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import type="com.delhivery.axle.ui.profile.ProfileUIState" />
        <variable
            name="viewModel"
            type="com.delhivery.axle.ui.profile.HomeProfileViewModel"
            />
        <variable
            name="state"
            type="com.delhivery.axle.ui.profile.ProfileUIState"
            />
    </data>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_bg"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:background="@color/white"
            android:layout_width="match_parent"
            bind:shadow="@{ @dimen/size_2dp }"
            android:layout_height="@dimen/height_toolbar"
            />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:background="@color/white"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:orientation="vertical"
                android:id="@+id/picLayout"
                android:background="@color/white"
                android:layout_marginTop="@dimen/size_24dp"
                bind:layout_constraintTop_toTopOf="parent"
                bind:layout_constraintStart_toStartOf="parent"
                android:layout_height="wrap_content">


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/profile"
                android:layout_width="52dp"
                   android:layout_height="52dp"
                android:gravity="center"
                android:textSize="@dimen/text_20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:layout_marginEnd="@dimen/size_16dp"
                android:layout_marginStart="@dimen/size_16dp"
                android:textColor="@color/white"
                android:background="@drawable/dark_red_circle" />

            <androidx.cardview.widget.CardView
                android:layout_width="52dp"
                android:layout_height="52dp"
                 android:layout_marginStart="@dimen/size_16dp"
                bind:cardElevation="0dp"
               android:visibility="gone"
                android:layout_marginEnd="@dimen/size_16dp"
                android:id="@+id/card1"
                bind:cardBackgroundColor="@color/grey_bg"
                bind:cardCornerRadius="26dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/profilepic"
                    android:scaleType="fitXY"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    />
            </androidx.cardview.widget.CardView>
            </RelativeLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="0dp"
                android:id="@+id/company_name"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold"
                android:text="@{viewModel.businessName}"
                bind:layout_constraintHorizontal_chainStyle="packed"
                bind:layout_constraintStart_toEndOf="@+id/picLayout"
               bind:layout_constraintRight_toLeftOf="@+id/verifyBadge"
                android:textColor="@color/heading_black"
                android:fontFamily="sans-serif"
                android:layout_marginTop="@dimen/size_24dp"
                bind:layout_constraintTop_toTopOf="parent"
                android:layout_height="wrap_content"/>

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
               bind:cardCornerRadius="@dimen/size_12dp"
                bind:cardBackgroundColor="@color/light_green"
                android:id="@+id/verifyBadge"
                android:visibility="gone"
                bind:layout_constraintHorizontal_chainStyle="packed"
                bind:layout_constraintLeft_toRightOf="@+id/company_name"
                bind:layout_constraintTop_toTopOf="parent"
               bind:cardElevation="0dp"
                android:layout_marginEnd="20dp"
                android:layout_marginStart="@dimen/size_4dp"
                android:layout_marginTop="@dimen/size_24dp"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_marginStart="@dimen/size_8dp"
                        android:layout_marginEnd="@dimen/size_8dp"
                        android:layout_gravity="center_vertical"
                        bind:srcCompat="@drawable/ic_badge_check"
                        android:layout_height="12dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="@string/label_verified"
                        android:textColor="@color/bid_placed_green"
                        android:layout_marginBottom="4dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="@dimen/size_8dp"
                        android:textSize="@dimen/text_12sp"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/user_name"
                android:text="@{viewModel.userName}"
                bind:layout_constraintTop_toBottomOf="@+id/company_name"
                bind:layout_constraintStart_toEndOf="@+id/picLayout"
                android:textColor="@color/heading_black"
                android:layout_marginBottom="@dimen/size_24dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:textSize="@dimen/text_14sp"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_width="0dp"
                android:id="@+id/mobile"
                android:text="@{viewModel.mobile}"
                android:layout_marginStart="@dimen/size_4dp"
                bind:layout_constraintTop_toBottomOf="@+id/company_name"
                bind:layout_constraintStart_toEndOf="@+id/user_name"
                android:textColor="@color/heading_black"
                android:layout_marginBottom="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:textSize="@dimen/text_14sp"
                android:layout_height="wrap_content"/>



            <RelativeLayout
                android:layout_width="match_parent"
                android:id="@+id/ratingsLayout"
                android:visibility="gone"
                android:layout_marginTop="@dimen/size_24dp"
                bind:layout_constraintTop_toBottomOf="@+id/user_name"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:src="@drawable/dotted"
                android:id="@+id/sep"
                />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:id="@+id/kycpendingLayout"
                    android:visibility="gone"
                   android:layout_marginTop="@dimen/size_16dp"
                    android:layout_marginStart="@dimen/size_16dp"
                    android:layout_marginEnd="@dimen/size_16dp"
                    android:background="@drawable/bg_all_round_corner_yellow"
                    android:padding="@dimen/size_16dp"
                     android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:id="@+id/imgKycpending"
                        bind:srcCompat="@drawable/ic_circle_exclamation"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/size_12dp"
                        android:layout_toEndOf="@+id/imgKycpending"
                        android:text="@string/label_kyc_pending"
                        android:textColor="@color/heading_black"
                        android:textSize="@dimen/text_14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/action_start_kyc"
                        android:visibility="gone"
                        android:textColor="#D97706"
                        android:paddingStart="@dimen/size_12dp"
                        android:paddingTop="@dimen/size_6dp"
                        android:id="@+id/startKyc"
                        android:paddingBottom="@dimen/size_6dp"
                        android:paddingEnd="@dimen/size_12dp"
                        android:background="@drawable/bg_all_round_corner_yellow_border"
                        android:layout_marginEnd="@dimen/size_4dp"
                        android:layout_centerVertical="true"
                        android:textSize="@dimen/text_14sp"
                        bind:srcCompat="@drawable/ic_vector_arrow"
                        android:layout_height="wrap_content"/>

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:id="@+id/kycfailedLayout"
                    android:visibility="gone"
                    android:layout_below="@+id/kycpendingLayout"
                    android:layout_marginTop="@dimen/size_16dp"
                    android:layout_marginEnd="@dimen/size_16dp"
                    android:layout_marginStart="@dimen/size_16dp"
                    android:background="@drawable/bg_all_round_corner_red"
                    android:padding="@dimen/size_16dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:id="@+id/imgKycfail"
                        bind:srcCompat="@drawable/ic_triangle_exclamation"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/size_12dp"
                        android:layout_toEndOf="@+id/imgKycfail"
                        android:text="@string/label_kyc_failed"
                        android:textColor="@color/heading_black"
                        android:textSize="@dimen/text_14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/action_restart_kyc"
                        android:textColor="@color/error_red"
                        android:paddingStart="@dimen/size_12dp"
                        android:paddingTop="@dimen/size_6dp"
                        android:id="@+id/btnRetry"
                        android:paddingBottom="@dimen/size_6dp"
                        android:paddingEnd="@dimen/size_12dp"
                        android:background="@drawable/bg_all_round_corner_red_border"
                        android:layout_marginEnd="@dimen/size_4dp"
                        android:layout_centerVertical="true"
                        android:textSize="@dimen/text_14sp"
                        bind:srcCompat="@drawable/ic_vector_arrow"
                        android:layout_height="wrap_content"/>

                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:id="@+id/rateLay"
                    android:visibility="gone"
                    android:layout_below="@+id/kycfailedLayout"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="@string/label_ratings"
                        android:id="@+id/label_ratings"
                       android:layout_marginStart="@dimen/size_16dp"
                        android:textColor="@color/heading_black"
                        android:layout_marginBottom="8dp"
                        android:layout_marginTop="@dimen/size_16dp"
                        android:layout_marginEnd="@dimen/size_8dp"
                        android:textSize="@dimen/text_14sp"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:id="@+id/reviews"
                        android:layout_below="@+id/label_ratings"
                        android:layout_marginStart="@dimen/size_16dp"
                        android:textColor="@color/colorAccent"
                        android:layout_marginEnd="@dimen/size_8dp"
                        android:textSize="@dimen/text_14sp"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:id="@+id/ratings"
                       android:layout_alignParentEnd="true"
                       android:layout_marginTop="@dimen/size_16dp"
                        android:layout_marginStart="@dimen/size_16dp"
                        android:textColor="@color/heading_black"
                        android:layout_marginEnd="@dimen/size_36dp"
                        android:textSize="@dimen/text_24sp"
                        android:layout_height="wrap_content"/>
                    <androidx.appcompat.widget.AppCompatRatingBar
                        android:layout_width="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@+id/ratings"
                        android:max="5"
                         android:theme="@style/RatingBar"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_marginEnd="@dimen/size_16dp"
                        android:layout_height="wrap_content"/>

                </RelativeLayout>

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                 android:background="@color/grey_bg"
                android:id="@+id/div2"
                android:layout_marginTop="@dimen/size_24dp"
                bind:layout_constraintTop_toBottomOf="@+id/ratingsLayout"
                android:layout_height="@dimen/size_6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:text="@string/label_account"
                android:id="@+id/label_account"
                android:layout_marginStart="@dimen/size_16dp"
                bind:layout_constraintTop_toBottomOf="@+id/div2"
               android:textColor="@color/heading_black"
                android:layout_marginBottom="@dimen/size_16dp"
                android:layout_marginTop="@dimen/size_16dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:textSize="@dimen/text_12sp"
                android:layout_height="wrap_content"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:id="@+id/profileLayout"
                android:padding="@dimen/size_16dp"
                bind:layout_constraintTop_toBottomOf="@+id/label_account"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:id="@+id/imgProfile"
                    bind:srcCompat="@drawable/ic_account_details"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="match_parent"
                    android:text="@string/label_profile"
                    android:layout_toStartOf="@+id/arrow2"
                    android:layout_toEndOf="@+id/imgProfile"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:textColor="@color/heading_black"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:textSize="@dimen/text_14sp"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:id="@+id/arrow2"
                    android:layout_marginEnd="@dimen/size_4dp"
                    android:layout_centerVertical="true"
                    bind:srcCompat="@drawable/ic_vector_arrow"
                    android:layout_height="wrap_content"/>

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:id="@+id/kycLayout"
                android:padding="@dimen/size_16dp"
                bind:layout_constraintTop_toBottomOf="@+id/profileLayout"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgKyc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    bind:srcCompat="@drawable/ic_kyc_details" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:layout_toStartOf="@+id/arrow1"
                    android:layout_toEndOf="@+id/imgKyc"
                    android:text="@string/label_kyc_details"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:id="@+id/issues"
                    android:visibility="gone"
                    android:layout_toStartOf="@+id/arrow1"
                    android:layout_centerVertical="true"
                    android:paddingStart="@dimen/size_12dp"
                    android:paddingEnd="@dimen/size_12dp"
                    android:paddingTop="@dimen/size_4dp"
                    android:paddingBottom="@dimen/size_4dp"
                    android:background="@drawable/bg_all_round_corner_light_red"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:textColor="@color/error_red"
                    android:layout_marginEnd="@dimen/size_16dp"
                    android:textSize="@dimen/text_14sp"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:id="@+id/arrow1"
                    android:layout_marginEnd="@dimen/size_4dp"
                    android:layout_centerVertical="true"
                    bind:srcCompat="@drawable/ic_vector_arrow"
                    android:layout_height="wrap_content"/>

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:id="@+id/bankLayout"
                android:padding="@dimen/size_16dp"
                bind:layout_constraintTop_toBottomOf="@+id/kycLayout"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:id="@+id/imgbank"
                    bind:srcCompat="@drawable/ic_bank_details"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:layout_toEndOf="@+id/imgbank"
                    android:layout_toStartOf="@+id/arrow3"
                    android:text="@string/label_payment_details"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_14sp"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:id="@+id/issues_payment"
                    android:visibility="gone"
                    android:layout_toStartOf="@+id/arrow3"
                    android:layout_centerVertical="true"
                    android:paddingStart="@dimen/size_12dp"
                    android:paddingEnd="@dimen/size_12dp"
                    android:paddingTop="@dimen/size_4dp"
                    android:paddingBottom="@dimen/size_4dp"
                    android:background="@drawable/bg_all_round_corner_light_red"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:textColor="@color/error_red"
                    android:layout_marginEnd="@dimen/size_16dp"
                    android:textSize="@dimen/text_14sp"
                    android:layout_height="wrap_content"/>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:id="@+id/arrow3"
                    android:layout_marginEnd="@dimen/size_4dp"
                    android:layout_centerVertical="true"
                    bind:srcCompat="@drawable/ic_vector_arrow"
                    android:layout_height="wrap_content"/>

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:id="@+id/routeLayout"
                android:padding="@dimen/size_16dp"
                bind:layout_constraintTop_toBottomOf="@+id/bankLayout"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:id="@+id/imgroute"
                    bind:srcCompat="@drawable/ic_my_routes"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="match_parent"
                    android:text="@string/label_routes"
                    android:layout_toStartOf="@+id/arrow4"
                    android:layout_toEndOf="@+id/imgroute"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:textColor="@color/heading_black"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:textSize="@dimen/text_14sp"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:id="@+id/arrow4"
                    android:layout_marginEnd="@dimen/size_4dp"
                    android:layout_centerVertical="true"
                    bind:srcCompat="@drawable/ic_vector_arrow"
                    android:layout_height="wrap_content"/>

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:id="@+id/earningsLayout"
                android:padding="@dimen/size_16dp"
                bind:layout_constraintTop_toBottomOf="@+id/routeLayout"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:id="@+id/imgearnings"
                    bind:srcCompat="@drawable/ic_earnings"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:layout_toEndOf="@+id/imgearnings"
                    android:layout_toStartOf="@+id/arrow5"
                    android:text="@string/label_earnings"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_14sp"
                    />
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:id="@+id/arrow5"
                    android:layout_marginEnd="@dimen/size_4dp"
                    android:layout_centerVertical="true"
                    bind:srcCompat="@drawable/ic_vector_arrow"
                    android:layout_height="wrap_content"/>

            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:id="@+id/share_layout"
                android:padding="@dimen/size_16dp"
                android:visibility="gone"
                bind:layout_constraintTop_toBottomOf="@+id/earningsLayout"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:id="@+id/img_share"
                    bind:srcCompat="@drawable/ic_share_rate"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="match_parent"
                    android:text="@string/label_share_rate"
                    android:layout_toStartOf="@+id/arrow_share"
                    android:layout_toEndOf="@+id/img_share"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:textColor="@color/heading_black"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:textSize="@dimen/text_14sp"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:id="@+id/arrow_share"
                    android:layout_marginEnd="@dimen/size_4dp"
                    android:layout_centerVertical="true"
                    bind:srcCompat="@drawable/ic_vector_arrow"
                    android:layout_height="wrap_content"/>

            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:id="@+id/teamLayout"
                android:padding="@dimen/size_16dp"
                bind:layout_constraintTop_toBottomOf="@+id/share_layout"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:id="@+id/imgteam"
                    bind:srcCompat="@drawable/ic_team_members"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="match_parent"
                    android:text="@string/label_team"
                    android:layout_toStartOf="@+id/arrow6"
                    android:layout_toEndOf="@+id/imgteam"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:textColor="@color/heading_black"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:textSize="@dimen/text_14sp"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:id="@+id/arrow6"
                    android:layout_marginEnd="@dimen/size_4dp"
                    android:layout_centerVertical="true"
                    bind:srcCompat="@drawable/ic_vector_arrow"
                    android:layout_height="wrap_content"/>

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:id="@+id/podLayout"
               android:paddingStart="@dimen/size_16dp"
                android:paddingTop="@dimen/size_16dp"
                android:paddingBottom="@dimen/size_16dp"
                bind:layout_constraintTop_toBottomOf="@+id/teamLayout"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="wrap_content"
                   android:layout_alignParentStart="true"
                    android:id="@+id/imgpod"
                    bind:srcCompat="@drawable/ic_pod_address"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/podtv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:layout_toEndOf="@+id/imgpod"
                    android:layout_toStartOf="@+id/arrow7"
                    android:paddingTop="@dimen/size_4dp"
                    android:text="@string/label_pod"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_14sp"
                    />
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:id="@+id/arrow7"
                    android:rotation="90"
                    android:layout_marginTop="@dimen/size_4dp"
                    android:layout_marginEnd="@dimen/size_20dp"
                    bind:srcCompat="@drawable/ic_vector_arrow"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:textSize="@dimen/text_12sp"
                    android:layout_marginTop="@dimen/size_12dp"
                    android:id="@+id/podaddress"
                    android:visibility="gone"
                    android:text="@{viewModel.podAddress}"
                    android:layout_below="@+id/podtv"
                    android:layout_marginEnd="@dimen/size_16dp"
                    android:textColor="@color/heading_black"
                    android:layout_height="wrap_content"/>

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:id="@+id/helpLayout"
                android:padding="@dimen/size_16dp"
                bind:layout_constraintTop_toBottomOf="@+id/podLayout"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:id="@+id/imghelp"
                    bind:srcCompat="@drawable/ic_help"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="match_parent"
                    android:text="@string/label_help"
                    android:layout_toStartOf="@+id/arrow8"
                    android:layout_toEndOf="@+id/imghelp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:textColor="@color/heading_black"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:textSize="@dimen/text_14sp"
                    android:layout_height="wrap_content"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:id="@+id/arrow8"
                    android:layout_marginEnd="@dimen/size_4dp"
                   android:layout_centerVertical="true"
                    bind:srcCompat="@drawable/ic_vector_arrow"
                    android:layout_height="wrap_content"/>

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
               bind:layout_constraintTop_toBottomOf="@+id/helpLayout"
                android:background="@color/grey_bg"
                android:id="@+id/div3"
                android:layout_height="@dimen/size_12dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:id="@+id/logoutLayout"
                android:padding="@dimen/size_16dp"
                bind:layout_constraintTop_toBottomOf="@+id/div3"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:id="@+id/imglogout"
                    bind:srcCompat="@drawable/ic_logout"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="match_parent"
                    android:text="@string/label_logout"
                   android:layout_toEndOf="@+id/imglogout"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/size_16dp"
                    android:textColor="@color/error_red"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:textSize="@dimen/text_14sp"
                    android:layout_height="wrap_content"/>
            </RelativeLayout>
            <View
                android:layout_width="match_parent"
                bind:layout_constraintTop_toBottomOf="@+id/logoutLayout"
                android:background="@color/grey_bg"
                android:id="@+id/div4"
                android:layout_height="@dimen/size_12dp"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:id="@+id/deleteLayout"
                android:padding="@dimen/size_16dp"
                bind:layout_constraintTop_toBottomOf="@+id/div4"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:id="@+id/imgdelete"
                    bind:srcCompat="@drawable/ic_remove"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="match_parent"
                    android:text="@string/label_delete"
                    android:layout_toEndOf="@+id/imgdelete"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/size_16dp"
                    android:textColor="@color/error_red"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:textSize="@dimen/text_14sp"
                    android:layout_height="wrap_content"/>
            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:background="@color/grey_bg"
                android:gravity="bottom"
                android:paddingBottom="@dimen/size_32dp"
                bind:layout_constraintVertical_weight="1"
                bind:layout_constraintTop_toBottomOf="@id/deleteLayout"
                android:layout_height="0dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_marginTop="29dp"
                    bind:srcCompat="@drawable/ic_logo_delhivery"
                   android:layout_gravity="center_horizontal"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:id="@+id/appversion"
                    android:layout_marginTop="@dimen/size_6dp"
                    android:layout_gravity="center_horizontal"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_10sp"
                    android:layout_height="wrap_content"/>

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>



