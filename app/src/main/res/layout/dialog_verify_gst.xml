<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/size_24dp"
        android:background="@drawable/bg_bottom_dialog">

        <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/size_12dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_12dp"
                app:layout_constraintTop_toTopOf="parent"
                android:textColor="@color/heading_black"
                android:layout_marginStart="@dimen/size_24dp"
                android:layout_gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                android:textSize="@dimen/text_16sp"
                android:text="@string/label_gst_dialog"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close_btn"
                android:layout_marginTop="@dimen/size_12dp"
                android:layout_marginEnd="@dimen/size_24dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_close_black"/>


        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_4dp"
            android:id="@+id/sepLine"
            android:layout_marginTop="@dimen/size_12dp"
            app:layout_constraintTop_toBottomOf="@+id/close_btn"
            app:srcCompat="@drawable/seperator_line"/>

        <LinearLayout
            android:layout_width="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sepLine"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:orientation="horizontal"
            android:id="@+id/verifyOtpLayout"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginBottom="@dimen/size_24dp"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
               android:layout_height="wrap_content"
                android:id="@+id/imgCall"
                app:srcCompat="@drawable/ic_call_otp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/size_16dp"
                android:textColor="@color/heading_black"
                android:layout_marginStart="@dimen/size_12dp"
                android:layout_gravity="center"
                android:textSize="@dimen/text_14sp"
                android:text="@string/label_gst_dialog_option1"/>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_4dp"
            android:id="@+id/optionLine"
            android:layout_marginTop="@dimen/size_24dp"
            app:layout_constraintTop_toBottomOf="@+id/verifyOtpLayout"
            app:srcCompat="@drawable/seperator_line"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:id="@+id/gstDocLayout"
            android:layout_marginTop="@dimen/size_24dp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginBottom="@dimen/size_24dp"
            app:layout_constraintTop_toBottomOf="@+id/optionLine"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
               android:id="@+id/imgUpload"
                 app:srcCompat="@drawable/ic_vector_upload"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/size_16dp"
                android:textColor="@color/heading_black"
                android:layout_marginStart="@dimen/size_12dp"
                android:layout_gravity="center"
                android:textSize="@dimen/text_14sp"
                android:text="@string/label_gst_dialog_option2"/>
        </LinearLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>