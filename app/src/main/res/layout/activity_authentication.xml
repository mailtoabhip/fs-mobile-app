<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

  <data>
    <import type="com.delhivery.axle.ui.auth.AuthenticationUIState" />
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.auth.AuthenticationViewModel"
        />
    <variable
        name="state"
        type="com.delhivery.axle.ui.auth.AuthenticationUIState"
        />
  </data>

  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/white"
      android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

      <!-- Phone no container -->
      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingStart="@dimen/size_24dp"
          android:paddingTop="@dimen/size_24dp"
          android:paddingEnd="@dimen/size_24dp"
          android:paddingBottom="@dimen/size_48dp"
          android:visibility="gone"
          bind:visibility="@{ state == AuthenticationUIState.PhoneNo }"
          >

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:text="@string/label_phone_number"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_24sp"
            android:id="@+id/labelPhone"
            android:textStyle="bold"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12dp"
            android:fontFamily="sans-serif"
            android:id="@+id/sub_label_phone"
            android:layout_below="@+id/labelPhone"
            android:text="@string/sub_label_phone_number"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/sub_label_phone"
            android:gravity="center_vertical|start"
            android:orientation="horizontal">

          <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
              android:id="@+id/edit_phone_no"
              android:layout_width="match_parent"
              android:layout_height="@dimen/edit_text_height"
              android:layout_marginTop="@dimen/size_32dp"
              android:layout_marginBottom="16dp"
              android:background="@drawable/bg_login_edit"
              android:digits="1234567890"
              android:imeOptions="actionDone"
              android:inputType="phone"
              android:maxLength="10"
              android:paddingStart="@dimen/size_12dp"
              android:paddingEnd="@dimen/size_12dp"
              android:hint="Mobile number"
              android:text="@={ viewModel.phoneNo }"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_16sp"
              />
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/login_using_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:layout_marginBottom="@dimen/size_4dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:layout_above="@+id/btn_send_otp"
            android:lineSpacingExtra="@dimen/text_4sp"
            android:text="Login by password"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/custom_dark_grey"
            android:textSize="@dimen/text_16sp"
            />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_send_otp"
            style="@style/ActionButton"
            android:enabled="false"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/size_24dp"
            android:text="@string/action_send_otp"
            />

      </RelativeLayout>
      <!-- Password container -->
      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="@dimen/size_24dp"
          android:orientation="vertical"
          android:visibility="gone"
          bind:visibility="@{ state == AuthenticationUIState.Password }">
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:text="@string/action_login"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_24sp"
            android:textStyle="bold"
            />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_userId"
            style="@style/TextInputLayoutAppearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorEnabled="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >

          <androidx.appcompat.widget.AppCompatEditText
              android:id="@+id/edit_userId"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_4dp"
              android:background="@drawable/bg_form_edit"
              android:hint="@string/hint_user_name"
              android:imeOptions="actionDone"
              android:textSize="@dimen/text_14sp"
              />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_userPassword"
            style="@style/TextInputLayoutAppearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorEnabled="true"
            app:layout_constraintEnd_toEndOf="parent"
            android:hint="@string/hint_password"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            bind:passwordToggleEnabled="true"
            >

          <androidx.appcompat.widget.AppCompatEditText
              android:id="@+id/edit_userPassword"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_4dp"
              android:background="@drawable/bg_form_edit"
              android:imeOptions="actionDone"
              android:inputType="textPassword"
              android:textSize="@dimen/text_14sp"
              />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_24dp"
            android:textAllCaps="false"
            android:text="@string/action_login"
            bind:shadow="@{ @dimen/action_btn_elevation }"
            style="@style/ActionButton"/>
      </androidx.appcompat.widget.LinearLayoutCompat>

      <!-- OTP authentication container -->
      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:orientation="vertical"
          android:paddingStart="@dimen/size_24dp"
          android:paddingTop="@dimen/size_24dp"
          android:paddingEnd="@dimen/size_24dp"
          android:paddingBottom="@dimen/size_48dp"
          bind:visibility="@{ state == AuthenticationUIState.OTP }"
          >

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:text="@string/label_otp"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_24sp"
            android:textStyle="bold"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/labelotp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:text="@string/label_otp"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_24sp"
            android:textStyle="bold"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_otp_sent_to_phone_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            bind:autoSizeTextType="uniform"
            android:fontFamily="sans-serif"
            android:layout_marginTop="@dimen/size_12dp"
            android:layout_below="@+id/labelotp"
            android:gravity="start"
            android:textSize="@dimen/text_16sp"
            android:textColor="@color/sub_heading_black"
            tools:text="to 8695900493"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btn_change_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:textSize="@dimen/text_16sp"
            android:layout_marginTop="@dimen/size_12dp"
           android:layout_below="@+id/text_otp_sent_to_phone_no"
            android:textColor="@color/colorAccent"
            android:text="@string/action_change_number"
            tools:text="Change number"
            />
        <com.delhivery.axle.ui.custom.DelhiveryOTPView
            android:id="@+id/otp_view"
            android:layout_below="@+id/text_otp_sent_to_phone_no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/otpError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/otp_view"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:fontFamily="sans-serif"
            android:layout_centerHorizontal="true"
            android:text="@string/error_invalid_otp"
            android:textColor="@color/error_red"
            android:textSize="@dimen/text_14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_below="@+id/otpError"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_height="wrap_content">

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/label_resend"
              android:layout_gravity="center"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:textSize="@dimen/text_16sp"
              android:textColor="@color/sub_heading_black"
              android:text="@string/label_resend"
              />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/btn_resend_otp"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:layout_gravity="center"
              android:layout_marginStart="@dimen/size_8dp"
              android:textSize="@dimen/text_16sp"
              android:textStyle="bold"
              android:textColor="@color/colorAccent"
              tools:text="Resend OTP"
              />
        </LinearLayout>


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_verify_otp"
            style="@style/ActionButton"
            android:layout_width="match_parent"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_8dp"
            android:enabled="false"
            android:text="@string/action_verify_otp"
            android:textAllCaps="false" />

      </RelativeLayout>
    </FrameLayout>

  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>
