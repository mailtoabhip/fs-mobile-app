<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >

  <data>
    <import type="com.delhivery.axle.ui.auth.AuthenticationUIState" />
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.auth.AuthenticationViewModel"
        />
    <variable
        name="state"
        type="com.delhivery.axle.ui.auth.AuthenticationUIState"
        />
  </data>

  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/white"
      android:orientation="vertical"
      android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        app:contentInsetStartWithNavigation="@dimen/size_8dp"
        app:navigationIcon="@drawable/ic_back_arrow"
        bind:titleTextAppearance="@style/Toolbar.TitleText" />
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/horizontalDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_1dp"
        bind:layout_constraintTop_toBottomOf="@id/toolbar"
        android:padding="0dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

      <!-- Phone no container -->
      <ScrollView
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:fillViewport="true"
          android:visibility="gone"
          bind:visibility="@{ state == AuthenticationUIState.PhoneNo }">

      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:paddingTop="@dimen/size_24dp"
          >


        <!-- Title -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/labelPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/size_24dp"
            android:layout_marginTop="@dimen/size_16dp"
            android:text="@string/label_phone_number"
            android:textColor="@color/text_primary"
            android:textFontWeight="600"
            style="@style/TextAppearance.Delfin.SB14"
            android:textSize="28sp"
            />

        <!-- Subtitle -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/sub_label_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/labelPhone"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/size_8dp"
            android:text="@string/sub_label_phone_number"
            android:layout_marginHorizontal="@dimen/size_24dp"
            android:textColor="@color/text_body_primary"
            style="@style/TextAppearance.Delfin.R14"
            />

        <!-- "Phone number" label -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/labelEnterPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/sub_label_phone"
            android:layout_marginTop="28dp"
            android:layout_marginHorizontal="@dimen/size_24dp"
            android:text="@string/str_phone_number"
            android:textColor="@color/text_body_secondary_v2"
            style="@style/TextAppearance.Delfin.M14"
            />

        <!-- Phone input row: +91 prefix + number field -->
        <LinearLayout
            android:id="@+id/phoneInputRow"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/size_24dp"
            android:layout_height="wrap_content"
            android:layout_below="@+id/labelEnterPhone"
            android:layout_marginTop="@dimen/size_8dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_login_edit"
            android:padding="0dp"
            >

          <!-- +91 prefix -->
          <androidx.appcompat.widget.AppCompatTextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:gravity="center"
              android:padding="@dimen/size_12dp"
              android:text="+91"
              android:textColor="@color/text_body_primary"
              style="@style/TextAppearance.Delfin.M14"
              android:textSize="@dimen/text_16sp"
              android:background="@drawable/bg_phone_prefix"
              />

          <!-- Phone number input -->
          <androidx.appcompat.widget.AppCompatEditText
              android:id="@+id/edit_phone_no"
              android:layout_width="0dp"
              android:layout_height="match_parent"
              android:layout_weight="1"
              android:background="@null"
              android:digits="1234567890"
              android:imeOptions="actionDone"
              android:inputType="phone"
              android:maxLength="10"
              android:paddingHorizontal="@dimen/size_12dp"
              android:hint="@string/str_10_digit_mobile_number"
              android:textColorHint="@color/text_body_base"
              android:text="@={ viewModel.phoneNo }"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_16sp"
              />
          <androidx.appcompat.widget.AppCompatImageView
              android:id="@+id/iv_check"
              android:layout_width="wrap_content"
              android:layout_height="match_parent"
              android:gravity="center"
              android:visibility="gone"
              android:src="@drawable/ic_success_checkmark"
              android:tint="@color/background_dark_grey"
              android:padding="@dimen/size_12dp"
              />
        </LinearLayout>

        <!-- Get OTP button pinned to bottom -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_send_otp"
            style="@style/ActionButton"
            android:enabled="false"
            android:layout_margin="@dimen/size_16dp"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:textColor="@color/text_body_primary_inverse"
            android:text="@string/action_send_otp"
            android:textAllCaps="false"
            />

      </RelativeLayout>
      </ScrollView>

      <!-- OTP authentication container -->
      <ScrollView
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:fillViewport="true"
          bind:visibility="@{ state == AuthenticationUIState.OTP || state == AuthenticationUIState.LoginProgress }">

      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:orientation="vertical"
          android:paddingTop="@dimen/size_24dp"
          >

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/labelotp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8dp"
            android:layout_marginHorizontal="@dimen/size_24dp"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:text="@string/label_otp"
            android:textFontWeight="600"
            style="@style/TextAppearance.Delfin.SB14"
            android:textSize="28sp"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_otp_sent_to_phone_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            bind:autoSizeTextType="uniform"
            android:layout_marginHorizontal="@dimen/size_24dp"
            android:layout_marginTop="@dimen/size_12dp"
            android:layout_below="@+id/labelotp"
            style="@style/TextAppearance.Delfin.R14"
            android:gravity="start"
            android:textSize="@dimen/text_16sp"
            android:textFontWeight="400"
            android:textColor="@color/text_body_primary"
            tools:text="to 8695900493"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_enter_otp_here"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/size_24dp"
            android:layout_marginTop="@dimen/size_32dp"
            android:layout_below="@+id/text_otp_sent_to_phone_no"
            android:gravity="start"
            android:textSize="@dimen/text_16sp"
            android:text="@string/str_enter_otp"
            android:textFontWeight="500"
            android:textColor="@color/text_body_secondary_v2"
            style="@style/TextAppearance.Delfin.M14"
            />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/otp_view"
            android:layout_below="@+id/tv_enter_otp_here"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/size_24dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8dp"
            android:inputType="number"
            android:maxLength="8"
            android:hint="@string/str_enter_otp"
            android:textColorHint="@color/text_body_base"
            android:textColor="@color/text_body_primary"
            android:padding="@dimen/size_12dp"
            android:background="@drawable/bg_edit_text_outlined"
            style="@style/TextAppearance.Delfin.M14"
            android:textFontWeight="500"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_below="@+id/otp_view"
            android:orientation="horizontal"
            android:gravity="start"
            android:layout_marginHorizontal="@dimen/size_24dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:layout_height="wrap_content">

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/label_resend"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              style="@style/TextAppearance.Delfin.M12"
              android:textFontWeight="500"
              android:textColor="@color/text_caption_secondary"
              android:text="@string/label_resend"
              />
          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/otpError"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@+id/otp_view"
              android:layout_weight="1"
              android:visibility="gone"
              android:text="@string/error_incorrect_otp"
              style="@style/TextAppearance.Delfin.M12"
              android:textColor="@color/text_error_primary" />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/btn_resend_otp"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:layout_marginStart="@dimen/size_8dp"
              android:textFontWeight="500"
              style="@style/TextAppearance.Delfin.M12"
              android:textColor="@color/text_info_blue_primary"
              tools:text="Resend OTP"
              />
        </LinearLayout>


        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_16dp"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="@dimen/size_24dp">

          <androidx.appcompat.widget.AppCompatButton
              android:id="@+id/btn_verify_otp"
              style="@style/ActionButton"
              android:layout_width="match_parent"
              android:enabled="false"
              android:text="@string/action_verify_otp"
              android:textAllCaps="false" />

          <ProgressBar
              android:id="@+id/progressVerifyOtp"
              android:layout_width="24dp"
              android:layout_height="24dp"
              android:layout_gravity="center"
              android:visibility="gone"
              android:indeterminateTint="@color/colorDelhiveryRed" />

        </FrameLayout>

      </RelativeLayout>
      </ScrollView>
    </FrameLayout>

  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>
