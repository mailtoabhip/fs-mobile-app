<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
  <data>
    <import type="com.delhivery.axle.ui.auth.AuthenticationUIState" />
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.auth.AuthenticationViewModel"
        />
    <variable
        name="state"
        type="com.delhivery.axle.ui.auth.AuthenticationUIState"
        />
  </data>
  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@android:color/white"
      android:orientation="vertical"
      >

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

      <!-- Phone no container -->
      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingStart="@dimen/size_24dp"
          android:paddingTop="@dimen/size_24dp"
          android:paddingEnd="@dimen/size_16dp"
          android:paddingBottom="@dimen/size_24dp"
          android:visibility="gone"
          bind:visibility="@{ state == AuthenticationUIState.PhoneNo }"
          >

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:text="@string/label_phone_number"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_24sp"
            android:textStyle="bold"
            />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical|start"
            android:orientation="horizontal"
            >

          <androidx.appcompat.widget.AppCompatTextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif-medium"
              android:lineSpacingExtra="@dimen/text_8sp"
              android:text="@string/label_isd_code"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_20sp"
              />

          <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
              android:id="@+id/edit_phone_no"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginStart="@dimen/size_10dp"
              android:layout_marginTop="@dimen/size_16dp"
              android:layout_marginEnd="@dimen/size_8dp"
              android:layout_marginBottom="16dp"
              android:background="@drawable/bg_login_edit"
              android:digits="1234567890"
              android:imeOptions="actionDone"
              android:inputType="phone"
              android:maxLength="10"
              android:paddingStart="@dimen/size_8dp"
              android:paddingEnd="@dimen/size_8dp"
              android:text="@={ viewModel.phoneNo }"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_20sp"
              />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_send_otp"
            style="@style/ActionButton"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_8dp"
            android:text="@string/action_send_otp"
            bind:shadow="@{ @dimen/action_btn_elevation }"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:layout_marginEnd="@dimen/size_8dp"
            android:fontFamily="sans-serif"
            android:gravity="center_horizontal"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="@dimen/text_4sp"
            android:text="@string/msg_send_otp_auth"
            android:textColor="@color/sub_heading_black"
            android:textSize="@dimen/text_14sp"
            />
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/login_using_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:layout_marginBottom="@dimen/size_14dp"
            android:fontFamily="sans-serif"
            android:layout_gravity="center"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="@dimen/text_4sp"
            android:text="Login by password"
            android:clickable="true"
            android:focusable="true"
            android:textColor="@color/sub_heading_black"
            android:textSize="@dimen/text_16sp"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/size_8dp"
            android:layout_marginBottom="@dimen/size_8dp"
            android:fontFamily="sans-serif"
            android:gravity="center_horizontal"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:text="@string/msg_contact_terms_auth"
            android:textColor="@color/sub_heading_black"
            />
      </androidx.appcompat.widget.LinearLayoutCompat>

      <!-- Password container -->
      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="@dimen/size_14dp"
          android:orientation="vertical"
          android:visibility="gone"
          bind:visibility="@{ state == AuthenticationUIState.Password }">
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:text="@string/action_login"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_24sp"
            android:textStyle="bold"
            />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_userId"
            style="@style/TextInputLayoutAppearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorEnabled="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >

          <androidx.appcompat.widget.AppCompatEditText
              android:id="@+id/edit_userId"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_4dp"
              android:background="@drawable/bg_form_edit"
              android:hint="@string/hint_user_name"
              android:imeOptions="actionDone"
              android:textSize="@dimen/text_14sp"
              />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_userPassword"
            style="@style/TextInputLayoutAppearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:errorEnabled="true"
            app:layout_constraintEnd_toEndOf="parent"
            android:hint="@string/hint_password"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            bind:passwordToggleEnabled="true"
            >

          <androidx.appcompat.widget.AppCompatEditText
              android:id="@+id/edit_userPassword"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_4dp"
              android:background="@drawable/bg_form_edit"
              android:imeOptions="actionDone"
              android:inputType="textPassword"
              android:textSize="@dimen/text_14sp"
              />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_11dp"
            android:textAllCaps="false"
            android:text="Login"
            android:background="@drawable/bg_all_round_corner_black"
            android:textColor="@color/white"/>
      </androidx.appcompat.widget.LinearLayoutCompat>

      <!-- OTP authentication container -->
      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingStart="@dimen/size_24dp"
          android:paddingTop="@dimen/size_24dp"
          android:paddingEnd="@dimen/size_16dp"
          android:paddingBottom="@dimen/size_24dp"
          bind:visibility="@{ state == AuthenticationUIState.OTP }"
          >

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:text="@string/label_otp"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_24sp"
            android:textStyle="bold"
            />

        <com.delhivery.axle.ui.custom.DelhiveryOTPView
            android:id="@+id/otp_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_otp_sent_to_phone_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8dp"
            android:fontFamily="sans-serif"
            android:gravity="center_horizontal"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="@dimen/text_4sp"
            android:textColor="@color/sub_heading_black"
            tools:text="We have send the otp to your phone number ending with (32)"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_resend_otp"
            style="@style/ActionButton"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_8dp"
            android:text="@string/action_resend_otp"
            bind:shadow="@{ @dimen/action_btn_elevation }"
            />

      </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>

  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>