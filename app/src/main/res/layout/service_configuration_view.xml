<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_service"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/size_16dp"
    app:cardBackgroundColor="#F7F7F7"
    app:cardCornerRadius="@dimen/size_16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Main Content Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/size_16dp"
            android:paddingStart="@dimen/size_16dp"
            android:paddingEnd="@dimen/size_16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_service_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/size_4dp"
                        android:textColor="#121212"
                        android:textSize="@dimen/text_16sp"
                        android:textStyle="bold"
                        tools:text="Fleet Carting" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_service_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#2B2B2B"
                        android:textSize="@dimen/text_12sp"
                        tools:text="Intracity fleet operations with own vehicles" />

                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_service_icon"
                    android:layout_width="@dimen/size_72dp"
                    android:layout_height="@dimen/size_42dp"
                    android:layout_gravity="center_vertical"
                    android:scaleType="fitCenter"
                    tools:src="@drawable/iv_fleet_carting" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/size_16dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_know_more"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size_36dp"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_info"
                    android:text="@string/know_more"
                    android:textAllCaps="false"
                    android:textColor="#2B2B2B"
                    android:textSize="@dimen/text_14sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_configure"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/size_36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_configure"
                    android:text="@string/configure"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/text_14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Status Banner (Yellow Pending Section) -->
        <LinearLayout
            android:id="@+id/status_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FEFAEC"
            android:orientation="horizontal"
            android:paddingStart="@dimen/size_16dp"
            android:paddingTop="@dimen/size_12dp"
            android:paddingEnd="@dimen/size_16dp"
            android:paddingBottom="@dimen/size_12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_status_icon"
                android:layout_width="@dimen/size_16dp"
                android:layout_height="@dimen/size_16dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/size_6dp"
                android:src="@drawable/iv_doc_pending_hourglass_load_services" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/size_2dp"
                    android:text="In Progress"
                    android:textColor="#7B6414"
                    android:textSize="@dimen/text_12sp"
                    android:textStyle="bold"
                    tools:text="In Progress" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_status_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1/3 Sections Completed"
                    android:textColor="#2B2B2B"
                    android:textSize="@dimen/text_12sp"
                    tools:text="1/3 Sections Completed" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
