<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.bids.DmtBidsActivity">


<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/background_rectangle_border"
    >


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/contOne"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginTop="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="MissingConstraints">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:id="@+id/titleContainer"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/size_10dp"
        android:orientation="horizontal"
        tools:ignore="MissingConstraints">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PLACE BIDS"
            android:id="@+id/tvTitle"
            android:textColor="@color/black"
            android:layout_weight="1"
            android:textSize="@dimen/size_20dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bulk Load :"
            android:id="@+id/tvLoad"
            android:textColor="@color/price_red"
            android:textSize="@dimen/size_20dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/price_red"
            android:id="@+id/tvLoadAmount"
            android:text="200 MT"
            android:textSize="@dimen/size_20dp"
            />

    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:id="@+id/originContainer"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/titleContainer"
        android:layout_marginTop="@dimen/size_10dp"
        android:orientation="horizontal"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panjim"
            android:id="@+id/tvOrigin"
            android:textColor="@color/black"
            android:textSize="@dimen/size_20dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=">"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:id="@+id/tvSeperator"
            android:textColor="@color/black"
            android:textSize="@dimen/size_20dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hyderabad"
            android:id="@+id/tvDestination"
            android:textColor="@color/black"
            android:layout_weight="1"
            android:textSize="@dimen/size_20dp"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_10dp"
            android:layout_marginEnd="@dimen/size_10dp"
            app:srcCompat="@drawable/ic_closed_truck"
            android:id="@+id/ivTruck"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvTruckBodyType"
            android:textColor="@color/black"
            android:text="Open"
            android:textSize="@dimen/size_20dp"
            />

    </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
<View
    android:layout_width="match_parent"
    app:layout_constraintTop_toBottomOf="@+id/contOne"
    android:layout_marginStart="@dimen/size_20dp"
    android:layout_marginEnd="@dimen/size_20dp"
    android:background="@drawable/background_rectangle_border"
    android:layout_height="3dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:id="@+id/rvBids"
        android:nestedScrollingEnabled="true"
        tools:listitem="@layout/view_dmt_bid_item"
        app:layout_constraintTop_toBottomOf="@+id/contOne"
        android:layout_marginStart="@dimen/size_20dp"
        android:scrollbars="vertical"
        android:layout_marginTop="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"
        android:layout_height="wrap_content"/>
        <View
            android:layout_width="match_parent"
            app:layout_constraintTop_toBottomOf="@+id/rvBids"
            android:layout_marginStart="@dimen/size_20dp"
            android:layout_marginEnd="@dimen/size_20dp"
            android:background="@drawable/background_rectangle_border"
            android:layout_height="3dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/contTwo"
        android:layout_marginTop="@dimen/size_10dp"
        android:layout_marginStart="@dimen/size_20dp"
        android:layout_marginEnd="@dimen/size_20dp"
        app:layout_constraintTop_toBottomOf="@+id/rvBids"

        >
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:id="@+id/detailCont"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_10dp"
            android:orientation="vertical"
            >
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+ Add"
                android:textAlignment="viewEnd"
                android:id="@+id/tvAdd"
                android:textColor="@color/blue"
                android:textSize="@dimen/size_20dp"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Additional Requirements"
                android:layout_marginStart="5dp"
                android:textStyle="bold"
                android:layout_marginEnd="5dp"
                android:id="@+id/tvAddReq"
                android:textSize="@dimen/size_20dp"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Express"
                android:id="@+id/tvReq1"
                android:layout_weight="1"
                android:textSize="@dimen/size_20dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvReq2"
                android:text="2. Mandatory GPS"
                android:textSize="@dimen/size_20dp"
                />

        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:id="@+id/detailAction"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/detailCont"
            android:layout_marginTop="@dimen/size_10dp"
            android:orientation="horizontal"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total volume being placed :"
                android:id="@+id/tvVolume"
                android:layout_weight="1"
                android:lines="2"
                android:layout_marginBottom="@dimen/size_20dp"
                android:textColor="@color/bid_placed_green"
                android:textSize="@dimen/size_20dp"
                />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                style="@style/Widget.AppCompat.ActionButton"
                android:id="@+id/btnCancel"
                android:textSize="@dimen/size_20dp"
                />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/btnOK"
                style="@style/Widget.AppCompat.ActionButton"
                android:background="@color/blue"
                android:text="Confirm"
                android:textColor="@color/white"
                android:textSize="@dimen/size_20dp"
                />

           </androidx.appcompat.widget.LinearLayoutCompat>


          </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>


</layout>