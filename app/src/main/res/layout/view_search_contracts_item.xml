<?xml version="1.0" encoding="utf-8"?>
<layout>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        xmlns:app="http://schemas.android.com/apk/res-auto">
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_marginTop="@dimen/size_8dp"
            android:id="@+id/edit_sticky_search"
            android:layout_width="0dp"
            android:layout_toStartOf="@+id/info"
            android:layout_alignParentStart="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_height="@dimen/size_38dp"
            android:drawableStart="@drawable/ic_search_trucks"
            app:layout_constraintEnd_toStartOf="@+id/info"
            android:text="Search Contracts"
            android:drawablePadding="@dimen/size_8dp"
            android:background="@drawable/bg_search_white_load"
            android:paddingBottom="@dimen/size_8dp"
            android:paddingTop="@dimen/size_8dp"
            android:textSize="@dimen/text_16sp"
            android:textColor="@color/heading_black"
            />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/info"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size_38dp"
            android:textAlignment="center"
            app:layout_constraintStart_toEndOf="@+id/edit_sticky_search"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/size_8dp"
            android:paddingStart="@dimen/size_8dp"
            android:src="@drawable/icon_info"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>