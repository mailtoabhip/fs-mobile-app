<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_rounded_top"
        android:paddingTop="@dimen/size_16dp"
        android:paddingBottom="@dimen/size_32dp"
        android:paddingStart="@dimen/size_20dp"
        android:paddingEnd="@dimen/size_20dp">

        <!-- Close button -->
        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="@dimen/size_24dp"
            android:layout_height="@dimen/size_24dp"
            android:src="@drawable/ic_close_black"
            android:contentDescription="Close"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Success Icon -->
        <ImageView
            android:id="@+id/ivSuccess"
            android:layout_width="@dimen/size_64dp"
            android:layout_height="@dimen/size_64dp"
            android:src="@drawable/ic_vector_circle_check"
            android:layout_marginTop="@dimen/size_16dp"
            android:layout_marginBottom="@dimen/size_16dp"
            app:layout_constraintTop_toBottomOf="@id/ivClose"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="#00A651" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your dispute has been\nsubmitted"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:gravity="center"
            android:layout_marginTop="@dimen/size_16dp"
            app:layout_constraintTop_toBottomOf="@id/ivSuccess"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Ticket ID Card -->
        <LinearLayout
            android:id="@+id/llTicketId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_bottom_sheet_rounded_top"
            android:backgroundTint="#F1F5F9"
            android:padding="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_24dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ticket ID:   "
                android:textSize="14sp"
                android:textColor="#64748B" />

            <TextView
                android:id="@+id/tvTicketId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_14sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

        </LinearLayout>

        <!-- Go to loads button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGoToLoads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_all_rounded_black"
            android:text="Go to home"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:minHeight="52dp"
            android:layout_marginTop="@dimen/size_24dp"
            app:layout_constraintTop_toBottomOf="@id/llTicketId"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
