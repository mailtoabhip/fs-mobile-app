<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.delhivery.axle.ui.fastag.FastagRechargeViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_screen_gradient">

        <!-- Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/size_56dp"
            android:background="@android:color/white"
            android:fitsSystemWindows="true"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivBack"
                android:layout_width="45dp"
                android:layout_height="25dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:paddingStart="@dimen/size_4dp"
                android:src="@drawable/ic_back_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/heading_black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recharge_fastag"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivBack"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/layoutHeader"
            app:layout_constraintBottom_toTopOf="@id/layoutSlideToRecharge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <!-- Vehicle Info Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardVehicleInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_16dp"
            app:cardCornerRadius="@dimen/size_16dp"
            app:cardElevation="@dimen/size_1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/size_20dp">

                <!-- Vehicle Number and Balance -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvVehicleNumber"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/size_8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textSize="@dimen/text_18sp"
                        android:textStyle="bold"
                        android:textColor="#1E293B"
                        tools:text="DL79FL7982" />

                    <TextView
                        android:id="@+id/tvFastagBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_14sp"
                        android:textColor="#6B7280"
                        tools:text="FASTag Balance: ₹0" />
                </LinearLayout>

                <!-- Add Amount Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_20dp"
                    android:text="@string/add_amount"
                    android:textColor="#4B5563"
                    android:textSize="@dimen/text_14sp" />

                <!-- Amount Input -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_amount_input_border"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_amount_prefix"
                        android:gravity="center"
                        android:paddingStart="@dimen/size_16dp"
                        android:paddingEnd="17dp"
                        android:text="₹"
                        android:textColor="#4B5563"
                        android:textSize="@dimen/text_16sp" />

                    <View
                        android:layout_width="@dimen/size_1dp"
                        android:layout_height="match_parent"
                        android:background="#E5E7EB" />

                    <EditText
                        android:id="@+id/etAmount"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="0"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="@dimen/size_16dp"
                        android:textColor="#1E293B"
                        android:textSize="@dimen/text_18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAmountError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_4dp"
                    android:text="Please enter amount between ₹1 to ₹100000"
                    android:textColor="#DC2626"
                    android:textSize="@dimen/text_12sp"
                    android:visibility="gone" />

                <!-- Quick Amount Chips -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_20dp"
                    android:paddingTop="@dimen/size_4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip500"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_amount_chip"
                        android:paddingHorizontal="@dimen/size_20dp"
                        android:paddingVertical="@dimen/size_8dp"
                        android:text="₹500"
                        android:textColor="#334155"
                        android:textSize="@dimen/text_14sp" />

                    <TextView
                        android:id="@+id/chip1000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size_8dp"
                        android:background="@drawable/bg_amount_chip"
                        android:paddingHorizontal="@dimen/size_20dp"
                        android:paddingVertical="@dimen/size_8dp"
                        android:text="₹1000"
                        android:textColor="#334155"
                        android:textSize="@dimen/text_14sp" />

                    <TextView
                        android:id="@+id/chip1500"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/size_8dp"
                        android:background="@drawable/bg_amount_chip"
                        android:paddingHorizontal="@dimen/size_20dp"
                        android:paddingVertical="@dimen/size_8dp"
                        android:text="₹1500"
                        android:textColor="#334155"
                        android:textSize="@dimen/text_14sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Wallet Section -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardWallet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_16dp"
            app:cardCornerRadius="@dimen/size_16dp"
            app:cardElevation="@dimen/size_1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/size_16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivWalletIcon"
                        android:layout_width="@dimen/size_36dp"
                        android:layout_height="@dimen/size_36dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_delhivery_wallet"
                        android:contentDescription="Wallet" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/size_12dp"
                        android:layout_marginEnd="@dimen/size_8dp"
                        android:layout_toStartOf="@id/tvAddMoney"
                        android:layout_toEndOf="@id/ivWalletIcon"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Paying via: Delhivery Wallet"
                            android:textColor="#1E293B"
                            android:textSize="@dimen/text_14sp"
                            android:textStyle="bold"
                            android:ellipsize="end"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/tvWalletBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#6B7280"
                            android:textSize="@dimen/text_12sp"
                            tools:text="₹0" />

                        <TextView
                            android:id="@+id/tvLowBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#DC2626"
                            android:textSize="@dimen/text_12sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="LOW BALANCE: ₹250" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAddMoney"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="@string/add_money"
                        android:textAllCaps="true"
                        android:textColor="#2563EB"
                        android:textSize="@dimen/text_12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Low Balance Warning Banner -->
                <LinearLayout
                    android:id="@+id/layoutInsufficientBalance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_12dp"
                    android:background="@drawable/bg_low_balance_warning"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/size_12dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/size_20dp"
                        android:layout_height="@dimen/size_20dp"
                        android:layout_marginEnd="@dimen/size_8dp"
                        android:src="@drawable/ic_warning_amber"
                        android:contentDescription="Warning" />

                    <TextView
                        android:id="@+id/tvInsufficientMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#D97706"
                        android:textSize="@dimen/text_12sp"
                        tools:text="Please add at least ₹750 to your Delhivery Wallet to recharge your FASTag" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Payment Summary -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_16dp"
            android:layout_marginBottom="@dimen/size_16dp"
            app:cardCornerRadius="@dimen/size_16dp"
            app:cardElevation="@dimen/size_1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/size_20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/payment_summary"
                    android:textColor="#1E293B"
                    android:textSize="@dimen/text_16sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16dp"
                    android:paddingTop="@dimen/size_12dp"
                    android:paddingBottom="13dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="@string/recharge_amount"
                        android:textColor="#4B5563"
                        android:textSize="@dimen/text_16sp" />

                    <TextView
                        android:id="@+id/tvRechargeAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:textColor="#1E293B"
                        android:textSize="@dimen/text_16sp"
                        android:textStyle="bold"
                        tools:text="₹500" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_1dp"
                    android:background="#F3F4F6" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="@string/payable_amount"
                        android:textColor="#1E293B"
                        android:textSize="@dimen/text_16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPayableAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:textColor="#1E293B"
                        android:textSize="@dimen/text_18sp"
                        android:textStyle="bold"
                        tools:text="₹500" />
                </RelativeLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

        <!-- Slide to Recharge Section -->
        <LinearLayout
            android:id="@+id/layoutSlideToRecharge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/size_16dp"
            android:paddingTop="@dimen/size_16dp"
            android:paddingBottom="@dimen/size_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_1dp"
                android:layout_marginBottom="17dp"
                android:background="#F3F4F6" />

            <!-- Blacklisted Warning Banner -->
            <LinearLayout
                android:id="@+id/layoutBlacklistWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_warning_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/size_12dp"
                android:layout_marginBottom="@dimen/size_12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/size_20dp"
                    android:layout_height="@dimen/size_20dp"
                    android:layout_marginEnd="@dimen/size_8dp"
                    android:src="@drawable/ic_info_outline"
                    android:contentDescription="Warning"
                    app:tint="#212121" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Your FASTag is currently blacklisted. Recharge request may be decline by the bank."
                    android:textColor="#212121"
                    android:textSize="@dimen/text_14sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/slideToPayContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_56dp"
                android:background="@drawable/bg_slide_to_pay">

                <TextView
                    android:id="@+id/tvSlideLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/slide_to_pay"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/text_18sp" />

                <ImageView
                    android:id="@+id/ivSlideThumb"
                    android:layout_width="@dimen/size_56dp"
                    android:layout_height="@dimen/size_36dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/size_8dp"
                    android:background="@drawable/bg_slide_thumb"
                    android:padding="@dimen/size_6dp"
                    android:src="@drawable/ic_chevron_right_double"
                    android:contentDescription="Slide" />

                <ImageView
                    android:id="@+id/ivCheckIcon"
                    android:layout_width="@dimen/size_56dp"
                    android:layout_height="@dimen/size_36dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:background="@drawable/bg_slide_thumb"
                    android:padding="@dimen/size_6dp"
                    android:src="@drawable/ic_check"
                    android:visibility="gone"
                    android:contentDescription="Done" />
            </FrameLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
