<?xml version="1.0" encoding="utf-8"?>
<com.dfd.delfin.ui.custom.DelhiveryShimmerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/size_16dp"
    android:layout_marginBottom="@dimen/size_12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_service_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/size_16dp">

        <!-- Icon placeholder -->
        <View
            android:layout_width="@dimen/size_40dp"
            android:layout_height="@dimen/size_40dp"
            android:background="@color/colorShimmerPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title placeholder -->
            <View
                android:layout_width="120dp"
                android:layout_height="@dimen/size_16dp"
                android:background="@color/colorShimmerPrimary" />

            <!-- Subtitle placeholder -->
            <View
                android:layout_width="80dp"
                android:layout_height="@dimen/size_12dp"
                android:layout_marginTop="@dimen/size_6dp"
                android:background="@color/colorShimmerSecondary" />
        </LinearLayout>

        <!-- Arrow placeholder -->
        <View
            android:layout_width="@dimen/size_20dp"
            android:layout_height="@dimen/size_20dp"
            android:background="@color/colorShimmerSecondary" />
    </LinearLayout>

</com.dfd.delfin.ui.custom.DelhiveryShimmerLayout>
