<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.paymentdetails.VendorPolicyActivity">

    <data>

        <import type="android.view.View" />

    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            app:navigationIcon="@drawable/ic_close_black"
            android:layout_height="@dimen/height_toolbar"
            android:background="@android:color/white"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/toolbar"
            android:layout_above="@+id/vendor_policy_text"
            >

        <!-- Place Web-view on the Screen -->
        <WebView
            android:id="@+id/webView"
            android:isScrollContainer="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/vendor_policy_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/vendor_policy_link"
        android:autoLink="web"
        android:layout_marginTop="@dimen/size_16dp"
        android:text="@string/sub_label_vendor_policy"
        android:textAlignment="center"
        android:textColor="@color/sub_heading_black"
        android:linksClickable="true"
        />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/vendor_policy_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/button_i_agree"
            android:autoLink="web"
            android:visibility="visible"
             android:layout_marginBottom="@dimen/size_16dp"
            android:text="@string/sub_label_vendor_link"
            android:textAlignment="center"
            android:textColor="@color/link"
            android:linksClickable="true"
            />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_i_agree"
        android:layout_width="match_parent"
        style="@style/ActionButton"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/size_16dp"
        android:layout_marginStart="@dimen/size_16dp"
        android:layout_marginBottom="@dimen/size_16dp"
        android:layout_height="wrap_content"
        android:text="@string/label_i_agree"
        />
    </RelativeLayout>

</layout>