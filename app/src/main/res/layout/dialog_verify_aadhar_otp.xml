<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/size_24dp"
        android:background="@drawable/bg_bottom_dialog">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_marginTop="@dimen/size_12dp"
            app:layout_constraintStart_toEndOf="@+id/close_btn"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_12dp"
            android:textColor="@color/heading_black"
            android:layout_gravity="center"
            android:textSize="@dimen/text_16sp"
            android:id="@+id/label_gst"
            android:layout_marginStart="@dimen/size_12dp"
            android:layout_toEndOf="@+id/close_btn"
            android:text="@string/label_gst_dialog_option1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close_btn"
            android:layout_marginTop="@dimen/size_16dp"
            android:layout_marginEnd="@dimen/size_10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="@dimen/size_24dp"
            android:layout_alignParentStart="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_vector_back"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_4dp"
            android:id="@+id/sepLine"
            android:layout_marginTop="@dimen/size_12dp"
            app:layout_constraintTop_toBottomOf="@+id/label_gst"
            app:srcCompat="@drawable/seperator_line"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/labelOtpGst"
            app:layout_constraintTop_toBottomOf="@+id/sepLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/size_32dp"
            android:textAlignment="center"
            android:textSize="@dimen/text_14sp"
            android:text="@string/label_otp_aadhaar"
            android:textColor="@color/sub_heading_black"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/otpNum"
            app:layout_constraintTop_toBottomOf="@+id/labelOtpGst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:textSize="@dimen/text_14sp"
            android:textColor="@color/sub_heading_black"
            />

        <com.delhivery.axle.ui.custom.DelhiveryOTPViewSix
            android:id="@+id/otp_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/otpNum"
            android:layout_marginTop="@dimen/size_32dp"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/gstotpError"
            app:layout_constraintTop_toBottomOf="@+id/otp_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="start"
            android:layout_marginTop="@dimen/size_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:textSize="@dimen/text_14sp"
            android:visibility="gone"
            android:text="@string/error_invalid_otp"
            android:textColor="@color/error_red"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btn_resend_otp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/size_24dp"
            android:text="RESEND OTP"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gstotpError"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_share"
            android:layout_width="match_parent"
            style="@style/ActionButton"
            android:textAllCaps="false"
            android:enabled="false"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_24dp"
            android:layout_marginStart="@dimen/size_24dp"
            android:layout_height="wrap_content"
            android:text="@string/action_verify_otp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_resend_otp"

            />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>