<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

  <data>
    <import type="com.delhivery.axle.ui.accountsetup.AccountSetupUIState" />
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.accountsetup.AccountSetupViewModel"
        />
    <variable
        name="state"
        type="com.delhivery.axle.ui.accountsetup.AccountSetupUIState"
        />
  </data>

  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/blue_bg"
      android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

      <ProgressBar
          style="?android:attr/progressBarStyleHorizontal"
          android:layout_width="match_parent"
          android:layout_height="6dp"
          android:id="@+id/progress"
          android:layout_marginBottom="@dimen/size_24dp"
          android:layout_marginTop="@dimen/size_24dp"
          android:layout_marginEnd="@dimen/size_24dp"
          android:layout_marginStart="@dimen/size_24dp"
          android:max="100"
          android:progressDrawable="@drawable/account_progress"
          android:progress="33"/>

      <!-- Phone no container -->
      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingStart="@dimen/size_24dp"
          android:paddingTop="@dimen/size_24dp"
          android:paddingEnd="@dimen/size_24dp"
          android:paddingBottom="@dimen/size_48dp"
          android:visibility="gone"
          bind:visibility="@{ state == AccountSetupUIState.PrimaryAction }"
          >

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:text="@string/label_phone_number"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_24sp"
            android:id="@+id/labelPhone"
            android:textStyle="bold"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12dp"
            android:fontFamily="sans-serif"
            android:id="@+id/sub_label_phone"
            android:layout_below="@+id/labelPhone"
            android:text="@string/sub_label_phone_number"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/sub_label_phone"
            android:gravity="center_vertical|start"
            android:orientation="horizontal">

          <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
              android:id="@+id/edit_phone_no"
              android:layout_width="match_parent"
              android:layout_height="@dimen/edit_text_height"
              android:layout_marginTop="@dimen/size_32dp"
              android:layout_marginBottom="16dp"
              android:background="@drawable/bg_login_edit"
              android:digits="1234567890"
              android:imeOptions="actionDone"
              android:inputType="phone"
              android:maxLength="10"
              android:paddingStart="@dimen/size_12dp"
              android:paddingEnd="@dimen/size_12dp"
              android:hint="Mobile number"
             android:textColor="@color/heading_black"
              android:textSize="@dimen/text_16sp"
              />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_send_otp"
            style="@style/ActionButton"
            android:enabled="false"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/size_24dp"
           android:text="@string/action_send_otp"
          />

      </RelativeLayout>

      <!-- OTP authentication container -->
      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:orientation="vertical"
          android:paddingStart="@dimen/size_24dp"
          android:paddingTop="@dimen/size_24dp"
          android:paddingEnd="@dimen/size_24dp"
          android:paddingBottom="@dimen/size_48dp"
          bind:visibility="@{ state == AccountSetupUIState.UserRole }"
          >

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:text="@string/label_otp"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_24sp"
            android:textStyle="bold"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:text="@string/label_otp"
            android:id="@+id/labelotp"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_24sp"
            android:textStyle="bold"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_otp_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12dp"
            android:fontFamily="sans-serif"
            android:gravity="start"
            android:textSize="@dimen/text_16sp"
            android:text="@string/label_otp_text"
            android:layout_below="@+id/labelotp"
            android:textColor="@color/sub_heading_black"
            tools:text="Enter the 4-digit code we have sent by SMS"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_otp_sent_to_phone_no"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
           android:fontFamily="sans-serif"
            android:gravity="start"
            android:textSize="@dimen/text_16sp"
            android:layout_below="@+id/text_otp_label"
            android:textColor="@color/sub_heading_black"
            tools:text="to 8695900493"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btn_change_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:textSize="@dimen/text_16sp"
            android:layout_marginStart="@dimen/size_12dp"
            android:layout_toEndOf="@+id/text_otp_sent_to_phone_no"
            android:layout_below="@+id/text_otp_label"
            android:textColor="@color/colorAccent"
            android:text="@string/action_change_number"
            tools:text="Change number"
            />
        <com.delhivery.axle.ui.custom.DelhiveryOTPView
            android:id="@+id/otp_view"
            android:layout_below="@+id/text_otp_sent_to_phone_no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_32dp"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_below="@+id/otp_view"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_resend"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
           android:textSize="@dimen/text_16sp"
            android:textColor="@color/sub_heading_black"
            android:text="@string/label_resend"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btn_resend_otp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/size_8dp"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            android:textColor="@color/colorAccent"
            tools:text="Resend OTP"
            />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_verify_otp"
            style="@style/ActionButton"
            android:enabled="false"
            android:textAllCaps="false"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_8dp"
            android:text="@string/action_verify_otp"
           />

      </RelativeLayout>
    </FrameLayout>

  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>



