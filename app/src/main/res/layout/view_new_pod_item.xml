<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tool="http://schemas.android.com/tools">
    <data>
        <variable
            name="trip"
            type="com.delhivery.axle.data.home.trips.HomeTripsItemData"
            />
        <import type="android.view.View" />
        <import type="com.delhivery.axle.data.home.trips.TripStatus" />
        <import type="androidx.core.content.ContextCompat" />
    </data>

    <androidx.cardview.widget.CardView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_2dp"
        android:layout_marginEnd="@dimen/size_2dp"
        android:layout_marginBottom="@dimen/size_12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:cardCornerRadius="@dimen/size_6dp"
        app:cardElevation="@dimen/size_2dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/size_16dp">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_status_duration"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/text_size_12sp"
                android:textColor="@color/colorDelhiveryRed"
                android:contentDescription="@string/delay_status_content_description"
                tool:text="Delayed by 3 days" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPodStatus"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                tool:background="@drawable/bg_all_rounded_delhivery"
                android:textStyle="bold"
                android:textSize="@dimen/text_12sp"
                tool:text="ePod Verified"
                />
            <View
                android:id="@+id/divider"
                android:layout_marginTop="@dimen/size_8dp"
                android:background="@color/bg_light_grey"
                app:layout_constraintTop_toBottomOf="@+id/tvPodStatus"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <include layout="@layout/view_origin_destination"
                android:id="@+id/originDestination"
                app:layout_constraintTop_toBottomOf="@+id/divider"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                />

            <include layout="@layout/view_vehicle_loaded_details"
                android:id="@+id/vehicleLoadedDetails"
                app:layout_constraintTop_toBottomOf="@+id/originDestination"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:trip="@{trip}"
                />

            <include layout="@layout/view_pod_actions"
                android:id="@+id/podActions"
                app:layout_constraintTop_toBottomOf="@+id/vehicleLoadedDetails"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12dp"
                app:trip="@{trip}"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>
