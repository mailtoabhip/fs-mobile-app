<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    >

  <data>
    <variable
        name="transaction"
        type="com.dfd.delfin.data.transactions.TransactionsItemData"
        />

    <variable
        name="bank"
        type="String"
        />

    <import type="androidx.core.content.ContextCompat" />
  </data>

  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      >

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_8dp"
        android:layout_marginEnd="@dimen/size_8dp"
        android:layout_marginTop="@dimen/size_8dp"
        android:layout_marginBottom="@dimen/size_4dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:cardCornerRadius="@dimen/size_6dp"
        app:cardElevation="2dp"
        >

      <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/layout_from"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="@dimen/size_12dp"
          >

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_payee_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@{transaction.fromAccName}"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_20sp"
            app:layout_constraintBottom_toBottomOf="@+id/img_transaction"
            app:layout_constraintStart_toEndOf="@+id/img_transaction"
            app:layout_constraintTop_toTopOf="@+id/img_transaction"
            tools:text="From account name"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_transaction"
            android:layout_width="@dimen/size_56dp"
            android:layout_height="@dimen/size_56dp"
            android:layout_marginStart="@dimen/size_12dp"
            android:layout_marginTop="@dimen/text_16sp"
            app:srcCompat="@drawable/ic_wallet"
            android:paddingTop="@dimen/size_8dp"
            android:paddingBottom="@dimen/size_12dp"
            android:background="@drawable/bg_circular_boundary_black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/id1"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/id1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_transferred_from"
            android:textSize="@dimen/text_16sp"
            android:textColor="@color/heading_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

      </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_8dp"
        android:layout_marginEnd="@dimen/size_8dp"
        android:layout_marginTop="@dimen/size_4dp"
        android:layout_marginBottom="@dimen/size_4dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:cardCornerRadius="@dimen/size_6dp"
        app:cardElevation="2dp"
        >

      <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="@dimen/size_12dp"
          >

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_acc_num"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_account_number"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/id2"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_acc_num"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/size_8dp"
            android:layout_marginStart="@dimen/size_8dp"
            android:fontFamily="sans-serif"
            android:gravity="end"
            android:text="@{transaction.accNumber()}"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/label_acc_num"
            app:layout_constraintTop_toTopOf="@+id/label_acc_num"
            tools:text="1234567890"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_owner_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_account_owner"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_acc_num"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_owner_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_8dp"
            android:layout_marginStart="@dimen/size_8dp"
            android:fontFamily="sans-serif"
            android:gravity="end"
            android:text="@{transaction.toAccName}"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            app:layout_constraintEnd_toEndOf="@+id/text_acc_num"
            app:layout_constraintStart_toEndOf="@+id/label_owner_name"
            app:layout_constraintTop_toTopOf="@+id/label_owner_name"
            tools:text="qwertyuio"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_advance_utr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_utr_number"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_owner_name"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_utr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_8dp"
            android:layout_marginStart="@dimen/size_8dp"
            android:fontFamily="sans-serif"
            android:gravity="end"
            android:text="@{transaction.referenceNo}"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            app:layout_constraintEnd_toEndOf="@+id/text_acc_num"
            app:layout_constraintStart_toEndOf="@+id/label_status"
            app:layout_constraintTop_toTopOf="@+id/label_advance_utr"
            tools:text="1234567890"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/label_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_transaction_status"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/text_utr"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_8dp"
            android:layout_marginStart="@dimen/size_8dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:text="@{transaction.status()}"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            bind:textColor="@{ ContextCompat.getColor(context, transaction.requiredStatusColor()) }"
            app:layout_constraintEnd_toEndOf="@+id/text_acc_num"
            app:layout_constraintStart_toEndOf="@+id/label_status"
            app:layout_constraintTop_toTopOf="@+id/label_status"
            tools:text="Processing"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/id2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_transferred_to"
            android:textSize="@dimen/text_16sp"
            android:textColor="@color/heading_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

      </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

  </androidx.appcompat.widget.LinearLayoutCompat>

</layout>