<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="request"
        type="com.delhivery.orion.data.home.bids.HomeBidsRequestItemData"
        />
  </data>
  <android.support.v7.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/size_6dp"
      android:layout_marginEnd="@dimen/size_8dp"
      android:layout_marginStart="@dimen/size_8dp"
      android:layout_marginTop="@dimen/size_6dp"
      android:clickable="true"
      android:focusable="true"
      android:foreground="?attr/selectableItemBackgroundBorderless"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="@dimen/size_2dp"
      >

    <android.support.constraint.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:paddingBottom="@dimen/size_16dp"
        android:paddingEnd="@dimen/size_16dp"
        android:paddingStart="@dimen/size_16dp"
        android:paddingTop="@dimen/size_12dp"
        >

      <android.support.v7.widget.AppCompatImageView
          android:id="@+id/img_forward"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:srcCompat="@drawable/ic_arrow_forward_black"
          />

      <TextView
          android:id="@+id/text_source_city"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif"
          android:text="@{request.origin}"
          android:textColor="#de000000"
          android:textSize="@dimen/text_16sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="@id/img_forward"
          tools:text="Goa"
          />

      <TextView
          android:id="@+id/text_source_state"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="@{request.originState}"
          android:textColor="#99000000"
          android:textSize="@dimen/text_14sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_source_city"
          tools:text="Goa"
          />

      <TextView
          android:id="@+id/text_destination_city"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_24dp"
          android:fontFamily="sans-serif"
          android:text="@{request.destination}"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_16sp"
          android:textStyle="normal"
          app:layout_constraintStart_toEndOf="@id/img_forward"
          app:layout_constraintTop_toTopOf="@id/img_forward"
          tools:text="Goa"
          />

      <TextView
          android:id="@+id/text_destination_state"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif"
          android:text="@{request.destinationState}"
          android:textColor="@color/sub_heading_black"
          android:textSize="@dimen/text_14sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="@id/text_destination_city"
          app:layout_constraintTop_toBottomOf="@id/text_source_city"
          tools:text="Goa"
          />

      <TextView
          android:id="@+id/text_date_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_16dp"
          android:lineSpacingExtra="4sp"
          android:text="@{request.requiredAt()}"
          android:textColor="@color/white"
          android:textSize="@dimen/text_12sp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_source_state"
          bind:drawableResId="@{ request.requiredAtBg() }"
          tools:text="Today"
          />

      <android.support.v7.widget.AppCompatImageView
          android:id="@+id/img_truck_type"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="@id/text_truck_details"
          app:srcCompat="@{ request.truckTypeDrawableRes() }"
          />

      <TextView
          android:id="@+id/text_truck_details"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_8dp"
          android:fontFamily="sans-serif"
          android:text="@{request.truckTypeDetails()}"
          android:textColor="@color/sub_heading_black"
          android:textSize="@dimen/text_14sp"
          android:textStyle="normal"
          app:layout_constraintStart_toEndOf="@id/img_truck_type"
          app:layout_constraintTop_toTopOf="@id/text_date_time"
          tools:text="Goa Gao goa goa"
          />

      <TextView
          android:id="@+id/text_load_details"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_4dp"
          android:fontFamily="sans-serif-medium"
          android:text="@{request.loadDetails()}"
          android:textColor="@color/colorAccent"
          android:textSize="@dimen/text_12sp"
          android:textStyle="normal"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_date_time"
          tools:text="Goa goa goa"
          />

      <TextView
          android:id="@+id/text_amount"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_14dp"
          android:fontFamily="sans-serif-medium"
          android:letterSpacing="0.01"
          android:lineSpacingExtra="-2sp"
          android:text="@{request.targetPrice()}"
          android:textColor="#000000"
          android:textSize="@dimen/text_20sp"
          android:textStyle="bold"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/text_load_details"
          tools:text="₹ 23900.00"
          />

    </android.support.constraint.ConstraintLayout>
  </android.support.v7.widget.CardView>
</layout>