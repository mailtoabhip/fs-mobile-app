<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
    <data>
        <variable
            name="route"
            type="String"
            />

        <variable
            name="page"
            type="String"
            />

        <variable
            name="request"
            type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData"
            />

        <import type="android.view.View" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:paddingStart="@dimen/size_24dp"
        android:paddingTop="@dimen/size_24dp"
        android:paddingEnd="@dimen/size_24dp"
        android:paddingBottom="@dimen/size_4dp"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="@dimen/text_8sp"
                tools:text="@string/label_place_bid"
                android:text="@{page}"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/id2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="@dimen/text_8sp"
                android:paddingStart="@dimen/size_8dp"
                android:paddingEnd="@dimen/size_8dp"
                android:text="@{request.setDmtText()}"
                android:textColor="@color/price_red"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                tools:text="Bulk Load: 100 MT"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_route_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_6dp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="@dimen/text_14sp"
            android:textSize="@dimen/size_16dp"
            android:text="@{ route }"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:textColor="@color/heading_black"
            tools:text="GA - MH"
            />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/id1"
                android:layout_width="wrap_content"
                app:srcCompat="@drawable/ic_closed_truck"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/size_8dp"
                android:paddingEnd="@dimen/size_8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/id3"
                app:layout_constraintTop_toTopOf="parent"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/id3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/size_8dp"
                android:text="@{request.setTruckTypeText()}"
                android:textSize="@dimen/text_14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Open"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBids"
            android:layout_marginBottom="@dimen/size_16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            tools:listitem="@layout/view_bid_create_edit_item"
            tools:itemCount="2" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+ Add"
                    app:layout_constraintTop_toBottomOf="@+id/rvBids"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:textAlignment="viewEnd"
                    android:id="@+id/tvAdd"
                    android:textColor="@color/blue"
                    android:textSize="@dimen/size_20dp"
                    />
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/additional_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4dp"
            app:layout_constraintTop_toBottomOf="@+id/tvAdd"
            android:visibility="@{request.isExpress()? View.VISIBLE : View.GONE }"
            android:orientation="vertical"
            >
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Additional Requirements:"
                android:layout_marginTop="@dimen/size_6dp"
                android:textColor="@color/sub_heading_black"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@{request.expressText(true)}"
                android:textColor="@color/sub_heading_black"
                tools:text="1. Express"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="2. Mandatory GPS"
                android:textColor="@color/sub_heading_black"
                />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12dp"
            app:layout_constraintTop_toBottomOf="@+id/additional_txt"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="horizontal"
            >
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="@dimen/size_130dp"
                android:layout_height="wrap_content"
                tools:text="Total Volume being placed: 89 MT"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:text="@{request.setAllocatedText()}"
                android:textColor="@color/bid_placed_green"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1.8"
                android:gravity="end"
                android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_cancel"
                style="@style/Widget.AppCompat.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@android:string/cancel"
                android:background="@drawable/background_rectangle_border_blue"
                android:textColor="@color/blue"
                android:textSize="@dimen/text_14sp"
                />

            <View
                android:layout_width="@dimen/size_14dp"
                android:layout_height="0dp"
                />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_confirm"
                style="@style/Widget.AppCompat.Button.Borderless.Colored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="@drawable/rounded_layout"
                android:backgroundTint="@color/blue"
                android:text="@string/action_confirm"
                android:textColor="@color/white"
                android:textSize="@dimen/text_14sp"
                />
            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>