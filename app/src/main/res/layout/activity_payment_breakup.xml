<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.dfd.delfin.ui.fastag.issuance.PaymentBreakupViewModel" />

        <import type="android.view.View" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:fitsSystemWindows="true"
        tools:context=".ui.fastag.issuance.PaymentBreakupActivity">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_toolbar"
            android:background="@android:color/white"
            app:contentInsetStartWithNavigation="@dimen/size_8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:navigationIcon="@drawable/ic_close"
            app:title="Payment Breakup"
            app:titleTextAppearance="@style/Toolbar.TitleText" />

        <View
            android:id="@+id/dividerTop"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_1dp"
            android:background="#E6E6E6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar"/>

        <!-- Content ScrollView -->
        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/btnProceedToPay"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerTop">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/size_16dp">

                <!-- Title -->
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Breakup"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_18sp"
                    style="@style/TextAppearance.Delfin.B16" />

                <!-- Breakup Items RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvBreakup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16dp"
                    android:nestedScrollingEnabled="false" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/size_16dp"
                    android:background="#E0E3EB" />

                <!-- Grand Total -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Grand Total"
                        android:textColor="@color/text_primary"
                        style="@style/TextAppearance.Delfin.B16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvGrandTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{`₹` + viewModel.grandTotal}"
                        android:textColor="@color/heading_black"
                        style="@style/TextAppearance.Delfin.B16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="₹3399" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Wallet Section -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWallet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_24dp"
                    android:visibility="@{viewModel.isDataLoaded ? View.VISIBLE : View.GONE}"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/size_8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E0E3EB"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/size_16dp">

                        <!-- Wallet info row -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivWalletIcon"
                                android:layout_width="@dimen/size_24dp"
                                android:layout_height="@dimen/size_24dp"
                                android:src="@drawable/ic_delhivery_wallet"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/size_8dp"
                                android:orientation="vertical"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/tvAddMoney"
                                app:layout_constraintStart_toEndOf="@id/ivWalletIcon"
                                app:layout_constraintTop_toTopOf="parent">

                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/stR_paying_via_wallet"
                                    android:textColor="@color/text_primary"
                                    style="@style/TextAppearance.Delfin.M14" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/tvWalletBalance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{`Wallet Balance: ₹` + viewModel.walletBalance}"
                                    android:textColor="@color/text_caption_primary"
                                    style="@style/TextAppearance.Delfin.M12"
                                    tools:text="Wallet Balance: ₹0" />

                            </LinearLayout>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvAddMoney"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Add Money"
                                android:textColor="#1E88E5"
                                style="@style/TextAppearance.Delfin.SB14"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- Warning message -->
                        <LinearLayout
                            android:id="@+id/warningContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/size_12dp"
                            android:background="@drawable/bg_warning_container"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/size_8dp"
                            android:visibility="@{(viewModel.isDataLoaded &amp;&amp; !viewModel.isWalletSufficient) ? View.VISIBLE : View.GONE}">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="@dimen/size_16dp"
                                android:layout_height="@dimen/size_16dp"
                                android:src="@drawable/ic_error_circle_red" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvWarningMessage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/size_8dp"
                                android:text="@{viewModel.warningMessage}"
                                android:textColor="#E53935"
                                style="@style/TextAppearance.Delfin.R14"
                                android:textSize="@dimen/text_12sp"
                                tools:text="Wallet balance is lower than the item value" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

        <!-- Proceed to Pay Button (visible when wallet insufficient) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnProceedToPay"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_48dp"
            android:layout_marginHorizontal="@dimen/size_16dp"
            android:layout_marginBottom="@dimen/size_16dp"
            android:background="@drawable/bg_all_round_corner_light_grey"
            android:enabled="false"
            android:text="@string/stR_proceed_to_pay"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            style="@style/TextAppearance.Delfin.SB14"
            android:textSize="@dimen/text_16sp"
            android:visibility="@{(viewModel.isDataLoaded &amp;&amp; !viewModel.isWalletSufficient) ? View.VISIBLE : View.GONE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Slide to Continue (visible when wallet sufficient) -->
        <com.dfd.delfin.ui.custom.SlideToConfirmView
            android:id="@+id/slideToConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/size_16dp"
            android:layout_marginBottom="@dimen/size_16dp"
            android:visibility="@{(viewModel.isDataLoaded &amp;&amp; viewModel.isWalletSufficient) ? View.VISIBLE : View.GONE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
