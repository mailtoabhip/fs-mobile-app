<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
        <data>
                <variable
                    name="request"
                    type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData"
                    />

                <import type="android.view.View" />
        </data>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/transaction_info"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/truckType"
            tools:hint="32FTMXL"
            android:text="@{request.truckTypeWithMT()}"
            android:textColor="@color/faded_black"
            android:fontFamily="sans-serif-medium"
            android:textSize="@dimen/text_16sp"
            android:layout_marginTop="@dimen/size_16dp"
            android:drawablePadding="@dimen/size_4dp"
            android:layout_marginStart="@dimen/size_16dp"
            android:drawableStart="@drawable/ic_truck_type_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/reportingTime"
            android:textSize="@dimen/text_12sp"
            android:drawablePadding="@dimen/size_4dp"
            tools:hint = "8:00 am"
            android:fontFamily="sans-serif"
            android:text="@{request.requiredAtWithTime()}"
            android:paddingTop="@dimen/size_2dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:textColor="@color/faded_black"
            app:layout_constraintTop_toTopOf="@+id/truckType"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/totalKm"
            tools:hint="100 KM -"
            android:textColor="@color/faded_black"
            android:textSize="@dimen/text_12sp"
            android:layout_marginTop="@dimen/size_4dp"
            android:paddingStart="@dimen/size_2dp"
            android:fontFamily="sans-serif"
            android:text="@{request.adhocIntracityKms()}"
            app:layout_constraintTop_toBottomOf="@+id/reportingTime"
            app:layout_constraintEnd_toStartOf="@+id/totalDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/totalDuration"
            tools:hint=" 8 hr"
            android:layout_marginEnd="@dimen/size_16dp"
            android:textColor="@color/faded_black"
            android:textSize="@dimen/text_12sp"
            android:paddingStart="@dimen/size_1dp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="@dimen/size_4dp"
            android:text="@{request.adhocIntracityhrs()}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/reportingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/cityCodePincode"
            tools:hint="Bangalore - 834004"
            android:textColor="@color/faded_black"
            android:paddingTop="@dimen/size_2dp"
            android:textSize="@dimen/text_12sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="@dimen/size_8dp"
            android:text="@{request.originCentreName()}"
            android:layout_marginStart="@dimen/size_16dp"
            app:layout_constraintTop_toBottomOf="@+id/totalKm"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/navigate"
            android:src="@drawable/ic_navigate"
            app:layout_constraintStart_toEndOf="@+id/cityCodePincode"
            app:layout_constraintTop_toTopOf="@id/cityCodePincode"
            android:paddingStart="@dimen/size_8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/reportingAddress"
            tools:hint="SV Road - Bangalore"
            android:textSize="@dimen/text_12sp"
            android:textColor="@color/faded_black"
            android:paddingTop="@dimen/size_4dp"
            android:paddingBottom="@dimen/size_8dp"
            android:paddingStart="@dimen/size_2dp"
            android:paddingEnd="@dimen/size_16dp"
            android:fontFamily="sans-serif"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="@{request.pickupLocationAddress}"
            app:layout_constraintTop_toBottomOf="@+id/cityCodePincode"
            app:layout_constraintStart_toStartOf="@id/cityCodePincode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>