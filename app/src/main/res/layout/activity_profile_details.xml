<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:bind="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.delhivery.axle.ui.profile.profiledetails.ProfileDetailsViewModel"
            />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        bind:shadow="@{ @dimen/size_1dp }"
        />
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">
                    <RelativeLayout
                        android:layout_width="wrap_content"
                       android:id="@+id/picLayout"
                        android:layout_marginBottom="@dimen/size_12dp"
                        android:layout_gravity="center_horizontal"
                        android:background="@color/white"
                        android:layout_marginTop="@dimen/size_24dp"
                       android:layout_height="wrap_content">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/profile"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:gravity="center"
                            android:textSize="@dimen/text_20sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif"
                            android:layout_marginEnd="@dimen/size_16dp"
                            android:layout_marginStart="@dimen/size_16dp"
                            android:textColor="@color/white"
                            android:background="@drawable/dark_blue_circle" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="@dimen/size_16dp"
                            bind:cardElevation="0dp"
                            android:visibility="gone"
                            android:layout_marginEnd="@dimen/size_16dp"
                            android:id="@+id/card1"
                            bind:cardBackgroundColor="@color/grey_bg"
                            bind:cardCornerRadius="26dp">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/profilepic"
                                android:scaleType="fitXY"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                />
                        </androidx.cardview.widget.CardView>
                    </RelativeLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_update_business_logo"
                        android:id="@+id/updateLogo"
                        android:textColor="@color/colorAccent"
                        android:textSize="@dimen/text_14sp"/>

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16dp"
                    android:padding="@dimen/size_16dp"
                    android:orientation="vertical">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_business_name"
                        android:textSize="@dimen/text_14sp"
                        android:textColor="@color/heading_black"/>
                    <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/size_6dp"
                        android:layout_height="@dimen/edit_text_height"
                        android:background="@drawable/bg_login_edit"
                        android:padding="@dimen/size_6dp"
                        android:singleLine="true"
                        android:imeOptions="actionNext"
                        android:id="@+id/busineesName"
                        tools:text="Jeeyam Logistics"
                        android:text="@={viewModel.businessName}"
                        android:textColor="@color/heading_black"
                        android:textSize="@dimen/text_16sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/size_16dp"
                    android:orientation="vertical">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_my_name"
                        android:textColor="@color/heading_black"/>
                    <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/size_6dp"
                        android:layout_height="@dimen/edit_text_height"
                        android:background="@drawable/bg_login_edit"
                        android:padding="@dimen/size_6dp"
                        android:imeOptions="actionDone"
                        android:singleLine="true"
                        tools:text="Jeeyam Logistics"
                        android:id="@+id/user_name"
                        android:text="@={viewModel.userName}"
                        android:textColor="@color/heading_black"
                        android:textSize="@dimen/text_16sp" />       </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/size_16dp"
                    android:orientation="vertical">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_14sp"
                        android:text="@string/label_mobile_number"
                        android:textColor="@color/heading_black"/>
                    <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/size_6dp"
                        android:layout_height="@dimen/edit_text_height"
                        android:background="@drawable/bg_login_edit"
                        android:padding="@dimen/size_6dp"
                        android:enabled="false"
                        android:clickable="false"
                        android:backgroundTint="@color/grey_bg"
                        android:text="@{viewModel.mobile}"
                        android:textColor="@color/heading_black"
                        android:textSize="@dimen/text_16sp" />     </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/size_14dp"
                    android:orientation="vertical">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_i_want"
                        android:textColor="@color/heading_black"/>
                   <RadioGroup
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       android:id="@+id/radioType"
                       android:layout_marginTop="@dimen/size_6dp"
                       android:orientation="horizontal"
                       android:layout_weight="3">
                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_post_load"
                        android:layout_weight="1"/>
                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_post_truck"
                        android:layout_weight="1"/>
                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_both"
                        android:layout_weight="1"/>
                   </RadioGroup>

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/size_14dp"
                    android:orientation="vertical">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_my_occupation"
                        android:textColor="@color/heading_black"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/size_6dp"
                       android:layout_height="@dimen/edit_text_height"
                        android:background="@drawable/bg_login_edit">
                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/spinner_proof"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/edit_text_height"
                            android:background="@drawable/bg_spinner"
                            bind:layout_constraintStart_toStartOf="parent"
                            bind:layout_constraintTop_toTopOf="parent"
                            bind:layout_constraintBottom_toBottomOf="parent"
                            android:spinnerMode="dropdown"
                            android:textColor="@color/heading_black"
                            android:textSize="@dimen/text_16sp"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:id="@+id/switchLay"
                    android:padding="@dimen/size_14dp">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                            android:text="@string/label_third_party"
                        android:textColor="@color/heading_black"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_2dp"
                        android:text="@string/msg_view_third_party_loads"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/loadSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginStart="@dimen/size_8dp"
                        android:layout_marginEnd="@dimen/size_8dp"
                        android:layout_gravity="center"
                        android:thumb="@drawable/switch_thumb_blue"
                        app:track="@drawable/switch_track_blue" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.appcompat.widget.LinearLayoutCompat>
        </ScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_14dp"
            style="@style/ActionButton"
            android:enabled="false"
            android:text="Save Details"
            android:id="@+id/btnSave"
            android:layout_gravity="bottom"
            android:textAllCaps="false"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>