<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:shadow="@{ @dimen/size_1dp }"
        />
    <androidx.appcompat.widget.SearchView
        android:id="@+id/edit_query"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_16dp"
        android:layout_marginLeft="@dimen/size_16dp"
        android:layout_marginRight="@dimen/size_16dp"
        android:layout_marginTop="@dimen/size_16dp"
        android:background="@drawable/bg_login_edit"
        android:textColorHint="@color/color_hint"
        android:textSize="@dimen/text_16sp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:closeIcon="@null"
        app:iconifiedByDefault="false"
        app:queryBackground="@color/white"
        app:queryHint="@string/hint_search_city"
        app:searchIcon="@null"
        />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/search_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_16dp"
        android:layout_marginLeft="@dimen/size_16dp"
        android:layout_marginRight="@dimen/size_16dp"
        android:layout_marginTop="@dimen/size_16dp"
        app:layout_constraintBottom_toBottomOf="@+id/edit_query"
        app:layout_constraintEnd_toEndOf="@+id/edit_query"
        app:layout_constraintTop_toTopOf="@+id/edit_query"
        app:srcCompat="@drawable/ic_search_city"
        />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/close_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_16dp"
        android:layout_marginLeft="@dimen/size_16dp"
        android:layout_marginRight="@dimen/size_16dp"
        android:layout_marginTop="@dimen/size_16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/edit_query"
        app:layout_constraintEnd_toEndOf="@+id/edit_query"
        app:layout_constraintTop_toTopOf="@+id/edit_query"
        app:srcCompat="@drawable/ic_search_close"
        />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/popular_ll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/size_14dp"
        android:layout_marginTop="@dimen/size_16dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_city_items"
        >
      <View
          android:layout_width="match_parent"
          android:layout_height="@dimen/size_1dp"
          android:layout_marginBottom="@dimen/size_8dp"
          android:background="@color/light_line_grey"
          />
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/popular_txt"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="@dimen/size_8dp"
          android:layout_marginStart="@dimen/size_16dp"
          android:text="@string/popular_cities"
          android:textSize="@dimen/text_14sp"
          />
      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rv_popular_city_items"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="@dimen/size_16dp"
          />
    </androidx.appcompat.widget.LinearLayoutCompat>



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_city_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/size_16dp"
        android:layout_marginTop="@dimen/size_8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_query"
        />
  </androidx.constraintlayout.widget.ConstraintLayout>

  <data>
    <import type="android.view.View" />
    <import type="androidx.core.content.ContextCompat" />
  </data>

</layout>