<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <data>
        <import type="android.view.View" />
        <import type="androidx.core.content.ContextCompat" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_toolbar"
            android:background="@android:color/white"
            app:layout_constraintTop_toTopOf="parent"
            />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edit_query"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_12dp"
            android:layout_marginLeft="@dimen/size_8dp"
            android:layout_marginRight="@dimen/size_8dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:hint="@string/hint_search_city"
            android:background="@drawable/bg_search_bar_light"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@+id/toolbar"
            android:paddingStart="@dimen/size_12dp"
            android:textColorHint="@color/color_hint"
            android:textSize="@dimen/text_16sp"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_city_items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:layout_marginBottom="@dimen/size_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_query"
            />
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/popular_ll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/size_14dp"
            app:layout_constraintTop_toBottomOf="@+id/rv_city_items"
            app:layout_constraintStart_toStartOf="parent"
            android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/popular_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/popular_cities"
            android:layout_marginBottom="@dimen/size_8dp"
            android:layout_marginStart="@dimen/size_16dp"
            android:textSize="@dimen/text_14sp"
            />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_popular_city_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_16dp"
                />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>