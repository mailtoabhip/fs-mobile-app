<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:autofit="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="user"
        type="com.delhivery.axle.data.UserModel"
        />

    <import type="android.view.View" />
  </data>
  <androidx.cardview.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/size_16dp"
      android:layout_marginEnd="@dimen/size_16dp"
      android:layout_marginBottom="@dimen/size_12dp"
      android:clickable="true"
      android:focusable="true"
      android:foreground="?attr/selectableItemBackgroundBorderless"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="@dimen/size_2dp"
      >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/admin_card_container"
        android:layout_width="match_parent"
        android:background="@drawable/bg_all_round_corner_grey_boundary"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:padding="@dimen/size_12dp"
        android:focusable="false">

      <androidx.appcompat.widget.AppCompatTextView
          android:layout_width="40dp"
          android:layout_height="40dp"
          android:gravity="center"
          android:textSize="@dimen/text_20sp"
          android:textStyle="bold"
          android:fontFamily="sans-serif"
          android:textColor="@color/white"
          android:id="@+id/logo_team_member"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          android:background="@drawable/dark_blue_circle" />

      <androidx.appcompat.widget.LinearLayoutCompat
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintStart_toEndOf="@id/logo_team_member"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toStartOf="@+id/dieselLay"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_12dp"
          android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/heading_black"
            android:text="@{user.name}"
            android:layout_marginStart="@dimen/size_20dp"
            android:textSize="@dimen/text_18sp"
            tools:text="Supplier"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/faded_black"
            android:text="@{user.phoneNo}"
            android:layout_marginStart="@dimen/size_20dp"
              android:textSize="@dimen/size_16dp"
            tools:text="9876543210"/>

      </androidx.appcompat.widget.LinearLayoutCompat>

      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:id="@+id/dieselLay"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toStartOf="@id/admin_text"
          android:gravity="center"
          android:layout_marginEnd="@dimen/size_24dp"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_diesel_card"
            android:textColor="@color/heading_black"
            android:layout_marginBottom="@dimen/size_4dp"
            android:layout_gravity="center"
            android:textSize="@dimen/text_16sp"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/admin_diesel_preference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/size_2dp"
            android:enabled="false"
            android:checked="@{user.getDieselPreferences()}"
            android:thumb="@drawable/switch_thumb"
            app:track="@drawable/switch_track" />

      </androidx.appcompat.widget.LinearLayoutCompat>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/admin_text"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          android:layout_marginEnd="@dimen/size_14dp"
          android:layout_marginTop="@dimen/size_20dp"
          android:layout_marginBottom="@dimen/size_20dp"
          android:layout_marginStart="@dimen/size_20dp"
          android:text="Admin"
          android:background="@drawable/bg_login_edit"
          android:padding="@dimen/size_8dp"
          android:textColor="@color/heading_black"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          tools:text="Admin"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.cardview.widget.CardView>

</layout>