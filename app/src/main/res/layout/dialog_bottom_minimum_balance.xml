<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_all_round_corner_white_boundary"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/size_24dp"
    android:paddingTop="@dimen/size_16dp"
    android:paddingBottom="@dimen/size_24dp">

    <!-- Close button -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivClose"
        android:layout_width="@dimen/size_24dp"
        android:layout_height="@dimen/size_24dp"
        android:layout_gravity="end"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Close"
        android:src="@drawable/ic_close" />

    <!-- Info icon -->
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/size_16dp"
        android:contentDescription="Info"
        android:padding="@dimen/size_14dp"
        android:src="@drawable/minimum_balance_iv" />

    <!-- Title -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20dp"
        android:gravity="center"
        android:text="@string/str_minimum_balance_alert"
        android:textColor="@color/text_primary"
        style="@style/TextAppearance.Delfin.B20" />

    <!-- Description -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_8dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/str_fastag_minimum_balance_description"
        android:textColor="@color/grey_500"
        style="@style/TextAppearance.Delfin.M14" />

    <!-- Checkbox -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cbAcknowledge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/str_i_understand_that_low_balance_may_lead_to_hotlisting"
            android:textColor="@color/text_caption_primary"
            style="@style/TextAppearance.Delfin.M14" />

    </LinearLayout>

    <!-- Continue button with progress -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/size_20dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_tag_mapping_continue_disabled"
            android:enabled="false"
            android:fontFamily="sans-serif-medium"
            android:text="Continue"
            android:textAllCaps="false"
            android:textColor="#CDCBCB"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:indeterminateTint="@android:color/white"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
