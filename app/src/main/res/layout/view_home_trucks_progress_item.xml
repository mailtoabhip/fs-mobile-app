<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_12dp"
        android:layout_marginEnd="@dimen/size_2dp"
        android:layout_marginStart="@dimen/size_2dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:cardCornerRadius="@dimen/size_6dp"
        app:cardElevation="2dp"
        >

    <com.dfd.delfin.ui.custom.DelhiveryShimmerLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:paddingBottom="@dimen/size_16dp"
            android:paddingEnd="@dimen/size_16dp"
            android:paddingStart="@dimen/size_16dp"
            android:paddingTop="@dimen/size_12dp">

            <View
                android:id="@+id/truck_image_progress"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@color/colorShimmerPrimary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/truck_number_progress"
                android:layout_width="200dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/size_6dp"
                android:background="@color/colorShimmerPrimary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/truck_image_progress"/>
            <View
                android:id="@+id/truck_capacity_progress"
                android:layout_width="200dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/size_6dp"
                android:layout_marginTop="@dimen/size_4dp"
                android:background="@color/colorShimmerPrimary"
                app:layout_constraintTop_toBottomOf="@id/truck_number_progress"
                app:layout_constraintStart_toEndOf="@id/truck_image_progress"/>
            <View
                android:id="@+id/label_current_progress"
                android:layout_width="@dimen/size_140dp"
                android:layout_height="20dp"
                android:background="@color/colorShimmerPrimary"
                android:layout_marginTop="@dimen/size_4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/truck_image_progress"
                />
            <View
                android:id="@+id/text_current_progress"
                android:layout_width="@dimen/size_160dp"
                android:layout_height="20dp"
                android:background="@color/colorShimmerPrimary"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="@dimen/size_4dp"
                app:layout_constraintTop_toBottomOf="@id/label_current_progress"/>
            <View
                android:id="@+id/label_unloading_progress"
                android:layout_width="@dimen/size_140dp"
                android:layout_height="20dp"
                android:layout_marginTop="@dimen/size_4dp"
                android:background="@color/colorShimmerPrimary"
                android:layout_marginEnd="@dimen/size_8dp"
                app:layout_constraintTop_toBottomOf="@id/truck_image_progress"
                app:layout_constraintEnd_toEndOf="parent"/>
            <View
                android:id="@+id/text_unloading_progress"
                android:layout_width="@dimen/size_160dp"
                android:layout_height="20dp"
                android:layout_marginTop="@dimen/size_4dp"
                android:background="@color/colorShimmerPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toBottomOf="@id/label_unloading_progress"/>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.dfd.delfin.ui.custom.DelhiveryShimmerLayout>
    </androidx.cardview.widget.CardView>
</layout>