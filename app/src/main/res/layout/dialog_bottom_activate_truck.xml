<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_dialog">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:padding="@dimen/size_14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_close_black"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginStart="@dimen/size_8dp"
                android:layout_gravity="center"
                android:text="@string/label_confirm_details"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_4dp"
            app:srcCompat="@drawable/seperator_line"/>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/size_14dp"
            android:paddingEnd="@dimen/size_14dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_12sp"
                android:layout_marginTop="@dimen/size_14dp"
                android:text="@string/label_current_city"
                android:textColor="@color/black"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/edit_current_city_layout_activate"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_40dp"
                android:padding="@dimen/size_8dp"
                android:layout_marginTop="@dimen/size_6dp"
                android:textSize="@dimen/text_14sp"
                android:background="@drawable/background_rectangle_border_curved">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_current_city_activate"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_search_black"
                    android:drawablePadding="@dimen/size_4dp"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:hint="Search city"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/origin_error_activate"
                android:layout_width="wrap_content"
                android:textColor="@color/bid_placed_red"
                android:textSize="@dimen/text_12sp"
                android:visibility="gone"
                android:layout_height="wrap_content" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_14dp"
                android:textSize="@dimen/text_12sp"
                android:text="@string/label_unloading_destination"
                android:textColor="@color/black"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/edit_unloading_destinations_layout_activate"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_40dp"
                android:layout_marginTop="@dimen/size_6dp"
                android:padding="@dimen/size_8dp"
                android:textSize="@dimen/text_14sp"
                android:background="@drawable/background_rectangle_border_curved">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_unloading_destination_activate"
                    android:layout_width="wrap_content"
                    android:layout_gravity="center"
                    android:hint="Eg: Bhopal"
                    android:textColor="@color/black"
                    android:layout_height="wrap_content"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/destination_error_activate"
                android:layout_width="wrap_content"
                android:textColor="@color/bid_placed_red"
                android:textSize="@dimen/text_12sp"
                android:visibility="gone"
                android:layout_height="wrap_content" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/label_text_price_activate_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_14dp"
                android:textSize="@dimen/text_12sp"
                android:text="@string/label_price"
                android:textColor="@color/black"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edit_price_activate_truck"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_40dp"
                android:layout_marginTop="@dimen/size_8dp"
                android:padding="@dimen/size_8dp"
                android:textSize="@dimen/text_14sp"
                android:textColor="@color/black"
                android:inputType="number"
                android:maxLength="9"
                android:hint="Eg: ₹2500"
                android:background="@drawable/background_rectangle_border_curved">
            </androidx.appcompat.widget.AppCompatEditText>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_activate_truck_dialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_14dp"
                android:textAllCaps="false"
                android:text="@string/action_activate_truck"
                android:layout_marginBottom="@dimen/size_11dp"
                android:background="@drawable/bg_all_round_corner_black"
                android:textColor="@color/white"/>


        </androidx.appcompat.widget.LinearLayoutCompat>



    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>