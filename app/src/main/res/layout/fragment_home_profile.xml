<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
  <data>
    <variable
        name="viewModel"
        type="com.delhivery.orion.ui.home.fragments.profile.HomeProfileViewModel"
        />
  </data>
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/colorBackground"
      >

    <android.support.v7.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingEnd="@dimen/size_24dp"
        android:paddingStart="@dimen/size_24dp"
        >

      <android.support.v7.widget.AppCompatImageView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_56dp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:srcCompat="@drawable/ic_under_development"
          />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_24dp"
          android:fontFamily="sans-serif-medium"
          android:gravity="center_horizontal"
          android:letterSpacing="0.01"
          android:lineSpacingExtra="@dimen/text_2sp"
          android:text="@string/title_we_are_building_this_page"
          android:textColor="#181818"
          android:textSize="@dimen/text_16sp"
          android:textStyle="normal"
          />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="@dimen/size_24dp"
          android:layout_marginStart="@dimen/size_24dp"
          android:layout_marginTop="@dimen/size_8dp"
          android:fontFamily="sans-serif"
          android:gravity="center_horizontal"
          android:letterSpacing="0.01"
          android:lineSpacingExtra="@dimen/text_6sp"
          android:paddingEnd="@dimen/size_16dp"
          android:paddingStart="@dimen/size_16dp"
          android:text="@string/msg_under_dev"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_12sp"
          android:textStyle="normal"
          />

      <!-- your routes container -->
      <android.support.v7.widget.CardView
          android:id="@+id/container_trip_meter"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_16dp"
          app:cardCornerRadius="@dimen/size_8dp"
          app:cardElevation="@dimen/size_4dp"
          >

        <android.support.constraint.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_trip_meter_gradient"
            android:padding="@dimen/size_16dp"
            >

          <TextView
              android:id="@+id/id1"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif-medium"
              android:text="@string/card_heading_trip_meter"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_14sp"
              android:textStyle="normal"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              />

          <TextView
              android:id="@+id/id2"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_4dp"
              android:fontFamily="sans-serif"
              android:text="@string/card_subheading_trip_meter"
              android:textColor="@color/sub_heading_black"
              android:textSize="@dimen/text_12sp"
              android:textStyle="normal"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@id/id1"
              />

          <android.support.constraint.ConstraintLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_16dp"
              app:layout_constraintTop_toBottomOf="@id/id2"
              >

            <android.support.v7.widget.LinearLayoutCompat
                android:id="@+id/id3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/size_8dp"
                android:background="@drawable/bg_trip_meter_this_month"
                android:orientation="vertical"
                android:padding="@dimen/size_12dp"
                app:layout_constraintEnd_toStartOf="@id/id4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                >

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/size_4dp"
                  android:fontFamily="sans-serif"
                  android:textColor="@color/sub_heading_black"
                  android:textSize="@dimen/text_10sp"
                  android:textStyle="normal"
                  />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/size_12dp"
                  android:fontFamily="sans-serif"
                  android:textColor="@color/heading_black"
                  android:textSize="@dimen/text_14sp"
                  android:textStyle="normal"
                  />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/size_4dp"
                  android:fontFamily="sans-serif"
                  android:textColor="@color/sub_heading_black"
                  android:textSize="@dimen/text_12sp"
                  android:textStyle="normal"
                  />

            </android.support.v7.widget.LinearLayoutCompat>

            <android.support.v7.widget.LinearLayoutCompat
                android:id="@+id/id4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_8dp"
                android:background="@drawable/bg_trip_meter_last_month"
                android:orientation="vertical"
                android:padding="@dimen/size_12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/id3"
                app:layout_constraintTop_toTopOf="parent"
                >

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/size_4dp"
                  android:fontFamily="sans-serif"
                  android:textColor="@color/sub_heading_black"
                  android:textSize="@dimen/text_10sp"
                  android:textStyle="normal"
                  />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/size_12dp"
                  android:fontFamily="sans-serif"
                  android:textColor="@color/heading_black"
                  android:textSize="@dimen/text_14sp"
                  android:textStyle="normal"
                  />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/size_4dp"
                  android:fontFamily="sans-serif"
                  android:textColor="@color/sub_heading_black"
                  android:textSize="@dimen/text_12sp"
                  android:textStyle="normal"
                  />
            </android.support.v7.widget.LinearLayoutCompat>

          </android.support.constraint.ConstraintLayout>

        </android.support.constraint.ConstraintLayout>
      </android.support.v7.widget.CardView>

      <!-- your routes container -->
      <android.support.v7.widget.CardView
          android:id="@+id/container_your_routes"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_16dp"
          android:foreground="?attr/selectableItemBackgroundBorderless"
          app:cardCornerRadius="@dimen/size_8dp"
          app:cardElevation="@dimen/size_4dp"
          >

        <android.support.constraint.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/size_16dp"
            android:paddingEnd="@dimen/size_12dp"
            android:paddingStart="@dimen/size_16dp"
            android:paddingTop="@dimen/size_16dp"
            >

          <TextView
              android:id="@+id/text_your_routes"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif-medium"
              android:text="@string/label_your_routes"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_14sp"
              android:textStyle="normal"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              />

          <TextView
              android:id="@+id/text_your_routes_subtitle"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_4dp"
              android:fontFamily="sans-serif"
              android:text="@string/msg_view_edit_route_prefs"
              android:textColor="@color/sub_heading_black"
              android:textSize="@dimen/text_12sp"
              android:textStyle="normal"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@id/text_your_routes"
              />

          <android.support.v7.widget.AppCompatImageView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              app:layout_constraintBottom_toBottomOf="@id/text_your_routes_subtitle"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintTop_toTopOf="@id/text_your_routes"
              app:srcCompat="@drawable/ic_chevron_right_dark"
              />

        </android.support.constraint.ConstraintLayout>
      </android.support.v7.widget.CardView>

      <!-- logout container -->
      <android.support.v7.widget.CardView
          android:id="@+id/container_logout"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="@dimen/size_24dp"
          android:layout_marginTop="@dimen/size_8dp"
          android:foreground="?attr/selectableItemBackgroundBorderless"
          app:cardCornerRadius="@dimen/size_8dp"
          app:cardElevation="@dimen/size_4dp"
          >

        <android.support.v7.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/size_24dp"
            android:paddingEnd="@dimen/size_12dp"
            android:paddingStart="@dimen/size_16dp"
            android:paddingTop="@dimen/size_24dp"
            >

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif-medium"
              android:text="@string/action_logout_from_app"
              android:textColor="#de000000"
              android:textSize="14sp"
              android:textStyle="normal"
              />

          <View
              android:layout_width="0dp"
              android:layout_height="1dp"
              android:layout_weight="1"
              />

          <android.support.v7.widget.AppCompatImageView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              app:srcCompat="@drawable/ic_logout"
              />
        </android.support.v7.widget.LinearLayoutCompat>
      </android.support.v7.widget.CardView>
    </android.support.v7.widget.LinearLayoutCompat>
  </ScrollView>
</layout>