<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_sheet_rounded_top"
        android:padding="@dimen/size_24dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="@dimen/size_80dp"
                android:layout_height="@dimen/size_80dp"
                android:layout_marginTop="@dimen/size_32dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:alpha="0.2"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/bid_placed_green" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/size_40dp"
                    android:layout_height="@dimen/size_40dp"
                    android:layout_centerInParent="true"
                    app:srcCompat="@drawable/ic_submitted_success" />
            </RelativeLayout>

            <!-- Title -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_24dp"
                android:text="Request received"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_20sp"
                android:textStyle="bold" />

            <!-- Description -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_12dp"
                android:gravity="center"
                android:text="Our team will contact you shortly to complete FASTag issuance."
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_14sp" />

            <!-- Secondary Message -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:gravity="center"
                android:text="You can continue managing your trucks meanwhile."
                android:textColor="@color/color_hint"
                android:textSize="@dimen/text_12sp" />

            <!-- Close Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_close"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_48dp"
                android:layout_marginTop="@dimen/size_32dp"
                android:layout_marginBottom="@dimen/size_16dp"
                android:background="@drawable/bg_all_round_corner_light_grey"
                android:minWidth="@dimen/size_120dp"
                android:paddingStart="@dimen/size_32dp"
                android:paddingEnd="@dimen/size_32dp"
                android:text="Close"
                android:textAllCaps="false"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </RelativeLayout>

</layout>
