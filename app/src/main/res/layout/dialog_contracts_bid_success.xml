<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
    <data>
      <variable
          name="transaction"
          type="com.dfd.delfin.data.home.bids.HomeBidsRequestItemData"
          />
    </data>
  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingBottom="@dimen/size_24dp"
      android:layout_margin="@dimen/size_28dp"
      android:padding="@dimen/size_16dp"
      android:gravity="center_horizontal"
      android:background="@drawable/bg_all_round_corner_white">



    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_vector_correct_green"
        android:layout_marginTop="@dimen/size_16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/title"
        app:layout_constraintTop_toBottomOf="@+id/img_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/size_8dp"
        android:textSize="@dimen/text_14sp"
        android:text="@string/bid_placed_sucessfully"
        android:textColor="@color/heading_black"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBidAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_all_round_corner_solid_light_grey"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/size_24dp"
        android:padding="@dimen/size_8dp">
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/yourBidAmountLabel"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          android:drawablePadding="@dimen/size_12dp"
          android:textSize="@dimen/text_12sp"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toStartOf="@+id/yourTripLabel"
          android:textColor="@color/background_dark_grey"
          android:text="@string/your_bid"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/yourBidAmountValue"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          app:layout_constraintTop_toBottomOf="@+id/yourBidAmountLabel"
          app:layout_constraintStart_toStartOf="parent"
          android:textStyle="bold"
          android:textSize="@dimen/text_14sp"
          tools:text="₹ 2000"
          android:textColor="@color/heading_black"/>

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/yourTripLabel"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          android:drawablePadding="@dimen/size_12dp"
          android:textSize="@dimen/text_12sp"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintEnd_toStartOf="@+id/moneyIcon"
          app:layout_constraintStart_toEndOf="@+id/yourBidAmountLabel"
          android:textColor="@color/background_dark_grey"
          tools:visibility="gone"
          android:visibility="@{transaction.isFRCContract()}"
          android:text="@string/trip_commitment"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/yourTripValue"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          app:layout_constraintTop_toBottomOf="@+id/yourTripLabel"
          app:layout_constraintStart_toStartOf="@id/yourTripLabel"
          android:textStyle="bold"
          android:textSize="@dimen/text_14sp"
          android:textColor="@color/heading_black"
          tools:visibility="gone"
          android:visibility="@{transaction.isFRCContract()}"
          tools:text="25"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/yourVehicleLabel"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_12dp"
          android:drawablePadding="@dimen/size_12dp"
          android:textSize="@dimen/text_12sp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/yourBidAmountValue"
          android:textColor="@color/background_dark_grey"
          android:visibility="@{transaction.isIntraCityContract()}"
          tools:visibility="visible"
          android:text="@string/your_vehicle_number"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/yourVehicleValue"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          app:layout_constraintTop_toBottomOf="@+id/yourVehicleLabel"
          app:layout_constraintStart_toStartOf="@id/yourVehicleLabel"
          android:textStyle="bold"
          android:textSize="@dimen/text_14sp"
          android:textColor="@color/heading_black"
          android:visibility="@{transaction.isIntraCityContract()}"
          tools:visibility="visible"
          tools:text="MK 89 NH 76544"/>
      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/moneyIcon"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          app:layout_constraintEnd_toEndOf="parent"
          app:srcCompat="@drawable/ic_icons8_cash_1"
          app:layout_constraintStart_toEndOf="@+id/yourTripLabel"
          app:layout_constraintTop_toTopOf="@+id/yourBidAmountLabel"
          app:layout_constraintBottom_toBottomOf="@+id/yourBidAmountValue"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/action_ok"
        android:textColor="@color/background_dark_grey"
        app:layout_constraintTop_toBottomOf="@+id/clBidAmount"
        android:background="@drawable/bg_all_round_corner_grey_boundary"
        android:textAllCaps="false"
        android:paddingStart="@dimen/size_32dp"
        android:paddingEnd="@dimen/size_32dp"
        android:textSize="@dimen/text_16sp"
        android:layout_marginTop="@dimen/size_20dp"
        />

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>