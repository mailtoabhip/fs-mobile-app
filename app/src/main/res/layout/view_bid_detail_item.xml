<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="item"
            type="com.delhivery.axle.data.biddetail.BulkBidSummaryItemData" />
    </data>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_4dp"
        android:layout_marginBottom="@dimen/size_4dp"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:cardElevation="@dimen/size_2dp"
        >
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

       <androidx.constraintlayout.widget.ConstraintLayout
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:orientation="horizontal"
           android:padding="@dimen/size_8dp">
           <androidx.appcompat.widget.AppCompatImageView
               android:id="@+id/expandButton"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               app:srcCompat="@{item.toggleButton()}"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintTop_toTopOf="parent"/>


       </androidx.constraintlayout.widget.ConstraintLayout>

        <RelativeLayout
            android:id="@+id/expandableLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_8dp"
            android:orientation="vertical">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/label_vehicle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_vehicle_type"
                android:layout_gravity="center"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_marginTop="@dimen/size_10dp"
                android:textSize="@dimen/text_16sp"
                android:layout_alignParentStart="true"
                android:textStyle="bold"
                android:layout_alignParentTop="true"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_vehicle_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6_TYRE(7.5MT)"
                android:layout_alignBaseline="@id/label_vehicle"
                android:layout_alignParentTop="true"
                android:textColor="@color/black"
                android:layout_marginStart="25dp"
                android:layout_marginTop="@dimen/size_10dp"
                android:layout_toEndOf="@id/label_vehicle"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/label_pmt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/size_11dp"
                    android:visibility="@{item.visibility()}"
                    android:textSize="@dimen/text_16sp"
                    android:layout_below="@id/label_vehicle"
                    android:text="@string/label_pmt_rate"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/edit_trucks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{item.pmtRate()}"
                    android:layout_below="@id/label_vehicle"
                    android:layout_toEndOf="@id/label_pmt"
                    android:textColor="@color/black"
                    android:visibility="@{item.visibility()}"
                    android:layout_marginTop="@dimen/size_11dp"
                    android:layout_alignStart="@id/text_vehicle_type"
                    tools:text="1050"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/amt_compare_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:textColor="@color/bid_placed_green"
                    android:text="@string/label_lowest_bid"
                    android:visibility="@{item.visibility()}"
                    android:layout_marginTop="@dimen/size_11dp"
                    android:textStyle="italic"
                    android:layout_below="@id/text_vehicle_type"
                    android:layout_toEndOf="@id/edit_trucks"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/label_count_truck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/edit_trucks"
                android:layout_alignParentStart="true"
                android:textColor="@color/black"
                android:layout_marginTop="@dimen/size_8dp"
                android:textSize="@dimen/text_16sp"
                android:visibility="@{item.visibility()}"
                android:text="@string/label_truck_count"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_truck_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/label_count_truck"
                android:layout_marginTop="@dimen/size_8dp"
                android:layout_alignStart="@id/text_vehicle_type"
                android:visibility="@{item.visibility()}"
                android:layout_below="@id/edit_trucks"
                android:textColor="@color/black"
                android:text="@{item.truckCount()}"
                tools:text="2"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/label_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:textColor="@color/black"
                android:textSize="@dimen/text_16sp"
                android:visibility="@{item.visibility()}"
                android:layout_below="@id/label_count_truck"
                android:layout_marginTop="@dimen/size_8dp"
                android:text="@string/label_status"/>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/label_count_truck"
                android:layout_alignStart="@id/text_vehicle_type"
                android:layout_marginTop="@dimen/size_8dp"
                android:layout_toEndOf="@id/label_status"
                android:visibility="@{item.visibility()}"
                android:orientation="vertical">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="@{item.openStatusVisibility()}"
                    android:text="@{item.openCount()}"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="@{item.confirmedStatusVisibility()}"
                    android:text="@{item.confirmedCount()}"
                    android:textColor="@color/bid_placed_green"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="@{item.lostStatusVisibility()}"
                    android:text="@{item.lostCount()}"
                    android:textColor="@color/bid_placed_red"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/Vehicle_num_layout"
                    android:text="Textview"
                    visibility="@{item.confirmedStatusVisibility()}"
                    android:orientation="vertical"
                    android:textColor="@color/bid_placed_green">

                </androidx.appcompat.widget.LinearLayoutCompat>


            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            </androidx.appcompat.widget.LinearLayoutCompat>

        </RelativeLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.cardview.widget.CardView>


</layout>