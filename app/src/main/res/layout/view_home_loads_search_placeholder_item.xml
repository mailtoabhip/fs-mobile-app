<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/spinner_truck_display_name"
        android:layout_width="wrap_content"
        android:layout_toStartOf="@+id/edit_sticky_search"
        android:layout_alignParentStart="true"
        android:layout_height="@dimen/size_38dp"
        android:background="@drawable/bg_search_white_load_spinner"
        android:paddingBottom="@dimen/size_12dp"
        android:paddingTop="@dimen/size_8dp"
        android:textSize="@dimen/text_16sp"
        android:textColor="@color/heading_black"
        />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/edit_sticky_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:layout_alignParentEnd="true"
        android:focusable="true"
        android:paddingStart="@dimen/size_4dp"
        android:src="@drawable/ic_search"
        />
    </RelativeLayout>
</layout>