<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="maskedNumber"
            type="String" />

        <variable
            name="timerText"
            type="String" />

        <variable
            name="isOtpFilled"
            type="Boolean" />

        <variable
            name="isLoading"
            type="Boolean" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_rounded_top"
        android:paddingBottom="@dimen/size_32dp">

        <!-- Header -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_16dp"
            android:text="Enter OTP"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/ivClose"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/divider1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_1dp"
            android:background="#E6E6E6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            android:layout_marginTop="@dimen/size_16dp"/>

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="@dimen/size_24dp"
            android:layout_height="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:src="@drawable/ic_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle" />

        <!-- Description -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_16dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:text="@{`OTP is sent on the linked mobile number\ni.e. ` + maskedNumber}"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider1"
            tools:text="We’ve sent an OTP via SMS to: 9876543321"/>

        <!-- OTP Input Fields -->
        <LinearLayout
            android:id="@+id/otpContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription">

            <EditText
                android:id="@+id/etOtp1"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_48dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text_outline"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp2"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_48dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text_outline"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp3"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_48dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text_outline"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp4"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_48dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text_outline"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp5"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_48dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text_outline"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp6"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text_outline"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Error Text (shown on invalid OTP) -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvOtpError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_12dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:text="Incorrect OTP. Resend OTP"
            android:textColor="#E53935"
            android:textSize="@dimen/text_12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/otpContainer" />

        <!-- Resend Timer -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvResendTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_16dp"
            android:text="@{`Resend in ` + timerText}"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvOtpError" />

        <!-- Resend Button (shown after timer expires) -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_16dp"
            android:text="Resend OTP"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvOtpError" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrierResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tvResend,tvResendTimer" />

        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_1dp"
            android:background="#E6E6E6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barrierResend"
            android:layout_marginTop="@dimen/size_16dp"/>

        <!-- Submit Button -->
        <FrameLayout
            android:id="@+id/layoutSubmit"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_48dp"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_12dp"
            android:layout_marginEnd="@dimen/size_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider2">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@{isOtpFilled &amp;&amp; !isLoading ? @drawable/bg_all_round_corner_solid_black : @drawable/bg_all_round_corner_light_grey}"
                android:enabled="@{isOtpFilled &amp;&amp; !isLoading}"
                android:text="@{isLoading ? `` : `Submit`}"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_16sp" />

            <ProgressBar
                android:id="@+id/progressSubmit"
                android:layout_width="@dimen/size_24dp"
                android:layout_height="@dimen/size_24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@android:color/white"
                android:visibility="@{isLoading ? android.view.View.VISIBLE : android.view.View.GONE}" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
