<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="maskedNumber"
            type="String" />

        <variable
            name="timerText"
            type="String" />

        <variable
            name="isOtpFilled"
            type="Boolean" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_sheet_rounded_top"
        android:paddingBottom="@dimen/size_16dp">

        <!-- Header -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_16dp"
            android:text="Enter OTP"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/ivClose"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="@dimen/size_24dp"
            android:layout_height="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:src="@drawable/ic_close_black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTitle"
            app:layout_constraintBottom_toBottomOf="@id/tvTitle" />

        <!-- Description -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_16dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:text="@{`OTP is sent on the linked mobile number\ni.e. ` + maskedNumber}"
            android:textColor="@color/background_dark_grey"
            android:textSize="@dimen/text_14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- OTP Input Fields -->
        <LinearLayout
            android:id="@+id/otpContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription">

            <EditText
                android:id="@+id/etOtp1"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_48dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text_outline"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp2"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_48dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text_outline"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp3"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_48dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text_outline"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp4"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_48dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text_outline"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp5"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_48dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text_outline"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etOtp6"
                android:layout_width="0dp"
                android:layout_height="@dimen/size_48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text_outline"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Resend Timer -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvResendTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_16dp"
            android:text="@{`Resend in ` + timerText}"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/otpContainer" />

        <!-- Resend Button (shown after timer expires) -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_16dp"
            android:text="Resend OTP"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_14sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/otpContainer" />

        <!-- Submit Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmit"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_48dp"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:background="@{isOtpFilled ? @drawable/bg_all_round_corner_solid_black : @drawable/bg_all_round_corner_light_grey}"
            android:enabled="@{isOtpFilled}"
            android:text="Submit"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvResendTimer" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
