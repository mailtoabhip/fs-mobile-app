<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="bidsRecieved"
        type="Integer"
        />
  </data>
  <android.support.v7.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/size_12dp"
      android:layout_marginEnd="@dimen/size_8dp"
      android:layout_marginStart="@dimen/size_8dp"
      android:layout_marginTop="@dimen/size_4dp"
      android:background="@drawable/bg_bid_details_action"
      android:gravity="center_horizontal"
      android:orientation="vertical"
      bind:shadow="@{ @dimen/size_2dp }"
      >

    <android.support.v7.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="38dp"
        app:srcCompat="@drawable/ic_place_bid"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_12dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        android:lineSpacingExtra="2sp"
        android:shadowColor="#3b000000"
        android:shadowDy="2"
        android:shadowRadius="16"
        android:text="@{ @string/msg_bids_received_till_now(bidsRecieved) }"
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:textStyle="normal"
        tools:text="23 bids recieved till now"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_2dp"
        android:fontFamily="sans-serif"
        android:gravity="center_horizontal"
        android:letterSpacing="0.01"
        android:lineSpacingExtra="6sp"
        android:text="@string/msg_you_have_not_placed_any_bid"
        android:textColor="#e0e0e0"
        android:textSize="12sp"
        android:textStyle="normal"
        />

    <android.support.v7.widget.AppCompatButton
        android:id="@+id/btn_place_bid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_28dp"
        android:layout_marginTop="@dimen/size_20dp"
        android:background="@drawable/bg_bid_details_action_btn"
        android:fontFamily="sans-serif-medium"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:letterSpacing="0.04"
        android:paddingEnd="36dp"
        android:paddingStart="36dp"
        android:text="@string/action_place_bid"
        android:textColor="@color/colorAccent"
        android:textSize="14sp"
        />
  </android.support.v7.widget.LinearLayoutCompat>
</layout>