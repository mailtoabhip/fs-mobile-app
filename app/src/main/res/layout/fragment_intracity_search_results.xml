<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    >
  <data>
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.searchload.fragments.searchresults.SearchResultsViewModel"
        />
    <variable
        name="origin"
        type="com.delhivery.axle.data.CityModel"
        />
    <variable
        name="destination"
        type="com.delhivery.axle.data.CityModel"
        />
  </data>
  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_cities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/size_16dp"
        android:paddingRight="@dimen/size_16dp"
        android:background="@color/colorPrimary">

      <androidx.appcompat.widget.AppCompatTextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="@color/black"
          android:fontFamily="sans-serif"
          android:textFontWeight="500"
          app:layout_constraintBottom_toTopOf="@id/container_reporting_center"
          app:layout_constraintStart_toStartOf="parent"
          android:text="@string/select_reporting_center"
          android:textSize="@dimen/text_14sp"
          android:layout_marginTop="@dimen/size_12dp"
          android:layout_marginBottom="@dimen/size_4dp"
          />

     <androidx.appcompat.widget.LinearLayoutCompat
         android:id="@+id/container_reporting_center"
         android:layout_width="match_parent"
         android:layout_height="wrap_content"
         android:paddingLeft="@dimen/size_12dp"
         android:layout_marginTop="36dp"
         android:background="@drawable/rounded_corner"
         android:paddingTop="@dimen/size_8dp"
         android:paddingBottom="@dimen/size_8dp"
         android:lineHeight="@dimen/size_24dp"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintTop_toTopOf="parent">

       <androidx.appcompat.widget.AppCompatTextView
           android:id="@+id/tv_reporting_center_city"
           android:text="@{origin.cityName()+','}"
           android:textColor="@color/black"
           android:textSize="@dimen/text_16sp"
           android:layout_height="match_parent"
           android:layout_width="wrap_content"/>

       <androidx.appcompat.widget.AppCompatTextView
           android:id="@+id/tv_reporting_center_state"
           android:text="@{' '+origin.stateName()}"
           android:textColor="#A3AAC2"
           android:textSize="@dimen/text_16sp"
           android:layout_height="match_parent"
           android:layout_width="wrap_content"/>
     </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rv"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_margin="@dimen/size_8dp"
          />

      <RelativeLayout
          android:id="@+id/container_spinner"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@color/colorPrimary"
          android:paddingBottom="@dimen/size_8dp"
          android:paddingEnd="@dimen/size_16dp"
          android:paddingStart="@dimen/size_16dp"
          android:paddingTop="@dimen/size_8dp"
          bind:shadow="@{ @dimen/size_4dp }"
          >

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_truck_type"
            android:textColor="@color/black"
            android:textSize="@dimen/text_14sp"
            android:textFontWeight="500"
            android:fontFamily="sans-serif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/truck_type"
            />

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/spinner_truck_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_4dp"
            android:textSize="@dimen/text_16sp"
            android:paddingTop="@dimen/size_8dp"
            android:paddingBottom="@dimen/size_8dp"
            android:paddingStart="@dimen/size_12dp"
            android:background="@drawable/bg_search_load_spinner"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_below="@id/tv_truck_type"
            bind:shadow="@{ @dimen/size_2dp }"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_status"
            android:textColor="@color/black"
            android:textFontWeight="500"
            android:fontFamily="sans-serif"
            android:textSize="@dimen/text_14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/spinner_truck_type"
            android:text="@string/status"
            />
        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@id/spinner_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_status"
            android:textSize="@dimen/text_16sp"
            android:paddingTop="@dimen/size_8dp"
            android:paddingBottom="@dimen/size_8dp"
            android:paddingStart="@dimen/size_12dp"
            android:layout_marginBottom="@dimen/size_8dp"
            android:layout_marginTop="@dimen/size_4dp"
            android:background="@drawable/bg_search_load_spinner"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            bind:shadow="@{ @dimen/size_2dp }"
            />

        <View
            android:id="@+id/view_hidden_indicator"
            android:layout_width="@dimen/size_64dp"
            android:layout_height="@dimen/size_6dp"
            android:layout_below="@id/spinner_status"
            android:layout_centerHorizontal="true"
            android:alpha="0"
            android:background="@drawable/bg_search_header_visible_view"
            />
      </RelativeLayout>
    </FrameLayout>
  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>