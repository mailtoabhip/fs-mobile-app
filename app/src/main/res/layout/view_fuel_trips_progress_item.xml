<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
  <androidx.cardview.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:clickable="true"
      android:focusable="true"
      android:layout_marginStart="@dimen/size_8dp"
      android:layout_marginEnd="@dimen/size_8dp"
      android:layout_marginTop="@dimen/size_4dp"
      android:layout_marginBottom="@dimen/size_4dp"
      android:foreground="?attr/selectableItemBackgroundBorderless"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="@dimen/size_2dp"
      >

    <com.delhivery.axle.ui.custom.DelhiveryShimmerLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
      <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:clickable="false"
          android:focusable="false"
          android:paddingBottom="@dimen/size_16dp"
          android:paddingEnd="@dimen/size_16dp"
          android:paddingStart="@dimen/size_16dp"
          android:paddingTop="@dimen/size_12dp"
          >

        <View
            android:id="@+id/img_forward"
            android:layout_width="@dimen/size_24dp"
            android:layout_height="@dimen/size_24dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:background="@color/colorShimmerPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <View
            android:id="@+id/view_source_city"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:background="@color/colorShimmerPrimary"
            app:layout_constraintBottom_toBottomOf="@id/img_forward"
            app:layout_constraintEnd_toStartOf="@id/img_forward"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/img_forward"
            />

        <View
            android:id="@+id/view_source_state"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_16dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:background="@color/colorShimmerSecondary"
            app:layout_constraintEnd_toStartOf="@id/img_forward"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/view_source_city"
            />

        <View
            android:id="@+id/view_destination_city"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/size_16dp"
            android:background="@color/colorShimmerPrimary"
            app:layout_constraintBottom_toBottomOf="@id/img_forward"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/img_forward"
            app:layout_constraintTop_toTopOf="@id/img_forward"
            />

        <View
            android:id="@+id/view_destination_state"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_16dp"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:background="@color/colorShimmerSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/img_forward"
            app:layout_constraintTop_toBottomOf="@id/view_destination_city"
            />

        <View
            android:id="@+id/view_date_time"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="@dimen/size_16dp"
            android:background="@color/colorShimmerPrimary"
            app:layout_constraintEnd_toEndOf="@id/view_source_city"
            app:layout_constraintStart_toEndOf="@+id/view_truck_type"
            app:layout_constraintTop_toBottomOf="@id/view_source_state"
            />

        <View
            android:id="@+id/view_truck_type"
            android:layout_width="32dp"
            android:layout_height="@dimen/size_20dp"
            android:background="@color/colorShimmerPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/view_date_time"
            />

        <View
            android:id="@+id/view_truck_details"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_16dp"
            android:layout_marginTop="2dp"
            android:background="@color/colorShimmerSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/view_destination_state"
            app:layout_constraintTop_toTopOf="@id/view_truck_type"
            />

        <View
            android:id="@+id/view_load_details"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_12dp"
            android:background="@color/colorShimmerSecondary"
            app:layout_constraintEnd_toEndOf="@+id/view_date_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/view_date_time"
            />

        <View
            android:id="@+id/view"
            android:layout_width="60dp"
            android:layout_height="@dimen/size_14dp"
            android:layout_marginTop="8dp"
            android:background="@color/colorShimmerSecondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_load_details"
            />

        <View
            android:id="@+id/id1"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_40dp"
            android:layout_marginEnd="@dimen/size_8dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:background="@color/colorShimmerPrimary"
            app:layout_constraintEnd_toStartOf="@+id/id2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view"
            />

        <View
            android:id="@+id/id2"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_40dp"
            android:layout_marginStart="@dimen/size_8dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:background="@color/colorShimmerPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/id1"
            app:layout_constraintTop_toBottomOf="@+id/view"
            />
      </androidx.constraintlayout.widget.ConstraintLayout>
    </com.delhivery.axle.ui.custom.DelhiveryShimmerLayout>
  </androidx.cardview.widget.CardView>
</layout>