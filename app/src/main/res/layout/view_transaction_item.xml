<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >

  <data>

    <variable
        name="transaction"
        type="com.dfd.delfin.data.transactions.TransactionsItemData"
        />

    <import type="androidx.core.content.ContextCompat" />

    <import type="android.view.View" />
  </data>

  <androidx.cardview.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/size_8dp"
      android:layout_marginEnd="@dimen/size_8dp"
      android:layout_marginTop="@dimen/size_4dp"
      android:layout_marginBottom="@dimen/size_4dp"
      android:clickable="true"
      android:focusable="true"
      android:foreground="?attr/selectableItemBackgroundBorderless"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="2dp"
      >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:paddingTop="@dimen/size_8dp"
        android:paddingBottom="@dimen/size_8dp"
        android:layout_height="wrap_content"
        >

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/sublabel"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif"
          android:text="@{transaction.subLabel()}"
          bind:textColor="@{ ContextCompat.getColor(context, transaction.requiredStatusColor()) }"
          android:textColor="@color/heading_black"
          android:visibility="@{ transaction.subLabel().isEmpty() ? View.GONE : View.VISIBLE }"
          app:layout_constraintEnd_toStartOf="@+id/time"
          tools:visibility="gone"
          app:layout_constraintStart_toStartOf="@+id/label"
          app:layout_constraintTop_toTopOf="@+id/time"
          tools:text="₹ 23,900.00"
          />

      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/image"
          android:layout_width="@dimen/size_56dp"
          android:layout_height="@dimen/size_56dp"
          android:layout_margin="@dimen/size_8dp"
          android:paddingTop="@dimen/size_12dp"
          android:paddingBottom="@dimen/size_12dp"
          android:background="@drawable/bg_circular_boundary_black"
          app:srcCompat="@{ transaction.transactionTypeDrawableRes() }"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/label"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_8dp"
          android:fontFamily="sans-serif-medium"
          android:text="@{transaction.transactionHeading()}"
          android:textSize="@dimen/text_16sp"
          app:layout_constraintBottom_toBottomOf="@+id/amount"
          app:layout_constraintEnd_toStartOf="@+id/amount"
          app:layout_constraintStart_toEndOf="@+id/image"
          app:layout_constraintTop_toTopOf="@+id/amount"
          tools:text="Debit from IOCL"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/amount"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="@dimen/size_8dp"
          android:textSize="@dimen/text_20sp"
          tools:text="-$ 3000"
          android:fontFamily="sans-serif-medium"
          android:singleLine="true"
          android:text="@{transaction.amountAndSymbol()}"
          bind:textColor="@{ ContextCompat.getColor(context, transaction.requiredAmountColor()) }"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toTopOf="@+id/time"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="@dimen/size_8dp"
          android:fontFamily="sans-serif"
          android:singleLine="true"
          android:text="@{transaction.dateTime()}"
          android:textColor="@color/heading_black"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/amount"
          app:layout_constraintBottom_toBottomOf="parent"
          tools:text="Sat 29 2019"
          />

    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.cardview.widget.CardView>

</layout>