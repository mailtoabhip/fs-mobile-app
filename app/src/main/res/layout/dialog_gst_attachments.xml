<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/size_24dp"
        android:background="@drawable/bg_bottom_dialog">

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/size_12dp"
                app:layout_constraintStart_toEndOf="@+id/close_btn"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/size_12dp"
                android:textColor="@color/heading_black"
                android:layout_gravity="center"
                android:textSize="@dimen/text_16sp"
                android:id="@+id/label_gst"
                android:layout_marginStart="@dimen/size_12dp"
                android:layout_toEndOf="@+id/close_btn"
                android:text="@string/label_gst"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close_btn"
                android:layout_marginTop="@dimen/size_16dp"
                android:layout_marginEnd="@dimen/size_10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="@dimen/size_24dp"
                android:layout_alignParentStart="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_vector_back"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_4dp"
            android:id="@+id/sepLine"
            android:layout_marginTop="@dimen/size_12dp"
            app:layout_constraintTop_toBottomOf="@+id/label_gst"
            app:srcCompat="@drawable/seperator_line"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/labelAttach"
            app:layout_constraintTop_toBottomOf="@+id/sepLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:gravity="start"
            android:layout_marginStart="@dimen/size_24dp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/size_32dp"
            android:textSize="@dimen/text_14sp"
            android:text="@string/label_attach"
            android:textColor="@color/sub_heading_black"
            />

        <ListView
            android:layout_width="match_parent"
            android:id="@+id/attachmentList"
            app:layout_constraintTop_toBottomOf="@+id/labelAttach"
            android:layout_marginTop="@dimen/size_16dp"
            android:layout_below="@+id/labelAttach"
            android:layout_height="wrap_content"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_upload_more"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/action_upload_more"
            app:autoSizeTextType="uniform"
            style="@style/OutlineActionButton"
            android:textAllCaps="false"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_marginStart="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_8dp"
            app:layout_constraintEnd_toStartOf="@+id/button_submit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/attachmentList"
             />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_submit"
            android:layout_width="0dp"
            style="@style/ActionButton"
            app:autoSizeTextType="uniform"
            android:textAllCaps="false"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_marginEnd="@dimen/size_24dp"
            android:layout_marginStart="@dimen/size_8dp"
            app:layout_constraintStart_toEndOf="@+id/button_upload_more"
            android:layout_height="wrap_content"
            android:text="@string/action_submit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/attachmentList"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>