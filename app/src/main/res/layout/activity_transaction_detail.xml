<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="transaction"
        type="com.delhivery.axle.data.transactions.TransactionsItemData"
        />

  </data>
  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/colorBackground"
      android:orientation="vertical"
      >

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_8dp"
        android:layout_marginEnd="@dimen/size_8dp"
        android:layout_marginTop="@dimen/size_8dp"
        android:layout_marginBottom="@dimen/size_4dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@+id/container_detail"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:cardCornerRadius="@dimen/size_6dp"
        app:cardElevation="2dp"
        >

      <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_all_round_corner_white"
          >

        <TextView
            android:id="@+id/text_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_24dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_24sp"
            android:text="@{transaction.amount()}"
            app:layout_constraintStart_toEndOf="@+id/id1"
            app:layout_constraintTop_toBottomOf="@+id/id2"
            tools:text="₹ 23,900.00"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/id1"
            android:layout_marginStart="@dimen/size_32dp"
            android:layout_marginTop="@dimen/size_32dp"
            android:layout_marginBottom="@dimen/size_32dp"
            android:layout_width="@dimen/size_56dp"
            android:layout_height="@dimen/size_56dp"
            app:srcCompat="@drawable/ic_wallet"
            android:paddingTop="@dimen/size_8dp"
            android:paddingBottom="@dimen/size_12dp"
            android:background="@drawable/bg_circular_boundary_black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/id2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_24dp"
            tools:text="@string/label_your_advance_amount"
            android:textSize="@dimen/text_12sp"
            android:text="@{transaction.balanceHeading()}"
            app:layout_constraintStart_toEndOf="@+id/id1"
            app:layout_constraintTop_toTopOf="@+id/id1"
            />

      </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/container_detail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        >

    </androidx.appcompat.widget.LinearLayoutCompat>

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>