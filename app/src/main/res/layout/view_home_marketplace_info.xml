<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:autofit="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <androidx.cardview.widget.CardView
      android:id="@+id/add_truck_card"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/size_12dp"
      android:layout_marginEnd="@dimen/size_12dp"
      android:layout_marginTop="@dimen/size_8dp"
      android:clickable="true"
      android:focusable="true"
      android:foreground="?attr/selectableItemBackgroundBorderless"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="@dimen/size_2dp"
      >
  <RelativeLayout
      android:id="@+id/truck_banner"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@drawable/background_all_rounded_truck_banner"
      android:orientation="horizontal"
      android:paddingStart="@dimen/size_8dp"
      android:paddingTop="@dimen/size_16dp"
      android:paddingEnd="@dimen/size_16dp"
      android:paddingBottom="@dimen/size_16dp"
      android:visibility="visible">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_priority_access"
        android:layout_width="@dimen/size_20dp"
        android:layout_height="@dimen/size_20dp"
        android:paddingTop="@dimen/size_4dp"
        app:srcCompat="@drawable/ic_circle_exclamation"
        app:tint="@color/orange_v3"
         />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/label_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/size_8dp"
        android:layout_toRightOf="@id/img_priority_access"
        android:orientation="vertical"
        bind:layout_constraintBottom_toBottomOf="parent"
        bind:layout_constraintStart_toEndOf="@id/img_priority_access"
        bind:layout_constraintTop_toTopOf="parent">

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_truck_heading"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginBottom="@dimen/size_4dp"
          android:fontFamily="sans-serif-medium"
          android:lineSpacingExtra="6sp"
          android:text="Place a Bid to Contact Shipper"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_16sp" />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_truck_sub_heading"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:text="Submit your bid to contact the shipper directly"
          android:textColor="@color/custom_dark_grey"
          android:textSize="@dimen/text_12sp" />

    </androidx.appcompat.widget.LinearLayoutCompat>

  </RelativeLayout>
  </androidx.cardview.widget.CardView>
</layout>