<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/white">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/haveNoBid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:paddingBottom="@dimen/size_12dp"
        android:layout_margin="@dimen/size_16dp"
        android:visibility="gone">
      <androidx.appcompat.widget.AppCompatTextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          android:gravity="center"
          android:textSize="@dimen/text_18sp"
          android:padding="@dimen/size_16dp"
          android:textStyle="bold"
          android:textColor="@color/background_dark_grey"
          android:background="@drawable/bg_all_round_corner_solid_light_grey"
          android:text="@string/you_did_not_bid_for_this_contract"
          />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contractBidResultLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone"
        android:padding="@dimen/size_16dp">
      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/imgResult"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:srcCompat="@drawable/ic_icon_result"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintStart_toStartOf="parent"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/resultLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_8dp"
          app:layout_constraintTop_toTopOf="@id/imgResult"
          app:layout_constraintBottom_toBottomOf="@id/imgResult"
          app:layout_constraintStart_toEndOf="@id/imgResult"
          android:textSize="@dimen/text_16sp"
          android:textColor="@color/background_dark_grey"
          android:text="Result"
          android:textStyle="bold"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/resultDescribe"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          app:layout_constraintTop_toBottomOf="@id/resultLabel"
          app:layout_constraintStart_toStartOf="parent"
          android:visibility="gone"
          android:textSize="@dimen/text_14sp"
          android:textColor="@color/background_dark_grey"
          android:text="@string/results_will_be_announced_shortly"/>

      <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/bidAmountLayout"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/bg_all_round_corner_solid_light_grey"
          app:layout_constraintTop_toBottomOf="@id/resultDescribe"
          app:layout_constraintStart_toStartOf="parent"
          android:layout_marginTop="@dimen/size_12dp"
          android:visibility="gone"
          android:padding="@dimen/size_8dp">
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/yourBidAmountLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          android:drawableStart="@drawable/ic_black_money"
          android:drawablePadding="@dimen/size_12dp"
          android:textSize="@dimen/text_16sp"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          android:textColor="@color/background_dark_grey"
          android:textStyle="bold"
          android:text="@string/your_bid_amount"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/yourBidAmountValue"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          app:layout_constraintTop_toTopOf="parent"
         app:layout_constraintEnd_toEndOf="parent"
          android:textStyle="bold"
          android:textSize="@dimen/text_16sp"
          android:textColor="@color/background_dark_grey"
          android:text="$ 50000"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/seperator"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            app:srcCompat="@drawable/seperator_line"
            android:layout_marginTop="@dimen/size_12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/yourBidAmountValue"
            />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/yourTripCommitment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8dp"
            android:drawableStart="@drawable/ic_black_money"
            android:drawablePadding="@dimen/size_12dp"
            app:layout_constraintTop_toBottomOf="@+id/seperator"
            app:layout_constraintStart_toStartOf="parent"
            android:textStyle="bold"
            android:textSize="@dimen/text_16sp"
            android:textColor="@color/background_dark_grey"
            android:text="@string/trip_commitment"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/yourTripCommitmentValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8dp"
            app:layout_constraintTop_toBottomOf="@+id/seperator"
            app:layout_constraintEnd_toEndOf="parent"
            android:textStyle="bold"
            android:textSize="@dimen/text_16sp"
            android:textColor="@color/background_dark_grey"
            android:text="25"/>
      </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>

</layout>