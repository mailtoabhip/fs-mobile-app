<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/weakBidCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/layout_mobile_no"
        app:cardBackgroundColor="#FEEFEF">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <!-- Thumbs Down Icon -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/thumbIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_thumbs_down"
                android:tint="#B71C1C"
                android:contentDescription="Weak bid icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/weakBidTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weak bid"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#8E2720"
                app:layout_constraintStart_toEndOf="@id/thumbIcon"
                app:layout_constraintTop_toTopOf="@id/thumbIcon"
                android:layout_marginStart="8dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/weakBidSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="You have low chances of winning!"
                android:textSize="14sp"
                android:textColor="#505361"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/weakBidTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</layout>
