<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
        <data>
                <variable
                    name="request"
                    type="com.dfd.delfin.data.home.bids.HomeBidsRequestItemData"
                    />

                <import type="android.view.View" />
        </data>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/transaction_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/target_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/faded_black"
                    tools:hint="Rs 1200"
                    android:text="@{request.formatedTargetPrice()}"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_16sp"
                    android:paddingStart="@dimen/size_16dp"
                    android:paddingTop="@dimen/size_12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/target_price_div"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/faded_black"
                    android:text="|"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_16sp"
                    android:paddingStart="@dimen/size_4dp"
                    android:paddingTop="@dimen/size_12dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/target_price"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/totalKm"
                    tools:hint="100 KM -"
                    android:textColor="@color/faded_black"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_12sp"
                    android:paddingTop="@dimen/size_12dp"
                    android:paddingStart="@dimen/size_2dp"
                    android:text="@{request.adhocIntracityKms()}"
                    app:layout_constraintStart_toEndOf="@+id/target_price_div"
                    app:layout_constraintBottom_toBottomOf="@+id/target_price"
                    app:layout_constraintTop_toTopOf="@+id/target_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/totalDuration"
                    tools:hint=" 8 hr"
                    android:textStyle="bold"
                    android:textColor="@color/faded_black"
                    android:textSize="@dimen/text_12sp"
                    android:paddingStart="@dimen/size_1dp"
                    android:paddingTop="@dimen/size_12dp"
                    android:text="@{request.adhocIntracityhrs()}"
                    app:layout_constraintStart_toEndOf="@+id/totalKm"
                    app:layout_constraintBottom_toBottomOf="@+id/target_price"
                    app:layout_constraintTop_toTopOf="@+id/target_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/vehicleNumber"
                    tools:hint="MK12KJ9876"
                    android:text="@{request.truckTypeWithMT()}"
                    android:textColor="@color/faded_black"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_12sp"
                    android:paddingTop="@dimen/size_12dp"
                    android:paddingEnd="@dimen/size_16dp"
                    android:drawablePadding="@dimen/size_4dp"
                    android:drawableStart="@drawable/ic_truck_type"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/location"
                    app:layout_constraintTop_toTopOf="@+id/cityCodePincode"
                    app:layout_constraintBottom_toBottomOf="@+id/cityCodePincode"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_16dp"
                    android:paddingTop="@dimen/size_2dp"
                    android:src="@drawable/ic_location_pincode"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/cityCodePincode"
                    tools:hint="Bangalore - 834004"
                    android:textStyle="bold"
                    android:textColor="@color/head_black"
                    android:paddingTop="@dimen/size_2dp"
                    android:textSize="@dimen/text_12sp"
                    android:layout_marginTop="@dimen/size_8dp"
                    android:text="@{request.originCentreName()}"
                    android:layout_marginStart="@dimen/size_4dp"
                    app:layout_constraintTop_toBottomOf="@+id/totalKm"
                    app:layout_constraintStart_toEndOf="@+id/location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/reportingTime"
                    android:textSize="@dimen/text_12sp"
                    android:drawablePadding="@dimen/size_4dp"
                    tools:hint = "8:00 am"
                    android:text="@{request.requiredAtWithTime()}"
                    android:paddingTop="@dimen/size_2dp"
                    android:paddingEnd="@dimen/size_16dp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_reporting_time"
                    android:textColor="@color/head_black"
                    app:layout_constraintTop_toTopOf="@+id/cityCodePincode"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/reportingAddress"
                    tools:hint="SV Road - Bangalore"
                    android:textSize="@dimen/text_12sp"
                    android:textColor="@color/faded_black"
                    android:paddingTop="@dimen/size_2dp"
                    android:paddingBottom="@dimen/size_8dp"
                    android:paddingStart="@dimen/size_2dp"
                    android:paddingEnd="@dimen/size_16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:text="@{request.pickupLocationAddress}"
                    app:layout_constraintTop_toBottomOf="@+id/cityCodePincode"
                    app:layout_constraintStart_toStartOf="@id/cityCodePincode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
</layout>