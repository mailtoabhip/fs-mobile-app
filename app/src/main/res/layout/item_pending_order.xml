<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginHorizontal="@dimen/size_16dp"
    android:layout_marginVertical="@dimen/size_6dp"
    android:background="@drawable/bg_pending_order_card"
    android:padding="@dimen/size_16dp">

    <!-- Header: Order ID + Date + Expand/Collapse -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_body_primary"
                style="@style/TextAppearance.Delfin.B16"
                android:textSize="@dimen/text_14sp"
                tools:text="Order ID: #41641" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvOrderMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_4dp"
                android:textColor="@color/text_caption_primary"
                style="@style/TextAppearance.Delfin.R14"
                android:textSize="@dimen/text_12sp"
                tools:text="26 May 2026" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivExpandCollapse"
            android:layout_width="@dimen/size_24dp"
            android:layout_height="@dimen/size_24dp"
            android:contentDescription="@string/action_continue"
            android:src="@drawable/ic_chevron_down" />

    </LinearLayout>

    <!-- Divider (shown when expanded) -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/size_12dp"
        android:background="#E5E7EB"
        android:visibility="gone" />

    <!-- Expandable Vehicles Container -->
    <LinearLayout
        android:id="@+id/vehiclesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_4dp"
        android:orientation="vertical"
        android:visibility="gone" />

</LinearLayout>
