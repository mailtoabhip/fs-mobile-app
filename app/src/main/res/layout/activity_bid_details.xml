<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.biddetails.BidDetailsViewModel"
        />

    <variable
        name="transaction"
        type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData"
        />

    <variable
        name="refreshing"
        type="Boolean"
        />

    <variable
        name="error"
        type="Boolean"
        />
    <variable
        name="unallocated"
        type="String"
        />
    <import type="android.view.View" />
  </data>

  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:animateLayoutChanges="true"
      android:orientation="vertical"
      >

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        bind:shadow="@{ @dimen/size_4dp }"
        />

    <include
        android:id="@+id/container_error"
        layout="@layout/view_warning_item"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:visibility="@{error ? View.VISIBLE : View.GONE }"
        tools:visibility="gone"
        />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="@{!error ? View.VISIBLE : View.GONE }"
        tools:visibility="visible"
        >

      <androidx.core.widget.NestedScrollView
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:fillViewport="true"
          >

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="@{!refreshing &amp;&amp; !error ? View.VISIBLE : View.GONE }"
            tools:visibility="visible"
            >

          <!-- details container -->
          <androidx.constraintlayout.widget.ConstraintLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:background="@color/colorPrimary"
              android:paddingTop="@dimen/size_10dp"
              android:paddingBottom="@dimen/size_10dp"
              android:paddingStart="@dimen/size_14dp"
              android:paddingEnd="@dimen/size_14dp"
              bind:shadow="@{ @dimen/size_2dp }"
              >

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:text="@{transaction.originDistrictCityState()}"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="North Goa\nPanjim, Goa"
                />


            <LinearLayout
                android:layout_width="wrap_content"
                android:id="@+id/img_forward"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/size_4dp"
                android:layout_marginEnd="@dimen/size_4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/text_destination"
                android:layout_height="wrap_content">
              <TextView
                  android:layout_width="wrap_content"
                  android:id="@+id/stopNo"
                  android:paddingStart="@dimen/size_16dp"
                  android:paddingEnd="@dimen/size_16dp"
                  android:layout_height="wrap_content"/>

              <androidx.appcompat.widget.AppCompatImageView
                  android:layout_width="match_parent"
                  android:layout_height="5dp"
                  app:srcCompat="@drawable/seprator_dotted"
                  />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_destination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_2dp"
                android:fontFamily="sans-serif"
                android:text="@{transaction.destinationDistrictCityState()}"
                android:textColor="@color/heading_black"
                android:textAlignment="textEnd"
                android:textSize="@dimen/text_16sp"
               app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Andheri east\nMumbai, Maharashtra"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_via_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_10dp"
                android:fontFamily="sans-serif"
                android:text="@string/label_intermediary"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_14sp"
                android:visibility="@{transaction.isMultiDrop() ? View.VISIBLE : View.GONE}"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_destination"
                />

            <include
                android:layout_width="match_parent"
                android:id="@+id/text_via_destination"
                android:layout_marginTop="@dimen/size_2dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_via_label"
                android:visibility="@{transaction.isMultiDrop() ? View.VISIBLE : View.GONE}"
                android:layout_height="wrap_content"
                layout="@layout/view_intermdiary" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_load_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_6dp"
                android:fontFamily="sans-serif"
                android:gravity="end"
                android:text="@{ transaction.loadDetails() }"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_via_destination"
                tools:text="Load: Pharmaceuticals"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_bulk_load"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_via_destination"
                android:textSize="@dimen/text_16sp"
                android:textStyle="bold"
                android:visibility="@{transaction.setDMTTypeForBid(viewModel.fromPage)}"
                android:layout_marginTop="@dimen/size_6dp"
                android:text="@{transaction.setDmtText()}"
                android:textColor="@color/bid_placed_red"
                tools:text="Bulk Load: 200MT"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_date_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:lineSpacingExtra="@dimen/text_4sp"
                android:text="@{ transaction.requiredAt() }"
                android:textColor="@color/white"
                android:textSize="@dimen/text_12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_load_details"
                bind:drawableResId="@{ transaction.requiredAtBg() }"
                tools:background="@drawable/bg_date_today"
                tools:text="TODAY"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_truck_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:text="@{ transaction.truckDetail() }"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/text_date_time"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/text_date_time"
                tools:text="Closed truck (32ft)"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/size_8dp"
                app:layout_constraintBottom_toBottomOf="@id/text_truck_details"
                app:layout_constraintEnd_toStartOf="@id/text_truck_details"
                app:layout_constraintTop_toTopOf="@id/text_truck_details"
                app:srcCompat="@{ transaction.truckTypeDrawableRes() }"
                tools:srcCompat="@drawable/ic_closed_truck"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_is_multidrop"
                android:text="Multidrop"
                android:visibility="@{transaction.setMutidrop()}"
                android:fontFamily="sans-serif"
                android:padding="@dimen/size_8dp"
                android:background="@drawable/bg_gradient_blue"
                android:layout_marginTop="@dimen/size_10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_date_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <RelativeLayout
                android:layout_width="wrap_content"
                android:paddingTop="@dimen/size_8dp"
                android:paddingBottom="@dimen/size_8dp"
                android:paddingStart="@dimen/size_16dp"
                android:paddingEnd="@dimen/size_16dp"

                android:visibility="@{transaction.timerPlaceLayoutVisibility()}"
                android:id="@+id/timerLayout"
                android:layout_marginTop="@dimen/size_10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_date_time"
                android:background="@drawable/bg_gradient_orange_16"
                android:layout_height="wrap_content">
              <androidx.appcompat.widget.AppCompatImageView
                  android:layout_width="wrap_content"
                  app:srcCompat="@drawable/ic_timer"
                  android:id="@+id/img"
                  android:layout_marginTop="@dimen/size_2dp"
                  android:layout_below="@+id/tvtimer"
                  android:layout_height="wrap_content"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:text="Time left to bid"
                  android:textColor="@color/white"
                  android:id="@+id/tvtimer"
                  android:layout_centerHorizontal="true"
                  android:textSize="@dimen/text_12sp"
                  android:layout_height="wrap_content"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_below="@+id/tvtimer"
                  android:id="@+id/timerTime"
                  android:layout_marginTop="@dimen/size_2dp"
                  android:textSize="@dimen/size_16dp"
                  android:layout_toEndOf="@+id/img"
                  android:layout_marginStart="@dimen/size_4dp"
                  android:textColor="@color/white"
                  android:layout_height="wrap_content"/>
            </RelativeLayout>


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_target_price_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_24dp"
                android:fontFamily="sans-serif"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_12sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_is_multidrop"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_target_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_4dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="-4sp"
                android:textColor="@color/black"
                android:textSize="@dimen/text_24sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_target_price_label"
                tools:text="₹ 23900.00"
                />
          </androidx.constraintlayout.widget.ConstraintLayout>

          <!-- bidding completed text -->
          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/text_bid_ended"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="@dimen/size_4dp"
              android:background="@color/colorPrimary"
              android:fontFamily="sans-serif-medium"
              android:gravity="center_horizontal"
              android:padding="@dimen/size_14dp"
              android:text="@string/label_bidding_ended"
              android:textColor="#59181818"
              android:textSize="@dimen/text_16sp"
              android:visibility="gone"
              bind:shadow="@{ @dimen/size_2dp }"
              />

          <!-- actions container -->
          <FrameLayout
              android:id="@+id/container_actions"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:paddingTop="@dimen/size_4dp"
              />
        </androidx.appcompat.widget.LinearLayoutCompat>

      </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>