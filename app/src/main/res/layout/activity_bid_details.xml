<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="viewModel"
        type="com.delhivery.orion.ui.biddetails.BidDetailsViewModel"
        />
    <variable
        name="transaction"
        type="com.delhivery.orion.data.home.HomeBidsRequestItemData"
        />
  </data>
  <android.support.v7.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      >

    <android.support.v7.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        bind:shadow="@{ @dimen/size_4dp }"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        >
      <android.support.v7.widget.LinearLayoutCompat
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          >
        <!-- confirmed bid banner -->
        <android.support.constraint.ConstraintLayout
            android:id="@+id/container_confirm_bid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_4dp"
            android:background="@color/colorPrimary"
            android:paddingBottom="@dimen/size_36dp"
            android:paddingEnd="@dimen/size_28dp"
            android:paddingStart="@dimen/size_28dp"
            android:paddingTop="@dimen/size_36dp"
            android:visibility="gone"
            bind:shadow="@{ @dimen/size_2dp }"
            >

          <TextView
              android:id="@+id/text_title_confirmed_bid"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif-medium"
              android:gravity="center_horizontal"
              android:letterSpacing="0.01"
              android:lineSpacingExtra="2sp"
              android:text="@string/title_confirmed_bid_details_banner"
              android:textColor="#181818"
              android:textSize="16sp"
              android:textStyle="normal"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toStartOf="parent"
              />

          <android.support.v7.widget.AppCompatImageView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginEnd="@dimen/size_4dp"
              app:layout_constraintEnd_toStartOf="@id/text_title_confirmed_bid"
              app:srcCompat="@drawable/ic_check_circle_green"
              />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_10dp"
              android:fontFamily="sans-serif"
              android:gravity="center_horizontal"
              android:letterSpacing="0.01"
              android:lineSpacingExtra="6sp"
              android:text="@string/msg_confirmed_bid_details_banner"
              android:textColor="#181818"
              android:textSize="12sp"
              android:textStyle="normal"
              app:layout_constraintTop_toBottomOf="@id/text_title_confirmed_bid"
              />

        </android.support.constraint.ConstraintLayout>

        <!-- details container -->
        <android.support.constraint.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:padding="24dp"
            bind:shadow="@{ @dimen/size_2dp }"
            >

          <TextView
              android:id="@+id/text_from_label"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:text="@string/label_from"
              android:textColor="#99000000"
              android:textSize="12sp"
              android:textStyle="normal"
              />

          <TextView
              android:id="@+id/text_source"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_2dp"
              android:fontFamily="sans-serif"
              android:textColor="#de000000"
              android:textSize="16sp"
              app:layout_constraintTop_toBottomOf="@id/text_from_label"
              bind:htmlText="@{ @string/label_city_state(transaction.origin, transaction.originState) }"
              tools:text="Panjim, Goa"
              />

          <TextView
              android:id="@+id/text_to_label"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_16dp"
              android:fontFamily="sans-serif"
              android:text="@string/label_to"
              android:textColor="#99000000"
              android:textSize="12sp"
              android:textStyle="normal"
              app:layout_constraintTop_toBottomOf="@id/text_source"
              />

          <TextView
              android:id="@+id/text_destination"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_2dp"
              android:fontFamily="sans-serif"
              android:textColor="#de000000"
              android:textSize="16sp"
              app:layout_constraintTop_toBottomOf="@id/text_to_label"
              bind:htmlText="@{ @string/label_city_state(transaction.destination, transaction.destinationState) }"
              tools:text="Andheri east, Mumbai, Maharashtra"
              />

          <TextView
              android:id="@+id/text_date_time"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_16dp"
              android:lineSpacingExtra="4sp"
              android:text="@{ transaction.requiredAt() }"
              android:textColor="#ffffff"
              android:textSize="10sp"
              app:layout_constraintTop_toBottomOf="@id/text_destination"
              bind:drawableResId="@{ transaction.requiredAtBg() }"
              tools:background="@drawable/bg_date_today"
              tools:text="TODAY 6:30 pm"
              />

          <TextView
              android:id="@+id/text_truck_details"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:gravity="center_vertical"
              android:text="@{ transaction.truckTypeDetails() }"
              android:textColor="#99000000"
              android:textSize="13sp"
              android:textStyle="normal"
              app:layout_constraintBottom_toBottomOf="@id/text_date_time"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintTop_toTopOf="@id/text_date_time"
              tools:text="Closed truck (32ft)"
              />

          <android.support.v7.widget.AppCompatImageView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginEnd="@dimen/size_8dp"
              app:layout_constraintEnd_toStartOf="@id/text_truck_details"
              app:layout_constraintTop_toTopOf="@id/text_truck_details"
              app:srcCompat="@{ transaction.truckTypeDrawableRes() }"
              tools:srcCompat="@drawable/ic_closed_truck"
              />

          <TextView
              android:id="@+id/text_load_details"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_24dp"
              android:fontFamily="sans-serif"
              android:gravity="end"
              android:text="@{ transaction.loadDetails() }"
              android:textColor="#99000000"
              android:textSize="16sp"
              android:textStyle="normal"
              app:layout_constraintTop_toBottomOf="@id/text_date_time"
              tools:text="Load: Pharmaceuticals"
              />

          <android.support.v7.widget.AppCompatImageView
              android:id="@+id/img_supply_patner"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_10dp"
              app:layout_constraintTop_toBottomOf="@id/text_load_details"
              app:srcCompat="@drawable/ic_supply_patner"
              />

          <TextView
              android:id="@+id/text_loading_details"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="@dimen/size_6dp"
              android:fontFamily="sans-serif"
              android:text="Loading to be done by Supply partner"
              android:textColor="#99000000"
              android:textSize="12sp"
              android:textStyle="normal"
              app:layout_constraintBottom_toBottomOf="@id/img_supply_patner"
              app:layout_constraintStart_toEndOf="@id/img_supply_patner"
              app:layout_constraintTop_toTopOf="@id/img_supply_patner"
              />

          <TextView
              android:id="@+id/text_target_price_label"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_32dp"
              android:fontFamily="sans-serif"
              android:text="@string/label_target_price"
              android:textColor="#99000000"
              android:textSize="12sp"
              android:textStyle="normal"
              app:layout_constraintTop_toBottomOf="@id/text_loading_details"
              />

          <TextView
              android:id="@+id/text_target_price"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:fontFamily="sans-serif-medium"
              android:letterSpacing="0.01"
              android:lineSpacingExtra="-4sp"
              android:text="@{ @string/label_inr(transaction.targetPrice) }"
              android:textColor="#000000"
              android:textSize="22sp"
              android:textStyle="normal"
              app:layout_constraintTop_toBottomOf="@id/text_target_price_label"
              tools:text="₹ 23900.00"
              />
        </android.support.constraint.ConstraintLayout>

        <!-- bidding deadline text -->
        <TextView
            android:id="@+id/text_bid_deadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_4dp"
            android:background="#29a8e0"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:padding="@dimen/size_14dp"
            android:text="Bidding ends today at 4:00pm"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="normal"
            android:visibility="gone"
            bind:shadow="@{ @dimen/size_2dp }"
            />

        <!-- bidding completed text -->
        <TextView
            android:id="@+id/text_bid_ended"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_4dp"
            android:background="@color/colorPrimary"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:padding="@dimen/size_14dp"
            android:text="@string/label_bidding_ended"
            android:textColor="#59181818"
            android:textSize="16sp"
            android:textStyle="normal"
            android:visibility="gone"
            bind:shadow="@{ @dimen/size_2dp }"
            />

        <!-- actions container -->
        <FrameLayout
            android:id="@+id/container_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/size_4dp"
            />
      </android.support.v7.widget.LinearLayoutCompat>
    </ScrollView>
  </android.support.v7.widget.LinearLayoutCompat>
</layout>