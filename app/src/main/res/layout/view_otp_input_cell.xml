<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Single OTP digit cell.
        Width is 0dp + weight=1 so all 4 cells share the parent width equally.
        Background is swapped between bg_login_edit (normal) and bg_otp_cell_error (error).
    -->
    <com.dfd.delfin.ui.custom.DelhiveryOTPViewEditText
        android:id="@+id/otp_cell_edit"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="6dp"
        android:background="@drawable/bg_login_edit"
        android:digits="1234567890"
        android:gravity="center"
        android:imeOptions="actionNext"
        android:inputType="number"
        android:maxLength="1"
        android:textColor="@color/heading_black"
        android:textSize="22sp"
        android:textStyle="bold" />
</layout>
