<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_dialog"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/size_24dp"
        android:paddingTop="@dimen/size_40dp"
        android:paddingBottom="@dimen/size_40dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            bind:srcCompat="@drawable/ic_wallet" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_24dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/label_wallet_creating_title"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_20sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8dp"
            android:text="@string/label_wallet_creating_message"
            android:textColor="@color/color_hint"
            android:textSize="@dimen/text_14sp" />

    </LinearLayout>

</layout>
