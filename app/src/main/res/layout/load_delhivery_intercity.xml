<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <data>
    <variable
        name="request"
        type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData"
        />
    </data>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/size_16dp"
        android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_intercity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/size_8dp"
        app:cardCornerRadius="@dimen/size_8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingStart="@dimen/size_16dp"
        android:paddingEnd="@dimen/size_16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/fromCity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:text="@{request.originCityName()}"
            tools:text ="Navi Mumbai"
            android:textColor="#121A31"
            app:layout_constraintEnd_toStartOf="@id/guidelineCenter"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/view_stops"
            android:layout_width="60dp"
            android:layout_height="@dimen/size_16dp"
            app:layout_constraintBottom_toBottomOf="@id/fromCity"
            app:layout_constraintEnd_toStartOf="@id/toCity"
            app:layout_constraintHorizontal_bias="0.211"
            app:layout_constraintStart_toEndOf="@id/fromCity"
            app:layout_constraintTop_toTopOf="@id/fromCity"
            app:srcCompat="@drawable/ic_line_5" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_stops"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            tools:text ="2 stops"
            android:textColor="#8F9198"
            app:layout_constraintTop_toBottomOf="@id/view_stops"
            app:layout_constraintEnd_toEndOf="@id/view_stops"
            app:layout_constraintStart_toStartOf="@id/view_stops" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineCenter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.4"
            android:orientation="vertical" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineCenter1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.7"
            android:orientation="vertical" />
        <TextView
            android:id="@+id/toCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="@{request.destinationCityName()}"
            tools:text ="Jaisalmer"
            android:textColor="#121A31"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- From State -->
        <TextView
            android:id="@+id/fromState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#505361"
            android:paddingTop="@dimen/size_4dp"
            android:text="@{request.originDistrictState()}"
            tools:text ="Mumbai, Maharashtra"
            app:layout_constraintTop_toBottomOf="@id/fromCity"
            app:layout_constraintEnd_toStartOf="@id/guidelineCenter"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- To State -->
        <TextView
            android:id="@+id/toState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:paddingTop="@dimen/size_4dp"
            android:textColor="#505361"
            android:textAlignment="textEnd"
            android:text="@{request.destinationDistrictState()}"
            tools:text ="Rajasthan"
            app:layout_constraintStart_toEndOf="@id/guidelineCenter1"
            app:layout_constraintTop_toBottomOf="@id/toCity"
            app:layout_constraintEnd_toEndOf="@id/toCity" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/truckInfo"
            android:layout_width="wrap_content"
            android:paddingTop="@dimen/size_4dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_marginTop="@dimen/size_16dp"
            android:drawablePadding="@dimen/size_4dp"
            android:text="@{request.getTruckTypeAndNo()}"
            tools:text ="Open 32FTXXL18 MT"
            android:textColor="#505361"
            android:drawableStart="@drawable/ic_truck_small"
            app:layout_constraintTop_toBottomOf="@id/fromState"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/material_type"
            android:layout_width="wrap_content"
            android:paddingTop="@dimen/size_4dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            tools:text ="Battery Type"
            android:textColor="#505361"
            android:drawablePadding="@dimen/size_4dp"
            android:drawableStart="@drawable/icon_box"
            app:layout_constraintBottom_toTopOf="@id/view"
            app:layout_constraintTop_toBottomOf="@id/truckInfo"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/closingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:drawablePadding="@dimen/size_4dp"
            tools:text ="Closes in 2 hrs 15 min"
            android:textColor="#505361"
            android:text="@{request.formattedBiddingEndTime()}"
            android:drawableStart="@drawable/ic_clock_small"
            app:layout_constraintBottom_toBottomOf="@id/truckInfo"
            app:layout_constraintTop_toTopOf="@id/truckInfo"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/view"
            android:layout_marginTop="@dimen/size_16dp"
            style="@style/Divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/material_type"
            app:layout_constraintBottom_toTopOf="@id/container_error"/>
        <include
            android:id="@+id/container_error"
            layout="@layout/item_bottom_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/size_16dp"
            android:layout_gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/view"
            tools:visibility="visible"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

        <include
            android:id="@+id/layoutIntracity"
            tools:visibility = "gone"
            layout="@layout/card_load_delhivery_intracity"/>
    </androidx.cardview.widget.CardView>

</layout>
