<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data></data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground">

        <!-- Search Bar -->
        <com.delhivery.axle.ui.custom.DelhiveryAnimatedSearchBar
            android:id="@+id/edit_sticky_search"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_72dp"
            android:focusable="false"
            android:gravity="center_vertical"
            android:hint="Search LR/Vehicle Number"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:paddingStart="@dimen/size_56dp"
            android:paddingBottom="@dimen/size_16dp"
            android:textColorHint="@color/color_hint"
            android:textSize="@dimen/text_16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shadow="@{ @dimen/size_4dp }" />

        <!-- Filter Button -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/btn_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/size_16dp"
            android:background="@drawable/bg_load_action_btn"
            android:orientation="horizontal"
            android:paddingStart="@dimen/size_12dp"
            android:paddingTop="@dimen/size_8dp"
            android:paddingEnd="@dimen/size_12dp"
            android:paddingBottom="@dimen/size_8dp"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/edit_sticky_search"
            app:layout_constraintBottom_toBottomOf="@id/edit_sticky_search">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_filter"
                android:tint="@color/white" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- ePOD and HPOD Tags -->
        <LinearLayout
            android:id="@+id/container_pod_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/edit_sticky_search"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tag_epod"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_pod_tag_selected"
                android:gravity="center"
                android:paddingStart="@dimen/size_8dp"
                android:paddingTop="@dimen/size_2dp"
                android:paddingEnd="@dimen/size_8dp"
                android:paddingBottom="@dimen/size_2dp"
                android:text="ePOD (0)"
                android:textColor="@color/colorDelhiveryRed"
                android:textSize="@dimen/text_14sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tag_hpod"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/size_8dp"
                android:background="@drawable/bg_pod_tag_unselected"
                android:gravity="center"
                android:paddingStart="@dimen/size_8dp"
                android:paddingTop="@dimen/size_2dp"
                android:paddingEnd="@dimen/size_8dp"
                android:paddingBottom="@dimen/size_2dp"
                android:text="HPOD (0)"
                android:textColor="@color/font_labels"
                android:textSize="@dimen/text_14sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- RecyclerView for POD items -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_pending_pod"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingTop="@dimen/size_12dp"
            app:layout_constraintTop_toBottomOf="@id/container_pod_tags"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
