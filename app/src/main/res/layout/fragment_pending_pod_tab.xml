<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data></data>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorBackground">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/edit_sticky_search_cl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
        <!-- Search Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/edit_sticky_search"
            android:layout_margin="@dimen/size_16dp"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="@dimen/size_8dp"
            android:background="@drawable/bg_search_white_load_minimal_padding"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/search_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_12dp"
                android:src="@drawable/bg_search_bar_light_v2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/search_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_8dp"
                android:layout_marginEnd="@dimen/size_12dp"
                android:text="Search LR/Vehicle Number"
                android:textSize="@dimen/text_14sp"
                android:textColor="#A3AAC2"
                android:gravity="start"
                android:singleLine="true"
                android:ellipsize="end"
                app:layout_constraintStart_toEndOf="@id/search_icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <!-- ePOD and HPOD Tags -->
        <LinearLayout
            android:id="@+id/container_pod_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/size_16dp"
            android:background="@color/white"
            android:paddingTop="@dimen/size_16dp"
            android:paddingEnd="@dimen/size_16dp"
            android:paddingBottom="@dimen/size_16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/edit_sticky_search_cl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tag_epod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pod_tag_selected"
                android:paddingStart="@dimen/size_8dp"
                android:paddingTop="@dimen/size_2dp"
                android:paddingEnd="@dimen/size_8dp"
                android:paddingBottom="@dimen/size_2dp"
                android:text="ePOD"
                android:textColor="@color/colorRed"
                android:textSize="@dimen/text_14sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tag_hpod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_8dp"
                android:background="@drawable/bg_pod_tag_unselected"
                android:paddingStart="@dimen/size_8dp"
                android:paddingTop="@dimen/size_2dp"
                android:paddingEnd="@dimen/size_8dp"
                android:paddingBottom="@dimen/size_2dp"
                android:text="HPOD"
                android:textColor="@color/font_labels"
                android:textSize="@dimen/text_14sp"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- RecyclerView for POD items -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_pending_pod"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:layout_marginStart="@dimen/size_8dp"
            android:layout_marginEnd="@dimen/size_8dp"
            android:paddingTop="@dimen/size_12dp"
            app:layout_constraintTop_toBottomOf="@id/container_pod_tags"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</layout>
