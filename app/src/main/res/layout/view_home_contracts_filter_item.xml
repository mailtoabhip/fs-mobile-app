<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <data>

    <variable
        name="actionLabel"
        type="Boolean"
        />

  </data>
  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/size_10dp"
      android:layout_marginBottom="@dimen/size_12dp">
  <androidx.appcompat.widget.AppCompatTextView
      android:id="@+id/dlvIntercityToggle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:layout_constraintStart_toStartOf="parent"
      android:text="@string/action_express"
      android:paddingTop="@dimen/size_6dp"
      android:paddingBottom="@dimen/size_6dp"
      android:paddingStart="@dimen/size_10dp"
      android:paddingEnd="@dimen/size_10dp"
      android:background="@drawable/bg_all_round_corner_blue_solid_selector"
      app:layout_constraintTop_toTopOf="parent"
      />
  <androidx.appcompat.widget.AppCompatTextView
      android:id="@+id/customerIntercityToggle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/size_8dp"
      android:paddingTop="@dimen/size_6dp"
      android:paddingBottom="@dimen/size_6dp"
      android:paddingStart="@dimen/size_10dp"
      android:paddingEnd="@dimen/size_10dp"
      android:background="@drawable/bg_all_round_corner_blue_solid_selector"
      app:layout_constraintStart_toEndOf="@id/dlvIntercityToggle"
      android:text="@string/action_non_express"
      app:layout_constraintTop_toTopOf="parent"
      />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dlvIntracityToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_8dp"
        android:paddingTop="@dimen/size_6dp"
        android:paddingBottom="@dimen/size_6dp"
        android:paddingStart="@dimen/size_10dp"
        android:paddingEnd="@dimen/size_10dp"
        android:background="@drawable/bg_all_round_corner_blue_solid_selector"
        app:layout_constraintStart_toEndOf="@id/customerIntercityToggle"
        android:text="@string/action_dlv_intracity"
        app:layout_constraintTop_toTopOf="parent"
        />
  <androidx.appcompat.widget.AppCompatImageView
      android:id="@+id/info"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      app:layout_constraintEnd_toEndOf="parent"
      android:padding="@dimen/size_6dp"
      app:layout_constraintTop_toTopOf="parent"
      app:srcCompat="@drawable/ic_info_contract"/>
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>