<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools"
    >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_all_round_corner_white"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:id="@+id/top_lay"
            bind:layout_constraintStart_toStartOf="parent"
            bind:layout_constraintTop_toTopOf="parent"
            android:layout_alignParentStart="true"
            android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_marginTop="@dimen/size_12dp"
            app:layout_constraintStart_toEndOf="@+id/close_btn"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_12dp"
            android:textColor="@color/heading_black"
            android:layout_gravity="center"
            android:textSize="@dimen/text_16sp"
            android:id="@+id/label_gst"
            android:layout_marginStart="@dimen/size_12dp"
            android:layout_toEndOf="@+id/close_btn"
            android:text="@string/label_address_details"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close_btn"
            android:layout_marginTop="@dimen/size_16dp"
            android:layout_marginEnd="@dimen/size_10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="@dimen/size_24dp"
            android:layout_alignParentStart="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_close_black"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_4dp"
            android:id="@+id/sepLine"
            android:layout_marginTop="@dimen/size_12dp"
            android:layout_marginBottom="@dimen/size_20dp"
            app:layout_constraintTop_toBottomOf="@+id/label_gst"
            app:srcCompat="@drawable/seperator_line"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
         android:layout_width="match_parent"
         bind:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_lay"
            android:layout_alignParentStart="false"
            bind:layout_constraintTop_toBottomOf="@+id/top_lay"
         android:layout_height="wrap_content">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        bind:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/size_32dp"
        android:paddingStart="@dimen/size_24dp"
        android:paddingEnd="@dimen/size_24dp"
        android:paddingBottom="@dimen/size_24dp"
        bind:layout_constraintTop_toBottomOf="@+id/top_lay"
        android:orientation="vertical">
        <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
            android:id="@+id/edit_flat"
            android:layout_width="match_parent"
            android:layout_height="@dimen/edit_text_height"
            android:digits="@string/allowed_char_address"
            android:background="@drawable/bg_login_edit"
            bind:layout_constraintStart_toStartOf="parent"
            bind:layout_constraintTop_toBottomOf="@+id/top_lay"
            android:inputType="text"
            android:singleLine="true"
            android:paddingStart="@dimen/size_12dp"
            android:paddingEnd="@dimen/size_12dp"
            android:hint="@string/flat_hint"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"
            android:layout_height="wrap_content">
            <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                android:id="@+id/edit_area"
                android:layout_marginTop="@dimen/size_24dp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/edit_text_height"
                android:background="@drawable/bg_login_edit"
                android:inputType="text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:digits="@string/allowed_char_address"
                android:singleLine="true"
                android:paddingStart="@dimen/size_12dp"
                android:paddingEnd="@dimen/size_12dp"
                android:hint="@string/area_hint"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/edit_area"
            android:textColor="@color/destructive_red"
            android:visibility="gone"
            android:id="@+id/error_area"
            />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_wrong_area"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/edit_text_height"
            app:srcCompat="@drawable/ic_wrong"
            app:layout_constraintTop_toTopOf="@id/edit_area"
            app:layout_constraintEnd_toEndOf="@id/edit_area"
            app:layout_constraintBottom_toBottomOf="@id/edit_area"
            android:visibility="gone"
            android:paddingStart="@dimen/size_12dp"
            android:paddingEnd="@dimen/size_12dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.delhivery.axle.ui.custom.DelhiveryCityAutoEditText
            android:id="@+id/auto_complete_city"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_height="@dimen/edit_text_height"
            android:digits="@string/allowed_char_address"
            android:background="@drawable/bg_login_edit"
            bind:layout_constraintStart_toStartOf="parent"
            bind:layout_constraintTop_toBottomOf="parent"
            android:singleLine="true"
            android:inputType="text"
            android:paddingStart="@dimen/size_12dp"
            android:paddingEnd="@dimen/size_12dp"
            android:hint="@string/city_hint"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            />
        <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
            android:id="@+id/edit_pincode"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_height="@dimen/edit_text_height"
            android:background="@drawable/bg_login_edit"
            bind:layout_constraintStart_toStartOf="parent"
            bind:layout_constraintTop_toBottomOf="parent"
            android:digits="1234567890"
            android:inputType="number"
            android:maxLength="6"
            android:paddingStart="@dimen/size_12dp"
            android:paddingEnd="@dimen/size_12dp"
            android:hint="@string/pincode_hint"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            bind:state_error="false"
            />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/size_24dp"
            android:layout_height="@dimen/edit_text_height"
            android:background="@drawable/bg_login_edit">
            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinner_proof"
                android:layout_width="match_parent"
                android:paddingBottom="@dimen/size_16dp"
                android:layout_height="@dimen/edit_text_height"
                android:gravity="center_vertical"
                android:background="@drawable/bg_spinner_dialog"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toTopOf="parent"
                bind:layout_constraintBottom_toBottomOf="parent"
                android:spinnerMode="dropdown"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/address_proof_text"
            android:layout_marginTop="@dimen/size_24dp"
            android:textSize="@dimen/text_14sp"
            android:textStyle="bold"
            android:text="@string/address_proof_attachment"
            />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/upload_doc_lay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:layout_marginTop="@dimen/size_16dp"
                bind:layout_constraintTop_toTopOf="parent"
                bind:layout_constraintStart_toStartOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/upload_icon"
                    android:layout_width="@dimen/size_16dp"
                    android:layout_height="@dimen/size_20dp"
                    app:srcCompat="@drawable/ic_upload"
                    android:layout_marginStart="@dimen/size_2dp"
                    bind:layout_constraintTop_toTopOf="parent"
                    bind:layout_constraintLeft_toLeftOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_16dp"
                    bind:layout_constraintTop_toTopOf="parent"
                    android:textSize="@dimen/text_16sp"
                    android:textColor="@color/colorAccent"
                    android:textStyle="bold"
                    app:layout_constraintLeft_toRightOf="@+id/upload_icon"
                    android:text="@string/upload_document"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/uploaded_doc_lay"
                android:visibility="gone"
                android:layout_marginTop="@dimen/size_16dp"
                app:layout_constraintTop_toBottomOf="@+id/upload_doc_lay"
                bind:layout_constraintTop_toTopOf="parent"
                bind:layout_constraintStart_toStartOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/doc_icon"
                    android:layout_width="@dimen/size_48dp"
                    android:layout_height="@dimen/size_48dp"
                    app:srcCompat="@drawable/ic_doc_business"
                    android:layout_marginStart="@dimen/size_2dp"
                    android:layout_marginRight="@dimen/size_16dp"
                    android:layout_marginEnd="@dimen/size_16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/doc_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:width="@dimen/size_270dp"
                    android:layout_marginStart="@dimen/size_16dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:textSize="@dimen/text_16sp"
                    android:layout_marginRight="@dimen/size_16dp"
                    app:layout_constraintLeft_toRightOf="@+id/doc_icon"
                    android:text="IMG_344_98899"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/doc_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_16dp"
                    app:layout_constraintTop_toBottomOf="@+id/doc_title"
                    android:textSize="@dimen/text_12sp"
                    android:textColor="@color/color_hint"
                    app:layout_constraintLeft_toRightOf="@+id/doc_icon"
                    android:text="233kb"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/doc_remove"
                    android:layout_width="@dimen/size_20dp"
                    android:layout_height="@dimen/size_20dp"
                    app:srcCompat="@drawable/ic_remove"
                    android:layout_marginStart="@dimen/size_2dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_submit_details"
            style="@style/ActionButton"
            android:enabled="false"
            android:textAllCaps="false"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/size_32dp"
            android:text="@string/action_submit_details"
            android:visibility="visible"
            />
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/save_delete_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/size_32dp"
            android:visibility="gone"
            android:weightSum="2">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_confirm_delete"
            style="@style/OutlineDeleteActionButton"
            android:textAllCaps="false"
            android:layout_marginEnd="@dimen/size_20dp"
            android:layout_width="0dp"
            android:text="@string/action_delete_address"
            android:layout_weight="1"
            />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_save_changes"
            style="@style/ActionButton"
            android:textAllCaps="false"
            android:layout_width="0dp"
            android:text="@string/action_save_changes"
            android:layout_weight="1"
            />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
     </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>