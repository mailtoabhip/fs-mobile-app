<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    >
  <android.support.v7.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@android:color/white"
      android:orientation="vertical"
      android:paddingBottom="@dimen/size_4dp"
      android:paddingEnd="@dimen/size_24dp"
      android:paddingStart="@dimen/size_24dp"
      android:paddingTop="@dimen/size_24dp"
      >
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="8sp"
        android:text="@string/title_add_nearby_locations"
        android:textColor="#de000000"
        android:textSize="20sp"
        android:textStyle="normal"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_4dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="5sp"
        android:text="@string/msg_add_nearby_locations"
        android:textColor="#de000000"
        android:textSize="14sp"
        android:textStyle="normal"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="6sp"
        android:text="@string/msg_add_nearby_locations_deselect"
        android:textColor="#de000000"
        android:textSize="14sp"
        android:textStyle="normal"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
      <android.support.v7.widget.LinearLayoutCompat
          android:id="@+id/container_cities"
          android:layout_width="match_parent"
          android:layout_height="@dimen/size_240dp"
          android:layout_marginBottom="16dp"
          android:layout_marginTop="16dp"
          android:orientation="vertical"
          />
    </ScrollView>
    <android.support.v7.widget.AppCompatButton
        android:id="@+id/btn_confirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="@string/action_confirm"
        android:textColor="@color/colorAccent"
        android:textSize="14sp"
        style="@style/Widget.AppCompat.Button.Borderless.Colored"
        />
  </android.support.v7.widget.LinearLayoutCompat>
</layout>