<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" >
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_dialog">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:padding="@dimen/size_14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/close_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_close_black"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/size_8dp"
               android:text="@string/msg_enter_unloading_details"/>


        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_4dp"
            app:srcCompat="@drawable/seperator_line"/>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/size_14dp"
            android:paddingEnd="@dimen/size_24dp"
            android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_24dp"
            android:textSize="@dimen/text_12sp"
            android:text="@string/label_enter_unloading_destination"
            android:textColor="@color/black"/>

        <com.delhivery.axle.ui.custom.DelhiveryCityAutoEditText
            android:id="@+id/edit_unloading_city"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40dp"
            android:background="@drawable/background_rectangle_border"
            android:hint="@string/label_search_by_city"
            android:drawableStart="@drawable/ic_search_black"
            android:imeOptions="actionNext"
            android:dropDownWidth="match_parent"
            android:layout_marginTop="@dimen/size_8dp"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textColorHint="@color/color_hint"
            android:textSize="@dimen/text_14sp"
            android:padding="@dimen/size_8dp"
            />


        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_24dp"
            android:textSize="@dimen/text_12sp"
            android:text="@string/label_price_mt"
            android:textColor="@color/black"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edit_price"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:layout_marginBottom="@dimen/size_12dp"
            android:padding="@dimen/size_8dp"
            android:textSize="@dimen/text_14sp"
            android:textColor="@color/black"
            android:hint="Eg: ₹2500"
            android:background="@drawable/background_rectangle_border">
        </androidx.appcompat.widget.AppCompatEditText>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_save_destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_14dp"
            android:text="@string/action_add_destination"
            android:textAllCaps="false"
            android:background="@drawable/bg_all_round_corner_black"
            android:textColor="@color/white"/>

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>