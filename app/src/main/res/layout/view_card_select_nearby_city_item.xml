<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="city"
        type="com.delhivery.axle.data.CityModel"
        />
  </data>
  <androidx.cardview.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/size_4dp"
      android:layout_marginTop="@dimen/size_4dp"
      app:cardBackgroundColor="@color/colorPrimary"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="@dimen/size_8dp"
      >

    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/check"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_16dp"
        android:buttonTint="@color/status_active"
        android:paddingBottom="@dimen/size_12dp"
        android:paddingStart="@dimen/size_16dp"
        android:paddingTop="@dimen/size_12dp"
        android:text="@{ city.city }"
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_16sp"
        tools:targetApi="lollipop"
        />
  </androidx.cardview.widget.CardView>
</layout>