<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="request"
            type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <!-- Bid CardView -->
        <androidx.cardview.widget.CardView
            android:id="@+id/bidCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/routeTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/size_12dp"
                    android:paddingTop="@dimen/size_12dp"
                    android:paddingEnd="@dimen/size_12dp"
                    android:text="@{request.getOriginAndDestinationName()}"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/map_text"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Navi Mumbai -> Jaisalmer" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/map_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/size_12dp"
                    android:drawableStart="@drawable/ic_navigate"
                    android:drawablePadding="@dimen/size_4dp"
                    android:paddingTop="@dimen/size_12dp"
                    android:text="@string/view_on_map_html"
                    android:textColor="#4657B9"
                    android:textColorLink="@color/blue"
                    android:textSize="@dimen/text_12sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/routeTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/routeTitle"
                    tools:visibility="visible" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/routeAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/size_12dp"
                    android:paddingTop="@dimen/size_4dp"
                    android:paddingEnd="@dimen/size_12dp"
                    android:textColor="#505361"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/routeTitle"
                    tools:text="C/O Shed No. 876, Plot 6, Mumbai Maharashtra" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/editBidCl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/size_12dp"
                    android:paddingRight="@dimen/size_12dp"
                    android:paddingBottom="@dimen/size_12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/routeAddress">
                    <!-- Bid Amount Label -->
                    <TextView
                        android:id="@+id/bidLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@{request.bidAmountLabel()}"
                        android:textColor="#3D445C"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:id="@+id/bidll"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/background_grey_border"
                        android:padding="1dp"
                        app:layout_constraintTop_toBottomOf="@+id/bidLabel">

                        <RelativeLayout
                            android:layout_width="34dp"
                            android:layout_height="40dp"
                            android:background="#6FE0E3EB">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/phone_initial"
                                android:layout_width="@dimen/size_24dp"
                                android:layout_height="@dimen/size_24dp"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="2dp"
                                android:layout_marginTop="@dimen/size_8dp"
                                android:layout_marginEnd="2dp"
                                android:background="@null"
                                app:srcCompat="@drawable/ic_rupee_text_editor" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_alignParentEnd="true"
                                android:layout_gravity="end"
                                android:background="#dddddd" />
                        </RelativeLayout>


                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/et_bid_amount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:background="@null"
                            android:focusable="true"
                            android:hint="@{request.bidAmountLabelEditHint()}"
                            android:inputType="phone"
                            android:singleLine="true"
                            android:textColor="#3D445C"
                            android:textColorHint="#8F9198"
                            android:textSize="18sp"
                            tools:text="Enter bid amount for entire contract" />

                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/bidError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/size_4dp"
                        android:text="@string/invalid_amount_out_of_range"
                        android:textColor="@color/bid_error"
                        android:textSize="@dimen/text_12sp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/bidll" />

                    <TextView
                        android:id="@+id/vehicleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Vehicle Number"
                        android:textColor="#3D445C"
                        android:textSize="14sp"
                        android:visibility="@{request.isIntraCityContract()}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/bidError" />

                    <LinearLayout
                        android:id="@+id/vehicleLl"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/background_grey_border"
                        android:padding="1dp"
                        android:visibility="@{request.isIntraCityContract()}"
                        app:layout_constraintTop_toBottomOf="@+id/vehicleLabel">

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/etVehicleNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="50dp"
                            android:background="@null"
                            android:hint="Enter vehicle number"
                            android:inputType="textCapCharacters"
                            android:singleLine="true"
                            android:textColor="#3D445C"
                            android:textColorHint="#8F9198"
                            android:textSize="18sp" />

                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/vehicleError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/size_4dp"
                        android:text="@string/invalid_amount_out_of_range"
                        android:textColor="@color/bid_error"
                        android:textSize="@dimen/text_12sp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/vehicleLl" />

                    <TextView
                        android:id="@+id/tripLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Number of trips you can serve on this lane"
                        android:textColor="#3D445C"
                        android:textSize="14sp"
                        android:visibility="@{request.isFRCContract()}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/vehicleError" />

                    <LinearLayout
                        android:id="@+id/tripLl"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/background_grey_border"
                        android:padding="1dp"
                        android:visibility="@{request.isFRCContract()}"
                        app:layout_constraintTop_toBottomOf="@+id/tripLabel">


                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/etTripNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="50dp"
                            android:background="@null"
                            android:focusable="true"
                            android:hint="Enter number of trips"
                            android:inputType="phone"
                            android:singleLine="true"
                            android:textColor="#3D445C"
                            android:textColorHint="#8F9198"
                            android:textSize="18sp" />

                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tripError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/size_4dp"
                        android:text="@string/invalid_amount_out_of_range"
                        android:textColor="@color/bid_error"
                        android:textSize="@dimen/text_12sp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tripLl" />

                    <TextView
                        android:id="@+id/placementLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Vehicle Can Be Placed In (Days)"
                        android:textColor="#3D445C"
                        android:textSize="14sp"
                        android:visibility="@{request.isIntraCityContract()}"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tripError" />

                    <LinearLayout
                        android:id="@+id/placementLl"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/background_grey_border"
                        android:padding="1dp"
                        android:visibility="@{request.isIntraCityContract()}"
                        app:layout_constraintTop_toBottomOf="@+id/placementLabel">

                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/spinnerPlacementDays"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="@dimen/size_12dp"
                            android:layout_marginEnd="@dimen/size_12dp"
                            android:background="@drawable/bg_spinner"
                            android:drawSelectorOnTop="true"
                            android:entries="@array/placementDaysItems"
                            android:spinnerMode="dropdown"
                            android:textColor="#3D445C"
                            android:textSize="18sp"
                            app:layout_constraintStart_toStartOf="parent" />

                    </LinearLayout>

                    <include
                        android:id="@+id/strongBidCard"
                        layout="@layout/card_strong_bid"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/placementLl" />

                    <include
                        android:id="@+id/weak_bid_card"
                        layout="@layout/card_weak_bid"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/placementLl" />


                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/placeBidButton"
                        style="@style/ActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:clickable="true"
                        android:drawablePadding="8dp"
                        android:enabled="false"
                        android:text="Place Bid"
                        android:textAllCaps="false"
                        android:textSize="@dimen/text_14sp"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/placementLl" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <include
                    android:id="@+id/placementCl"
                    layout="@layout/view_placement_input_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/size_12dp"
                    android:padding="@dimen/size_12dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/routeAddress" />

                <include
                    android:id="@+id/confirmedBidCl"
                    layout="@layout/view_bid_status_confirmed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/size_12dp"
                    android:padding="@dimen/size_12dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/routeTitle" />

                <include
                    android:id="@+id/rejectedBidCl"
                    layout="@layout/view_bid_status_rejected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/size_12dp"
                    android:padding="@dimen/size_12dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/routeTitle" />

                <include
                    android:id="@+id/awaitingBidCl"
                    layout="@layout/view_bid_status_awaiting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/size_12dp"
                    android:padding="@dimen/size_12dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/routeTitle" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>