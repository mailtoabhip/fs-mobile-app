<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable
            name="title"
            type="String"
            />
        <variable
            name="addresst"
            type="String"
            />

    </data>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/cardView"
        android:layout_marginBottom="@dimen/size_16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:id="@+id/relLay"
            android:background="@drawable/bg_all_round_corner_blue_selector"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/address_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@{ addresst }"
                android:layout_marginTop="@dimen/size_18dp"
                android:layout_marginStart="@dimen/size_8dp"
                android:layout_marginEnd="@dimen/size_16dp"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_14sp"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/size_16dp"
                android:id="@+id/imgAddress"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_edit_pencil"
                android:layout_marginBottom="@dimen/size_18dp"
                android:layout_marginStart="@dimen/size_16dp"
                android:layout_marginEnd="@dimen/size_16dp"
                android:layout_marginTop="@dimen/size_18dp"
                android:layout_height="@dimen/size_16dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/gst_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:layout_toLeftOf="@+id/imgAddress"
                android:layout_alignParentStart="true"
                android:fontFamily="sans-serif"
                android:text="@{ title }"
                android:layout_below="@+id/address_type"
                android:layout_marginBottom="@dimen/size_18dp"
                android:layout_marginStart="@dimen/size_8dp"
                android:layout_marginEnd="@dimen/size_16dp"
                android:textColor="@color/info_bg"
                android:textSize="@dimen/text_12sp"
                />


        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</layout>