<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_sheet_rounded_top"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/rl_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/size_16dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/size_4dp"
                android:text="@string/buy_fastag_for_your_trucks"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_close"
                android:layout_width="@dimen/size_24dp"
                android:layout_height="@dimen/size_24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/size_4dp"
                app:srcCompat="@drawable/ic_close_black" />
        </RelativeLayout>

        <!-- Submit Button - Fixed at Bottom -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_48dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginEnd="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_8dp"
            android:layout_marginBottom="@dimen/size_16dp"
            android:background="@drawable/bg_all_round_corner_solid_black"
            android:text="@string/submit_request"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold" />

        <!-- Content ScrollView -->
        <ScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/btn_submit"
            android:layout_below="@id/rl_header"
            android:layout_marginTop="-9dp"
            android:layout_marginBottom="57dp"
            android:fillViewport="false">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/size_16dp"
                android:paddingBottom="@dimen/size_8dp">

                <!-- Description Text -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_description"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/share_a_few_details_and_our_team_will_help_you_get_fastags_quickly"
                    android:textColor="@color/background_dark_grey"
                    android:textSize="@dimen/text_14sp" />



                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_24dp"
                    android:layout_marginBottom="@dimen/size_8dp">


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/label_operating_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="@string/operating_location"
                        android:textColor="@color/heading_black"
                        android:textSize="@dimen/text_14sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/label_mandatory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="@dimen/size_4dp"
                        android:layout_marginEnd="6dp"
                        android:text="MANDATORY"
                        android:textColor="@color/colorDelhiveryRed"
                        android:textSize="@dimen/text_10sp" />
                </RelativeLayout>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ll_operating_location"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_48dp"
                    android:layout_marginTop="@dimen/size_4dp"
                    android:background="@drawable/bg_search_location"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/size_12dp"
                    android:paddingEnd="@dimen/size_12dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="@dimen/size_20dp"
                        android:layout_height="@dimen/size_20dp"
                        android:layout_marginEnd="@dimen/size_8dp"
                        app:srcCompat="@drawable/ic_location_pincode" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_operating_location"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Select city where trucks operate"
                        android:textColor="@color/heading_black"
                        android:textColorHint="@color/color_hint"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_14sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- Truck Count Field -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/label_truck_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_24dp"
                    android:text="How many trucks need FASTag?"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_14sp"
                    android:textStyle="bold" />

                <!-- Counter Container -->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_56dp"
                    android:layout_marginTop="@dimen/size_16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/size_12dp"
                    android:paddingEnd="@dimen/size_12dp"
                    android:background="@drawable/bg_counter_container">

                    <!-- Minus Button -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btn_decrease"
                        android:layout_width="@dimen/size_36dp"
                        android:layout_height="@dimen/size_36dp"
                        android:background="@drawable/bg_circle_button_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="@dimen/size_8dp"
                        app:srcCompat="@drawable/ic_baseline_remove_24" />

                    <!-- Count Display -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_truck_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/heading_black"
                        android:textSize="@dimen/text_20sp"
                        android:textStyle="bold" />

                    <!-- Plus Button -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/btn_increase"
                        android:layout_width="@dimen/size_36dp"
                        android:layout_height="@dimen/size_36dp"
                        android:background="@drawable/bg_circle_button_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="@dimen/size_8dp"
                        app:srcCompat="@drawable/ic_add_black_24dp" />

                </androidx.appcompat.widget.LinearLayoutCompat>


            </androidx.appcompat.widget.LinearLayoutCompat>
        </ScrollView>

    </RelativeLayout>

</layout>
