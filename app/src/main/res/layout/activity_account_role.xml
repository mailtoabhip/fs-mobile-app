                  android:textColor="@color/heading_black"
                  android:textSize="@dimen/text_14sp"
                  android:textStyle="bold"
                  />
              <androidx.appcompat.widget.AppCompatTextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="sans-serif"
                  android:text="@string/label_transporter_select"
                  android:layout_alignParentStart="true"
                  android:layout_marginTop="@dimen/size_4dp"
                  android:layout_marginStart="@dimen/size_14dp"
                  android:layout_marginEnd="@dimen/size_14dp"
                  android:layout_below="@+id/labelTransporter3"
                  android:layout_toStartOf="@+id/imgTransporter3"
                  android:textColor="@color/heading_black"
                  android:textSize="@dimen/text_12sp"
                  />
              <androidx.cardview.widget.CardView
                  android:layout_width="wrap_content"
                  android:layout_marginEnd="@dimen/size_1dp"
                  android:layout_marginBottom="@dimen/size_1dp"
                  android:layout_marginTop="@dimen/size_1dp"
                  bind:cardCornerRadius="@dimen/size_8dp"
                  android:layout_alignParentEnd="true"
                  android:id="@+id/imgTransporter3"
                  android:layout_height="wrap_content">
              <androidx.appcompat.widget.AppCompatImageView
                  android:layout_width="wrap_content"
                  android:src="@drawable/transporter"
                  android:background="@drawable/bg_all_round_corner_white_right"
                  android:layout_height="wrap_content"/>
              </androidx.cardview.widget.CardView>
            </RelativeLayout>
          </RelativeLayout>
        </RelativeLayout>


      </RelativeLayout>
      </ScrollView>

      <androidx.appcompat.widget.AppCompatButton
          android:id="@+id/btn_proceed"
          style="@style/ActionButton"
          android:textAllCaps="false"
          android:enabled="false"
           android:layout_marginStart="@dimen/size_24dp"
          android:layout_alignParentBottom="true"
          android:layout_width="match_parent"
          android:layout_marginBottom="@dimen/size_48dp"
          android:layout_marginTop="@dimen/size_24dp"
          android:layout_marginEnd="@dimen/size_24dp"
          android:text="@string/action_proceed_account"
          />

    </RelativeLayout>

  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>



