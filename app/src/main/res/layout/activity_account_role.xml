                android:background="@drawable/bg_all_round_corner_blue_selector"
                android:id="@+id/broker_layout2"
                android:layout_marginTop="@dimen/size_16dp"
                android:layout_below="@+id/transporter_layout2"
                android:layout_height="wrap_content">
