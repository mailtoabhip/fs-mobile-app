                android:src="@drawable/broker"
                android:background="@drawable/bg_all_round_corner_white_right"
                android:layout_height="wrap_content"/>
            </androidx.cardview.widget.CardView>
          </RelativeLayout>

        </RelativeLayout>

          <RelativeLayout
