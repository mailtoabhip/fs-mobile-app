<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

  <data>
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.accountrole.AccountRoleViewModel"
        />
  </data>

  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/blue_bg"
      android:orientation="vertical"
      android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
      android:fitsSystemWindows="true">

      <ScrollView
          android:layout_width="match_parent"
          android:id="@+id/scView"
         android:layout_marginBottom="@dimen/size_72dp"
          android:layout_height="wrap_content">
      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
           android:orientation="vertical"
          android:paddingBottom="@dimen/size_48dp"
          android:paddingStart="@dimen/size_24dp"
          android:paddingEnd="@dimen/size_24dp">

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:id="@+id/progress"
            android:layout_marginBottom="@dimen/size_24dp"
              android:max="100"
            android:progressDrawable="@drawable/account_progress"
            android:progress="66"/>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:id="@+id/role_layout">

          <androidx.appcompat.widget.AppCompatTextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_32dp"
              android:fontFamily="sans-serif"
              android:lineSpacingExtra="@dimen/text_6sp"
              android:id="@+id/label_role"
              android:text="@string/label_role"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_24sp"
              android:textStyle="bold"
              />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/label_select_role"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif"
              android:gravity="start"
              android:layout_marginBottom="@dimen/size_16dp"
              android:text="@string/label_account_setup_primary_select"
              android:layout_marginTop="@dimen/size_12dp"
              android:layout_below="@+id/label_role"
              android:textSize="@dimen/text_16sp"
              android:textColor="@color/sub_heading_black"
              />

          <RelativeLayout
              android:layout_width="match_parent"
              android:id="@+id/shipper_section"
              android:layout_below="@+id/label_select_role"
              android:layout_height="wrap_content">

          <RelativeLayout
              android:layout_width="match_parent"
              android:background="@drawable/bg_all_round_corner_blue_selector"
              android:id="@+id/shipper_layout"
              android:layout_marginTop="@dimen/size_16dp"
             android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/label_shipper"
                android:id="@+id/labelShipper"
                android:layout_alignParentStart="true"
                android:layout_marginTop="@dimen/size_14dp"
                android:layout_marginStart="@dimen/size_14dp"
                android:layout_marginEnd="@dimen/size_14dp"
                android:layout_toStartOf="@+id/cardShipp"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:layout_toStartOf="@+id/cardShipp"
                android:layout_marginTop="@dimen/size_4dp"
                android:layout_marginStart="@dimen/size_14dp"
                android:layout_marginEnd="@dimen/size_14dp"
                android:layout_below="@+id/labelShipper"
                android:layout_alignParentStart="true"
                android:text="@string/label_shipper_select"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_12sp"
                />
            <View
                android:id="@+id/centerShim"
                android:layout_height="match_parent"
                android:layout_width="0dp"
                android:visibility="invisible"
                android:layout_centerHorizontal="true"/>
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:id="@+id/cardShipp"
                android:layout_marginEnd="@dimen/size_1dp"
                android:layout_marginBottom="@dimen/size_1dp"
                android:layout_marginTop="@dimen/size_1dp"
                android:layout_alignParentEnd="true"
                bind:cardCornerRadius="@dimen/size_8dp"
                android:layout_height="wrap_content">
              <androidx.appcompat.widget.AppCompatImageView
                  android:layout_width="wrap_content"
                  android:src="@drawable/shipper"
                android:background="@drawable/round_image"
                  android:layout_height="wrap_content"/>
            </androidx.cardview.widget.CardView>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:background="@drawable/bg_all_round_corner_blue_selector"
                android:id="@+id/transporter_layout"
                android:layout_marginTop="@dimen/size_16dp"
                android:layout_below="@+id/shipper_layout"
                android:layout_height="wrap_content">
              <androidx.appcompat.widget.AppCompatTextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="sans-serif"
                  android:text="@string/label_transporter"
                  android:layout_alignParentStart="true"
                  android:layout_toStartOf="@+id/imgTransporter"
                  android:id="@+id/labelTransporter"
                  android:layout_marginTop="@dimen/size_14dp"
                  android:layout_marginStart="@dimen/size_14dp"
                  android:layout_marginEnd="@dimen/size_14dp"
                  android:textColor="@color/heading_black"
                  android:textSize="@dimen/text_14sp"
                  android:textStyle="bold"
                  />
              <androidx.appcompat.widget.AppCompatTextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="sans-serif"
                 android:text="@string/label_transporter_select"
                  android:layout_alignParentStart="true"
                  android:layout_marginTop="@dimen/size_4dp"
                  android:layout_marginStart="@dimen/size_14dp"
                  android:layout_marginEnd="@dimen/size_14dp"
                  android:layout_below="@+id/labelTransporter"
                  android:layout_toStartOf="@+id/imgTransporter"
                  android:textColor="@color/heading_black"
                  android:textSize="@dimen/text_12sp"
                  />
              <androidx.cardview.widget.CardView
                  android:layout_width="wrap_content"
                  bind:cardCornerRadius="@dimen/size_8dp"
                  android:layout_alignParentEnd="true"
                  android:id="@+id/imgTransporter"
                  android:layout_marginEnd="@dimen/size_1dp"
                  android:layout_marginBottom="@dimen/size_1dp"
                  android:layout_marginTop="@dimen/size_1dp"
                  android:layout_height="wrap_content">
                 <androidx.appcompat.widget.AppCompatImageView
                  android:layout_width="wrap_content"
                  android:src="@drawable/transporter"
                  android:background="@drawable/bg_all_round_corner_white_right"
                  android:layout_height="wrap_content"/>
              </androidx.cardview.widget.CardView>
            </RelativeLayout>
          <RelativeLayout
              android:layout_width="match_parent"
              android:background="@drawable/bg_all_round_corner_blue_selector"
              android:id="@+id/broker_layout"
              android:layout_marginTop="@dimen/size_16dp"
              android:layout_below="@+id/transporter_layout"
              android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/label_broker"
                android:id="@+id/labelBroker"
                android:layout_marginTop="@dimen/size_14dp"
                android:layout_marginStart="@dimen/size_14dp"
                android:layout_marginEnd="@dimen/size_14dp"
                android:textColor="@color/heading_black"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/imgBroker"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                />
            <androidx.appcompat.widget.AppCompatTextView
