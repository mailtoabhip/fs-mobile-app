<?xml version="1.0" encoding="utf-8"?>
<layout   xmlns:tool="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="request"
            type="com.delhivery.axle.data.home.placements.HomePlacementsItemData"
            />

        <import type="android.view.View" />
    </data>
    <androidx.cardview.widget.CardView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_2dp"
        android:layout_marginEnd="@dimen/size_2dp"
        android:layout_marginBottom="@dimen/size_12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:cardCornerRadius="@dimen/size_6dp"
        app:cardElevation="@dimen/size_2dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clContractCode"
            android:background="@color/placement_grey_bg"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/vehicleType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/faded_black"
                tool:hint="MK98KJ8765(18MT)"
                android:text="@{request.vehicleType}"
                android:background="@color/placement_grey_bg"
                android:fontFamily="sans-serif-medium"
                android:textSize="@dimen/text_14sp"
                android:paddingStart="@dimen/size_8dp"
                android:paddingTop="@dimen/size_8dp"

                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/contractType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pending_status"
                android:text="@{request.loadType()}"
                android:textSize="@dimen/text_12sp"
                android:paddingStart="@dimen/size_8dp"
                android:paddingBottom="@dimen/size_2dp"
                tool:text="FTL Adhoc"
                app:layout_constraintTop_toBottomOf="@+id/vehicleType"
                app:layout_constraintStart_toStartOf="parent"
                />
            <androidx.appcompat.widget.AppCompatTextView
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@+id/vehicleType"
                android:id="@+id/reportingTime"
                android:layout_width="wrap_content"
                android:paddingStart="@dimen/size_8dp"
                android:paddingTop="@dimen/size_8dp"
                android:layout_height="wrap_content"
                android:textColor="@color/faded_black"
                android:textSize="@dimen/text_14sp"
                tool:text="Today,10 am"
                android:visibility="@{request.detailsNotVisible()}"
                android:text="@{request.formatReportingTimeWithDiv()}"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/status_text"
                app:layout_constraintTop_toTopOf="@+id/vehicleType"
                app:layout_constraintBottom_toBottomOf="@+id/vehicleType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                android:textStyle="bold"
                android:textSize="@dimen/text_12sp"
                android:background="@drawable/bg_all_rounded_won"
                android:textColor="@color/bid_placed_green"
                android:layout_marginEnd="@dimen/size_8dp"
                android:paddingStart="@dimen/size_8dp"
                android:paddingEnd="@dimen/size_8dp"
                android:paddingTop="@dimen/size_4dp"
                android:paddingBottom="@dimen/size_4dp"
                android:visibility="@{request.detailsNotVisible()}"
                android:text="@{request.status}"
                tool:text="Marked In"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/map_text"
                app:layout_constraintTop_toTopOf="@+id/vehicleType"
                app:layout_constraintBottom_toBottomOf="@+id/vehicleType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                android:textStyle="bold"
                android:textSize="@dimen/text_12sp"
                android:elevation="@dimen/size_4dp"
                android:drawableStart="@drawable/ic_map_navigation"
                android:drawablePadding="@dimen/size_4dp"
                android:background="@drawable/bg_all_rounded_pending"
                android:textColor="@color/colorDelhiveryRed"
                android:layout_marginEnd="@dimen/size_8dp"
                android:paddingStart="@dimen/size_4dp"
                android:paddingEnd="@dimen/size_8dp"
                android:paddingTop="@dimen/size_4dp"
                android:paddingBottom="@dimen/size_4dp"
                android:visibility="gone"
                android:text="Map"
                tool:text="Map"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
            <include layout="@layout/view_driver_truck_details"
                android:id="@+id/driverTruckDetails"
                app:layout_constraintTop_toBottomOf="@+id/clContractCode"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/size_8dp"
                android:visibility="@{request.detailsNotVisible()}"
                />
            <include layout="@layout/view_origin_destination"
                android:id="@+id/originDestination"
                app:layout_constraintTop_toBottomOf="@+id/driverTruckDetails"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/size_8dp"/>
            <View
                android:id="@+id/divider2"
                android:background="@color/light_grey"
                app:layout_constraintTop_toBottomOf="@+id/originDestination"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                app:layout_constraintEnd_toStartOf="@+id/targetPrice"
                app:layout_constraintTop_toBottomOf="@+id/divider2"
                android:layout_width="wrap_content"
                android:layout_marginStart="@dimen/size_8dp"
                android:layout_marginTop="@dimen/size_8dp"
                android:paddingBottom="@dimen/size_8dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textSize="@dimen/text_12sp"
                android:text="Confirmed Price: "/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/targetPrice"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider2"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:layout_marginEnd="@dimen/size_8dp"
                android:paddingBottom="@dimen/size_8dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textSize="@dimen/text_12sp"
                android:text="@{request.formattedConfirmedPrice()}"/>
            <View
                android:id="@+id/divider3"
                android:background="@color/light_grey"
                app:layout_constraintTop_toBottomOf="@+id/targetPrice"
                android:layout_width="match_parent"
                android:visibility="@{request.detailsNotVisible()}"
                android:layout_height="1dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/missingInfo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider3"
                android:layout_width="wrap_content"
                android:layout_marginStart="@dimen/size_8dp"
                android:layout_marginTop="@dimen/size_8dp"
                android:paddingBottom="@dimen/size_8dp"
                android:layout_height="wrap_content"
                android:textColor="@color/pending_status"
                android:fontFamily="sans-serif"
                android:textSize="@dimen/text_12sp"
                android:visibility="@{request.missingVehicleVisibility()}"
                android:text="@{request.detailMissingText()}"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>