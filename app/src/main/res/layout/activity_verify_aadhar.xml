<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="viewModel"
            type="com.delhivery.axle.ui.kyc.aadhaar.AadhaarVerificationViewModel"
            />
        <import type="android.view.View" />
    </data>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blue_bg"
        android:orientation="vertical">

        <include
            android:id="@+id/progress_step_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/view_progress_steps"
            android:layout_marginBottom="@dimen/size_24dp"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/size_24dp"
            android:paddingEnd="@dimen/size_24dp"
            android:paddingBottom="@dimen/size_48dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/step_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toTopOf="parent"
                android:text="@{viewModel.currentStep}"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_12sp"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/aadhaar_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/step_text"
                android:layout_marginTop="@dimen/size_8dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                android:text="@string/label_aadhaar"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/aadhaar_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/aadhaar_text"
                android:text="@string/sub_label_aadhaar_details"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_14sp"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:visibility="gone"
                android:id="@+id/aadhaar_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:drawableLeft="@drawable/ic_vector_error"
                android:drawablePadding="@dimen/size_8dp"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/aadhaar_hint"
                android:text="@{viewModel.errorText}"
                android:textColor="@color/destructive_red"
                android:textSize="@dimen/text_16sp"
                />

            <androidx.cardview.widget.CardView
                android:id="@+id/aadhaar_edit_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/edit_text_height"
                android:layout_marginTop="@dimen/size_32dp"
                bind:cardElevation="@dimen/size_2dp"
                bind:cardCornerRadius="@dimen/size_6dp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/aadhaar_error">
                <com.delhivery.axle.ui.custom.DelhiveryAadhaarFormattedEditText
                    android:id="@+id/edit_aadhaar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edit_text_height"
                    android:background="@drawable/bg_login_edit"
                    android:imeOptions="actionDone"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="parent"
                    android:digits="1234567890-"
                    bind:groupSeparator="-"
                    android:inputType="phone"
                    android:maxLength="14"
                    android:paddingStart="@dimen/size_12dp"
                    android:paddingEnd="@dimen/size_12dp"
                    android:hint="@string/aadhaar_hint"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_16sp"
                    android:text="@={ viewModel.aadhaarCardNumber }"
                    />

            </androidx.cardview.widget.CardView>
            <CheckBox
                android:id="@+id/aadhaarTermCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                bind:layout_constraintTop_toBottomOf="@+id/aadhaar_edit_layout"
                bind:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="@dimen/size_16dp"
                android:gravity="top"
                android:paddingTop="@dimen/size_4dp"
                android:text="@string/label_aadhaar_consent"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_14sp"
                />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_verify_aadhaar"
                style="@style/ActionButton"
                android:enabled="false"
                android:textAllCaps="false"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/aadhaarTermCondition"
                android:layout_alignParentBottom="true"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/size_32dp"
                android:text="@string/action_verify_aadhaar"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>



