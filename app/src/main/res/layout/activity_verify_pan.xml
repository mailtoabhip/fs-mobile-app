<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
<data>
    <variable
        name="viewModel"
        type="com.dfd.delfin.ui.kyc.pan.PanVerificationViewModel"
        />
    <import type="android.view.View" />

</data>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/light_red_bg"
        android:orientation="vertical"
      android:fitsSystemWindows="true">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            app:title="@string/title_account_setup"
            app:titleTextAppearance="@style/Toolbar.TitleText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:contentInsetLeft="0dp"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp"
            />
        <View
            android:id="@+id/horizontalDivider"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/light_line_grey"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar" />
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="@dimen/size_24dp"
                android:paddingEnd="@dimen/size_24dp"
                android:paddingBottom="@dimen/size_48dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/step_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="@dimen/text_6sp"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toTopOf="parent"
                    android:text="@{viewModel.currentStep}"
                    android:textColor="@color/sub_heading_black"
                    android:textSize="@dimen/text_12sp"
                    tools:text="@string/sub_label_step1_3"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/pan_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/step_text"
                    android:layout_marginTop="@dimen/size_8dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="@dimen/text_6sp"
                    android:text="@string/label_pan"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_18sp"
                    android:textStyle="bold"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/pan_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="@dimen/text_6sp"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/pan_text"
                    android:text="@string/sub_label_pan_details"
                    android:textColor="@color/sub_heading_black"
                    android:textSize="@dimen/text_14sp"
                    />
                <androidx.cardview.widget.CardView
                    android:id="@+id/pan_edit_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_32dp"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:cardElevation="@dimen/size_2dp"
                    bind:cardCornerRadius="@dimen/size_6dp"
                    bind:layout_constraintTop_toBottomOf="@+id/pan_hint">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.dfd.delfin.ui.custom.DelfinPanViewEditText
                        android:id="@+id/edit_pan"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/edit_text_height"
                        android:background="@drawable/bg_login_edit"
                        android:imeOptions="actionDone"
                        bind:layout_constraintStart_toStartOf="parent"
                        bind:layout_constraintTop_toTopOf="parent"
                        android:inputType="textCapCharacters"
                        android:maxLength="10"
                        android:paddingStart="@dimen/size_12dp"
                        android:paddingEnd="@dimen/size_12dp"
                        android:hint="@string/pan_hint"
                        android:textColor="@color/heading_black"
                        android:textSize="@dimen/text_16sp"
                        android:text="@={ viewModel.panCardNumber }"
                        />
                    <ProgressBar
                        android:id="@+id/pan_verify_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/edit_text_height"
                        bind:layout_constraintTop_toTopOf="parent"
                        bind:layout_constraintEnd_toEndOf="parent"
                        bind:layout_constraintBottom_toBottomOf="parent"
                        android:visibility="gone"
                        android:paddingStart="@dimen/size_12dp"
                        android:paddingEnd="@dimen/size_12dp"
                        style="?android:attr/progressBarStyleSmall" />
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/img_correct"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/edit_text_height"
                        bind:srcCompat="@drawable/ic_correct"
                        bind:layout_constraintTop_toTopOf="parent"
                        bind:layout_constraintEnd_toEndOf="parent"
                        bind:layout_constraintBottom_toBottomOf="parent"
                        android:visibility="gone"
                        android:paddingStart="@dimen/size_12dp"
                        android:paddingEnd="@dimen/size_12dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_pan_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="@dimen/text_6sp"
                    android:drawableStart="@drawable/ic_info_pan"
                    android:drawablePadding="@dimen/size_8dp"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/pan_edit_layout"
                    android:text="@string/hint_for_quick_processing"
                    android:textColor="@color/info_bg"
                    android:textSize="@dimen/text_16sp"
                    android:visibility="visible"
                    />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/text_pan_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="@dimen/text_6sp"
                    android:drawablePadding="@dimen/size_8dp"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/text_pan_name"
                    android:text="@string/error_duplicate_pan"
                    android:textColor="@color/colorDelhiveryRed"
                    android:textSize="@dimen/text_16sp"
                    android:visibility="gone"
                    />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_verify_pan"
                    style="@style/ActionButton"
                    android:enabled="false"
                    android:textAllCaps="false"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/text_pan_error"
                    android:layout_alignParentBottom="true"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/size_32dp"
                    android:text="@string/action_save_proceed"
                    />

              <androidx.appcompat.widget.AppCompatTextView
                  android:id="@+id/text_pan_not_linked_to_aadhaar"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/size_16dp"
                  android:text="@string/pan_not_linked_to_aadhaar"
                  android:textColor="@color/error_red"
                  android:visibility="gone"
                  android:fontFamily="sans-serif"
                  android:textSize="@dimen/text_16sp"
                  bind:layout_constraintEnd_toEndOf="parent"
                  bind:layout_constraintStart_toStartOf="parent"
                  bind:layout_constraintTop_toBottomOf="@id/btn_verify_pan"
                  android:textAlignment="center"
                  />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>



