<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:autofit="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="route"
        type="com.delhivery.axle.data.home.routes.RouteModel"
        />

    <import type="android.view.View" />
  </data>
  <androidx.cardview.widget.CardView
      android:id="@+id/route_card"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/size_6dp"
      android:layout_marginEnd="@dimen/size_6dp"
      android:layout_marginBottom="@dimen/size_6dp"
      android:foreground="?attr/selectableItemBackgroundBorderless"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="@dimen/size_2dp"
      android:layout_marginTop="@dimen/size_6dp"
      >

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/lay_routes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/size_11dp">

      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_origin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/text_origin_title"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:textColor="@color/faded_black"
              android:text="@string/label_origin_city"
              android:textSize="@dimen/text_16sp" />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/text_origin_name"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:textColor="@color/black"
              android:text="@{route.key()}"
              android:textSize="@dimen/text_16sp"
              android:textStyle="bold"
              android:layout_marginTop="@dimen/size_4dp"
              tools:text="New Delhi, Delhi"/>
          </androidx.appcompat.widget.LinearLayoutCompat>

          <androidx.appcompat.widget.AppCompatImageView
              android:id="@+id/icon_options_route"
              android:layout_marginEnd="@dimen/size_16dp"
              android:padding="@dimen/size_6dp"
              app:srcCompat="@drawable/ic_options_team"
              android:layout_width="wrap_content"
              android:layout_gravity="center"
              android:layout_height="wrap_content"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

      <View
          android:layout_width="match_parent"
          android:layout_height="@dimen/size_4dp"
          android:layout_marginTop="@dimen/size_10dp"
          android:background="@drawable/seprator_dotted"/>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_10dp"
            android:orientation="vertical">

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/text_destination_title"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:textColor="@color/faded_black"
              android:text="@string/label_destination_states"
              android:textSize="@dimen/text_16sp" />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/text_destination_name"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:textColor="@color/black"
              android:ellipsize="end"
              android:maxLines="1"
              android:text="@{route.stateNames()}"
              android:layout_marginTop="@dimen/size_4dp"
              android:textSize="@dimen/text_16sp"
              tools:text="Assam, Andhra Pradesh, Arunanchal Pradesh, Bihar, Uttar Pradesh"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

  </androidx.cardview.widget.CardView>

</layout>