<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto">

  <data>
     <variable
        name="viewModel"
        type="com.delhivery.axle.ui.accountdetails.AccountDetailsViewModel"
        />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/parent_cl"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/white"
      android:orientation="vertical"
      android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        app:contentInsetStartWithNavigation="@dimen/size_8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:title=""
        style="@style/Toolbar.TitleText" />

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/horizontalDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_1dp"
        bind:layout_constraintTop_toBottomOf="@id/toolbar"
        android:padding="0dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:id="@+id/scView"
        android:layout_height="wrap_content"
        bind:layout_constraintTop_toBottomOf="@id/horizontalDivider">

      <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
           android:orientation="vertical"
          android:paddingBottom="@dimen/size_48dp"
          android:paddingStart="@dimen/size_24dp"
          android:paddingEnd="@dimen/size_24dp">

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/label_tellus"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_16dp"
              bind:layout_constraintTop_toTopOf="parent"
              android:lineSpacingExtra="@dimen/text_6sp"
              android:text="@string/str_enter_your_name"
              android:textFontWeight="600"
              android:textColor="@color/text_primary"
              style="@style/TextAppearance.Delfin.SB14"
              android:textSize="28sp"
              />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/label_select_tellus"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_below="@+id/label_tellus"
              android:lineSpacingMultiplier="1.2"
              bind:layout_constraintTop_toBottomOf="@id/label_tellus"
              android:layout_marginBottom="@dimen/size_16dp"
              android:layout_marginTop="@dimen/size_12dp"
              android:gravity="start"
              android:text="@string/str_tell_us_your_name"
              style="@style/TextAppearance.Delfin.M14"
              android:textColor="@color/text_body_primary"
              />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/tv_first_name"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@+id/label_tellus"
              bind:layout_constraintTop_toBottomOf="@id/label_select_tellus"
              bind:layout_constraintStart_toStartOf="parent"
              android:layout_marginBottom="@dimen/size_16dp"
              android:layout_marginTop="@dimen/size_24dp"
              android:gravity="start"
              android:text="@string/str_first_name_required"
              style="@style/TextAppearance.Delfin.M14"
              android:textColor="@color/text_body_primary"
              />
          <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
              android:id="@+id/edit_name"
              android:layout_width="match_parent"
              android:layout_height="@dimen/edit_text_height"
              android:layout_below="@+id/label_select_tellus"
              android:layout_marginBottom="16dp"
              android:layout_marginTop="@dimen/size_8dp"
              android:background="@drawable/bg_login_edit"
              android:hint="@string/str_enter_first_name"
              bind:layout_constraintTop_toBottomOf="@id/tv_first_name"
              android:imeOptions="actionNext"
              android:inputType="text"
              android:paddingEnd="@dimen/size_12dp"
              android:paddingStart="@dimen/size_12dp"
              android:text="@={viewModel.firstName}"
              style="@style/TextAppearance.Delfin.M14"
              android:textColor="@color/text_body_primary"
              />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/tv_middle_name"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              bind:layout_constraintTop_toBottomOf="@id/edit_name"
              bind:layout_constraintStart_toStartOf="parent"
              android:layout_marginBottom="@dimen/size_16dp"
              android:layout_marginTop="@dimen/size_16dp"
              android:gravity="start"
              android:text="@string/str_middle_name"
              style="@style/TextAppearance.Delfin.M14"
              android:textColor="@color/text_body_primary"
              />


          <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
              android:id="@+id/edit_middle_name"
              android:layout_width="match_parent"
              android:layout_height="@dimen/edit_text_height"
              android:layout_marginBottom="16dp"
              android:layout_marginTop="@dimen/size_8dp"
              bind:layout_constraintTop_toBottomOf="@id/tv_middle_name"
              android:background="@drawable/bg_login_edit"
              android:hint="@string/str_enter_middle_name"
              android:imeOptions="actionDone"
              android:inputType="text"
              android:paddingEnd="@dimen/size_12dp"
              android:paddingStart="@dimen/size_12dp"
              android:text="@={viewModel.lastName}"
              style="@style/TextAppearance.Delfin.M14"
              android:textColor="@color/text_body_primary"
              />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_last_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            bind:layout_constraintTop_toBottomOf="@id/edit_middle_name"
            bind:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="@dimen/size_16dp"
            android:layout_marginTop="@dimen/size_16dp"
            android:gravity="start"
            android:text="@string/str_last_name"
            style="@style/TextAppearance.Delfin.M14"
            android:textColor="@color/text_body_primary"
            />


          <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
              android:id="@+id/edit_last_name"
              android:layout_width="match_parent"
              android:layout_height="@dimen/edit_text_height"
              android:layout_marginBottom="16dp"
              android:layout_marginTop="@dimen/size_8dp"
              bind:layout_constraintTop_toBottomOf="@id/tv_last_name"
              android:background="@drawable/bg_login_edit"
              android:hint="@string/str_enter_last_name"
              android:imeOptions="actionDone"
              android:inputType="text"
              android:paddingEnd="@dimen/size_12dp"
              android:paddingStart="@dimen/size_12dp"
              android:text="@={viewModel.lastName}"
              style="@style/TextAppearance.Delfin.M14"
              android:textColor="@color/text_body_primary"
              />

        <CheckBox
            android:id="@+id/communication_consent_cb"
            bind:layout_constraintTop_toBottomOf="@id/edit_last_name"
            android:layout_width="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            android:textSize="@dimen/text_14sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:checked="@={viewModel.commConsent}"
            android:layout_marginTop="@dimen/size_28dp"
            android:buttonTint="@color/black"
            android:layout_height="wrap_content"/>

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/consent_label"
              android:layout_width="0dp"
              app:layout_constraintTop_toTopOf="@id/communication_consent_cb"
              app:layout_constraintStart_toEndOf="@id/communication_consent_cb"
              app:layout_constraintEnd_toEndOf="parent"
              android:lineSpacingMultiplier="1.2"
              android:paddingVertical="@dimen/size_6dp"
              style="@style/TextAppearance.Delfin.M14"
              android:textColor="@color/text_body_primary"
              android:text="@string/str_communication_consent_note"
              android:layout_height="wrap_content"/>

          <androidx.appcompat.widget.AppCompatButton
              android:id="@+id/btn_create_account"
              android:layout_width="match_parent"
              android:layout_marginTop="@dimen/size_24dp"
              bind:layout_constraintTop_toBottomOf="@id/consent_label"
              android:enabled="false"
              android:text="@string/action_continue"
              android:textAllCaps="false"
              style="@style/ActionButton"
              />
    </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>



