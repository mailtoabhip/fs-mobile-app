<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

  <data>
     <variable
        name="viewModel"
        type="com.delhivery.axle.ui.accountdetails.AccountDetailsViewModel"
        />
  </data>

  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/white"
      android:orientation="vertical"
      android:fitsSystemWindows="true">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:id="@+id/scView"
        android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
           android:orientation="vertical"
          android:paddingBottom="@dimen/size_48dp"
          android:paddingStart="@dimen/size_24dp"
          android:paddingEnd="@dimen/size_24dp">

        <RelativeLayout
            android:id="@+id/account_details_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >
          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/label_tellus"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="@dimen/size_16dp"
              android:fontFamily="sans-serif"
              android:lineSpacingExtra="@dimen/text_6sp"
              android:text="@string/label_tellus"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_24sp"
              android:textStyle="bold"
              />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/label_select_tellus"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@+id/label_tellus"
              android:layout_marginBottom="@dimen/size_16dp"
              android:layout_marginTop="@dimen/size_12dp"
              android:fontFamily="sans-serif"
              android:gravity="start"
              android:text="@string/label_tellus_detail"
              android:textColor="@color/sub_heading_black"
              android:textSize="@dimen/text_16sp"
              />
          <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
              android:id="@+id/edit_name"
              android:layout_width="match_parent"
              android:layout_height="@dimen/edit_text_height"
              android:layout_below="@+id/label_select_tellus"
              android:layout_marginBottom="16dp"
              android:layout_marginTop="@dimen/size_32dp"
              android:background="@drawable/bg_login_edit"
              android:hint="@string/name_hint"
              android:imeOptions="actionNext"
              android:inputType="text"
              android:paddingEnd="@dimen/size_12dp"
              android:paddingStart="@dimen/size_12dp"
              android:text="@={viewModel.username}"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_16sp"
              />
          <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
              android:id="@+id/edit_business_name"
              android:layout_width="match_parent"
              android:layout_height="@dimen/edit_text_height"
              android:layout_below="@+id/edit_name"
              android:layout_marginBottom="16dp"
              android:layout_marginTop="@dimen/size_24dp"
              android:background="@drawable/bg_login_edit"
              android:hint="@string/business_hint"
              android:imeOptions="actionNext"
              android:inputType="text"
              android:paddingEnd="@dimen/size_12dp"
              android:paddingStart="@dimen/size_12dp"
              android:text="@={viewModel.business_name}"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_16sp"
              />


          <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
              android:id="@+id/edit_referral_code"
              android:layout_width="match_parent"
              android:layout_height="@dimen/edit_text_height"
              android:layout_below="@+id/edit_business_name"
              android:layout_marginBottom="16dp"
              android:layout_marginTop="@dimen/size_24dp"
              android:background="@drawable/bg_login_edit"
              android:hint="@string/referral_hint"
              android:imeOptions="actionDone"
              android:inputType="text"
              android:paddingEnd="@dimen/size_12dp"
              android:paddingStart="@dimen/size_12dp"
              android:text="@={viewModel.referral_code}"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_16sp"
              />
          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/privacyText"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@+id/edit_referral_code"
              android:layout_marginBottom="@dimen/size_4dp"
              android:layout_marginStart="@dimen/size_6dp"
              android:layout_marginTop="22dp"
              android:fontFamily="sans-serif"
              android:text="@string/our_privacy_policy_outlines"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_14sp"
              />
          <CheckBox
              android:id="@+id/checkTerms"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@+id/privacyText"
              android:gravity="top"
              android:paddingTop="@dimen/size_4dp"
              android:text="@string/i_read_accept"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_14sp"
              />

          <CheckBox
              android:id="@+id/checkWhatsapp"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@+id/checkTerms"
              android:layout_marginTop="@dimen/size_8dp"
              android:gravity="top"
              android:paddingTop="@dimen/size_4dp"
              android:text="@string/label_agree_whatsapp"
              android:textColor="@color/heading_black"
              android:textSize="@dimen/text_14sp"
              />

          <androidx.appcompat.widget.AppCompatButton
              android:id="@+id/btn_create_account"
              android:layout_width="match_parent"
              android:layout_below="@+id/checkWhatsapp"
              android:layout_marginTop="@dimen/size_32dp"
              android:enabled="false"
              android:text="@string/action_proceed_account"
              android:textAllCaps="false"
              style="@style/ActionButton"
              />
        </RelativeLayout>


      </RelativeLayout>
    </RelativeLayout>
    </ScrollView>

  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>



