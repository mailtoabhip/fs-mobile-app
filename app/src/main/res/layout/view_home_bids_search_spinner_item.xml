<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    >

  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/size_12dp"
      android:background="@color/colorPrimary"
      android:clickable="false"
      android:focusable="false"
      android:paddingBottom="@dimen/size_8dp"
      android:paddingEnd="@dimen/size_16dp"
      android:paddingStart="@dimen/size_16dp"
      android:paddingTop="@dimen/size_8dp"
      android:visibility="invisible"
      bind:shadow="@{ @dimen/size_4dp }"
      >

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_truck_type"
        android:textColor="@color/black"
        android:textSize="@dimen/text_14sp"
        android:textFontWeight="500"
        android:fontFamily="sans-serif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/truck_type"
        />

    <androidx.appcompat.widget.AppCompatSpinner
        android:id="@+id/spinner_truck_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/size_16dp"
        android:layout_marginTop="@dimen/size_4dp"
        android:textSize="@dimen/text_16sp"
        android:paddingTop="@dimen/size_8dp"
        android:paddingBottom="@dimen/size_8dp"
        android:paddingStart="@dimen/size_12dp"
        android:background="@drawable/bg_search_load_spinner"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:layout_below="@id/tv_truck_type"
        bind:shadow="@{ @dimen/size_2dp }"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_status"
        android:textColor="@color/black"
        android:textFontWeight="500"
        android:fontFamily="sans-serif"
        android:textSize="@dimen/text_14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/spinner_truck_type"
        android:text="@string/status"
        />
    <androidx.appcompat.widget.AppCompatSpinner
        android:id="@id/spinner_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_status"
        android:textSize="@dimen/text_16sp"
        android:paddingTop="@dimen/size_8dp"
        android:paddingBottom="@dimen/size_8dp"
        android:paddingStart="@dimen/size_12dp"
        android:layout_marginBottom="@dimen/size_8dp"
        android:layout_marginTop="@dimen/size_4dp"
        android:background="@drawable/bg_search_load_spinner"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        bind:shadow="@{ @dimen/size_2dp }"
        />

  </RelativeLayout>
</layout>