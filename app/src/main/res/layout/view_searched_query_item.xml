<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="result"
        type="String"
        />
    <import type="androidx.core.content.ContextCompat" />
  </data>

  <androidx.cardview.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/size_12dp"
      android:layout_marginTop="@dimen/size_6dp"
      android:layout_marginEnd="@dimen/size_12dp"
      android:layout_marginBottom="@dimen/size_6dp"
      android:clickable="true"
      android:focusable="true"
      android:foreground="?attr/selectableItemBackgroundBorderless"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="@dimen/size_2dp"
      >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:paddingStart="@dimen/size_16dp"
        android:paddingTop="@dimen/size_8dp"
        android:paddingEnd="@dimen/size_16dp"
        android:paddingBottom="@dimen/size_8dp"
        >

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/btn_results"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_8dp"
          android:fontFamily="sans-serif-medium"
          android:paddingTop="@dimen/size_8dp"
          android:paddingBottom="@dimen/size_8dp"
          android:text="@{result}"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_16sp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          tools:text="19 trips with search parameter"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/btn_reset"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/size_12dp"
          android:background="@drawable/bg_gradient_blue"
          android:fontFamily="sans-serif-medium"
          android:gravity="center"
          android:paddingStart="@dimen/size_36dp"
          android:paddingTop="@dimen/size_8dp"
          android:paddingEnd="@dimen/size_36dp"
          android:paddingBottom="@dimen/size_8dp"
          android:text="RESET"
          android:textColor="@color/white"
          android:textSize="@dimen/text_16sp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/btn_results"
          />

    </androidx.constraintlayout.widget.ConstraintLayout>
  </androidx.cardview.widget.CardView>
</layout>
