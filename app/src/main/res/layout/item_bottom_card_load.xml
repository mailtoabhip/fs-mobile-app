<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
  >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        >


    <!-- Reporting Time Label -->
    <TextView
        android:id="@+id/tv_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reporting time"
        android:textColor="#8F9198"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Reporting Time -->
    <TextView
        android:id="@+id/tv_reporting_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="13 July, 3:30 PM"
        android:textColor="#121A31"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_label"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Accept Button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/place_bid_button"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_place_bid"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    <Button
        android:id="@+id/btn_accept_bid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Accept for ₹3000"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:drawablePadding="8dp"
        android:backgroundTint="#121A31"
        android:layout_marginStart="12dp"
        android:minHeight="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
