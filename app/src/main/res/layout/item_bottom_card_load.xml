<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="request"
            type="com.dfd.delfin.data.home.bids.HomeBidsRequestItemData" />
        <import type="android.view.View" />

    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:duplicateParentState="true"
        >


    <!-- Reporting Time Label -->
    <TextView
        android:id="@+id/tv_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reporting time"
        android:textColor="#8F9198"
        android:duplicateParentState="true"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Reporting Time -->
    <TextView
        android:id="@+id/tv_reporting_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="13 July, 3:30 PM"
        android:textColor="#121A31"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_label"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Accept Button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/place_bid_button_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_place_bid"
        android:clickable="true"
        android:focusable="true"
        android:duplicateParentState="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_accept_bid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@{ @string/action_accept(request.formatedTargetPrice()) }"
        android:textAllCaps="false"
        android:clickable="true"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        tools:text = "Accept for 30000"
        android:duplicateParentState="true"
        android:backgroundTint="#121A31"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
