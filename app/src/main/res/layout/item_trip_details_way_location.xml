<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="request"
            type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/size_16dp"
        android:paddingEnd="@dimen/size_16dp">


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_truck_loc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_navigate_grey"
            android:drawablePadding="@dimen/size_8dp"
            android:paddingTop="@dimen/size_4dp"
            android:text="One Way"
            android:textColor="#505361"
            android:textSize="12sp"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="One Way" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_loc_fixes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_fix_location"
            android:drawablePadding="@dimen/size_8dp"
            android:paddingTop="@dimen/size_4dp"
            android:textColor="#505361"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="One Way" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/closingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_schedule_grey"
            android:drawablePadding="@dimen/size_8dp"
            android:text="7 days a week"
            android:textColor="#505361"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/text_truck_loc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/text_truck_loc"
            tools:text="7 days a week" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>