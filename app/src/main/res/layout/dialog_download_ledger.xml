<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
    <data>
        <variable
            name="error"
            type="Boolean" />
        <variable
            name="errorMsg"
            type="String" />

        <import type="android.view.View" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:orientation="vertical"
        android:paddingStart="@dimen/size_24dp"
        android:paddingTop="@dimen/size_24dp"
        android:paddingEnd="@dimen/size_24dp"
        android:paddingBottom="@dimen/size_4dp"
        >

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            >
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="@dimen/text_12sp"
                android:text="Select Duration"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/text_16sp"
                tools:text="Error"
                />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/btn_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:padding="@dimen/size_2dp"
                app:srcCompat="@drawable/ic_close_black"
                />
        </FrameLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/size_18dp"
            android:orientation="horizontal">


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/size_10dp"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="From"
                    android:textSize="@dimen/text_16sp"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edit_start_date"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:hint="Start Date"
                    android:paddingVertical="@dimen/size_10dp"
                    android:paddingHorizontal="@dimen/size_8dp"
                    android:layout_marginTop="@dimen/size_2dp"
                    android:textSize="@dimen/size_16dp"
                    android:fontFamily="sans-serif-medium"
                    android:textAlignment="center"
                    android:background="@drawable/bg_white_all_corner_black"
                    />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="@dimen/size_4dp"
                app:srcCompat="@drawable/ic_calendar"/>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/size_10dp"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="To"
                    android:textSize="@dimen/text_16sp"
                    android:fontFamily="sans-serif-medium"
                    />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edit_end_date"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    android:hint="End Date"
                    android:focusable="false"
                    android:paddingVertical="@dimen/size_10dp"
                    android:paddingHorizontal="@dimen/size_8dp"
                    android:layout_marginTop="@dimen/size_2dp"
                    android:textAlignment="center"
                    android:textSize="@dimen/size_16dp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_white_all_corner_black"
                    />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edit_email_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Email ID"
            android:textSize="@dimen/size_16dp"
            android:fontFamily="sans-serif-medium"
            android:paddingVertical="@dimen/size_10dp"
            android:layout_marginTop="@dimen/size_18dp"
            android:textAlignment="center"
            android:background="@drawable/bg_white_all_corner_black"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/error_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_12dp"
            android:text="Dummy"
            android:textAlignment="center"
            android:textColor="@color/status_lost"
            android:visibility="gone"
            />


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_18dp"
            android:layout_marginBottom="@dimen/size_24dp"
            android:gravity="center"
            >

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_download"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:text="Download"
                android:textColor="@color/white"
                android:paddingHorizontal="@dimen/size_12dp"
                android:textSize="@dimen/text_14sp"
                android:background="@drawable/bg_all_round_corner_black"
                />

            <View
                android:layout_width="@dimen/size_16dp"
                android:layout_height="0dp"
                />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_email"
                style="@style/Widget.AppCompat.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Email"
                android:paddingHorizontal="@dimen/size_12dp"
                android:textColor="@color/white"
                android:textSize="@dimen/text_14sp"
                android:background="@drawable/bg_all_round_corner_black"
                />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>