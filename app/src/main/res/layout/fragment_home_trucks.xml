<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
    <data>
        <variable
            name="viewModel"
            type="com.delhivery.axle.ui.home.fragments.trucks.HomeTrucksViewModel"
            />
    </data>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground"
        >

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_trucks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:itemCount="4"
                tools:listitem="@layout/view_home_trucks_request_item"
                />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <com.delhivery.axle.ui.custom.DelhiveryAnimatedSearchBar
            android:id="@+id/edit_sticky_search"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_72dp"
            android:gravity="center_vertical"
            android:hint="@string/hint_search_trucks"
            android:imeOptions="actionSearch"
            android:maxLines="1"
            android:paddingBottom="@dimen/size_16dp"
            android:paddingStart="@dimen/size_56dp"
            android:singleLine="true"
            android:textColorHint="@color/color_hint"
            android:textSize="@dimen/text_16sp"
            bind:shadow="@{ @dimen/size_4dp }"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/add_truck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical||bottom"
            />

    </FrameLayout>
</layout>