<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <data>
        <variable
            name="viewModel"
            type="com.delhivery.axle.ui.home.fragments.trucks.HomeTrucksViewModel"
            />
    </data>
    <FrameLayout
        android:layout_width="match_parent"
        android:id="@+id/fm"
        android:layout_height="match_parent"
        android:background="@color/colorBackground">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_trucks"
                android:layout_width="match_parent"
                android:layout_marginBottom="@dimen/size_8dp"
                android:layout_height="match_parent"
               android:layout_marginTop="@dimen/size_8dp"
                />

                <com.delhivery.axle.ui.custom.DelhiveryAnimatedSearchBar
                    android:id="@+id/edit_sticky_search"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/size_72dp"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_search_trucks"
                    android:imeOptions="actionSearch"
                    android:maxLines="1"
                    android:inputType="textCapCharacters"
                    android:paddingStart="@dimen/size_56dp"
                    android:paddingBottom="@dimen/size_16dp"
                    android:singleLine="true"
                    android:textColorHint="@color/color_hint"
                    android:textSize="@dimen/text_16sp"
                    bind:shadow="@{ @dimen/size_4dp }" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/add_truck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_add_truck"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:layout_alignParentBottom="true"
            android:gravity="center"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/size_18dp"
            android:background="@drawable/bg_load_action_btn"
            />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/add_truck_floating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_18dp"
            bind:srcCompat="@drawable/ic_add_white"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:visibility="gone"
            android:contentDescription="@string/action_add_truck"
            android:layout_marginEnd="@dimen/size_16dp"/>

                 </RelativeLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


    </FrameLayout>
</layout>