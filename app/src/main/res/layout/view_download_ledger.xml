<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
    <data>
        <variable
            name="ledger"
            type="com.delhivery.axle.data.ledger.ConsolidatedLedgerItemData"
            />
        <import type="androidx.core.content.ContextCompat" />
        <import type="android.view.View" />
    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="@dimen/size_16dp"
        android:paddingTop="@dimen/size_6dp"
        android:paddingEnd="@dimen/size_16dp"
        android:paddingBottom="@dimen/size_6dp"
        android:orientation="vertical"
        >
        <CheckBox android:id="@+id/checkbox_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select All"
            android:onClick="onCheckboxClicked"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/transparent_grey"
            />

        <CheckBox android:id="@+id/checkbox_month1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="May"
            android:onClick="onCheckboxClicked"/>
        <CheckBox android:id="@+id/checkbox_month2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="June"
            android:onClick="onCheckboxClicked"/>


    </androidx.appcompat.widget.LinearLayoutCompat>

</layout>
