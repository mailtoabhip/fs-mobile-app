<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>

  </data>
  <androidx.appcompat.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@drawable/bg_grey_all_corner_black"
      android:orientation="vertical"
      android:padding="@dimen/size_4dp"
      android:layout_marginTop="@dimen/size_4dp"
      >

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/deductions_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/size_4dp"
        android:orientation="horizontal"
        >

      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_deductions"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_weight=".90"
          android:ellipsize="end"
          android:fontFamily="sans-serif"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_16sp"
          tools:text="TDS (@1.5%)"
          />


      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/text_deductions_value"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_weight=".10"
          android:fontFamily="sans-serif"
          android:textColor="@color/status_lost"
          android:textSize="@dimen/text_16sp"
          tools:text="(750)"
          />

    </androidx.appcompat.widget.LinearLayoutCompat>

  </androidx.appcompat.widget.LinearLayoutCompat>
</layout>