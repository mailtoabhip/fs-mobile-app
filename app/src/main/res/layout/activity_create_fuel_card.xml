<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >

  <data>
    <variable
        name="trip"
        type="com.delhivery.axle.data.home.trips.HomeTripsItemData"
        />

    <variable
        name="fuel"
        type="com.delhivery.axle.data.fuelcards.FuelCardData"
        />

    <variable
        name="fetching"
        type="Boolean"
        />

    <variable
        name="error"
        type="Boolean"
        />

    <variable
        name="created"
        type="Boolean"
        />

    <variable
        name="createdError"
        type="Boolean"
        />

    <variable
        name="numberRecharged"
        type="String"
        />

    <variable
        name="amountAdded"
        type="String"
        />

    <variable
        name="cashback"
        type="String"
        />

    <import type="android.view.View" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/colorBackground"
      android:orientation="vertical"
      >

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        >

      <androidx.core.widget.NestedScrollView
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:visibility="@{ !fetching &amp;&amp; !error ? View.VISIBLE : View.GONE }"
          tools:visibility="gone"
          >

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            >

          <androidx.cardview.widget.CardView
              android:id="@+id/container_active_card"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_margin="@dimen/size_8dp"
              android:clickable="true"
              android:focusable="true"
              android:visibility="gone"
              android:foreground="?attr/selectableItemBackgroundBorderless"
              app:cardCornerRadius="@dimen/size_6dp"
              app:cardElevation="2dp"
              >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_all_round_corner_white"
                android:padding="@dimen/size_12dp"
                >

              <TextView
                  android:id="@+id/label_active_status"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="sans-serif"
                  android:lineSpacingExtra="@dimen/text_8sp"
                  android:text="@string/label_money_given"
                  android:textColor="@color/heading_black"
                  android:textSize="@dimen/text_16sp"
                  android:textStyle="normal"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintTop_toTopOf="parent"
                  />

              <TextView
                  android:id="@+id/label_active_amount"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="sans-serif-medium"
                  android:lineSpacingExtra="@dimen/text_8sp"
                  android:text="@{trip.fuelCard.amount()}"
                  android:textColor="@color/status_confirmed"
                  android:textSize="@dimen/text_16sp"
                  android:textStyle="normal"
                  app:layout_constraintEnd_toEndOf="parent"
                  app:layout_constraintTop_toTopOf="@+id/label_active_status"
                  tools:text="Rs 2000"
                  />

            </androidx.constraintlayout.widget.ConstraintLayout>

          </androidx.cardview.widget.CardView>

          <androidx.cardview.widget.CardView
              android:id="@+id/container_trip"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_margin="@dimen/size_8dp"
              android:clickable="true"
              android:focusable="true"
              android:foreground="?attr/selectableItemBackgroundBorderless"
              app:cardCornerRadius="@dimen/size_6dp"
              app:cardElevation="2dp"
              >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_all_round_corner_white"
                android:padding="@dimen/size_12dp"
                >

              <androidx.appcompat.widget.AppCompatImageView
                  android:id="@+id/img_fuel_partner"
                  android:layout_width="@dimen/size_56dp"
                  android:layout_height="@dimen/size_56dp"
                  app:layout_constraintStart_toStartOf="parent"
                  app:srcCompat="@drawable/ic_fuel"
                  android:padding="@dimen/size_6dp"
                  app:layout_constraintTop_toTopOf="parent"
                  />


              <TextView
                  android:id="@+id/label_fuel_partner"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="sans-serif-medium"
                  android:lineSpacingExtra="@dimen/text_8sp"
                  android:textColor="@color/heading_black"
                  android:textSize="@dimen/text_16sp"
                  android:textStyle="normal"
                  android:text="Fuel Partner - IOCL"
                  android:layout_marginStart="@dimen/size_8dp"
                  app:layout_constraintStart_toEndOf="@+id/img_fuel_partner"
                  app:layout_constraintTop_toTopOf="@+id/img_fuel_partner"
                  app:layout_constraintBottom_toBottomOf="@+id/img_fuel_partner"
                  />

              <TextView
                  android:id="@+id/text_truck_details"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="sans-serif-medium"
                  android:lineSpacingExtra="@dimen/text_8sp"
                  android:textColor="@color/heading_black"
                  android:textSize="@dimen/text_16sp"
                  android:textStyle="normal"
                  android:text="@{trip.vehicleDetails.vehicleNo}"
                  android:layout_marginTop="@dimen/size_8dp"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintTop_toBottomOf="@+id/img_fuel_partner"
                  tools:text="HR26 1234"
                  />

              <TextView
                  android:id="@+id/text_source_city"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="sans-serif"
                  android:text="@{ trip.originCityName() }"
                  android:textColor="@color/heading_black"
                  android:textSize="@dimen/text_16sp"
                  android:textStyle="normal"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintTop_toTopOf="@id/img_forward"
                  tools:text="Panjim"
                  />

              <TextView
                  android:id="@+id/text_source_state"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/size_4dp"
                  android:fontFamily="sans-serif"
                  android:text="@{trip.originStateName()}"
                  android:textColor="@color/sub_heading_black"
                  android:textSize="@dimen/text_14sp"
                  android:textStyle="normal"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintTop_toBottomOf="@id/text_source_city"
                  tools:text="GOA"
                  />

              <TextView
                  android:id="@+id/text_destination_city"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="@dimen/size_24dp"
                  android:fontFamily="sans-serif"
                  android:text="@{ trip.destinationCityName() }"
                  android:textColor="@color/heading_black"
                  android:textSize="@dimen/text_16sp"
                  android:textStyle="normal"
                  app:layout_constraintStart_toEndOf="@id/img_forward"
                  app:layout_constraintTop_toTopOf="@id/img_forward"
                  tools:text="Andheri East"
                  />

              <TextView
                  android:id="@+id/text_destination_state"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/size_4dp"
                  android:fontFamily="sans-serif"
                  android:text="@{trip.destinationStateName()}"
                  android:textColor="@color/sub_heading_black"
                  android:textSize="@dimen/text_14sp"
                  android:textStyle="normal"
                  app:layout_constraintStart_toStartOf="@id/text_destination_city"
                  app:layout_constraintTop_toBottomOf="@id/text_source_city"
                  tools:text="Mumbai"
                  />

              <androidx.appcompat.widget.AppCompatImageView
                  android:id="@+id/img_forward"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/size_16dp"
                  app:layout_constraintEnd_toEndOf="parent"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintTop_toBottomOf="@id/text_truck_details"
                  app:srcCompat="@drawable/ic_arrow_forward_black"
                  />

            </androidx.constraintlayout.widget.ConstraintLayout>
          </androidx.cardview.widget.CardView>

          <androidx.cardview.widget.CardView
              android:id="@+id/container_phone"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_margin="@dimen/size_8dp"
              android:clickable="true"
              android:focusable="true"
              android:foreground="?attr/selectableItemBackgroundBorderless"
              app:cardCornerRadius="@dimen/size_6dp"
              app:cardElevation="2dp"
              >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_all_round_corner_white"
                android:padding="@dimen/size_12dp"
                >

              <TextView
                  android:id="@+id/id1"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="sans-serif"
                  android:lineSpacingExtra="@dimen/text_8sp"
                  android:text="@string/label_give_fuel_to"
                  android:textColor="@color/heading_black"
                  android:textStyle="normal"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintTop_toTopOf="parent"
                  />

              <RadioGroup
                  android:id="@+id/radio_num_group"
                  android:layout_width="0dp"
                  app:layout_constraintTop_toBottomOf="@+id/id1"
                  app:layout_constraintEnd_toEndOf="parent"
                  app:layout_constraintStart_toStartOf="parent"
                  android:layout_height="wrap_content"
                  >

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/radio_driver_num"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_6dp"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_16sp"
                    android:text="@{trip.driverDetails.driverPhoneNo()}"
                    tools:text="Driver(1234567890)"
                    />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/radio_other_num"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_16sp"
                    android:layout_marginTop="@dimen/size_6dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/radio_driver_num"
                    android:text="Different number"
                    />

              </RadioGroup>

              <com.delhivery.axle.ui.custom.DelhiveryTextInputLayout
                  android:id="@+id/til_mobile"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  app:layout_constraintEnd_toEndOf="parent"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintTop_toBottomOf="@+id/radio_num_group"
                  app:errorEnabled="true"
                  app:max_length="10"
                  style="@style/TextInputLayoutAppearance"
                  >

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edit_mobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_form_edit"
                    android:digits="1234567890"
                    android:maxLength="10"
                    android:fontFamily="sans-serif"
                    android:hint="@string/label_enter_number"
                    android:inputType="number"
                    android:maxLines="1"
                    />
              </com.delhivery.axle.ui.custom.DelhiveryTextInputLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
          </androidx.cardview.widget.CardView>

          <androidx.cardview.widget.CardView
              android:id="@+id/container_amount"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_margin="@dimen/size_8dp"
              android:clickable="true"
              android:focusable="true"
              android:foreground="?attr/selectableItemBackgroundBorderless"
              app:cardCornerRadius="@dimen/size_6dp"
              app:cardElevation="2dp"
              >

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_all_round_corner_white"
                android:padding="@dimen/size_12dp"
                >

              <TextView
                  android:id="@+id/btn_create"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/size_16dp"
                  android:background="@drawable/bg_all_round_corner_black"
                  android:gravity="center"
                  android:paddingBottom="@dimen/size_16dp"
                  android:paddingTop="@dimen/size_16dp"
                  android:text="@string/label_create_fuel_card"
                  android:textColor="@color/white"
                  android:textSize="@dimen/text_16sp"
                  app:layout_constraintEnd_toEndOf="parent"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintTop_toBottomOf="@+id/til_amount"
                  />

              <TextView
                  android:id="@+id/btn_fuel_faq"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="@dimen/size_16dp"
                  android:fontFamily="sans-serif-medium"
                  android:gravity="center"
                  android:paddingTop="@dimen/size_8dp"
                  android:paddingBottom="@dimen/size_8dp"
                  android:text="@string/label_fuel_faq"
                  android:textColor="@color/heading_black"
                  app:layout_constraintEnd_toEndOf="parent"
                  app:layout_constraintTop_toBottomOf="@+id/btn_create"
                  app:layout_constraintStart_toStartOf="parent"
                  />


              <com.delhivery.axle.ui.custom.DelhiveryTextInputLayout
                  android:id="@+id/til_amount"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  app:layout_constraintEnd_toEndOf="parent"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintTop_toTopOf="parent"
                  app:errorEnabled="true"
                  style="@style/TextInputLayoutAppearance"
                  >

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edit_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_form_edit"
                    android:digits="1234567890"
                    android:fontFamily="sans-serif"
                    android:hint="Enter amount to be given for fuel"
                    android:inputType="number"
                    android:maxLines="1"
                    />
              </com.delhivery.axle.ui.custom.DelhiveryTextInputLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
          </androidx.cardview.widget.CardView>

        </androidx.appcompat.widget.LinearLayoutCompat>

      </androidx.core.widget.NestedScrollView>

      <include
          android:id="@+id/progress"
          tools:visibility="gone"
          layout="@layout/view_bid_details_loading_bids"
          android:visibility="@{ fetching ? View.VISIBLE : View.GONE }"
          />

      <androidx.appcompat.widget.LinearLayoutCompat
          android:id="@+id/container_empty"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          tools:visibility="visible"
          android:visibility="@{ !fetching &amp;&amp; error ? View.VISIBLE : View.GONE }"
          android:layout_marginTop="@dimen/size_64dp"
          android:orientation="vertical"
          android:paddingEnd="@dimen/size_24dp"
          android:paddingStart="@dimen/size_24dp"
          >

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_empty_box"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_40dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="@dimen/text_2sp"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            android:textStyle="normal"
            android:text="Session timed out!"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/size_24dp"
            android:layout_marginStart="@dimen/size_24dp"
            android:layout_marginTop="@dimen/size_4dp"
            android:fontFamily="sans-serif"
            android:gravity="center_horizontal"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:text="Unfortunately, we couldn't fetch the data you are looking for. \n Kindly refresh."
            android:textColor="@color/sub_heading_black"
            android:textSize="@dimen/text_12sp"
            android:textStyle="normal"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_action"
            android:layout_width="match_parent"
            android:layout_marginBottom="30dp"
            android:layout_marginTop="@dimen/size_56dp"
            android:text="REFRESH"
            style="@style/ActionButton"
            />
      </androidx.appcompat.widget.LinearLayoutCompat>

      <androidx.appcompat.widget.LinearLayoutCompat
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:visibility="@{ created ? View.VISIBLE : View.GONE }"
          android:weightSum="1"
          tools:visibility="gone"
          android:orientation="horizontal"
          android:background="@color/transparent_grey"
          >

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:layout_margin="@dimen/size_8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:cardCornerRadius="@dimen/size_6dp"
            app:cardElevation="2dp"
            >

          <androidx.constraintlayout.widget.ConstraintLayout
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:padding="@dimen/size_12dp"
              android:background="@drawable/bg_all_round_corner_white"
              >

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_status"
                android:layout_width="@dimen/size_72dp"
                android:layout_height="@dimen/size_72dp"
                android:layout_marginTop="@dimen/size_16dp"
                app:srcCompat="@drawable/ic_success"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center"
                android:textSize="@dimen/text_24sp"
                android:textColor="@color/heading_black"
                android:layout_marginTop="@dimen/size_16dp"
                app:layout_constraintTop_toBottomOf="@+id/img_status"
                android:text="Fuel Card Processed"
                />

            <TextView
                android:id="@+id/label_phone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/label_mobile_number"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/amount"
                />

            <TextView
                android:id="@+id/text_phone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_marginStart="@dimen/size_8dp"
                android:fontFamily="sans-serif"
                android:gravity="end"
                android:text="@{numberRecharged}"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/label_phone"
                app:layout_constraintTop_toTopOf="@+id/label_phone"
                tools:text="1234567890"
                />

            <TextView
                android:id="@+id/label_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Amount added"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_phone"
                />

            <TextView
                android:id="@+id/text_amount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_marginStart="@dimen/size_8dp"
                android:fontFamily="sans-serif"
                android:gravity="end"
                android:text="@{amountAdded}"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/label_amount"
                app:layout_constraintTop_toTopOf="@+id/label_amount"
                tools:text="Rs 10.00"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_pin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center"
                android:textSize="@dimen/text_20sp"
                android:textColor="@color/black"
                android:layout_marginTop="@dimen/size_16dp"
                android:paddingTop="@dimen/size_4dp"
                android:paddingBottom="@dimen/size_4dp"
                android:background="@drawable/bg_all_round_corner_green"
                app:layout_constraintTop_toBottomOf="@+id/text_amount"
                android:text="Fuel Card Pin: 1234"
                />

            <ImageView
                android:id="@+id/id3"
                android:layout_width="@dimen/size_8dp"
                android:layout_height="@dimen/size_8dp"
                android:layout_margin="@dimen/size_4dp"
                app:srcCompat="@drawable/ic_info"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/label_tip_1"
                app:layout_constraintBottom_toBottomOf="@+id/label_tip_1"
                app:layout_constraintEnd_toStartOf="@+id/label_tip_1"
                />

            <TextView
                android:id="@+id/label_tip_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:text="Any unused amount will be added back to your wallet at the end of the trip"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/id3"
                app:layout_constraintTop_toBottomOf="@+id/text_pin"
                />

            <ImageView
                android:id="@+id/id4"
                android:layout_width="@dimen/size_8dp"
                android:layout_height="@dimen/size_8dp"
                app:srcCompat="@drawable/ic_info"
                android:layout_margin="@dimen/size_4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/text_cashback"
                app:layout_constraintBottom_toBottomOf="@+id/text_cashback"
                app:layout_constraintEnd_toStartOf="@+id/text_cashback"
                />
            <TextView
                android:id="@+id/text_cashback"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:layout_margin="@dimen/size_4dp"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_12sp"
                android:text="@{cashback}"
                tools:text="You will receive cashback at end of trip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/id3"
                app:layout_constraintTop_toBottomOf="@+id/label_tip_1"
                />

            <TextView
                android:id="@+id/btn_back"
                android:layout_width="match_parent"
                android:text="@string/label_go_back"
                android:textColor="@color/heading_black"
                android:gravity="center"
                android:padding="@dimen/size_8dp"
                android:textSize="@dimen/text_16sp"
                android:layout_marginTop="@dimen/size_12dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_transaction_summary"
                />

            <TextView
                android:id="@+id/btn_transaction_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:background="@drawable/bg_all_round_corner_black"
                android:paddingTop="@dimen/size_10dp"
                android:paddingBottom="@dimen/size_10dp"
                android:text="@string/label_track_transaction_status"
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/text_cashback"
                app:layout_constraintStart_toStartOf="parent"
                />

          </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

      </androidx.appcompat.widget.LinearLayoutCompat>

      <androidx.appcompat.widget.LinearLayoutCompat
          android:id="@+id/container_create_card_error"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:visibility="@{ createdError ? View.VISIBLE : View.GONE }"
          android:weightSum="1"
          tools:visibility="gone"
          android:orientation="horizontal"
          android:background="@color/transparent_grey"
          >

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:layout_margin="@dimen/size_8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            app:cardCornerRadius="@dimen/size_6dp"
            app:cardElevation="2dp"
            >

          <androidx.constraintlayout.widget.ConstraintLayout
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:padding="@dimen/size_12dp"
              android:background="@drawable/bg_all_round_corner_white"
              >

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/id6"
                android:layout_width="@dimen/size_72dp"
                android:layout_height="@dimen/size_72dp"
                android:layout_marginTop="@dimen/size_16dp"
                app:srcCompat="@drawable/ic_cancel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/id7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:textSize="@dimen/text_20sp"
                android:textColor="@color/heading_black"
                android:layout_marginTop="@dimen/size_16dp"
                app:layout_constraintTop_toBottomOf="@+id/id6"
                android:text="Fuel Card creation failed"
                />

            <TextView
                android:id="@+id/id8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/label_mobile_number"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/id7"
                />

            <TextView
                android:id="@+id/id9"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_marginStart="@dimen/size_8dp"
                android:fontFamily="sans-serif"
                android:gravity="end"
                android:text="@{numberRecharged}"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/id8"
                app:layout_constraintTop_toTopOf="@+id/id8"
                tools:text="1234567890"
                />

            <TextView
                android:id="@+id/id10"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                android:fontFamily="sans-serif-medium"
                android:text="Amount added"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/id9"
                />

            <TextView
                android:id="@+id/id11"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/size_8dp"
                android:layout_marginStart="@dimen/size_8dp"
                android:fontFamily="sans-serif"
                android:gravity="end"
                android:text="@{amountAdded}"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/id10"
                app:layout_constraintTop_toTopOf="@+id/id10"
                tools:text="Rs 10.00"
                />

            <TextView
                android:id="@+id/btn_retry"
                android:layout_width="match_parent"
                android:text="RETRY"
                android:textColor="@color/white"
                android:background="@drawable/bg_all_round_corner_black"
                android:gravity="center"
                android:padding="@dimen/size_16dp"
                android:textSize="@dimen/text_16sp"
                android:layout_marginTop="@dimen/size_16dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/id11"
                />

          </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

      </androidx.appcompat.widget.LinearLayoutCompat>

    </FrameLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>

</layout>