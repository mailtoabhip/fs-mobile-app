<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="viewModel"
        type="com.delhivery.orion.ui.selectroutewelcome.SelectRouteWelcomeViewModel"
        />
  </data>
  <android.support.constraint.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/colorAccent"
      >


    <View
        android:id="@+id/center_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <View
        android:id="@+id/header_baseline_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/center_view"
        />

    <android.support.v7.widget.AppCompatImageView
        android:id="@+id/image_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:srcCompat="@drawable/ic_select_route_header_group"
        />

    <com.delhivery.orion.ui.custom.DelhiveryOnboardingArcView
        android:id="@+id/arc_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/center_view"
        />

    <TextView
        android:id="@+id/text_welcome_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:alpha="0"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="8sp"
        android:maxLines="2"
        android:text="@{ @string/msg_select_route_welcome_user(viewModel.username) }"
        android:textColor="#deffffff"
        android:textSize="24sp"
        android:textStyle="normal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Welcome\nMahinder Singh pal"
        />

    <TextView
        android:id="@+id/text_glad_to_onboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="6sp"
        android:text="@string/msg_glad_to_onboard"
        android:textColor="#deffffff"
        android:textSize="14sp"
        android:textStyle="normal"
        app:layout_constraintStart_toStartOf="@id/text_welcome_user"
        app:layout_constraintTop_toBottomOf="@id/text_welcome_user"
        />

    <android.support.v7.widget.LinearLayoutCompat
        android:id="@+id/container_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="24dp"
        android:layout_marginStart="24dp"
        android:alpha="0"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        >

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:text="@string/label_which_routes_you_serve"
          android:textColor="#de000000"
          android:textSize="20sp"
          android:textStyle="normal"
          />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:fontFamily="sans-serif"
          android:lineSpacingExtra="6sp"
          android:text="@string/msg_select_route_pref_to_load"
          android:textColor="#de000000"
          android:textSize="14sp"
          android:textStyle="normal"
          />

      <android.support.v7.widget.AppCompatButton
          android:id="@+id/btn_select_route"
          android:layout_width="match_parent"
          android:layout_marginTop="24dp"
          android:text="@string/action_select_routes"
          bind:shadow="@{ @dimen/action_btn_elevation }"
          style="@style/ActionButton"
          />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:layout_marginTop="16dp"
          android:fontFamily="sans-serif"
          android:gravity="center_horizontal"
          android:letterSpacing="0.01"
          android:lineSpacingExtra="6sp"
          android:padding="8dp"
          android:text="@string/action_skip_select_routes"
          android:textColor="#8a000000"
          android:textSize="12sp"
          android:textStyle="normal"
          />
    </android.support.v7.widget.LinearLayoutCompat>
  </android.support.constraint.ConstraintLayout>
</layout>