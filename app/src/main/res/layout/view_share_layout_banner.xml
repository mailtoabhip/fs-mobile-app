<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:autofit="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="title"
        type="String"
        />

    <variable
        name="subTitle"
        type="String"
        />

    <variable
        name="actionLabel"
        type="String"
        />

  </data>
  <androidx.cardview.widget.CardView
      android:id="@+id/share_rate_card"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/size_2dp"
      android:layout_marginTop="@dimen/size_10dp"
      android:layout_marginBottom="@dimen/size_10dp"
      android:clickable="true"
      android:focusable="true"
      android:foreground="?attr/selectableItemBackgroundBorderless"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="@dimen/size_2dp"
      >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/truck_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/banner_bg"
        android:orientation="horizontal"
        android:paddingStart="@dimen/size_8dp"
        android:paddingBottom="@dimen/size_16dp"
        android:visibility="visible">

      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/img_priority_access"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          android:layout_alignParentRight="true"
          app:layout_constraintRight_toLeftOf="@+id/label_text"
          bind:srcCompat="@drawable/ic_ratebanner_icon" />

      <androidx.appcompat.widget.LinearLayoutCompat
          android:id="@+id/label_text"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_centerHorizontal="true"
          android:layout_marginStart="@dimen/size_16dp"
          android:layout_marginTop="@dimen/size_16dp"
          android:orientation="vertical"
          app:layout_constraintStart_toStartOf="parent"
          bind:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toStartOf="@+id/img_priority_access"
          bind:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_share_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_4dp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="6sp"
            android:text="@{title}"
            android:textColor="@color/white"
            android:textSize="@dimen/text_16sp" />
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:orientation="horizontal"
            android:layout_height="wrap_content">
          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/text_share"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="sans-serif-medium"
              android:text="@{actionLabel}"
              android:textColor="@color/white"
              android:textSize="@dimen/text_24sp" />
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sharing_rate_rupee"
            android:textColor="@color/white"
            android:textSize="@dimen/text_16sp" />
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_share_sub_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="@dimen/size_12dp"
            android:text="@{subTitle}"
            android:textColor="@color/white"
            android:textSize="@dimen/text_12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/share_button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingRight="@dimen/size_40dp"
            android:paddingLeft="@dimen/size_40dp"
            android:background="@drawable/bg_all_round_corner_white"
            android:fontFamily="sans-serif-medium"
            android:text="@string/share_rate"
            android:textColor="@color/blue"
            android:textSize="@dimen/text_12sp" />

      </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
  </androidx.cardview.widget.CardView>
</layout>