<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="request"
            type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData"
            />

        <import type="android.view.View" />
    </data>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_top_round_corner_pure_white">

<androidx.appcompat.widget.AppCompatTextView
    android:id="@+id/title"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/title_submit_details"
    android:fontFamily="sans-serif-medium"
    android:textSize="@dimen/text_16sp"
    android:textStyle="bold"
    android:textColor="@color/heading_black"
    android:paddingTop="@dimen/size_12dp"
    android:paddingBottom="@dimen/size_12dp"
    android:paddingStart="@dimen/size_16dp"
    android:paddingEnd="@dimen/size_16dp"
    />
<androidx.appcompat.widget.AppCompatImageView
    android:id="@+id/close"
    app:layout_constraintTop_toTopOf="@id/title"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toBottomOf="@+id/title"
    android:layout_width="@dimen/size_24dp"
    android:layout_height="@dimen/size_24dp"
    android:layout_marginEnd="@dimen/size_12dp"
    android:src="@drawable/ic_close_dark_grey"
    />

 <androidx.constraintlayout.widget.ConstraintLayout
     android:id="@+id/cl_transaction_info"
     app:layout_constraintTop_toBottomOf="@+id/title"
     app:layout_constraintStart_toStartOf="parent"
     android:background="@color/light_blue"
     android:layout_width="match_parent"
     android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
     android:id="@+id/nepRequired"
     android:paddingEnd="@dimen/size_16dp"
     android:textColor="@color/heading_black"
     android:textSize="@dimen/text_12sp"
     android:fontFamily="sans-serif-medium"
     android:layout_marginTop="@dimen/size_10dp"
     android:layout_marginStart="@dimen/size_16dp"
     android:layout_marginEnd="@dimen/size_16dp"
     android:background="@drawable/bg_all_round_corner_white"
     android:drawableStart="@drawable/warning_icon"
     android:drawablePadding="@dimen/size_4dp"
     android:text="@{@string/entry_permit_for_required(request.nepState)}"
     tools:hint="Entry permit for Haryana required"
     android:padding="@dimen/size_2dp"
     android:visibility="@{request.isNEPrequired()}"
     app:layout_constraintTop_toTopOf="parent"
     app:layout_constraintStart_toStartOf="parent"
     android:layout_width="wrap_content"
     android:layout_height="wrap_content"/>
     <include
         app:layout_constraintTop_toBottomOf="@+id/nepRequired"
         app:layout_constraintStart_toStartOf="parent"
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:id="@+id/layout_transaction"
         layout="@layout/view_intracity_adhoc_transactional_info"/>

     <View
         android:id="@+id/divider"
         app:layout_constraintTop_toBottomOf="@+id/layout_transaction"
         app:layout_constraintStart_toStartOf="parent"
         android:background="@color/bg_grey"
         android:layout_marginLeft="@dimen/size_16dp"
         android:layout_marginRight="@dimen/size_16dp"
         android:layout_width="match_parent"
         android:layout_height="@dimen/size_2dp"/>
     <androidx.appcompat.widget.AppCompatTextView
         android:id="@+id/targetPrice"
         android:paddingEnd="@dimen/size_16dp"
         android:textColor="@color/faded_black"
         android:textSize="@dimen/text_16sp"
         android:fontFamily="sans-serif-medium"
         android:textStyle="bold"
         android:drawablePadding="@dimen/size_4dp"
         android:text="@{request.formatedTargetPrice()}"
         tools:hint="₹ 10000"
         android:paddingStart="@dimen/size_16dp"
         app:layout_constraintTop_toTopOf="@+id/additionalKmInfo"
         app:layout_constraintBottom_toBottomOf="@+id/additionalKmInfo"
         app:layout_constraintStart_toStartOf="parent"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"/>

     <androidx.appcompat.widget.AppCompatTextView
         android:id="@+id/additionalKmInfo"
         android:paddingTop="@dimen/size_12dp"
         android:paddingStart="@dimen/size_16dp"
         android:paddingBottom="@dimen/size_12dp"
         android:paddingEnd="@dimen/size_16dp"
         android:textColor="@color/faded_black"
         android:textSize="@dimen/text_12sp"
         android:drawablePadding="@dimen/size_4dp"
         android:fontFamily="sans-serif"
         android:text="@{request.additionalKMsRates()}"
         android:drawableStart="@drawable/ic_money_summary"
         tools:hint="₹10 per extra KM | ₹200 per extra Hr"
         app:layout_constraintTop_toBottomOf="@+id/divider"
         app:layout_constraintEnd_toEndOf="parent"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"/>

 </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/label_vehicle_number"
        android:text="@string/vehicle_number"
        android:layout_marginTop="@dimen/size_20dp"
        app:layout_constraintTop_toBottomOf="@+id/cl_transaction_info"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:textSize="@dimen/text_14sp"
        android:textColor="@color/heading_black"
        android:layout_marginLeft="@dimen/size_16dp"
        android:layout_marginRight="@dimen/size_16dp"
        android:layout_height="wrap_content"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/edit_text_vehicle_number"
        app:layout_constraintTop_toBottomOf="@+id/label_vehicle_number"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="match_parent"
        android:textSize="@dimen/text_16sp"
        android:inputType="textCapCharacters"
        android:layout_marginTop="@dimen/size_8dp"
        android:layout_marginLeft="@dimen/size_16dp"
        android:layout_marginRight="@dimen/size_16dp"
        android:background="@drawable/bg_login_edit"
        android:layout_height="@dimen/size_42dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/vehicleNumberError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/edit_text_vehicle_number"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@color/bid_error"
        android:padding="@dimen/size_2dp"
        android:textSize="@dimen/text_12sp"
        android:visibility="gone"
        android:layout_marginStart="@dimen/size_12dp"
        android:text="Please enter valid vehicle number"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/label_driver_name"
        android:text="@string/label_driver_name"
        app:layout_constraintTop_toBottomOf="@+id/vehicleNumberError"
        app:layout_constraintStart_toStartOf="parent"
        android:textSize="@dimen/text_14sp"
        android:layout_marginTop="@dimen/size_8dp"
        android:textColor="@color/heading_black"
        android:layout_marginLeft="@dimen/size_16dp"
        android:layout_marginRight="@dimen/size_16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/editTextDriverName"
        app:layout_constraintTop_toBottomOf="@+id/label_driver_name"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/size_8dp"
        android:layout_marginLeft="@dimen/size_16dp"
        android:layout_marginRight="@dimen/size_16dp"
        android:digits="@string/allowed_char_name"
        android:textSize="@dimen/text_16sp"
        android:inputType="text"
        android:layout_width="match_parent"
        android:background="@drawable/bg_login_edit"
        android:layout_height="@dimen/size_42dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/driverNameError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/editTextDriverName"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@color/bid_error"
        android:padding="@dimen/size_2dp"
        android:textSize="@dimen/text_12sp"
        android:visibility="gone"
        android:layout_marginStart="@dimen/size_12dp"
        android:text="Please enter valid driver number"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/label_driver_number"
        android:text="@string/label_driver_number"
        android:layout_marginTop="@dimen/size_8dp"
        android:textSize="@dimen/text_14sp"
        android:textColor="@color/heading_black"
        android:layout_marginLeft="@dimen/size_16dp"
        android:layout_marginRight="@dimen/size_16dp"
        app:layout_constraintTop_toBottomOf="@+id/driverNameError"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/editTextDriverNumber"
        android:inputType="number"
        android:maxLength="10"
        android:background="@drawable/bg_login_edit"
        app:layout_constraintTop_toBottomOf="@+id/label_driver_number"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/size_8dp"
        android:layout_marginLeft="@dimen/size_16dp"
        android:layout_marginRight="@dimen/size_16dp"
        android:textSize="@dimen/text_16sp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_42dp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/driverNumberError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/editTextDriverNumber"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@color/bid_error"
        android:padding="@dimen/size_2dp"
        android:textSize="@dimen/text_12sp"
        android:visibility="gone"
        android:layout_marginStart="@dimen/size_12dp"
        android:text="Please enter a valid driver number"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_submit"
        style="@style/SubmitButton"
        android:enabled="false"
        android:textAllCaps="false"
        android:layout_marginEnd="@dimen/size_16dp"
        android:layout_marginStart="@dimen/size_16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/driverNumberError"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/size_20dp"
        android:text="@string/action_submit"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/label_acceptance"
        android:text="@string/acceptance_declaration"
        android:layout_marginTop="@dimen/size_8dp"
        android:textSize="@dimen/text_12sp"
        android:textAlignment="center"
        android:textColor="@color/faded_black"
        android:paddingStart="@dimen/size_14dp"
        android:paddingEnd="@dimen/size_14dp"
        android:paddingBottom="@dimen/size_12dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_submit"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:elevation="@dimen/size_16dp"
        android:clickable="false"
        android:visibility="visible"
        style="?android:attr/progressBarStyleLarge"
        />
    <TextView
        android:id="@+id/progress_msg"
        android:textColor="@color/heading_black"
        app:layout_constraintTop_toBottomOf="@+id/progress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="@dimen/text_18sp"
        android:textStyle="bold"
        android:visibility="visible"
        android:text="Accepting your indent, hold on!"
        android:elevation="@dimen/size_16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>