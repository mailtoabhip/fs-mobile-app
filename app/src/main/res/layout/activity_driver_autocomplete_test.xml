<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.delhivery.axle.ui.test.DriverAutocompleteTestViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver Autocomplete Test"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/label_vehicle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehicle Number:"
            android:textSize="16sp"
            android:textColor="#666666"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/edit_vehicle_number"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:hint="Enter vehicle number (e.g., MP09QT0001)"
            android:inputType="textCapCharacters"
            android:background="@drawable/bg_login_edit"
            android:padding="12dp"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@+id/label_vehicle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/label_driver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver Name:"
            android:textSize="16sp"
            android:textColor="#666666"
            app:layout_constraintTop_toBottomOf="@+id/edit_vehicle_number"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="24dp" />

        <com.delhivery.axle.ui.custom.DelhiveryDriverNameAutoEditText
            android:id="@+id/edit_driver_name"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:hint="Enter driver name to see suggestions"
            android:inputType="textCapCharacters"
            android:background="@drawable/bg_login_edit"
            android:padding="12dp"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@+id/label_driver"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/text_driver_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Enter driver name to see suggestions..."
            android:textSize="14sp"
            android:textColor="#666666"
            android:background="@drawable/bg_login_edit"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/edit_driver_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/text_instructions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Test Instructions:\n1. Enter a vehicle number (e.g., MP09QT0001, MP09QT0002, etc.)\n2. Start typing a driver name to see autocomplete suggestions\n3. Select a driver from the dropdown\n4. Try different vehicle numbers to see different driver lists"
            android:textSize="12sp"
            android:textColor="#999999"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@+id/text_driver_info"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_test_vehicle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test with MP09QT0001"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/text_instructions"
            app:layout_constraintStart_toStartOf="parent"
            android:onClick="onTestVehicleClick" />

        <Button
            android:id="@+id/btn_test_vehicle2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Test with MP09QT0002"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/text_instructions"
            app:layout_constraintEnd_toEndOf="parent"
            android:onClick="onTestVehicle2Click" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
