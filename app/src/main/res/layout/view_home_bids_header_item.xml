<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="myBids"
        type="String"
        />
    <variable
        name="confirmedBids"
        type="String"
        />
  </data>
  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      >

    <View
        android:id="@+id/center_view"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_centerHorizontal="true"
        android:layout_margin="4dp"
        />

    <android.support.v7.widget.LinearLayoutCompat
        android:id="@+id/view_my_bids"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_toStartOf="@id/center_view"
        android:background="@drawable/bg_my_bids_gradient"
        android:orientation="vertical"
        android:padding="16dp"
        bind:shadow="@{ @dimen/action_btn_elevation }"
        >

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:lineSpacingExtra="6sp"
          android:text="@string/label_my_bids"
          android:textColor="#ffffff"
          android:textSize="14sp"
          android:textStyle="normal"
          />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:fontFamily="sans-serif-medium"
          android:text="@{ myBids }"
          android:textColor="#ffffff"
          android:textSize="24sp"
          android:textStyle="normal"
          tools:text="0"
          />
    </android.support.v7.widget.LinearLayoutCompat>

    <android.support.v7.widget.LinearLayoutCompat
        android:id="@+id/view_confirmed_bids"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="16dp"
        android:layout_toEndOf="@id/center_view"
        android:background="@drawable/bg_confirmed_bids_gradient"
        android:orientation="vertical"
        android:padding="16dp"
        bind:shadow="@{ @dimen/action_btn_elevation }"
        >

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:lineSpacingExtra="6sp"
          android:text="@string/label_confirmed_bids"
          android:textColor="#ffffff"
          android:textSize="14sp"
          android:textStyle="normal"
          />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:fontFamily="sans-serif-medium"
          android:text="@{ confirmedBids }"
          android:textColor="#ffffff"
          android:textSize="24sp"
          android:textStyle="normal"
          tools:text="0"
          />
    </android.support.v7.widget.LinearLayoutCompat>
  </RelativeLayout>
</layout>