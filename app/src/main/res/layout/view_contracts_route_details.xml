<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/white">
  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/routeDetails"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      android:visibility="gone">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/routeScheduleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/route_schedule"
        android:textSize="@dimen/text_16sp"
        android:textColor="@color/background_dark_grey"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textStyle="bold"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvContracts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/routeScheduleLabel"/>
  </androidx.constraintlayout.widget.ConstraintLayout>
  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/nonExpRouteDetails"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"
      tools:visibility="gone"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpRouteScheduleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/background_dark_grey"
        android:text="@string/route_details"
        android:textSize="@dimen/text_16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textStyle="bold"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/nonExpHubIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ic_hub_route"
        app:layout_constraintStart_toStartOf="parent"
        android:paddingEnd="@dimen/size_4dp"
        app:layout_constraintTop_toTopOf="@+id/nonExpTvHubCity"
        app:layout_constraintBottom_toBottomOf="@id/nonExpTvState"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpTvHubCity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/nonExpHubIcon"
        app:layout_constraintTop_toBottomOf="@+id/nonExpRouteScheduleLabel"
        android:textSize="@dimen/text_14sp"
        android:textColor="@color/heading_black"
        android:layout_marginTop="@dimen/size_10dp"
        tools:text="HUL Pvt. Ltd."/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpTvCity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/nonExpTvHubCity"
        app:layout_constraintStart_toEndOf="@+id/nonExpHubIcon"
        app:layout_constraintTop_toBottomOf="@+id/nonExpTvHubCity"
        android:textSize="@dimen/text_12sp"
        android:textColor="@color/heading_black"
        tools:text="Haryana"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpTvState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/nonExpTvCity"
        app:layout_constraintTop_toBottomOf="@+id/nonExpTvHubCity"
        android:textSize="@dimen/text_12sp"
        android:textColor="@color/color_hint"
        tools:text="Haryana"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/nonExpLineSep1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:srcCompat="@drawable/ic_line_double_arrow"
        app:layout_constraintTop_toBottomOf="@+id/nonExpTvState"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/nonExpHubIcon"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clNonExpTimeInterval1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_all_round_corner_light_blue"
        app:layout_constraintStart_toStartOf="@+id/nonExpTvHubCity"
        app:layout_constraintTop_toTopOf="@id/nonExpLineSep1"
        app:layout_constraintBottom_toBottomOf="@id/nonExpLineSep1"
        android:paddingStart="@dimen/size_12dp"
        android:paddingEnd="@dimen/size_12dp"
        android:paddingTop="@dimen/size_6dp"
        android:paddingBottom="@dimen/size_6dp">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpTimeInterval1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:textSize="@dimen/text_14sp"
        android:textColor="@color/dark_blue"
        android:textStyle="bold"
        tools:text="30 Trips for 4 weeks"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/nonExpHubIcon2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ic_hub_route"
        app:layout_constraintStart_toStartOf="parent"
        android:paddingEnd="@dimen/size_4dp"
        app:layout_constraintTop_toTopOf="@+id/nonExpTvHubCity2"
        app:layout_constraintBottom_toBottomOf="@id/nonExpTvState2"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpTvHubCity2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/nonExpHubIcon2"
        app:layout_constraintTop_toBottomOf="@+id/nonExpLineSep1"
        android:textSize="@dimen/text_14sp"
        android:textColor="@color/heading_black"
        android:layout_marginTop="@dimen/size_10dp"
        tools:text="Gurgaon_Tauru_GW"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/nonExpTvState2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/nonExpTvHubCity2"
        app:layout_constraintStart_toEndOf="@+id/nonExpHubIcon2"
        app:layout_constraintTop_toBottomOf="@+id/nonExpTvHubCity2"
        android:textSize="@dimen/text_12sp"
        android:textColor="@color/color_hint"
        tools:text="Haryana"/>

  </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/intraCityRouteDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/intraCityRouteScheduleLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="@color/background_dark_grey"
          android:text="@string/reporting_center"
          android:textSize="@dimen/text_16sp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          android:textStyle="bold"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/fixedIntracityTv"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintEnd_toEndOf="parent"
          android:text="@string/action_fixed_intracity"
          android:paddingTop="@dimen/size_6dp"
          android:drawableStart="@drawable/ic_place"
          android:drawablePadding="@dimen/size_8dp"
          android:layout_marginStart="@dimen/size_8dp"
          android:paddingBottom="@dimen/size_6dp"
          android:paddingStart="@dimen/size_10dp"
          android:paddingEnd="@dimen/size_12dp"
          android:background="@drawable/bg_all_round_corner_red_solid_selector"
          app:layout_constraintTop_toTopOf="parent"
          />
      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/intraCityHubIcon"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:srcCompat="@drawable/ic_hub_route"
          app:layout_constraintStart_toStartOf="parent"
          android:paddingEnd="@dimen/size_4dp"
          app:layout_constraintTop_toTopOf="@+id/intraCityTvHubCity"
          app:layout_constraintBottom_toBottomOf="@id/intraCityTvState"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/intraCityTvHubCity"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintStart_toEndOf="@+id/intraCityHubIcon"
          app:layout_constraintTop_toBottomOf="@+id/intraCityRouteScheduleLabel"
          android:textSize="@dimen/text_14sp"
          android:textColor="@color/heading_black"
          android:layout_marginTop="@dimen/size_10dp"
          tools:text="HUL Pvt. Ltd."/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/intraCityTvCity"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintStart_toStartOf="@id/intraCityTvHubCity"
          app:layout_constraintStart_toEndOf="@+id/intraCityHubIcon"
          app:layout_constraintTop_toBottomOf="@+id/intraCityTvHubCity"
          android:textSize="@dimen/text_12sp"
          android:textColor="@color/color_hint"
          tools:text="Hisag "/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/intraCityTvState"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintStart_toStartOf="@id/intraCityTvCity"
          app:layout_constraintStart_toEndOf="@+id/intraCityHubIcon"
          app:layout_constraintTop_toBottomOf="@+id/intraCityTvCity"
          android:textSize="@dimen/text_12sp"
          android:textColor="@color/heading_black"
          tools:text="Haryana"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/intraCityTvMapView"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:drawableStart="@drawable/ic_navigate"
          app:layout_constraintStart_toStartOf="@id/intraCityTvCity"
          app:layout_constraintStart_toEndOf="@+id/intraCityHubIcon"
          app:layout_constraintTop_toBottomOf="@+id/intraCityTvState"
          android:textColor="@color/dark_blue"
          android:paddingTop="@dimen/size_2dp"
          android:paddingBottom="@dimen/size_2dp"
          android:paddingEnd="@dimen/size_8dp"
          android:textSize="@dimen/text_12sp"
          android:text="@string/view_on_map"
          tools:text="@string/view_on_map"/>
      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/intraCityReportingIcon"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:srcCompat="@drawable/ic_time"
          app:layout_constraintStart_toStartOf="parent"
          android:paddingEnd="@dimen/size_4dp"
          app:layout_constraintTop_toTopOf="@+id/intraCityReportingTime"
          app:layout_constraintBottom_toBottomOf="@id/intraCityReportingTv"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/intraCityReportingTime"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintStart_toEndOf="@+id/intraCityReportingIcon"
          app:layout_constraintTop_toBottomOf="@+id/intraCityTvMapView"
          android:textSize="@dimen/text_14sp"
          android:textColor="@color/heading_black"
          android:layout_marginTop="@dimen/size_10dp"
          tools:text="10:30 AM"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/intraCityReportingTv"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintStart_toStartOf="@id/intraCityReportingTime"
          app:layout_constraintStart_toEndOf="@+id/intraCityReportingIcon"
          app:layout_constraintTop_toBottomOf="@+id/intraCityReportingTime"
          android:textSize="@dimen/text_12sp"
          android:text="@string/reporting_time"
          android:textColor="@color/color_hint"
          tools:text="Reporting Time"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/intraCityAdHocRouteDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/intraCityAdHocRouteScheduleLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="@color/background_dark_grey"
          android:text="@string/reporting_center"
          android:textSize="@dimen/text_16sp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          android:textStyle="bold"/>
      <androidx.appcompat.widget.AppCompatTextView
          android:id="@+id/flexibleIntracityTv"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:layout_constraintEnd_toEndOf="parent"
          android:text="@string/action_flexible_intracity"
          android:paddingTop="@dimen/size_6dp"
          android:drawableStart="@drawable/ic_multiple_location"
          android:drawablePadding="8dp"
          android:layout_marginStart="@dimen/size_8dp"
          android:paddingBottom="@dimen/size_6dp"
          android:paddingStart="@dimen/size_10dp"
          android:paddingEnd="@dimen/size_12dp"
          android:background="@drawable/bg_all_round_corner_red_solid_selector"
          app:layout_constraintTop_toTopOf="parent"
          />
      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rvIntracityFlexibleContracts"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@+id/intraCityAdHocRouteScheduleLabel"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>