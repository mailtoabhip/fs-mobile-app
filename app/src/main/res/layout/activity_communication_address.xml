<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="viewModel"
            type="com.delhivery.axle.ui.kyc.address.CommunicationAddressViewModel"
            />
        <import type="android.view.View" />
    </data>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blue_bg"
        android:orientation="vertical">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_toolbar"
            />
          <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/size_24dp"
            android:paddingEnd="@dimen/size_24dp"
            android:paddingBottom="@dimen/size_24dp">
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:id="@+id/progress"
                android:layout_marginBottom="@dimen/size_24dp"
                bind:layout_constraintTop_toTopOf="parent"
                android:max="100"
                android:progressDrawable="@drawable/account_progress" />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/step_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/progress"
                android:text="@{viewModel.currentStep}"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_16sp"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/address_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/step_text"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                android:text="@string/label_communication_address"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_24sp"
                android:textStyle="bold"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/aadhaar_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/address_text"
                android:text="@string/sub_label_communication_details"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_16sp"
                />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    bind:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="@dimen/size_32dp"
                    bind:layout_constraintTop_toBottomOf="@+id/aadhaar_hint"
                    android:orientation="vertical">
                        <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                            android:id="@+id/edit_flat"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/edit_text_height"
                            android:background="@drawable/bg_login_edit"
                            bind:layout_constraintStart_toStartOf="parent"
                            bind:layout_constraintTop_toBottomOf="parent"
                            android:inputType="text"
                            android:singleLine="true"
                            android:paddingStart="@dimen/size_12dp"
                            android:paddingEnd="@dimen/size_12dp"
                            android:hint="@string/flat_hint"
                            android:textColor="@color/heading_black"
                            android:textSize="@dimen/text_16sp"
                            android:text="@={ viewModel.flatAddress }"
                            />
                        <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                            android:id="@+id/edit_area"
                            android:layout_marginTop="@dimen/size_24dp"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/edit_text_height"
                            android:background="@drawable/bg_login_edit"
                            bind:layout_constraintStart_toStartOf="parent"
                            bind:layout_constraintTop_toBottomOf="parent"
                            android:inputType="text"
                            android:singleLine="true"
                            android:paddingStart="@dimen/size_12dp"
                            android:paddingEnd="@dimen/size_12dp"
                            android:hint="@string/area_hint"
                            android:textColor="@color/heading_black"
                            android:textSize="@dimen/text_16sp"
                            android:text="@={ viewModel.areaAddress }"
                            />
                        <com.delhivery.axle.ui.custom.DelhiveryCityAutoEditText
                            android:id="@+id/auto_complete_city"
                            android:layout_width="match_parent"
                            android:layout_marginTop="@dimen/size_24dp"
                            android:layout_height="@dimen/edit_text_height"
                            android:background="@drawable/bg_login_edit"
                            bind:layout_constraintStart_toStartOf="parent"
                            bind:layout_constraintTop_toBottomOf="parent"
                            android:singleLine="true"
                            android:inputType="text"
                            android:paddingStart="@dimen/size_12dp"
                            android:paddingEnd="@dimen/size_12dp"
                            android:hint="@string/city_hint"
                            android:textColor="@color/heading_black"
                            android:textSize="@dimen/text_16sp"
                            android:text="@={ viewModel.cityAddress }"
                            />
                        <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                            android:id="@+id/edit_pincode"
                            android:layout_width="match_parent"
                            android:layout_marginTop="@dimen/size_24dp"
                            android:layout_height="@dimen/edit_text_height"
                            android:background="@drawable/bg_login_edit"
                            bind:layout_constraintStart_toStartOf="parent"
                            bind:layout_constraintTop_toBottomOf="parent"
                            android:digits="1234567890"
                            android:inputType="number"
                            android:maxLength="6"
                            android:paddingStart="@dimen/size_12dp"
                            android:paddingEnd="@dimen/size_12dp"
                            android:hint="@string/pincode_hint"
                            android:textColor="@color/heading_black"
                            android:textSize="@dimen/text_16sp"
                            bind:state_error="false"
                            android:text="@={ viewModel.pincodeAddress }"
                            />
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_marginTop="@dimen/size_24dp"
                            android:layout_height="@dimen/edit_text_height"
                            android:background="@drawable/bg_login_edit">
                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/spinner_proof"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/edit_text_height"
                            android:background="@drawable/bg_spinner"
                            bind:layout_constraintStart_toStartOf="parent"
                            bind:layout_constraintTop_toTopOf="parent"
                            bind:layout_constraintBottom_toBottomOf="parent"
                            android:spinnerMode="dropdown"
                            android:textColor="@color/heading_black"
                            android:textSize="@dimen/text_16sp"
                            />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/text_proof"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/size_24dp"
                        android:textSize="@dimen/text_14sp"
                        android:textStyle="bold"
                        android:text="@string/address_proof_attachment"
                        />
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/doc_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_16dp">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:id="@+id/upload_doc_lay"
                            android:layout_height="wrap_content"
                            android:visibility="visible"
                            bind:layout_constraintTop_toTopOf="parent"
                            bind:layout_constraintStart_toStartOf="parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/upload_icon"
                            android:layout_width="@dimen/size_16dp"
                            android:layout_height="@dimen/size_20dp"
                            bind:srcCompat="@drawable/ic_upload"
                            android:layout_marginStart="@dimen/size_2dp"
                            bind:layout_constraintTop_toTopOf="parent"
                            bind:layout_constraintLeft_toLeftOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/size_16dp"
                            bind:layout_constraintTop_toTopOf="parent"
                            android:textSize="@dimen/text_16sp"
                            android:textColor="@color/colorAccent"
                            android:textStyle="bold"
                            bind:layout_constraintLeft_toRightOf="@+id/upload_icon"
                            android:text="@string/upload_document"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/doc_uploaded_lay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            bind:layout_constraintTop_toTopOf="parent"
                            bind:layout_constraintStart_toStartOf="parent">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/doc_icon"
                                android:layout_width="@dimen/size_48dp"
                                android:layout_height="@dimen/size_48dp"
                                bind:srcCompat="@drawable/image_placeholder"
                                android:layout_marginStart="@dimen/size_2dp"
                                bind:layout_constraintTop_toTopOf="parent"
                                bind:layout_constraintLeft_toLeftOf="parent"
                                bind:layout_constraintBottom_toBottomOf="parent" />
                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/doc_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/size_16dp"
                                bind:layout_constraintTop_toTopOf="parent"
                                android:textSize="@dimen/text_20sp"
                                bind:layout_constraintLeft_toRightOf="@+id/doc_icon"
                                android:text="IMG_344_98899"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:id="@+id/doc_size"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/size_16dp"
                                bind:layout_constraintTop_toBottomOf="@+id/doc_title"
                                android:textSize="@dimen/text_16sp"
                                android:textColor="@color/color_hint"
                                bind:layout_constraintLeft_toRightOf="@+id/doc_icon"
                                android:text="233kb"/>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/doc_remove"
                                android:layout_width="@dimen/size_20dp"
                                android:layout_height="@dimen/size_20dp"
                                bind:srcCompat="@drawable/ic_remove"
                                android:layout_marginStart="@dimen/size_2dp"
                                bind:layout_constraintTop_toTopOf="parent"
                                bind:layout_constraintBottom_toBottomOf="parent"
                                bind:layout_constraintRight_toRightOf="parent"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_submit_details"
                        style="@style/ActionButton"
                        android:enabled="false"
                        android:textAllCaps="false"
                        android:layout_alignParentBottom="true"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/size_32dp"
                        android:text="@string/action_submit_details"
                        />
                </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>
