<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="viewModel"
            type="com.delhivery.axle.ui.businessverification.BusinessVerificationViewModel"
            />
        <import type="android.view.View" />

    </data>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blue_bg"
        android:orientation="vertical">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blue_bg"
        android:orientation="vertical">

        <include
            android:id="@+id/progress_step_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/view_progress_steps"
            android:layout_marginBottom="@dimen/size_24dp"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">



        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/size_24dp"
            android:paddingEnd="@dimen/size_24dp"
            android:paddingBottom="@dimen/size_48dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/step_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toTopOf="parent"
                android:text="@{viewModel.currentStep}"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_12sp"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/business_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/step_text"
                android:layout_marginTop="@dimen/size_8dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                android:text="@string/label_business"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/business_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/business_text"
                android:text="@string/sub_label_business_details"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_14sp"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/business_error"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:drawableLeft="@drawable/ic_vector_error"
                android:drawablePadding="@dimen/size_8dp"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/business_hint"
                android:text="@{viewModel.errorText}"
                android:textColor="@color/destructive_red"
                android:textSize="@dimen/text_16sp"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/owned_trucks_textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:layout_marginTop="@dimen/size_32dp"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/business_error"
                android:text="@string/sub_label_no_of_trucks"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_16sp"
                />
            <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                android:id="@+id/owned_trucks_edittext"
                android:layout_width="match_parent"
                android:layout_height="@dimen/edit_text_height"
                android:imeOptions="actionDone"
                android:layout_marginTop="@dimen/size_8dp"
                android:inputType="number"
                android:text="@{viewModel.ownedTruck}"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/owned_trucks_textView"
                android:paddingStart="@dimen/size_12dp"
                android:paddingEnd="@dimen/size_12dp"
                android:hint="@string/hint_owned_truck"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/attached_trucks_textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:layout_marginTop="@dimen/size_16dp"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/owned_trucks_edittext"
                android:text="@string/sub_label_no_of_attached_trucks"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_16sp"
                />
            <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                android:id="@+id/attached_trucks_edittext"
                android:layout_width="match_parent"
                android:layout_height="@dimen/edit_text_height"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:text="@{viewModel.attachedTruck}"
                android:layout_marginTop="@dimen/size_8dp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/attached_trucks_textView"
                android:paddingStart="@dimen/size_12dp"
                android:paddingEnd="@dimen/size_12dp"
                android:hint="@string/hint_attached_truck"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_16sp"

                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/verification_method_textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:layout_marginTop="@dimen/size_16dp"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/attached_trucks_edittext"
                android:text="@string/sub_label_verification_method"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_16sp"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/verification_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:layout_marginTop="@dimen/size_8dp"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/verification_method_textView"
                android:text="@string/sub_label_verification_method_desc"
                android:textColor="@color/sub_details_grey"
                android:textSize="@dimen/text_12sp"
                />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:id="@+id/radio_lay"
                bind:layout_constraintTop_toBottomOf="@+id/verification_desc"
                android:layout_height="wrap_content">
                <RadioButton
                    android:id="@+id/text_truck"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/edit_text_height"
                    android:clickable="true"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toTopOf="parent"
                    android:maxLength="20"
                    android:paddingStart="@dimen/size_12dp"
                    android:paddingEnd="@dimen/size_12dp"
                    android:text="@string/truck_hint"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_16sp"
                    />
                <RadioButton
                    android:id="@+id/text_LR"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edit_text_height"
                    bind:layout_constraintStart_toEndOf="@id/text_truck"
                    android:maxLength="20"
                    android:clickable="true"
                    android:text="@string/lr_hint"
                    android:paddingStart="@dimen/size_12dp"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_16sp"
                    />

            </androidx.appcompat.widget.LinearLayoutCompat>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/truck_edit_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_8dp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/radio_lay"
                >


                <androidx.constraintlayout.widget.ConstraintLayout

                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:id="@+id/layout_truckrd"
                    android:padding="@dimen/size_1dp"
                    bind:layout_constraintTop_toTopOf="parent"
                    >


                <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                    android:id="@+id/edit_truck"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edit_text_height"
                    android:imeOptions="actionDone"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toTopOf="parent"
                    android:inputType="textCapCharacters"
                    android:maxLength="10"
                    android:paddingStart="@dimen/size_12dp"
                    android:paddingEnd="@dimen/size_12dp"
                    android:hint="@string/truck_hint"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_16sp"
                    android:text="@={ viewModel.truckNumber }"
                    />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/img_wrong"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/edit_text_height"
                    bind:srcCompat="@drawable/ic_wrong"
                    bind:layout_constraintTop_toTopOf="parent"
                    bind:layout_constraintEnd_toEndOf="parent"
                    bind:layout_constraintBottom_toBottomOf="parent"
                    android:visibility="gone"
                    android:paddingStart="@dimen/size_12dp"
                    android:paddingEnd="@dimen/size_12dp" />
            </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    bind:layout_constraintTop_toBottomOf="@+id/layout_truckrd"
                    android:textColor="@color/destructive_red"
                    android:visibility="gone"
                    android:id="@+id/rc_error_msg"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
           <androidx.constraintlayout.widget.ConstraintLayout
               android:layout_width="match_parent"
               android:id="@+id/upload_lay"
               android:layout_height="wrap_content"
               bind:layout_constraintTop_toBottomOf="@+id/truck_edit_layout"
               bind:layout_constraintStart_toStartOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:id="@+id/layout_upload_LR"
                android:visibility="gone"
                android:layout_height="wrap_content"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintEnd_toEndOf="parent"
                bind:layout_constraintBottom_toBottomOf="parent"

                >
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/upload_icon"
                    android:layout_width="@dimen/size_16dp"
                    android:layout_height="@dimen/size_20dp"
                    bind:srcCompat="@drawable/ic_upload"
                    android:layout_marginStart="@dimen/size_2dp"
                    bind:layout_constraintTop_toTopOf="parent"
                    bind:layout_constraintLeft_toLeftOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_16dp"
                    bind:layout_constraintTop_toTopOf="parent"
                    android:textSize="@dimen/text_16sp"
                    android:textColor="@color/colorAccent"
                    android:textStyle="bold"
                    bind:layout_constraintLeft_toRightOf="@+id/upload_icon"
                    android:text="@string/upload_document"/>
            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/doc_uploaded_lay"
                android:layout_width="match_parent"
                android:visibility="gone"
                android:layout_height="wrap_content"
                bind:layout_constraintBottom_toBottomOf="parent"
                bind:layout_constraintStart_toStartOf="parent"
                >
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/doc_icon"
                    android:layout_width="@dimen/size_48dp"
                    android:layout_height="@dimen/size_48dp"
                    bind:srcCompat="@drawable/ic_doc_business"
                    android:layout_marginStart="@dimen/size_2dp"
                    bind:layout_constraintTop_toTopOf="parent"
                    bind:layout_constraintLeft_toLeftOf="parent"
                    bind:layout_constraintBottom_toBottomOf="parent" />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/doc_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:layout_marginHorizontal="@dimen/size_16dp"
                    bind:layout_constraintEnd_toStartOf="@+id/doc_remove"
                    bind:layout_constraintTop_toTopOf="parent"
                    android:layout_marginEnd="@dimen/size_30dp"
                    android:textSize="@dimen/text_14sp"
                    bind:layout_constraintStart_toEndOf="@+id/doc_icon"
                    android:text="IMG_344_988"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="0dp"
                    android:id="@+id/doc_size"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_12dp"
                    android:layout_marginTop="@dimen/size_8dp"
                    bind:layout_constraintTop_toBottomOf="@+id/doc_title"
                    android:textSize="@dimen/size_12dp"
                    android:textColor="@color/color_hint"
                    bind:layout_constraintLeft_toRightOf="@+id/doc_icon"
                    android:text="233kb"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/doc_remove"
                    android:layout_width="@dimen/size_20dp"
                    android:layout_height="@dimen/size_20dp"
                    bind:srcCompat="@drawable/ic_remove"
                    android:layout_marginStart="@dimen/size_2dp"
                    bind:layout_constraintTop_toTopOf="parent"
                    bind:layout_constraintBottom_toBottomOf="parent"
                    bind:layout_constraintRight_toRightOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
           </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_verify_business"
                style="@style/ActionButton"
                android:layout_marginTop="@dimen/size_16dp"
                bind:layout_constraintTop_toBottomOf="@+id/upload_lay"
                android:enabled="false"
                android:textAllCaps="false"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintBottom_toBottomOf="parent"
                android:layout_alignParentBottom="true"
                android:layout_width="match_parent"
                android:layout_marginBottom="@dimen/size_32dp"
                android:text="@string/action_proceed_account"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>
    </androidx.appcompat.widget.LinearLayoutCompat>

    </RelativeLayout>

</layout>



