<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="viewModel"
            type="com.delhivery.axle.ui.businessverification.BusinessVerificationViewModel"
            />
        <import type="android.view.View" />

    </data>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/blue_bg"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_toolbar"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/size_24dp"
            android:paddingEnd="@dimen/size_24dp"
            android:paddingBottom="@dimen/size_48dp">
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:id="@+id/progress"
                android:layout_marginBottom="@dimen/size_24dp"
                bind:layout_constraintTop_toTopOf="parent"
                android:max="100"
                android:progressDrawable="@drawable/account_progress"
              />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/step_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/progress"
                android:text="@{viewModel.currentStep}"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_16sp"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/business_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/step_text"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                android:text="@string/label_business"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_24sp"
                android:textStyle="bold"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/business_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="@dimen/text_6sp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/business_text"
                android:text="@string/sub_label_business_details"
                android:textColor="@color/sub_heading_black"
                android:textSize="@dimen/text_16sp"
                />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/truck_edit_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_32dp"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/business_hint">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:background="@drawable/bg_all_round_corner_blue_selector"
                    android:id="@+id/layout_truckrd"
                    android:padding="@dimen/size_1dp"
                    bind:layout_constraintTop_toTopOf="parent"
                    >
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        bind:layout_constraintBottom_toBottomOf="parent"
                        android:background="@drawable/bg_login_edit"
                        android:layout_marginTop="@dimen/size_16dp">
                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/text_truck"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edit_text_height"
                    android:clickable="true"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toTopOf="parent"
                    android:maxLength="20"
                    android:paddingStart="@dimen/size_12dp"
                    android:paddingEnd="@dimen/size_12dp"
                    android:text="@string/truck_hint"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_16sp"
                    />
                <com.delhivery.axle.ui.custom.DelhiveryOTPViewEditText
                    android:id="@+id/edit_truck"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/edit_text_height"
                    android:imeOptions="actionDone"
                    bind:layout_constraintStart_toStartOf="parent"
                    bind:layout_constraintTop_toBottomOf="@+id/text_truck"
                    android:inputType="textCapCharacters"
                    android:maxLength="10"
                    android:paddingStart="@dimen/size_12dp"
                    android:paddingEnd="@dimen/size_12dp"
                    android:hint="@string/truck_hint"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_16sp"
                    android:text="@={ viewModel.truckNumber }"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    bind:layout_constraintTop_toBottomOf="@+id/edit_truck"
                    android:textColor="@color/destructive_red"
                    android:visibility="invisible"
                    android:id="@+id/rc_error_msg"
                    />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/layout_uploadLR"
                    android:padding="@dimen/size_1dp"
                    android:background="@drawable/bg_all_round_corner_blue_selector"
                    bind:layout_constraintTop_toBottomOf="@+id/layout_truckrd"
                    android:layout_marginTop="@dimen/size_16dp" >
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        bind:layout_constraintBottom_toBottomOf="parent"
                        android:background="@drawable/bg_login_edit"
                        android:layout_marginTop="@dimen/size_16dp">
                    <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/text_LR"
                    android:layout_width="match_parent"
                    bind:layout_constraintTop_toTopOf="parent"
                    android:layout_height="@dimen/edit_text_height"
                    bind:layout_constraintStart_toStartOf="parent"
                    android:maxLength="20"
                        android:clickable="true"
                    android:text="@string/lr_hint"
                    android:paddingStart="@dimen/size_12dp"
                    android:textColor="@color/heading_black"
                    android:textSize="@dimen/text_16sp"
                    />
                </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_verify_business"
                style="@style/ActionButton"
                android:enabled="false"
                android:textAllCaps="false"
                bind:layout_constraintStart_toStartOf="parent"
                bind:layout_constraintTop_toBottomOf="@+id/truck_edit_layout"
                android:layout_alignParentBottom="true"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/size_32dp"
                android:text="@string/action_save_proceed"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>



