<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />

        <variable
            name="request"
            type="com.dfd.delfin.data.home.bids.HomeBidsRequestItemData" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/closingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:drawablePadding="@dimen/size_4dp"
            tools:text ="Closes in 2 hrs 15 min"
            app:optionalTextColor="@{request}"
            android:text="@{request.formattedLoadAndContractBidEndingTime()}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/load_type_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/size_8dp"
            android:paddingEnd="@dimen/size_8dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_load_type_100dp_corner"
            android:backgroundTint="#F5EFFE"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/closingTime"
            app:layout_constraintBottom_toBottomOf="@id/closingTime">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/demand_load_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_truck_small"
                tools:text="Delhivery Contract"
                android:textSize="@dimen/text_12sp"
                android:drawablePadding="@dimen/size_2dp"
                android:drawableTint="#7C3AED"
                android:textColor="#7C3AED"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>