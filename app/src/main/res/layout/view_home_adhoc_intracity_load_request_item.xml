<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <data>
        <variable
            name="request"
            type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData"
            />

        <import type="android.view.View" />
    </data>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_transaction_info"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="@dimen/size_8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/delhivery_logo"
                android:src="@drawable/ic_delhivery_load"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_grey"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
            <include
                app:layout_constraintTop_toBottomOf="@+id/delhivery_logo"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:id="@+id/layout_transaction"
                layout="@layout/view_intracity_adhoc_transactional_info"/>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/button_navigate"
                android:layout_width="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_transaction"
                android:layout_marginTop="@dimen/size_10dp"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/size_16dp"
                android:paddingEnd="@dimen/size_16dp"
                android:paddingTop="@dimen/size_12dp"
                android:paddingBottom="@dimen/size_12dp"
                app:layout_constraintWidth_percent="0.33"
                android:background="@drawable/bg_all_rounded_blue_corner"
                android:gravity="center"
                android:layout_marginEnd="@dimen/size_12dp"
                android:layout_marginStart="@dimen/size_16dp">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/navigateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/route_heading"
                    android:textSize="@dimen/text_14sp"
                    android:drawablePadding="@dimen/size_10dp"
                    android:text="Navigate"
                    android:drawableStart="@drawable/ic_navigate"
                   />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/btn_accept"
                android:layout_width="0dp"
                app:layout_constraintTop_toTopOf="@+id/button_navigate"
                android:background="@drawable/bg_action_btn"
                android:gravity="center_horizontal"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/size_16dp"
                android:paddingEnd="@dimen/size_16dp"
                android:paddingTop="@dimen/size_12dp"
                android:paddingBottom="@dimen/size_12dp"
                android:layout_marginEnd="@dimen/size_12dp"
                android:layout_marginStart="@dimen/size_16dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/button_navigate"
                app:layout_constraintBottom_toBottomOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/confirmedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/button_text"
                    android:textSize="@dimen/text_16sp"
                    android:drawablePadding="@dimen/size_14dp"
                    android:text="Accept"/>
            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.constraintlayout.widget.ConstraintLayout>
</layout>