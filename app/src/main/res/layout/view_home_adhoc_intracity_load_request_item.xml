<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="request"
            type="com.delhivery.axle.data.home.bids.HomeBidsRequestItemData"
            />

        <import type="android.view.View" />
    </data>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_transaction_info"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="@dimen/size_12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:id="@+id/layout_transaction"
                layout="@layout/view_intracity_adhoc_transactional_info"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/btn_accept"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/size_4dp"
                android:background="@drawable/bg_action_light_blue_btn"
                android:gravity="center_horizontal"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/size_16dp"
                android:paddingEnd="@dimen/size_16dp"
                android:paddingTop="@dimen/size_12dp"
                android:paddingBottom="@dimen/size_12dp"
                android:layout_marginEnd="@dimen/size_12dp"
                android:layout_marginStart="@dimen/size_16dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_transaction"
                app:layout_constraintBottom_toBottomOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/confirmedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorAccent"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="@dimen/text_16sp"
                    android:drawablePadding="@dimen/size_14dp"
                    tools:text="@string/action_accept"
                    android:text="@{ @string/action_accept(request.formatedTargetPrice()) }"/>
            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.constraintlayout.widget.ConstraintLayout>
</layout>