<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
  <data>
    <variable
        name="route"
        type="com.delhivery.axle.data.home.routes.RouteModel"
        />
  </data>

  <androidx.cardview.widget.CardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="@dimen/size_4dp"
      android:layout_marginEnd="@dimen/size_12dp"
      android:layout_marginStart="@dimen/size_12dp"
      android:layout_marginTop="@dimen/size_4dp"
      android:foreground="?attr/selectableItemBackgroundBorderless"
      app:cardBackgroundColor="@color/colorPrimary"
      app:cardCornerRadius="@dimen/size_6dp"
      app:cardElevation="@dimen/size_2dp"
      >

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/size_16dp"
        >

      <ImageView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          app:srcCompat="@drawable/ic_route"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_18dp"
          android:layout_weight="1"
          android:fontFamily="sans-serif"
          android:text="@{ route.origin.cityName() }"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_16sp"
          />

      <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/img_forward"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="@dimen/size_16dp"
          android:layout_marginStart="@dimen/size_16dp"
          app:srcCompat="@drawable/ic_arrow_forward_black"
          />

      <androidx.appcompat.widget.AppCompatTextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="0.75"
          android:fontFamily="sans-serif"
          android:text="@{ route.statesCount() }"
          android:textColor="@color/heading_black"
          android:textSize="@dimen/text_16sp"
          />
    </androidx.appcompat.widget.LinearLayoutCompat>

  </androidx.cardview.widget.CardView>
</layout>