<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="selectedTab"
            type="Integer" />
        <variable
            name="ongoingCount"
            type="Integer" />
        <variable
            name="wonCount"
            type="Integer" />
        <variable
            name="lostCount"
            type="Integer" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/tab_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_all_round_corner_light_grey_v3"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:padding="1sp">

            <TextView
                android:id="@+id/tv_ongoing"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_selector_tab"
                android:gravity="center"
                android:text='@{"Ongoing (" + ongoingCount + ")"}'
                android:textColor='@color/selector_text_color'
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_gravity="center_vertical"
                android:state_selected='@{selectedTab == 0}'
                android:layout_marginEnd="2dp"
                tools:text="OnGoing(10)" />


            <TextView
                android:id="@+id/tv_won"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_selector_tab"
                android:gravity="center"
                android:text='@{"Won (" + wonCount + ")"}'
                android:textColor='@color/selector_text_color'
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_gravity="center_vertical"
                android:state_selected='@{selectedTab == 1}'
                android:layout_marginEnd="2dp"
                tools:text="Won(3)" />

            <TextView
                android:id="@+id/tv_lost"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_selector_tab"
                android:gravity="center"
                android:text='@{"Lost (" + lostCount + ")"}'
                android:textColor='@color/selector_text_color'
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_gravity="center_vertical"
                android:state_selected='@{selectedTab == 2}'
                android:layout_marginEnd="2dp"
                tools:text="Lost(3)" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/search_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/size_16dp"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tab_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_search_black"
                android:tint="@color/color_hint"
                android:layout_marginEnd="8dp"/>
            <EditText
                android:id="@+id/search_bar"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_bar"
                android:hint="Search"
                android:textColor="@color/heading_black"
                android:textSize="18sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:inputType="text"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout> 