<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <!-- Title -->
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Navi Mumbai ➔ Jaisalmer"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bid Amount Input -->
    <EditText
        android:id="@+id/bidAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="₹ 40,000"
        android:inputType="number"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Strong Bid Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/strongBidCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="#ECFDF5"
        app:layout_constraintTop_toBottomOf="@id/bidAmount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/strongBidTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👍 Strong bid"
                android:textColor="#065F46"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/strongBidMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You have high chances of winning!"
                android:textColor="#505361"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <!-- Place Bid Button -->
    <Button
        android:id="@+id/placeBid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Place Bid"
        android:layout_marginTop="16dp"
        android:backgroundTint="#000000"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/strongBidCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/detailsContent"
        layout="@layout/card_truck_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/placeBid"
        tools:visibility="visible"
        />
    <!-- Route Header -->
    <TextView
        android:id="@+id/routeHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Route Details"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/detailsContent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Route List -->
    <LinearLayout
        android:id="@+id/routeList"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/routeHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Navi Mumbai\nNo. 22, Transport Nagar, Sector 15, Turbhe, Navi Mumbai, Maharashtra – 400705"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Ahmedabad\nShree Balaji Logistics Hub, Shed No. 4, Sarkhej-Bavla Highway, Changodar, Ahmedabad, Gujarat – 382213"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Barmer\nThar Freight Terminal, Warehouse No. 7, NH-68, Shivkar Industrial Area, Barmer, Rajasthan – 344001"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Jaisalmer\nRajputana Loading Bay, Opp. Transport Chowk, Indira Colony, Jaisalmer, Rajasthan – 345001"
            android:padding="8dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
