<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <data>

    <variable
        name="actionLabel"
        type="Boolean"
        />

  </data>
  <HorizontalScrollView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:scrollbars="none">
  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_marginTop="@dimen/size_4dp"
      android:layout_marginBottom="@dimen/size_4dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
  <androidx.appcompat.widget.AppCompatTextView
      android:id="@+id/dlvIntracityToggle"
      style="@style/FilterButton"
      app:layout_constraintStart_toStartOf="parent"
      android:text="@string/intracity"
      android:textStyle="bold"
      app:layout_constraintTop_toTopOf="parent"
      />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dlvIntercityToggle"
        style="@style/FilterButton"
        app:layout_constraintStart_toEndOf="@id/dlvIntracityToggle"
        android:text="@string/intercity"
        android:textStyle="bold"
        android:layout_marginStart="@dimen/size_8dp"
        app:layout_constraintTop_toTopOf="parent"
        />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/dlvMarketplaceToggle"
        style="@style/FilterButton"
        app:layout_constraintStart_toEndOf="@id/dlvIntercityToggle"
        android:text="@string/market_place"
        android:textStyle="bold"
        android:layout_marginStart="@dimen/size_8dp"
        app:layout_constraintTop_toTopOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
  </HorizontalScrollView>
</layout>