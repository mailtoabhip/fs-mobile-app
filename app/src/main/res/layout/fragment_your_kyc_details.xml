<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:bind="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:background="@color/white"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:paddingBottom="52dp"
            android:layout_height="wrap_content">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/size_14dp"
        android:orientation="vertical">
       <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_pan"
            android:textColor="@color/heading_black"
            android:layout_marginTop="@dimen/size_10dp"
            android:textStyle="normal"
            android:id="@+id/label_pan"
            android:textSize="@dimen/text_14sp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40dp"
            android:layout_marginTop="@dimen/size_6dp"
            android:layout_gravity="center"
            android:padding="@dimen/size_4dp"
            android:id="@+id/panLay"
            android:background="@drawable/bg_all_round_corner_blue_selector_red">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_kyc_pan_number_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/size_6dp"
                android:textSize="@dimen/text_16sp"
                android:textColor="@color/faded_black"
                android:layout_weight="1"
                tools:text="DZPBE2087Q"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image_kyc_detail_pan_verified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_vector_circle_check"
                android:layout_marginEnd="@dimen/size_6dp"
                android:layout_gravity="center"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/error_red"
            android:layout_marginTop="4dp"
            android:textStyle="normal"
            android:visibility="gone"
            android:id="@+id/error_pan"
            android:textSize="@dimen/text_14sp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_gst"
            android:id="@+id/label_gst"
            android:layout_marginTop="@dimen/size_24dp"
            android:textColor="@color/heading_black"
            android:textStyle="normal"
            android:textSize="@dimen/text_14sp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40dp"
            android:layout_marginTop="@dimen/size_6dp"
            android:layout_gravity="center"
            android:padding="@dimen/size_4dp"
            android:id="@+id/gstLay"
            android:background="@drawable/bg_all_round_corner_blue_selector_red">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_kyc_gst_number_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/size_6dp"
                android:textSize="@dimen/text_16sp"
                android:textColor="@color/faded_black"
                android:layout_weight="1"
                tools:text="20-AABCU9603R-1Z1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image_kyc_detail_gst_verified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_vector_circle_check"
                android:layout_marginEnd="@dimen/size_6dp"
                android:layout_gravity="center"/>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/error_red"
            android:layout_marginTop="4dp"
            android:textStyle="normal"
            android:id="@+id/error_gst"
            android:visibility="gone"
            android:textSize="@dimen/text_14sp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_address"
            android:layout_marginTop="@dimen/size_24dp"
            android:id="@+id/label_address"
            android:textColor="@color/heading_black"
            android:textStyle="normal"
            android:textSize="@dimen/text_14sp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/edit_text_height"
            android:layout_marginTop="@dimen/size_6dp"
            android:layout_gravity="center"
            android:id="@+id/address_lay"
            android:padding="@dimen/size_4dp"
            android:background="@drawable/bg_all_round_corner_blue_selector_red">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_kyc_address_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/size_6dp"
                android:textSize="@dimen/text_16sp"
                android:textColor="@color/faded_black"
                android:layout_weight="1"
                tools:text="Delhivery Ltd., Sector 4 Gurgaon"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image_kyc_detail_address_verified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_vector_circle_check"
                android:layout_marginEnd="@dimen/size_6dp"
                android:layout_gravity="center"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/error_red"
            android:layout_marginTop="4dp"
            android:textStyle="normal"
            android:id="@+id/error_address"
            android:visibility="gone"
            android:textSize="@dimen/text_14sp"/>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tv_rc"
            android:text="@string/label_truck_rc"
            android:layout_marginTop="@dimen/size_24dp"
            android:textColor="@color/heading_black"
            android:textStyle="normal"
            android:textSize="@dimen/text_14sp"/>
        <RadioGroup
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:id="@+id/businessRadio"
            android:layout_height="match_parent">
            <RadioButton
                android:layout_width="wrap_content"
                android:text="Truck RC"
                android:id="@+id/rcRadio"
                android:textSize="@dimen/text_14sp"
                android:layout_height="wrap_content"/>
            <RadioButton
                android:layout_width="wrap_content"
                android:id="@+id/lrRadio"
                android:enabled="false"
                android:textSize="@dimen/text_14sp"
                 android:layout_marginStart="@dimen/size_16dp"
                android:text="LR Copy - Loading Note"
                android:layout_height="wrap_content"/>
        </RadioGroup>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_40dp"
            android:layout_marginTop="@dimen/size_6dp"
            android:layout_gravity="center"
            android:id="@+id/truck_rc_lay"
            android:padding="@dimen/size_4dp"
            android:background="@drawable/bg_all_round_corner_blue_selector_red">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_rc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/size_6dp"
                android:textSize="@dimen/text_16sp"
                android:textColor="@color/faded_black"
                android:layout_weight="1"
                tools:text="Delhivery Ltd., Sector 44, Gurgaon"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image_rc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_vector_circle_check"
                android:layout_marginEnd="@dimen/size_6dp"
                android:layout_gravity="center"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/error_red"
            android:layout_marginTop="4dp"
            android:textStyle="normal"
            android:id="@+id/error_truck"
            android:visibility="gone"
            android:textSize="@dimen/text_14sp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
        </ScrollView>
        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/size_14dp"
            style="@style/ActionButton"
            android:layout_alignParentBottom="true"
            android:text="Retry"
            android:visibility="gone"
            android:id="@+id/btnRetry"
            android:layout_gravity="bottom"
            android:textAllCaps="false"/>
</RelativeLayout>
</layout>