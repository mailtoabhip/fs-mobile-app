<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
   xmlns:bind="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:background="@color/grey_bg"
        android:orientation="vertical"
        >
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        bind:shadow="@{ @dimen/size_1dp }"
        />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/size_16dp"
            android:background="@color/white"

            android:orientation="vertical">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:id="@+id/paymentTerms"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_payment_terms"
                    android:layout_gravity="center"
                    android:textSize="@dimen/text_16sp"
                    android:textColor="@color/heading_black"
                    android:padding="@dimen/size_11dp"
                    android:drawableStart="@drawable/ic_payment_terms"
                    android:layout_weight="1"
                    android:drawablePadding="@dimen/size_16dp"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    bind:srcCompat="@drawable/ic_vector_arrow"
                    />

            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/size_11dp"
                android:id="@+id/terms"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_tc"
                    android:layout_gravity="center"
                    android:drawableStart="@drawable/ic_terms_conditions"
                    android:layout_weight="1"
                    android:textSize="@dimen/text_14sp"
                    android:padding="@dimen/size_11dp"
                    android:textColor="@color/heading_black"
                    android:drawablePadding="@dimen/size_16dp"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    bind:srcCompat="@drawable/ic_vector_arrow"/>

            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/size_11dp"
                android:id="@+id/privacy"
                android:orientation="horizontal">
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_privacy_policy"
                    android:layout_gravity="center"
                    android:textSize="@dimen/text_14sp"
                    android:textColor="@color/heading_black"
                    android:padding="@dimen/size_11dp"
                    android:drawableStart="@drawable/ic_privacy_policy"
                    android:layout_weight="1"
                    android:drawablePadding="@dimen/size_16dp"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    bind:srcCompat="@drawable/ic_vector_arrow"/>

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <RelativeLayout
            android:layout_width="match_parent"
            android:id="@+id/deleteLayout"
            android:padding="@dimen/size_16dp"
            android:background="@color/white"
            android:layout_marginTop="@dimen/size_8dp"
            bind:layout_constraintTop_toBottomOf="@+id/div4"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:id="@+id/imgdelete"
                android:paddingStart="@dimen/size_8dp"
                bind:srcCompat="@drawable/ic_remove"
                android:layout_height="wrap_content"/>
            <TextView
                android:layout_width="match_parent"
                android:text="@string/label_delete"
                android:layout_toEndOf="@+id/imgdelete"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/size_16dp"
                android:textColor="@color/error_red"
                android:layout_marginEnd="@dimen/size_12dp"
                android:textSize="@dimen/text_14sp"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>