<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View"/>
        <variable
            name="viewModel"
            type="com.delhivery.axle.ui.home.fragments.home.HomeFragmentViewModel" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/size_24dp">


            <!-- Quick Action Icons Row -->
            <LinearLayout
                android:id="@+id/quickActionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_24dp"
                android:layout_marginHorizontal="@dimen/size_16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Fastag -->
                <LinearLayout
                    android:id="@+id/fastagCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/size_8dp"
                    android:background="@drawable/bg_quick_action_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/size_16dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/label_fastag_no_space"
                        android:src="@drawable/ic_fastag_home" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_10dp"
                        android:text="@string/label_fastag_no_space"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/text_14sp" />
                </LinearLayout>

                <!-- GPS -->
                <LinearLayout
                    android:id="@+id/gpsCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="@dimen/size_4dp"
                    android:background="@drawable/bg_quick_action_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/size_16dp">

                    <ImageView
                        android:layout_width="@dimen/size_48dp"
                        android:layout_height="@dimen/size_48dp"
                        android:layout_marginVertical="@dimen/size_6dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/label_gps"
                        android:src="@drawable/ic_gps_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_10dp"
                        android:text="@string/label_gps"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/text_14sp" />
                </LinearLayout>

                <!-- Fuel Card -->
                <LinearLayout
                    android:id="@+id/fuelCardAction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/size_8dp"
                    android:background="@drawable/bg_quick_action_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/size_16dp">

                    <ImageView
                        android:layout_width="@dimen/size_56dp"
                        android:layout_height="@dimen/size_56dp"
                        android:layout_marginVertical="@dimen/size_2dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/label_fuel_card_home"
                        android:src="@drawable/card" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_10dp"
                        android:text="@string/label_fuel_card_home"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/text_14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- FASTag Pending Actions Card -->
            <LinearLayout
                android:id="@+id/fastagPendingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/size_16dp"
                android:layout_marginTop="@dimen/size_24dp"
                android:background="@drawable/bg_fastag_pending_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/size_16dp"
                android:paddingVertical="@dimen/size_14dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/size_20dp"
                    android:layout_height="@dimen/size_20dp"
                    android:contentDescription="@string/label_fastag_title"
                    android:src="@drawable/fs_pending_clock" />

                <TextView
                    android:id="@+id/tvFastagPendingText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/size_10dp"
                    android:layout_weight="1"
                    android:textColor="#7B6414"
                    android:textSize="@dimen/text_14sp"
                    android:textStyle="bold"
                    tools:text="FASTag pending actions (8)" />

                <ImageView
                    android:layout_width="@dimen/size_20dp"
                    android:layout_height="@dimen/size_20dp"
                    android:contentDescription="@string/action_continue"
                    android:src="@drawable/ic_chevron_right_dark"
                    app:tint="#7B6414" />

            </LinearLayout>

            <!-- Configure Service Onboarding Section -->
            <TextView
                android:id="@+id/sectionOnboardingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/size_16dp"
                android:layout_marginTop="@dimen/size_32dp"
                android:layout_marginBottom="@dimen/size_16dp"
                android:text="@string/label_business_services"
                android:textColor="@android:color/black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold" />

<!--            &lt;!&ndash; Service Groups Loading Shimmer &ndash;&gt;-->
<!--            <LinearLayout-->
<!--                android:id="@+id/serviceGroupsShimmer"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:orientation="vertical"-->
<!--                android:visibility="gone">-->

<!--                <include layout="@layout/shimmer_service_group_item" />-->

<!--                <include layout="@layout/shimmer_service_group_item" />-->
<!--            </LinearLayout>-->

            <!-- Business Service Cards (My Trucks & My Loads) -->
            <LinearLayout
                android:id="@+id/businessServiceCardsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/size_16dp"
                android:orientation="horizontal">

                <!-- My Trucks Card -->
                <LinearLayout
                    android:id="@+id/myTrucksCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/size_6dp"
                    android:background="@drawable/bg_quick_action_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="@dimen/size_16dp">

                    <!-- Top row: Icon + Arrow -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/size_72dp"
                            android:layout_height="@dimen/size_72dp"
                            android:contentDescription="@string/label_my_trucks"
                            android:src="@drawable/container" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="@dimen/size_20dp"
                            android:layout_height="@dimen/size_20dp"
                            android:contentDescription="@string/action_continue"
                            android:src="@drawable/ic_arrow_forward_black" />
                    </LinearLayout>

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_8dp"
                        android:text="@string/label_my_trucks"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/text_14sp"
                        android:textStyle="bold" />

                    <!-- Subtitle -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_4dp"
                        android:text="@string/label_my_trucks_subtitle"
                        android:textColor="#2B2B2B"
                        android:textSize="@dimen/text_12sp" />
                </LinearLayout>

                <!-- My Loads Card -->
                <LinearLayout
                    android:id="@+id/myLoadsCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/size_6dp"
                    android:background="@drawable/bg_quick_action_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="@dimen/size_16dp">

                    <!-- Top row: Icon + Arrow -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/size_72dp"
                            android:layout_height="@dimen/size_64dp"
                            android:contentDescription="@string/label_my_loads"
                            android:scaleType="centerInside"
                            android:src="@drawable/home_axle_logo" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <ImageView
                            android:layout_width="@dimen/size_20dp"
                            android:layout_height="@dimen/size_20dp"
                            android:contentDescription="@string/action_continue"
                            android:src="@drawable/ic_arrow_forward_black" />
                    </LinearLayout>

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_12dp"
                        android:text="@string/label_my_loads"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/text_16sp"
                        android:textStyle="bold" />

                    <!-- Subtitle -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_4dp"
                        android:text="@string/label_my_loads_subtitle"
                        android:textColor="#2B2B2B"
                        android:textSize="@dimen/text_12sp" />
                </LinearLayout>
            </LinearLayout>



            <!-- We @Delhivery Section -->
            <TextView
                android:id="@+id/sectionWeAtDelhivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/size_16dp"
                android:layout_marginTop="@dimen/size_24dp"
                android:text="@string/label_we_at_delhivery"
                android:textColor="@android:color/black"
                android:visibility="gone"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold" />

            <!-- Banner Carousel -->
            <androidx.viewpager.widget.ViewPager
                android:id="@+id/bannerViewPager"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginHorizontal="@dimen/size_16dp"
                android:layout_marginTop="@dimen/size_12dp"
                android:clipToPadding="false"
                android:visibility="gone"
                android:overScrollMode="never" />

            <!-- Banner Dot Indicator -->
            <LinearLayout
                android:id="@+id/bannerDotsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/size_12dp"
                android:gravity="center"
                android:visibility="gone"
                android:orientation="horizontal" />

            <!-- KYC / Bidding Card (existing) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/biddingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/size_16dp"
                android:layout_marginTop="@dimen/size_12dp"
                app:cardCornerRadius="@dimen/size_12dp"
                android:visibility="gone"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Top Section -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/kycStatusCl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_border_kyc_card"
                        bind:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:id="@+id/kycStatusLl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/cardboard_surface_dark"
                            android:gravity="center"
                            android:layout_margin="@dimen/size_1dp"
                            android:orientation="vertical"
                            android:padding="@dimen/size_24dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/bidHammerIv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/label_bidding"
                                android:src="@drawable/ic_bid_hammer" />

                            <TextView
                                android:id="@+id/kycHeading"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/size_12dp"
                                android:textColor="@android:color/black"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="You're all set to start bidding" />

                            <TextView
                                android:id="@+id/kycMessage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAlignment="center"
                                android:textColor="@color/text_body_secondary"
                                android:textSize="@dimen/text_12sp"
                                android:textStyle="normal"
                                tools:text="Your account is activated. Explore and bid on available loads." />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/size_6dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progressDrawable="@drawable/kyc_progress"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/kycStatusCl" />

                    <!-- Button -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/buttonCl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/cardboard_surface_light"
                        app:layout_constraintTop_toBottomOf="@id/progressBar">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnGetStarted"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/size_16dp"
                            android:background="@drawable/bg_all_round_corner_solid_black"
                            android:padding="@dimen/size_16dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/btnTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:elevation="@dimen/size_8dp"
                            android:gravity="center_vertical"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/text_14sp"
                            app:layout_constraintBottom_toBottomOf="@id/btnGetStarted"
                            app:layout_constraintEnd_toEndOf="@id/btnGetStarted"
                            app:layout_constraintStart_toStartOf="@id/btnGetStarted"
                            app:layout_constraintTop_toTopOf="@id/btnGetStarted"
                            bind:drawableEndCompat="@drawable/ic_chevron_right_white"
                            tools:text="Start Bidding" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</layout>
