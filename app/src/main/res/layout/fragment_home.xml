<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

  <data>
      <import type="android.view.View"/>
    <variable
        name="viewModel"
        type="com.delhivery.axle.ui.home.fragments.home.HomeFragmentViewModel" />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/white">

    <!-- Top Cards Container -->
      <LinearLayout
        android:id="@+id/topCardsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

      <!-- Loads Card -->
      <androidx.cardview.widget.CardView
          android:id="@+id/loadsCard"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginVertical="@dimen/size_16dp"
          android:layout_marginStart="@dimen/size_16dp"
          android:layout_marginEnd="@dimen/size_8dp"
          app:cardCornerRadius="12dp"
          app:cardElevation="4dp"
          app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/size_16dp">

          <ImageView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:src="@drawable/ic_loads_home_new"
              android:contentDescription="Loads" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="@dimen/size_8dp"
              android:text="Loads"
              android:textSize="@dimen/text_16sp"
              android:textColor="@android:color/black"
              android:textStyle="bold" />

        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Fastag Card -->
      <androidx.cardview.widget.CardView
          android:id="@+id/fastagCard"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginVertical="@dimen/size_16dp"
          android:layout_marginEnd="@dimen/size_16dp"
          android:layout_marginStart="@dimen/size_8dp"
          app:cardCornerRadius="12dp"
          app:cardElevation="4dp"
          app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/size_16dp">

          <ImageView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:src="@drawable/ic_fastag_home"
              android:contentDescription="Fastag" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="@dimen/size_8dp"
              android:text="Fastag"
              android:textSize="@dimen/text_16sp"
              android:textColor="@android:color/black"
              android:textStyle="bold" />

        </LinearLayout>
      </androidx.cardview.widget.CardView>

    </LinearLayout>
      <!-- Search Bar -->
      <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/edit_sticky_search"
          android:layout_margin="@dimen/size_16dp"
          android:layout_width="match_parent"
          android:layout_height="44dp"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/topCardsContainer"
          android:layout_marginEnd="@dimen/size_8dp"
          android:background="@drawable/bg_search_white_load_minimal_padding"
          android:clickable="true"
          android:focusable="true">

          <androidx.appcompat.widget.AppCompatImageView
              android:id="@+id/search_icon"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:tint="@color/gray_tint"
              android:src="@drawable/ic_search_black"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              app:layout_constraintBottom_toBottomOf="parent" />

          <androidx.appcompat.widget.AppCompatTextView
              android:id="@+id/search_hint"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_marginStart="@dimen/size_8dp"
              android:ellipsize="end"
              android:gravity="start"
              android:singleLine="true"
              android:text="Search Loads"
              android:textColor="#A3AAC2"
              android:textSize="@dimen/text_14sp"
              app:layout_constraintBottom_toBottomOf="parent"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toEndOf="@id/search_icon"
              app:layout_constraintTop_toTopOf="parent" />

      </androidx.constraintlayout.widget.ConstraintLayout>
      <!-- Start Bidding Card -->
      <androidx.cardview.widget.CardView
          android:id="@+id/biddingCard"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/size_16dp"
          android:layout_marginEnd="@dimen/size_16dp"
          android:layout_marginTop="@dimen/size_16dp"
          app:layout_constraintTop_toBottomOf="@id/edit_sticky_search"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp">

          <androidx.constraintlayout.widget.ConstraintLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content">

              <!-- Top Section -->
              <LinearLayout
                  android:id="@+id/kycStatusLl"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:gravity="center"
                  android:background="@color/cardboard_surface_dark"
                  android:padding="@dimen/size_24dp"
                  app:layout_constraintTop_toTopOf="parent"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintEnd_toEndOf="parent">

                  <ImageView
                      android:id="@+id/bidHammerIv"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:src="@drawable/ic_bid_hammer"
                      android:contentDescription="Bidding" />

                  <TextView
                      android:id="@+id/kycHeading"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="@dimen/size_12dp"
                      android:textSize="16sp"
                      android:textColor="@android:color/black"
                      android:textStyle="bold"
                      tools:text="You're all set to start bidding" />

                  <TextView
                      android:id="@+id/kycMessage"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:textSize="@dimen/text_12sp"
                      android:textStyle="normal"
                      android:textAlignment="center"
                      android:textColor="@color/text_body_secondary"
                      tools:text="Your account is activated. Explore and bid on available loads." />

              </LinearLayout>

              <!-- Progress Bar -->
              <ProgressBar
                  android:id="@+id/progressBar"
                  style="?android:attr/progressBarStyleHorizontal"
                  android:layout_width="0dp"
                  android:layout_height="@dimen/size_6dp"
                  android:max="100"
                  android:indeterminate="false"
                  android:progressDrawable="@drawable/kyc_progress"
                  app:layout_constraintTop_toBottomOf="@id/kycStatusLl"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintEnd_toEndOf="parent" />

              <!-- Button -->
              <androidx.constraintlayout.widget.ConstraintLayout
                  android:id="@+id/buttonCl"
                  android:background="@color/cardboard_surface_light"
                  app:layout_constraintTop_toBottomOf="@id/progressBar"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content">


              <androidx.appcompat.widget.AppCompatButton
                  android:id="@+id/btnGetStarted"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_margin="@dimen/size_16dp"
                  android:background="@drawable/bg_all_round_corner_solid_black"
                  android:padding="@dimen/size_16dp"
                  bind:layout_constraintBottom_toBottomOf="parent"
                  bind:layout_constraintTop_toTopOf="parent"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintEnd_toEndOf="parent" />

              <TextView
                  android:id="@+id/btnTv"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:textColor="@android:color/white"
                  android:elevation="@dimen/size_8dp"
                  android:textSize="@dimen/text_14sp"
                  android:gravity="center_vertical"
                  app:layout_constraintTop_toTopOf="@id/btnGetStarted"
                  app:layout_constraintBottom_toBottomOf="@id/btnGetStarted"
                  app:layout_constraintStart_toStartOf="@id/btnGetStarted"
                  app:layout_constraintEnd_toEndOf="@id/btnGetStarted"
                  bind:drawableEndCompat="@drawable/ic_chevron_right_white"
                  tools:text="Start Bidding" />
              </androidx.constraintlayout.widget.ConstraintLayout>
          </androidx.constraintlayout.widget.ConstraintLayout>

      </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
