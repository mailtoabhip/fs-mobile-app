<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        app:layout_constraintTop_toTopOf="@+id/filter"
        app:layout_constraintBottom_toBottomOf="@+id/filter"
        android:paddingStart="@dimen/size_16dp"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_cancel_grey"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/filter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cancel"
        android:text="Filter"
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_16sp"
        android:padding="@dimen/size_16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/div"
        android:layout_width="wrap_content"
        android:layout_height="2dp"
        android:background="@color/grey_bg"
        app:layout_constraintTop_toBottomOf="@+id/filter"
        app:layout_constraintStart_toStartOf="parent"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/hourTv"
        app:layout_constraintTop_toBottomOf="@+id/div"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/rvTime"
        android:padding="@dimen/size_16dp"
        android:text="Hours"
        android:textSize="@dimen/text_14sp"
        android:textColor="@color/colorRed"
        app:layout_constraintWidth_percent="0.4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTime"
        android:padding="@dimen/size_16dp"
        app:layout_constraintStart_toEndOf="@+id/hourTv"
        app:layout_constraintTop_toBottomOf="@+id/div"
        app:layout_constraintWidth_percent="0.6"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/light_grey_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_submit"
        style="@style/SubmitButton"
        app:layout_constraintTop_toBottomOf="@+id/rvTime"
        android:enabled="true"
        android:textAllCaps="false"
        android:layout_marginEnd="@dimen/size_16dp"
        android:layout_marginStart="@dimen/size_16dp"
        android:layout_marginBottom="@dimen/size_16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/size_20dp"
        android:text="Apply"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>