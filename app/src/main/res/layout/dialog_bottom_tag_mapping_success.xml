<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_all_round_corner_white_boundary"
    android:orientation="vertical">

    <!-- Header -->
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/size_16dp"
        android:text="@string/str_fastag_mapping"
        android:textColor="@color/text_body_primary"
        style="@style/TextAppearance.Delfin.B16"
        android:textSize="@dimen/text_14sp"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E6E6E6" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/size_24dp"
        android:paddingTop="@dimen/size_32dp"
        android:paddingBottom="@dimen/size_24dp">

        <!-- Green check icon -->
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle_green"
            android:contentDescription="Success"
            android:padding="@dimen/size_14dp"
            android:src="@drawable/ic_check_white" />

        <!-- Title -->
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20dp"
            android:gravity="center"
            android:text="@string/str_fastag_mapped_successfully"
            android:textColor="@color/text_primary"
            style="@style/TextAppearance.Delfin.B20" />

        <!-- Subtitle -->
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8dp"
            android:gravity="center"
            android:text="@string/str_you_can_now_continue_to_know_your_vehicle"
            android:textColor="@color/grey_500"
            style="@style/TextAppearance.Delfin.M14" />

    </LinearLayout>

    <!-- Continue to KYV button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinueToKyv"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="@dimen/size_16dp"
        android:layout_marginBottom="@dimen/size_24dp"
        android:background="@drawable/bg_tag_mapping_continue_enabled"
        android:fontFamily="sans-serif-medium"
        android:text="Continue to KYV"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

</LinearLayout>
