<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="request"
            type="com.delhivery.axle.data.home.placements.HomePlacementsItemData"
            />

        <import type="android.view.View" />
    </data>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<androidx.appcompat.widget.AppCompatImageView
    android:layout_width="@dimen/size_36dp"
    android:layout_height="@dimen/size_32dp"
    android:id="@+id/edit"
    android:padding="@dimen/size_8dp"
    android:layout_marginEnd="@dimen/size_8dp"
    android:visibility="@{request.editIconVisibility()}"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toStartOf="@+id/btnShareWhatsapp"
    android:src="@drawable/ic_edit_placement"
    android:background="@drawable/bg_all_round_corner_grey_boundary"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/btnShareWhatsapp"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/edit"
        app:layout_constraintEnd_toStartOf="@+id/btnCall"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="visible"
        android:background="@drawable/bg_all_round_corner_grey_boundary">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share Details"
            android:textColor="@color/info_title"
            android:textSize="@dimen/text_14sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_whatsapp"
            android:drawablePadding="8dp"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatButton
        android:layout_marginStart="@dimen/size_8dp"
        android:id="@+id/btnCall"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_32dp"
        android:text="Call"
        android:textAllCaps="false"
        android:visibility="@{request.callVisibility()}"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnShareWhatsapp"
        app:layout_constraintEnd_toStartOf="@+id/btnFillDetails"
        android:textColor="@color/white"
        android:gravity="center"
        android:background="@drawable/bg_dark_button"
        android:paddingHorizontal="@dimen/size_16dp"
        android:paddingVertical="8dp"
        android:textSize="@dimen/text_14sp"
        android:textStyle="bold"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/btnFillDetails"
        android:layout_width="0dp"
        android:layout_marginStart="@dimen/size_8dp"
        android:layout_height="@dimen/size_32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnCall"
        app:layout_constraintEnd_toEndOf="parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="@{request.fillDetailsVisibility()}"
        android:background="@drawable/bg_all_round_corner_red_v1_boundary">

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fill Details"
            android:textColor="@color/text_red_v1"
            android:textSize="@dimen/text_14sp"
            android:textStyle="bold"
            android:drawableEnd="@drawable/ic_fill_details"
            android:drawablePadding="8dp"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>
</layout>