<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tool="http://schemas.android.com/tools">
  <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="@color/heading_black"
        android:text="Account Deletion"
        />
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_2dp"
        android:id="@+id/centerView"
        android:layout_marginTop="@dimen/size_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
  <androidx.appcompat.widget.AppCompatTextView
    android:id="@+id/tvLabel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintBottom_toTopOf="@+id/centerView"
    app:layout_constraintStart_toStartOf="parent"
    android:textSize="@dimen/text_26sp"
    android:padding="@dimen/size_12dp"
    android:textStyle="bold"
    android:textAlignment="center"
    android:textColor="@color/sub_heading_black"
    android:text="@string/account_deletion"
    />
  <androidx.appcompat.widget.AppCompatButton
      android:id="@+id/callVendorDesk"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="Call Vendor Desk"
      android:padding="@dimen/size_10dp"
      android:textSize="@dimen/text_18sp"
      android:layout_marginTop="@dimen/size_32dp"
      android:background="@color/colorAccent"
      android:textColor="@color/white"
      app:layout_constraintTop_toBottomOf="@+id/tvLabel"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      />
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/logout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:padding="@dimen/size_10dp"
        android:textSize="@dimen/text_18sp"
        android:layout_marginTop="@dimen/size_16dp"
        android:background="@color/colorAccent"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/callVendorDesk"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>