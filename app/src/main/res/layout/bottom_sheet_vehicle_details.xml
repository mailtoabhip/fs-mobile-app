<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded_top"
    android:paddingBottom="@dimen/size_16dp">

    <!-- Header -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_16dp"
        android:layout_marginTop="@dimen/size_16dp"
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/ivClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="@dimen/size_24dp"
        android:layout_height="@dimen/size_24dp"
        android:layout_marginEnd="@dimen/size_16dp"
        android:src="@drawable/ic_close"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTitle" />

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/size_16dp"
        android:background="#E0E3EB"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Vehicle Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVehicleInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/size_16dp"
        android:layout_marginTop="@dimen/size_16dp"
        android:layout_marginEnd="@dimen/size_16dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/size_8dp"
        app:cardElevation="0dp"
        app:strokeColor="#E0E3EB"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/size_16dp">

            <!-- Color indicator -->
            <View
                android:id="@+id/colorIndicator"
                android:layout_width="4dp"
                android:layout_height="0dp"
                android:background="#4CAF50"
                app:layout_constraintBottom_toBottomOf="@id/tvVehicleNumber"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvVehicleNumber" />

            <!-- Vehicle Number -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvVehicleNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_8dp"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/tvStatusBadge"
                app:layout_constraintStart_toEndOf="@id/colorIndicator"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Status Badge (visible only for hotlisted) -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hotlisted_badge"
                android:paddingHorizontal="@dimen/size_8dp"
                android:paddingVertical="@dimen/size_4dp"
                android:text="Hotlisted"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_12sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Column 1 -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvCol1Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_8dp"
                android:layout_marginTop="@dimen/size_16dp"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_12sp"
                app:layout_constraintEnd_toStartOf="@id/tvCol2Label"
                app:layout_constraintStart_toEndOf="@id/colorIndicator"
                app:layout_constraintTop_toBottomOf="@id/tvVehicleNumber" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvCol1Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size_8dp"
                android:layout_marginTop="@dimen/size_4dp"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/tvCol2Label"
                app:layout_constraintStart_toEndOf="@id/colorIndicator"
                app:layout_constraintTop_toBottomOf="@id/tvCol1Label" />

            <!-- Column 2 -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvCol2Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_12sp"
                app:layout_constraintEnd_toStartOf="@id/tvCol3Label"
                app:layout_constraintStart_toEndOf="@id/tvCol1Label"
                app:layout_constraintTop_toBottomOf="@id/tvVehicleNumber" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvCol2Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_4dp"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/tvCol3Label"
                app:layout_constraintStart_toStartOf="@id/tvCol2Label"
                app:layout_constraintTop_toBottomOf="@id/tvCol2Label" />

            <!-- Column 3 -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvCol3Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_16dp"
                android:textColor="@color/background_dark_grey"
                android:textSize="@dimen/text_12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvCol2Label"
                app:layout_constraintTop_toBottomOf="@id/tvVehicleNumber" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvCol3Value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_4dp"
                android:textColor="@color/heading_black"
                android:textSize="@dimen/text_14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/tvCol3Label"
                app:layout_constraintTop_toBottomOf="@id/tvCol3Label" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Action Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnAction"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_48dp"
        android:layout_marginStart="@dimen/size_16dp"
        android:layout_marginTop="@dimen/size_24dp"
        android:layout_marginEnd="@dimen/size_16dp"
        android:background="@drawable/bg_all_round_corner_solid_black"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardVehicleInfo" />

</androidx.constraintlayout.widget.ConstraintLayout>
