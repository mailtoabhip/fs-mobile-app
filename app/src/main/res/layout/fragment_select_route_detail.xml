<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="route"
        type="com.delhivery.orion.data.RouteModel"
        />
  </data>

  <android.support.v7.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/colorBackground"
      android:focusableInTouchMode="true"
      android:orientation="vertical"
      android:paddingTop="@dimen/size_24dp"
      >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/size_24dp"
        android:layout_marginStart="@dimen/size_24dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="@dimen/text_6sp"
        android:text="@string/label_origin_city"
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_20sp"
        android:textStyle="bold"
        />

    <android.support.v7.widget.CardView
        android:id="@+id/container_gps_origin_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/size_24dp"
        android:layout_marginStart="@dimen/size_24dp"
        android:layout_marginTop="@dimen/size_12dp"
        app:cardBackgroundColor="@color/colorPrimary"
        app:cardCornerRadius="@dimen/size_4dp"
        app:cardElevation="@dimen/size_8dp"
        >

      <android.support.constraint.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_margin="@dimen/size_16dp"
          >

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/img_gps"
            android:layout_width="@dimen/size_24dp"
            android:layout_height="@dimen/size_24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_gps_light"
            />

        <TextView
            android:id="@+id/text_origin_city_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/img_gps"
            android:layout_alignTop="@id/img_gps"
            android:layout_marginEnd="@dimen/size_18dp"
            android:layout_marginStart="@dimen/size_18dp"
            android:layout_toEndOf="@id/img_gps"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            android:textStyle="normal"
            app:layout_constraintEnd_toStartOf="@id/img_edit"
            app:layout_constraintStart_toEndOf="@id/img_gps"
            app:layout_constraintTop_toTopOf="parent"
            bind:htmlText="@{ @string/label_city_state(route.origin.city, route.origin.state) }"
            />

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/img_edit"
            android:layout_width="@dimen/size_24dp"
            android:layout_height="@dimen/size_24dp"
            android:layout_alignParentEnd="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_edit_pencil"
            />
      </android.support.constraint.ConstraintLayout>

    </android.support.v7.widget.CardView>

    <TextView
        android:id="@+id/text_destination_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/size_24dp"
        android:layout_marginStart="@dimen/size_24dp"
        android:layout_marginTop="@dimen/size_24dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="@dimen/text_6sp"
        android:text=""
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_20sp"
        android:textStyle="bold"
        bind:htmlText="@{ @string/label_destination_state(route.destinationCount()) }"
        bind:text="@string/label_destination_city"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/size_12dp"
        android:layout_marginEnd="@dimen/size_24dp"
        android:layout_marginStart="@dimen/size_24dp"
        android:layout_marginTop="@dimen/size_12dp"
        >
      <android.support.v7.widget.LinearLayoutCompat
          android:id="@+id/container_destination"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          />
    </ScrollView>
  </android.support.v7.widget.LinearLayoutCompat>
</layout>