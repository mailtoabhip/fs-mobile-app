<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="route"
        type="com.delhivery.orion.data.RouteModel"
        />
  </data>

  <android.support.constraint.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/colorBackground"
      android:focusableInTouchMode="true"
      android:orientation="vertical"
      android:paddingTop="@dimen/size_24dp"
      >

    <TextView
        android:id="@+id/id1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/size_24dp"
        android:layout_marginStart="@dimen/size_24dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="@dimen/text_6sp"
        android:text="@string/label_origin_city"
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <android.support.v7.widget.CardView
        android:id="@+id/container_gps_origin_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/size_24dp"
        android:layout_marginStart="@dimen/size_24dp"
        android:layout_marginTop="@dimen/size_12dp"
        app:layout_constraintTop_toBottomOf="@id/id1"
        app:cardBackgroundColor="@color/colorPrimary"
        app:cardCornerRadius="@dimen/size_4dp"
        app:cardElevation="@dimen/size_8dp"
        >

      <android.support.constraint.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_margin="@dimen/size_16dp"
          >

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/img_gps"
            android:layout_width="@dimen/size_24dp"
            android:layout_height="@dimen/size_24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_gps_light"
            />

        <TextView
            android:id="@+id/text_origin_city_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/img_gps"
            android:layout_alignTop="@id/img_gps"
            android:layout_marginEnd="@dimen/size_18dp"
            android:layout_marginStart="@dimen/size_18dp"
            android:layout_toEndOf="@id/img_gps"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            android:textStyle="normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/img_gps"
            app:layout_constraintTop_toTopOf="parent"
            bind:htmlText="@{ @string/label_city_state(route.origin.city, route.origin.state) }"
            />

      </android.support.constraint.ConstraintLayout>

    </android.support.v7.widget.CardView>

    <TextView
        android:id="@+id/text_destination_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/size_24dp"
        android:layout_marginStart="@dimen/size_24dp"
        android:layout_marginTop="@dimen/size_24dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="@dimen/text_6sp"
        android:text=""
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container_gps_origin_city"
        bind:htmlText="@{ @string/label_destination_state(route.destinationCount()) }"
        />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_destination_heading"
        >

      <android.support.v7.widget.RecyclerView
          android:id="@+id/rv_destinations"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_margin="@dimen/size_12dp"
          android:saveEnabled="false"

          />

      <android.support.v7.widget.LinearLayoutCompat
          android:id="@+id/btn_save"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:layout_alignParentBottom="true"
          android:layout_marginEnd="@dimen/size_8dp"
          android:layout_marginStart="@dimen/size_8dp"
          android:visibility="gone"
          bind:shadow="@{ @dimen/action_btn_elevation }"
          style="@style/view_header_background"
          >

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:text="@string/update_route"
            android:textColor="@color/white"
            android:textSize="@dimen/text_16sp"
            android:textStyle="normal"
            />

      </android.support.v7.widget.LinearLayoutCompat>

    </RelativeLayout>

  </android.support.constraint.ConstraintLayout>
</layout>