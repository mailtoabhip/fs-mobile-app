<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="route"
        type="com.delhivery.axle.data.home.routes.RouteModel"
        />
  </data>

  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/colorBackground"
      android:focusableInTouchMode="true"
      android:orientation="vertical"
      android:paddingTop="@dimen/size_24dp"
      >

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/id1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/size_24dp"
        android:layout_marginStart="@dimen/size_24dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="@dimen/text_6sp"
        android:text="@string/label_origin_city"
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/container_gps_origin_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/size_24dp"
        android:layout_marginStart="@dimen/size_24dp"
        android:layout_marginTop="@dimen/size_12dp"
        app:layout_constraintTop_toBottomOf="@id/id1"
        app:cardBackgroundColor="@color/colorPrimary"
        app:cardCornerRadius="@dimen/size_4dp"
        app:cardElevation="@dimen/size_8dp"
        >

      <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/container_city"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_margin="@dimen/size_16dp"
          >

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_gps"
            android:layout_width="@dimen/size_24dp"
            android:layout_height="@dimen/size_24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_gps_light"
            />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/text_origin_city_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/size_12dp"
            android:layout_marginStart="@dimen/size_12dp"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@color/heading_black"
            android:textSize="@dimen/text_16sp"
            android:hint="Origin City"
            android:text="@{route.origin.city}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/img_edit_origin"
            app:layout_constraintStart_toEndOf="@id/img_gps"
            app:layout_constraintTop_toTopOf="parent"
            />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_edit_origin"
            android:layout_width="@dimen/size_24dp"
            android:layout_height="@dimen/size_24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_edit_pencil"
            />

      </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/text_destination_heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/size_24dp"
        android:layout_marginStart="@dimen/size_24dp"
        android:layout_marginTop="@dimen/size_24dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="@dimen/text_6sp"
        android:text="Destination States"
        android:textColor="@color/heading_black"
        android:textSize="@dimen/text_20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container_gps_origin_city"
        />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_destination_heading"
        >

      <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/rv_destinations"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:layout_marginEnd="@dimen/size_12dp"
          android:layout_marginStart="@dimen/size_12dp"
          android:layout_marginTop="@dimen/size_12dp"
          android:saveEnabled="false"
          />

      <androidx.appcompat.widget.LinearLayoutCompat
          android:id="@+id/btn_save"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:layout_alignParentBottom="true"
          android:layout_marginEnd="@dimen/size_8dp"
          android:layout_marginStart="@dimen/size_8dp"
          android:visibility="gone"
          bind:shadow="@{ @dimen/action_btn_elevation }"
          style="@style/view_header_background"
          >

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/text_6sp"
            android:text="@string/action_update_route"
            android:textColor="@color/white"
            android:textSize="@dimen/text_16sp"
            />

      </androidx.appcompat.widget.LinearLayoutCompat>

    </RelativeLayout>

  </androidx.constraintlayout.widget.ConstraintLayout>
</layout>