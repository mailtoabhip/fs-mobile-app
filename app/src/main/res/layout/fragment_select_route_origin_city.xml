<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    >
  <data>
    <variable
        name="viewModel"
        type="com.delhivery.orion.ui.selectroute.fragments.origincity.SelectRouteOriginCityViewModel"
        />
  </data>

  <android.support.v7.widget.LinearLayoutCompat
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:focusableInTouchMode="true"
      android:orientation="vertical"
      android:paddingTop="24dp"
      >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="6sp"
        android:text="@string/label_origin_city"
        android:textColor="#de000000"
        android:textSize="26sp"
        android:textStyle="bold"
        />

    <com.delhivery.orion.ui.custom.DelhiveryCityAutoEditText
        android:id="@+id/edit_origin_city"
        android:layout_marginEnd="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:hint="@string/hint_enter_city_name"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        style="@style/FormInputField"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.01"
        android:lineSpacingExtra="5sp"
        android:text="@string/msg_pickup_location_city_based"
        android:textColor="#99000000"
        android:textSize="14sp"
        android:textStyle="normal"
        />

    <android.support.v7.widget.CardView
        android:id="@+id/container_gps_origin_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardBackgroundColor="@color/colorPrimary"
        app:cardCornerRadius="4dp"
        app:cardElevation="8dp"
        >

      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_margin="16dp"
          >

        <android.support.v7.widget.AppCompatImageView
            android:id="@+id/img_gps"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ic_gps_light"
            />

        <TextView
            android:id="@+id/text_origin_city_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/img_gps"
            android:layout_alignTop="@id/img_gps"
            android:layout_marginStart="18dp"
            android:layout_toEndOf="@id/img_gps"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="#de000000"
            android:textSize="16sp"
            android:textStyle="normal"
            tools:text="Panjim, Goa"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/text_origin_city_name"
            android:layout_below="@id/text_origin_city_name"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="4sp"
            android:text="@string/msg_use_location_as_origin_city"
            android:textColor="#8a000000"
            android:textSize="12sp"
            android:textStyle="normal"
            />
      </RelativeLayout>

    </android.support.v7.widget.CardView>
  </android.support.v7.widget.LinearLayoutCompat>
</layout>