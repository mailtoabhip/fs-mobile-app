<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:bind="http://schemas.android.com/apk/res-auto">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        >
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_toolbar"
        android:background="@android:color/white"
        bind:shadow="@{ @dimen/size_1dp }"
        />
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/kycTabLayout"
            android:layout_width="match_parent"
            bind:tabTextAppearance="@style/CustomTextAppearanceTab"
            bind:tabIndicatorColor="@color/switch_red"
            android:background="@color/white"
            android:tabStripEnabled="true"
            bind:tabBackground="@color/white"
            bind:tabGravity="fill"
            bind:tabMode="fixed"
            bind:tabPaddingEnd="-1dp"
            bind:tabPaddingStart="-1dp"
            bind:tabRippleColor="@null"
            android:layout_height="wrap_content"/>
        <com.delhivery.axle.ui.custom.DelhiverViewPager
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />


    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>