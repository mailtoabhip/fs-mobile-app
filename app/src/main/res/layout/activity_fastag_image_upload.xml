<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="com.delhivery.axle.ui.fastag.tagAssignment.assign.kyv.KYVFastagImageUploadViewModel" />
    </data>

    <LinearLayout
        android:id="@+id/parentLl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_toolbar"
            android:background="@android:color/white"
            android:elevation="2dp"
            app:contentInsetStartWithNavigation="@dimen/size_8dp"
            app:navigationIcon="@drawable/ic_close"
            app:title="@string/know_your_vehicle_title"
            app:titleTextColor="@android:color/black"
            app:titleTextAppearance="@style/Toolbar.TitleText" />

        <!-- Scrollable Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/size_16dp">

                <!-- Section Title -->
                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/upload_fastag_image_title"
                    android:textColor="@color/neutral_black_200"
                    android:textSize="@dimen/text_16sp"
                    android:textStyle="bold" />

                <!-- Vehicle Info Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16dp"
                    android:background="@drawable/bg_vehicle_info_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/size_12dp"
                    android:paddingVertical="@dimen/size_12dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvVehicleNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/neutral_black_200"
                        android:textSize="@dimen/text_14sp"
                        tools:text="Vehicle Number: DL01CA1268" />

                </LinearLayout>

                <!-- Upload FASTag Image -->
                <com.delhivery.axle.ui.common.UploadCardView
                    android:id="@+id/uploadFastagImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_16dp"
                    app:uploadTitle="@string/upload_fastag_image_label"
                    app:uploadSubtitle="@string/upload_file_format_info" />

            </LinearLayout>
        </ScrollView>

        <!-- Submit Button (sticky at bottom) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/size_16dp"
            android:layout_marginBottom="@dimen/size_16dp"
            android:background="@drawable/bg_all_round_corner_solid_black"
            android:elevation="0dp"
            android:enabled="false"
            android:gravity="center"
            android:paddingVertical="@dimen/size_16dp"
            android:stateListAnimator="@null"
            android:text="@string/submit_for_verification"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_16sp"
            android:textStyle="bold" />

    </LinearLayout>
</layout>
